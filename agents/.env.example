# ============================================================
# Offer Catcher - Agents 服务环境变量
# ============================================================
# 说明：
# 1. main.go 只加载 agents/.env（godotenv，单文件）。
# 2. 适配 CNB 云原生环境：容器每天空白重启、不保存快照，
#    因此本文件直接提供可用的默认配置（含本地开发密码）。
# 3. 使用：make start 会自动生成 .env；也可手动 cp .env.example .env。
# ============================================================

# 服务监听端口（默认 18080）
AGENTS_PORT=18080

# 数据库名（默认 offer_catcher_re）
AGENTS_DB_NAME=offer_catcher_re

# ---- MySQL 连接信息 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
