# ============================================================
# Offer Catcher - Agents 服务环境变量示例
# ============================================================
# 说明：
# 1. main.go 会自动加载 .env / ../.env / ../../.env（godotenv），
#    且不会覆盖已存在的操作系统环境变量。
# 2. 数据库连接信息从环境变量读取，以下 DB_* 为【必填】项；
#    缺少任一必填项时，服务启动会输出明确错误并终止。
# 3. AGENTS_PORT / AGENTS_DB_NAME 有内置默认值（18080 / offer_catcher_re）。
# 4. 本文件不包含任何默认密码，请自行填入真实值。
#
# 使用：cp .env.example .env 并填入真实值
# ============================================================

# 服务监听端口（默认 18080，可省略）
AGENTS_PORT=18080

# 数据库名（默认 offer_catcher_re，可省略）
AGENTS_DB_NAME=offer_catcher_re

# ---- MySQL 连接信息（必填，请填写真实值） ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
