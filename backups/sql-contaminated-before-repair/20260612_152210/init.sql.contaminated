/*!40000 ALTER TABLE `match_analyses` ENABLE KEYS */;
UNLOCK TABLES;
DROP TABLE IF EXISTS `recommendation_results`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `recommendation_results` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `user_id` bigint unsigned NOT NULL,
  `resume_id` bigint unsigned NOT NULL,
  `result_json` json NOT NULL,
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `generation_tier` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'fast' COMMENT 'fast / quality',
  `generated_by` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'mock_agent' COMMENT 'mock_agent / mock_quality / llm_agent',
  `status` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'ready' COMMENT 'ready / error',
  `profile_type` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `profile_dominant_profile` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `updated_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `idx_rec_user_created` (`user_id`,`created_at`),
  KEY `idx_rec_resume` (`resume_id`),
  KEY `idx_rec_resume_tier_created` (`resume_id`,`generation_tier`,`created_at`),
  KEY `idx_rec_user_resume_created` (`user_id`,`resume_id`,`created_at`),
  CONSTRAINT `fk_rec_resume` FOREIGN KEY (`resume_id`) REFERENCES `resumes` (`id`),
  CONSTRAINT `fk_rec_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=48 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='岗位推荐结果表';
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `recommendation_results` WRITE;
/*!40000 ALTER TABLE `recommendation_results` DISABLE KEYS */;
INSERT INTO `recommendation_results` VALUES (1,2,1,'[{\"city\": \"深圳总部\", \"title\": \"算法-自然语言处理方向\", \"job_id\": 10003, \"category\": \"自然语言处理\", \"job_type\": \"技术\", \"priority\": \"high\", \"department\": \"企业发展事业群\", \"source_url\": \"\", \"external_id\": \"tencent-algorithm-nlp-intern-2026-001\", \"is_featured\": false, \"risk_points\": [\"缺少NLP专项项目或论文\", \"未涉及Transformer/预训练语言模型应用\"], \"agent_status\": \"mock_success\", \"data_quality\": \"manual_verified\", \"generated_by\": \"mock_agent\", \"match_evidence\": [{\"strength\": \"strong\", \"explanation\": \"简历中有PyTorch和深度学习项目经验\", \"resume_signal\": \"建模能力\", \"job_requirement\": \"岗位要求建模能力\"}, {\"strength\": \"strong\", \"explanation\": \"简历中有AUC/NDCG/消融实验等实验经验\", \"resume_signal\": \"实验能力\", \"job_requirement\": \"岗位要求实验评估能力\"}, {\"strength\": \"medium\", \"explanation\": \"简历中有研究方向和论文成果\", \"resume_signal\": \"研究能力\", \"job_requirement\": \"岗位要求研究能力\"}], \"apply_readiness\": \"ready_to_apply\", \"external_source\": \"manual_curated\", \"resume_evidence\": [\"深度学习模型训练经验\", \"实验评估与消融分析能力\"], \"why_ranked_here\": \"该岗位在NLP方向与你的简历证据匹配度最高，在5个候选岗位中排名第1。\", \"match_highlights\": [\"岗位方向与你的核心技能方向高度一致\", \"标签匹配度较高\", \"研究能力与该岗位要求匹配\"], \"suggested_action\": \"建议优先查看岗位详情并进行匹配分析。自然语言处理方向是你的强项。\", \"job_specific_risks\": [\"缺少NLP专项项目或论文\", \"未涉及Transformer/预训练语言模型应用\"], \"job_specific_reason\": \"NLP方向岗位与推荐系统在模型训练和数据实验上有共通方法论，但你目前缺少NLP专项项目（如文本分类、命名实体识别、预训练语言模型微调）。\", \"recommendation_label\": \"高匹配，重点关注\", \"recommendation_score\": 84, \"recommendation_reason\": \"你的算法研究画像与该岗位高度匹配，技能积累和项目经验可直接复用。\", \"suggested_improvement\": \"建议增加至少1个NLP方向项目（如文本分类/情感分析/问答系统），展示对Transformer架构的实际使用经验。\", \"recommendation_priority\": \"high\", \"optimization_stop_signal\": \"stop_and_apply\"}, {\"city\": \"深圳总部\", \"title\": \"算法-数据科学方向\", \"job_id\": 10022, \"category\": \"数据科学\", \"job_type\": \"技术\", \"priority\": \"high\", \"department\": \"企业发展事业群\", \"source_url\": \"\", \"external_id\": \"tencent-algorithm-data-science-intern-20