DROP TABLE IF EXISTS `resume_awards`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resume_awards` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `resume_id` bigint unsigned NOT NULL,
  `name` varchar(150) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `description` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `sort_order` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `idx_ra_resume` (`resume_id`,`sort_order`),
  CONSTRAINT `fk_ra_resume` FOREIGN KEY (`resume_id`) REFERENCES `resumes` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=19 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resume_awards` WRITE;
/*!40000 ALTER TABLE `resume_awards` DISABLE KEYS */;
INSERT INTO `resume_awards` VALUES (1,1,'研究生学业一等奖学金','校级奖学金，2024 年 10 月获得，基于课程成绩、科研参与和综合表现评定。',0),(2,1,'全国大学生数学建模竞赛省级二等奖','省级二等奖，2021 年 11 月获得，主要负责数据建模、算法实现和结果可视化部分。',1),(3,1,'北京邮电大学优秀毕业生','校级荣誉，2023 年 6 月获得，基于本科阶段学业成绩、竞赛经历和综合表现评定。',2),(4,2,'校级程序设计竞赛三等奖','校级三等奖，2023 年 12 月获得，主要使用 C++ 完成数组、字符串、排序、搜索和基础动态规划题目。',0),(5,2,'软件工程课程设计优秀项目','课程项目荣誉，2024 年 7 月获得，项目为校园二手交易平台后端系统，主要负责后端接口设计、数据库建模和部署联调。',1),(6,2,'优秀学生干部','学院级荣誉，2024 年 6 月获得，担任班级学习委员，参与课程资料整理、学习打卡组织和班级事务协同。',2),(7,3,'校级互联网+创新创业训练项目立项','校级项目立项，2024 年 6 月获得，参与校园服务类项目的需求调研和商业计划书撰写，主要负责用户问题分析、竞品调研和产品功能规划部分。',0),(8,3,'商学院优秀课程项目展示','学院级课程项目荣誉，2024 年 12 月获得，二手教材交易项目在课程展示中被评为优秀小组案例。',1),(9,3,'市场调研课程优秀报告','课程项目荣誉，2024 年 11 月获得，围绕大学生教材购买与二手交易行为完成问卷调研、数据整理和结论展示。',2),(10,4,'校级优秀学生干部','校级荣誉，2024 年 6 月获得，担任学院学生会学习发展部干事，参与学习活动组织、新生适应支持和学院学生服务工作。',0),(11,4,'学院优秀志愿服务个人','学院级荣誉，2023 年 12 月获得，参与迎新、校园开放日和公益支教活动，累计志愿服务时长超过 80 小时。',1),(12,4,'校园生活方式社群优秀策划','社团内部评选荣誉，2024 年 5 月获得，参与策划阅读打卡和城市探索活动，活动参与度和成员反馈较好。',2),(13,5,'国家励志奖学金','国家级奖学金，2024 年 10 月获得，基于学业成绩、综合表现和家庭经济情况评定。',0),(14,5,'校级优秀社会实践个人','校级荣誉，2024 年 9 月获得，参与社区老年人数字服务使用障碍研究，在访谈整理、调研简报和成果展示中表现突出。',1),(15,5,'学院优秀学生','学院级荣誉，2023 年 12 月获得，学业成绩稳定，参与学院调研项目、阅读支持计划和学生公益活动较多。',2),(16,7,'软件工程课程设计优秀项目','校级课程项目荣誉，2024 年 6 月获得，项目为校园失物招领系统，主要负责后端接口开发和数据库设计。',0),(17,8,'软件工程课程设计优秀项目','校级课程项目荣誉，2024 年 6 月获得，项目为校园失物招领系统，主要负责后端接口开发、数据库设计和前后端联调。',0),(18,8,'校级程序设计竞赛三等奖','校级三等奖，2024 年 5 月获得，主要使用 C++ 完成数组、字符串、排序和基础动态规划题目。',1);
/*!40000 ALTER TABLE `resume_awards` ENABLE KEYS */;
UNLOCK TABLES;
DROP TABLE IF EXISTS `resume_certificates`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resume_certificates` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `resume_id` bigint unsigned NOT NULL,
  `name` varchar(150) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `description` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `sort_order` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `idx_rc_resume` (`resume_id`,`sort_order`),
  CONSTRAINT `fk_rc_resume` FOREIGN KEY (`resume_id`) REFERENCES `resumes` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=20 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resume_certificates` WRITE;
/*!40000 ALTER TABLE `resume_certificates` DISABLE KEYS */;
INSERT INTO `resume_certificates` VALUES (1,1,'中国计算机学会 CSP 认证','2023 年 3 月获得，成绩排名前 20%，具备较好的算法基础和程序设计能力。',0),(2,1,'阿里云机器学习平台 PAI 基础课程认证','2024 年 5 月通过，了解机器学习平台基础能力、模型训练流程、数据处理和云上实验管理。',1),(3,2,'阿里云云计算基础认证 ACA','2025 年 4 月通过，了解云服务器、云数据库、对象存储、网络与安全等云计算基础概念。',0),(4,2,'全国计算机等级考试二级','2023 年 9 月通过，主要考查程序设计基础、数据库基础和常见办公软件应用能力。',1),(5,2,'软件设计师基础知识训练营结业证书','2024 年 12 月获得，系统学习软件工程、数据库、计算机网络、操作系统和面向对象设计等基础知识。',2),(6,3,'全国计算机等级考试二级','2024 年 3 月通过，掌握基础程序设计、数据库基础和常用办公软件应用能力。',0),(7,3,'Axure 产品原型设计课程证书','2024 年 8 月获得，学习产品原型设计、页面交互说明、组件复用和基础 PRD 表达方法。',1),(8,3,'数据分析基础训练营结业证书','2024 年 11 月获得，学习 Excel 数据透视表、基础 SQL 查询、用户分层和常见产品指标分析方法。',2),(9,4,'普通话水平测试二级甲等','2024 年 4 月获得，具备较好的普通话表达和沟通能力。',0),(10,4,'心理健康教育基础课程证书','2024 年 11 月获得，学习大学生常见心理困扰识别、基础沟通方法和心理支持边界等内容。',1),(11,4,'新媒体内容运营课程结业证书','2024 年 10 月获得，学习内容选题、社群互动、公众号排版、活动复盘和基础数据分析方法。',2),(12,5,'普通话水平测试二级甲等','2024 年 4 月获得，具备较好的普通话表达和访谈沟通能力。',0),(13,5,'社会调查方法训练营结业证书','2024 年 8 月获得，结业评价为优秀学员，系统学习问卷设计、访谈方法、抽样基础、资料整理和调研报告写作。',1),(14,5,'SPSS 社会统计基础课程证书','2024 年 11 月获得，学习描述统计、交叉分析、相关分析和基础数据可视化方法。',2),(15,6,'全国计算机等级考试二级','2024 年 3 月通过，掌握基础程序设计和常用办公软件应用能力。',0),(16,7,'全国计算机等级考试二级','2024 年 3 月通过，掌握基础程序设计和常用办公软件应用能力。',0),(17,7,'Java Web 后端开发训练营结业证书','2024 年 12 月获得，学习 Spring Boot、MyBatis、MySQL、Redis、接口开发和项目部署基础。',1),(18,8,'全国计算机等级考试二级','2024 年 3 月通过，掌握基础程序设计、数据库基础和常用办公软件应用能力。',0),(19,8,'Java Web 后端开发训练营结业证书','2024 年 12 月获得，学习 Spring Boot、MyBatis、MySQL、Redis、接口开发和项目部署基础。',1);
/*!40000 ALTER TABLE `resume_certificates` ENABLE KEYS */;
