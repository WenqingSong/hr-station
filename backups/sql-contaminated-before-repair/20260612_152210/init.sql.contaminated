, {\"weight\": 5, \"category\": \"technical_skill\", \"tag_code\": \"MySQL及SQL编程了解\", \"tag_label\": \"MySQL及SQL编程了解\", \"confidence\": 0.8, \"explanation\": \"岗位对MySQL及SQL编程有了解项要求\", \"evidence_text\": \"了解 MySQL 及 SQL 编程\", \"source_section\": \"了解项\", \"is_user_visible\": true}, {\"weight\": 5, \"category\": \"technical_skill\", \"tag_code\": \"NoSQL存储原理了解\", \"tag_label\": \"NoSQL存储原理了解\", \"confidence\": 0.8, \"explanation\": \"岗位对NoSQL、Key-Value存储原理有了解项要求\", \"evidence_text\": \"了解 NoSQL、Key-Value 存储原理\", \"source_section\": \"了解项\", \"is_user_visible\": true}, {\"weight\": 7, \"category\": \"preference_signal\", \"tag_code\": \"分布式系统开发知识\", \"tag_label\": \"分布式系统开发知识\", \"confidence\": 0.9, \"explanation\": \"了解分布式系统相关知识为岗位加分项\", \"evidence_text\": \"了解分布式系统设计与开发、负载均衡、系统容灾、高可用系统等知识\", \"source_section\": \"加分项\", \"is_user_visible\": true}, {\"weight\": 7, \"category\": \"preference_signal\", \"tag_code\": \"云原生技术了解\", \"tag_label\": \"云原生技术了解\", \"confidence\": 0.9, \"explanation\": \"对云原生相关技术有了解为岗位加分项\", \"evidence_text\": \"对云原生相关技术有所了解\", \"source_section\": \"加分项\", \"is_user_visible\": true}, {\"weight\": 8, \"category\": \"experience_signal\", \"tag_code\": \"产品功能实现优化经历\", \"tag_label\": \"产品功能实现优化经历\", \"confidence\": 0.9, \"explanation\": \"岗位工作内容包含产品功能实现与优化，偏好有相关经历的候选人\", \"evidence_text\": \"负责实现和优化公司的产品功能\", \"source_section\": \"岗位描述\", \"is_user_visible\": true}, {\"weight\": 8, \"category\": \"experience_signal\", \"tag_code\": \"服务与基础设施构建维护经历\", \"tag_label\": \"服务与基础设施构建维护经历\", \"confidence\": 0.9, \"explanation\": \"岗位工作内容包含关键服务与基础设施构建维护，偏好有相关经历的候选人\", \"evidence_text\": \"构建和维护关键服务与基础设施\", \"source_section\": \"岗位描述\", \"is_user_visible\": true}, {\"weight\": 6, \"category\": \"risk_signal\", \"tag_code\": \"计算机相关专业背景偏好\", \"tag_label\": \"计算机相关专业背景偏好\", \"confidence\": 0.7, \"explanation\": \"岗位要求大量专业软件知识，可能更偏好计算机相关专业的候选人\", \"evidence_text\": \"具备算法、操作系统、软件工程、设计模式、数据结构、数据库系统、网络安全等专业软件知识\", \"source_section\": \"必备要求\", \"is_user_visible\"