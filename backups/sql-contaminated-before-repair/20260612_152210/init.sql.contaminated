INSERT INTO `job_profiles` VALUES (1,10001,'软件开发','后台开发','[{\"tag\": \"golang\", \"group\": \"skill\", \"evidence\": \"JD明确要求Go语言\", \"confidence\": 2}, {\"tag\": \"python\", \"group\": \"skill\", \"evidence\": \"JD明确要求Python\", \"confidence\": 2}, {\"tag\": \"cpp\", \"group\": \"skill\", \"evidence\": \"JD明确要求C++\", \"confidence\": 3}, {\"tag\": \"mysql\", \"group\": \"skill\", \"evidence\": \"JD要求数据库能力\", \"confidence\": 3}]','[{\"tag\": \"golang\", \"group\": \"skill\", \"evidence\": \"JD明确要求Go语言\", \"confidence\": 2}, {\"tag\": \"python\", \"group\": \"skill\", \"evidence\": \"JD明确要求Python\", \"confidence\": 2}, {\"tag\": \"java\", \"group\": \"skill\", \"evidence\": \"JD明确要求Java\", \"confidence\": 1}, {\"tag\": \"cpp\", \"group\": \"skill\", \"evidence\": \"JD明确要求C++\", \"confidence\": 3}, {\"tag\": \"mysql\", \"group\": \"skill\", \"evidence\": \"JD要求数据库能力\", \"confidence\": 3}, {\"tag\": \"redis\", \"group\": \"skill\", \"evidence\": \"JD要求缓存能力\", \"confidence\": 1}, {\"tag\": \"linux\", \"group\": \"skill\", \"evidence\": \"JD要求Linux\", \"confidence\": 1}, {\"tag\": \"docker_k8s\", \"group\": \"skill\", \"evidence\": \"JD要求容器化能力\", \"confidence\": 1}]','[{\"tag\": \"degree_bachelor\", \"group\": \"requirement\", \"evidence\": \"要求本科学历\", \"confidence\": 1}, {\"tag\": \"degree_master\", \"group\": \"requirement\", \"evidence\": \"要求硕士学历\", \"confidence\": 1}, {\"tag\": \"internship_exp\", \"group\": \"requirement\", \"evidence\": \"要求实习经验\", \"confidence\": 1}, {\"tag\": \"project_exp\", \"group\": \"requirement\", \"evidence\": \"要求项目经验\", \"confidence\": 1}, {\"tag\": \"paper\", \"group\": \"requirement\", \"evidence\": \"要求论文\", \"confidence\": 1}]',NULL,'[{\"tag\": \"algorithm\", \"group\": \"risk\", \"evidence\": \"JD中包含算法相关要求\", \"confidence\": 1}, {\"tag\": \"backend\", \"group\": \"risk\", \"evidence\": \"JD中包含后端开发相关要求\", \"confidence\": 1}, {\"tag\": \"frontend\", \"group\": \"risk\", \"evidence\": \"JD中包含前端相关要求\", \"confidence\": 1}, {\"tag\": \"data\", \"group\": \"risk\", \"evidence\": \"JD中包含数据相关要求\", \"confidence\": 1}]','{\"keyword_evidence\": [{\"id\": \"kw_0\", \"text\": \"C/C++\", \"type\": \"jd_kw\", \"source\": \"skill_keywords\", \"strength\": 0.6}, {\"id\": \"kw_1\", \"text\": \"Java\", \"type\": \"jd_kw\", \"source\": \"skill_keywords\", \"strength\": 0.6}, {\"id\": \"kw_2\", \"text\": \"Go\", \"type\": \"jd_kw\", \"source\": \"skill_keywords\", \"strength\": 0.6}, {\"id\": \"kw_3\", \"text\": \"TCP/UDP\", \"type\": \"jd_kw\", \"source\": \"skill_keywords\", \"strength\": 0.6}, {\"id\": \"kw_4\", \"text\": \"MySQL\", \"type\": \"jd_kw\", \"source\": \"skill_keywords\", \"strength\": 0.6}, {\"id\": \"kw_5\", \"text\": \"NoSQL\", \"type\": \"jd_kw\", \"source\": \"skill_keywords\", \"strength\": 0.6}, {\"id\": \"kw_6\", \"text\": \"分布式系统\", \"type\": \"jd_kw\", \"source\": \"skill_keywords\", \"strength\": 0.6}, {\"id\": \"kw_7\", \"text\": \"云原生\", \"type\": \"jd_kw\", \"source\": \"skill_keywords\", \"strength\": 0.6}, {\"id\": \"kw_8\", \"text\": \"高可用\", \"type\": \"jd_kw\", \"source\": \"skill_keywords\", \"strength\": 0.6}], \"requirement_evidence\": [{\"id\": \"req_0\", \"text\": \"【必备要求】\", \"type\": \"jd_req\", \"source\": \"requirements\", \"strength\": 0.9}, {\"id\": \"req_1\", \"text\": \"扎实的编程能力\", \"type\": \"jd_req\", \"source\": \"requirements\", \"strength\": 0.9}, {\"id\": \"req_2\", \"text\": \"熟练掌握 C/C++/Java/Go 等其中一门开发语言\", \"type\": \"jd_req\", \"source\": \"requirements\", \"strength\": 0.9}, {\"id\": \"req_3\", \"text\": \"熟悉 TCP/UDP 网络协议及相关编程、进程间通讯编程\", \"type\": \"jd_req\", \"source\": \"requirements\", \"strength\": 0.9}, {\"id\": \"req_4\", \"text\": \"具备算法、操作系统、软件工程、设计模式、数据结构、数据库系统、网络安全等专业软件知识\", \"type\": \"jd_req\", \"source\": \"requirements\", \"strength\": 0.9}], \"responsibility_evidence\": [{\"id\": \"resp_0\", \"text\": \"负责实现和优化公司的产品功能，以及构建和维护关键服务与基础设施\", \"type\": \"jd_resp\", \"source\": \"description\", \"strength\": 0.7}]}','rule','tag_agent_v1','2026-06-12 