/*!40000 ALTER TABLE `resume_profiles` ENABLE KEYS */;
UNLOCK TABLES;
DROP TABLE IF EXISTS `resume_projects`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resume_projects` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `resume_id` bigint unsigned NOT NULL,
  `name` varchar(150) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `role` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `start_date` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `end_date` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `description` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `sort_order` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `idx_rp_resume` (`resume_id`,`sort_order`),
  CONSTRAINT `fk_rp_resume` FOREIGN KEY (`resume_id`) REFERENCES `resumes` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=26 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resume_projects` WRITE;
/*!40000 ALTER TABLE `resume_projects` DISABLE KEYS */;
INSERT INTO `resume_projects` VALUES (1,1,'多目标推荐排序模型实验平台','核心开发者','2024-03','2024-11','面向实验室推荐系统研究场景，搭建用于多目标排序模型实验、指标对比和实验记录管理的平台，支持召回结果导入、样本构建、特征拼接、模型训练、离线评估、实验记录管理和实验复现。项目使用 Python、PyTorch、Faiss、Redis、MySQL、Docker、Linux 实现，我主要负责样本构建、特征处理、模型训练脚本、离线评估模块和实验配置管理。项目中围绕点击率、停留时长、转化倾向等多目标排序任务，设计统一的数据输入格式和实验配置格式，减少不同排序模型之间重复修改训练代码的问题。模型训练部分基于 PyTorch 实现排序模型训练流程，支持不同特征组合、损失函数和负采样策略切换；检索实验部分使用 Faiss 完成向量召回结果导入和初步对比；离线评估部分实现 NDCG、Recall、AUC、HitRate 等指标计算，并将实验配置、指标结果、结论和问题记录统一落库。为了降低组内同学复现实验成本，我使用 Docker 统一实验环境，并整理实验启动脚本、参数说明和常见问题记录。最终将单次实验配置准备时间从约 40 分钟降低到 10 分钟以内，支持 5 类排序模型在同一数据集上的离线指标对比，累计完成 20 余组消融实验记录，为后续论文实验部分提供数据支持。',0),(2,1,'基于用户行为序列的点击率预估模型复现','算法实现与实验分析','2023-10','2024-01','基于公开电商行为数据集，复现用户兴趣建模相关方法，对比传统 LR、Wide&Deep 模型与序列兴趣建模方法在点击率预估任务中的表现差异。项目使用 Python、PyTorch、Pandas、NumPy、Scikit-learn 实现，我负责数据清洗、样本构造、模型实现、训练调参和实验分析。数据处理阶段，我完成用户行为日志清洗、用户行为序列截断、样本去重、负样本构造和训练验证集划分，并统计不同用户活跃度、物品曝光频率和序列长度分布。模型实现阶段，我基于 PyTorch 实现 Embedding、Attention Pooling 和序列兴趣建模模块，并搭建 LR、Wide&Deep 等基础对比模型。实验过程中重点分析不同序列长度、负采样比例、Embedding 维度和学习率对模型效果的影响，同时记录训练日志、指标变化和误差样例。最终在验证集上相比基础 LR 模型 AUC 提升约 6.8%，整理 12 页实验报告，说明模型结构、指标变化、参数影响和误差样例，并沉淀出一套可复用的 CTR 任务训练模板。通过误差样例分析发现，短序列用户、低频物品样本和行为噪声较高的用户更容易出现预测偏差。',1),(3,1,'论文阅读与实验复现管理工具','个人开发者','2024-12','2025-02','为了解决论文阅读、实验配置和复现实验记录分散的问题，开发一个轻量级工具，用于管理论文笔记、实验配置、指标结果和复盘结论。项目使用 Python、FastAPI、SQLite、Vue、Markdown 实现，我独立完成数据结构设计、后端接口、前端基础页面和 Markdown 导出能力。项目中设计了论文、实验、指标、结论四类核心数据结构，支持记录论文标题、方向、模型类型、数据集、关键方法、复现状态、实验参数、指标结果和复盘结论。功能上实现论文笔记增删改查、实验记录管理、按论文方向和模型类型筛选、指标结果对比、Markdown 导出和复现实验清单维护。为了提升复盘效率，我将常见实验问题整理为复盘清单，例如数据划分是否一致、负采样策略是否可复现、指标口径是否统一、随机种子是否固定、训练日志是否完整等。项目累计整理 30 余篇推荐系统和表示学习相关论文笔记，管理 40 余条实验配置和指标结果，帮助自己将论文阅读和实验复盘从零散记录转为结构化沉淀。',2),(4,1,'推荐系统论文实验误差样例分析','实验分析与案例整理','2025-03','2025-05','围绕推荐排序模型实验中“整体指标提升但部分用户预测效果不稳定”的问题，开展误差样例分析和样本分层研究，尝试从用户活跃度、行为序列长度、物品热度和负反馈比例等角度解释模型表现差异。项目使用 Python、Pandas、NumPy、Matplotlib 和 SQL 完成实验数据整理与分析。我将用户样本按行为序列长度、最近活跃时间、点击频率和物品交互稀疏程度进行分层，统计不同分层下 AUC、Recall 和 NDCG 的变化，并抽取预测偏差较大的样本进行人工检查。分析发现，模型在高活跃用户和热门物品上的表现更稳定，但在短序列用户、冷门物品和负反馈样本较多的用户群体上存在明显波动。基于分析结果，我整理了样本构造、负采样策略和特征补充方向的改进建议，并形成 10 页实验分析报告。该项目强化了我对推荐系统实验中“不能只看整体指标，还要理解样本结构和业务分布”的认识。',3),(5,2,'校园二手交易平台后端系统','后端负责人','2024-03','2024-07','面向校内学生闲置物品交易场景，开发校园二手交易平台后端系统，支持用户注册登录、商品发布、商品搜索、收藏、留言、订单状态流转和后台基础管理。项目采用 Go、Gin、MySQL、Redis、JWT、Docker、Nginx 实现，我主要负责后端整体设计、数据库建模、核心接口开发和前后端联调。项目中设计了用户表、商品表、商品图片表、收藏表、留言表、订单表和操作日志表等核心数据结构，完成用户登录鉴权、商品分页查询、关键词搜索、商品发布与编辑、收藏取消、留言回复、订单状态变更等 30 余个接口。为了提升商品列表和热门商品详情的访问效率，我使用 Redis 缓存热门商品列表和商品详情，并设置合理过期时间和缓存 key 规则，使重复访问场景下商品详情接口平均响应时间由约 180ms 降低到 60ms 左右。项目过程中补充了参数校验、登录态校验和资源归属校验，修复未登录用户发布商品、普通用户修改他人商品状态、订单状态重复变更等问题。最终项目完成前后端联调，并在课程展示中作为小组 Demo 演示，累计模拟录入 150 余条商品数据和 40 余条交易记录。',0),(6,2,'在线题库与练习系统','后端开发','2024-08','2024-11','面向学生刷题练习场景，开发在线题库与练习系统，支持题目管理、分类筛选、答题记录、错题本、练习统计和接口文档展示。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis、Swagger 实现，我负责题库模块、答题记录模块和错题本模块的后端开发。项目中设计了题目表、题目分类表、用户答题记录表、错题本表和练习统计表，完成题目分页查询、分类筛选、关键词搜索、提交答案、错题记录、错题移除、练习统计查询等接口。为了避免题目列表一次性加载导致响应变慢，我将原全量查询改为分页查询，并针对分类、难度、创建时间等字段增加组合索引，提升常见筛选场景的查询效率。对于用户近期练习统计，我使用 Redis 记录近 7 天练习次数和正确率摘要，减少频繁聚合查询对数据库的压力。项目中通过 Swagger 维护接口文档，补充请求参数、响应字段和异常码说明，降低前后端联调时字段理解不一致的问题。最终完成题库、练习记录、错题本 3 个核心模块，沉淀出一套较完整的 Controller、Service、Mapper 分层开发流程和接口测试用例。',1),(7,2,'简易消息通知服务','后端开发','2025-01','2025-02','为了理解消息队列在后端系统中的异步解耦和最终一致性作用，开发一个简易消息通知服务，模拟订单状态变更后异步发送站内通知的流程。项目使用 Go、RabbitMQ、MySQL、Redis 实现，包含订单事件生产、消息投递、通知消费、失败重试、未读数统计和幂等处理等功能。我设计了通知表、消息投递记录表和消费状态字段，使用 RabbitMQ 将订单状态变更事件发送到通知队列，由消费者异步写入用户站内通知。为了避免消费失败或重复投递导致重复通知，我使用业务唯一键作为幂等标识，并在消费前检查消息处理状态；对于消费失败的消息，记录失败原因和重试次数，超过阈值后进入异常记录表，便于后续人工排查。项目中使用 Redis 维护用户未读通知数，在通知写入成功后同步更新计数，并提供未读数查询和已读更新接口。通过该项目，我理解了消息队列在削峰、解耦、异步通知和最终一致性场景下的基本使用方式，也加深了对幂等处理、失败重试和消息状态流转的理解。',2),(8,2,'个人博客与技术笔记系统','个人开发者','2024-10','2024-01','为了整理课程笔记和技术学习内容，开发个人博客与技术笔记系统，支持文章发布、分类管理、标签筛选、评论管理、后台登录和 Markdown 内容展示。项目使用 Java、Spring Boot、MySQL、Redis、Vue 实现，我独立完成后端接口、数据库设计和基础后台页面联调。后端部分设计了文章、分类、标签、评论、用户和操作日志等数据表，实现文章增删改查、分类标签管理、评论审核、登录鉴权和文章浏览统计等能力。为了减少热门文章重复查询，我使用 Redis 缓存文章详情和首页文章列表，并在文章更新后主动清理相关缓存。项目中补充了 Markdown 内容存储、XSS 基础过滤、后台接口登录校验和评论状态控制，避免未审核评论直接展示。该项目虽然规模不大，但帮助我完整练习了从数据库建模、接口设计、权限控制、缓存使用到前后端联调的基础后端开发流程。',3),(9,3,'校园活动报名与签到小程序','产品负责人','2024-03','2024-06','面向校内社团、学院讲座和校园活动组织场景，设计一款活动报名与签到小程序原型，解决原本依赖微信群接龙、Excel 表格和人工签到导致的信息混乱、统计耗时、报名状态不清晰等问题。项目覆盖用户访谈、需求分析、流程设计、原型设计、PRD 编写和试用反馈收集。我主要负责前期调研和产品方案设计，访谈 8 名社团负责人和 20 余名学生参与者，梳理出活动发布、报名填写、名单管理、二维码签到、活动提醒和反馈收集等核心流程。基于调研结果，我使用 XMind 绘制功能结构图，使用墨刀和 Axure 设计活动列表、活动详情、报名表单、报名成功页、签到入口、组织者名单管理和反馈统计等页面，并编写 18 页产品需求文档，补充字段说明、页面状态、异常提示、数据统计口径和验收标准。项目试用阶段组织 2 轮同学体验，根据反馈调整报名成功提示、签到入口位置和报名表单字段顺序。最终原型支持一次学院讲座活动的流程模拟，活动负责人整理报名名单的时间从约 30 分钟降低到 10 分钟以内，并通过反馈问卷收集 63 份学生意见，定位出“报名后不知道是否成功”“签到入口不明显”“活动提醒不足”等 5 类问题。',0),(10,3,'二手教材交易需求调研与产品原型设计','产品设计与调研负责人','2024-09','2024-12','围绕大学生二手教材交易场景，完成从需求调研、竞品分析、用户分层到产品原型设计的完整产品分析流程，重点解决教材版本不一致、交易沟通成本高、教材信息不完整和交易状态不透明等问题。项目初期通过问卷星设计并回收 146 份问卷，分析学生购买和出售二手教材时的主要顾虑、交易渠道和价格接受区间；同时体验闲鱼、孔夫子旧书网、校内微信群等渠道，整理不同平台在商品信息展示、交易沟通、搜索筛选和信任机制上的差异。根据调研结果，我将用户划分为卖书学生、买书学生、班级教材负责人三类角色，梳理教材发布、教材搜索、版本核对、在线留言、交易确认和状态流转等核心链路。原型设计阶段，我使用 Figma 设计 16 个核心页面，重点增加 ISBN、课程名、任课老师、教材版本、适用专业和新旧程度等字段，降低买错教材的概率。项目最终输出竞品分析表、用户旅程图、功能优先级表、25 页产品需求说明文档和高保真原型。调研数据显示，72% 的学生最担心“教材版本不一致”，因此该项目将“版本核对”设为 MVP 优先级最高的功能之一，课程评分 91 分，并获得任课老师关于调研完整性和问题定义清晰度的正向评价。',1),(11,3,'学习打卡社区产品改版分析','产品分析与数据整理','2025-01','2024-02','选择 3 款学习打卡类产品进行体验分析，围绕新用户引导、目标创建、每日打卡、内容沉淀、社群互动和激励机制进行拆解，并提出改版建议。项目中我从新用户视角完整体验注册登录、目标创建、打卡提醒、每日复盘、好友互动和连续打卡反馈等流程，记录关键页面、转化节点和中断点，并用 Excel 整理功能矩阵、体验问题和改版优先级。分析过程中，我将问题分为新用户初次使用阻力、打卡持续动力不足、复盘内容沉淀弱、社交激励弱和提醒机制不清晰五类，共梳理 18 个体验问题，其中 6 个问题集中在新用户首次创建目标和首次打卡环节。基于问题优先级，我设计了“目标创建简化”“打卡后复盘提示”“连续打卡反馈”三个低保真改版原型，并输出 11 页产品体验分析报告。该项目帮助我理解产品分析不能只停留在页面好不好看，而要结合用户路径、操作成本、动机反馈和留存场景判断功能价值。',2),(12,3,'AI 求职助手产品需求拆解练习','产品需求分析','2025-04','2025-05','围绕学生求职中“不会判断岗位是否适合自己、不会根据 JD 修改简历、投递后缺少复盘”的问题，完成一套 AI 求职助手产品需求拆解练习。项目以产品方案设计为主，模拟实现简历录入、岗位 JD 粘贴、岗位匹配分析、简历优化建议和版本记录等功能。我通过访谈 10 名正在找实习的同学，整理出简历经历表达弱、岗位关键词看不懂、无法判断能力差距、修改简历没有方向等常见问题，并将需求拆分为“简历结构化录入、岗位信息管理、匹配结果展示、优化建议、历史记录”五个模块。原型设计中，我重点设计了匹配结果页的信息结构，将结果拆成匹配分数、优势项、风险项、缺失能力、优化建议和证据引用，避免只展示一个空泛分数。我使用飞书文档编写需求说明，并通过 AI 工具辅助整理字段清单和异常状态，再人工核对访谈记录和实际岗位 JD，保证功能描述贴近真实求职场景。最终沉淀 1 份产品功能清单、1 份页面流程图和 8 个核心页面原型。',3),(13,4,'大学生自习与学习陪伴小程序调研项目','调研与产品原型负责人','2024-03','2024-06','围绕大学生自习效率低、学习计划难坚持、缺少陪伴感和阶段反馈不足等问题，完成一款学习陪伴小程序的用户调研、需求分析和原型设计。项目重点探索“轻量打卡 + 学习搭子 + 阶段复盘”的学习支持方式，目标不是强制监督学生，而是帮助学生降低开始学习的门槛，并在学习过程中获得持续反馈。我主要负责问卷设计、学生访谈、需求整理、功能优先级拆分和核心页面原型设计。前期通过问卷星回收 178 份问卷，分析学生自习频率、学习计划中断原因、拖延场景和对学习陪伴功能的接受程度；同时访谈 12 名不同年级学生，整理出“任务太大不知道从哪里开始”“缺少即时反馈”“一个人坚持困难”“复盘记录分散”等典型问题。基于调研结果，我将功能拆分为学习目标创建、今日任务、学习搭子匹配、每日打卡、阶段复盘和轻量提醒六个模块，并使用 XMind 绘制功能结构图，使用墨刀和 Figma 设计 14 个核心页面原型。项目试用阶段组织 2 次小范围体验，根据反馈调整打卡入口、复盘提示文案和任务拆分方式。最终输出 20 页调研分析文档和一套可点击原型，调研数据显示超过 60% 的受访学生会制定学习计划，但连续执行超过 7 天的比例较低，因此项目将复杂学习计划拆为“今日任务 + 本周目标 + 阶段复盘”三层结构，提升功能可理解性和执行可行性。',0),(14,4,'校园生活方式社群运营计划','社群运营负责人','2023-10','2024-05','参与运营一个面向学生的校园生活方式社群，内容覆盖阅读、运动、摄影、城市探索和学习复盘，目标是帮助同学形成更稳定的生活节奏和兴趣交流氛围。项目不是单纯做活动通知，而是通过主题活动、轻量打卡、同伴交流和阶段复盘，让社群成员在低压力环境中形成持续参与感。我主要负责月度活动策划、活动文案、报名表设计、社群规则维护、活动反馈收集和复盘整理。运营过程中策划并执行“21 天阅读记录”“周末城市散步”“运动打卡”“期末复盘夜谈”等活动，使用微信公众号、飞书、Excel、Canva 和剪映完成活动通知、视觉物料、报名统计和复盘内容整理。数据方面，我持续记录报名人数、实际参与人数、打卡完成率、互动次数和反馈关键词，用于判断活动主题是否适合长期运营。项目期间累计组织 9 场线上 / 线下活动，覆盖 300 余名学生，其中“21 天阅读记录”活动报名 86 人，完整完成打卡 37 人。通过活动复盘发现，学生更容易接受明确阶段目标、低压力提醒和正向反馈，而不是强制打卡式管理。公众号活动总结平均阅读量约 600，最高单篇阅读量超过 1200，也帮助我理解内容选题、社群节奏和用户参与感之间的关系。',1),(15,4,'校园新生适应问题访谈与内容手册设计','访谈整理与内容策划','2024-09','2024-11','协助学院老师和学生会完成新生适应问题调研，围绕课程学习、宿舍关系、社团选择、时间管理、信息获取和情绪压力等主题，整理一份面向新生的适应手册。项目目标是将零散的新生困惑转化为结构化内容，帮助新生更快理解大学生活中的常见问题和可求助路径。我主要负责访谈记录整理、问题归类、内容框架设计和部分章节撰写。项目中协助设计新生适应问卷和访谈提纲，整理 20 份访谈记录，将问题归纳为学习适应、生活适应、人际适应、信息获取和自我管理五类，并从中提炼出 32 个高频问题。内容策划阶段，我参与设计手册章节结构，撰写“如何安排第一学期”“如何选择社团”“如何处理宿舍关系”“如何寻求老师和学长学姐帮助”等内容，并协助完成线上版本排版和发布。最终形成约 1.5 万字的新生适应手册初稿，发布后被学院新生群置顶使用。这个项目提升了我对学生真实需求的理解，也让我练习了从访谈资料中提炼问题、组织内容和面向目标用户表达信息的能力。',2),(16,4,'在线课程学习体验优化分析','学习体验分析与反馈整理','2025-01','2025-02','围绕在线课程学习过程中“课程开始难、坚持难、反馈少、作业压力不清晰”等问题，选择 2 个主流在线学习平台和 1 个学校课程平台进行体验分析，重点拆解课程详情页、学习路径、任务提醒、作业提交、学习进度和反馈机制。我从学生用户视角完整体验选课、开始学习、观看课程、提交作业、查看反馈和复盘学习记录等流程，并记录关键页面、操作阻力和信息缺失点。分析过程中，我将体验问题分为学习目标不明确、课程结构不清晰、任务提醒不够友好、学习进度反馈弱和作业反馈延迟五类，并用 Excel 整理功能矩阵和问题优先级。基于体验结果，我提出了课程学习路径可视化、阶段目标提示、作业截止提醒、学习进度反馈和学习复盘卡片等优化建议，并使用 Figma 绘制 6 个低保真优化页面。最终输出 12 页体验分析报告，帮助我进一步理解教育科技产品中“学习效果”和“用户体验”需要同时考虑，不能只关注页面功能是否完整。',3),(17,5,'县域高中学生升学选择与家庭支持调研','调研执行与报告撰写','2024-04','2024-11','围绕县域高中学生在升学选择、家庭支持、信息获取和心理压力方面的问题，参与完成问卷调研、深度访谈、资料编码和阶段性报告撰写，为后续教育支持项目设计提供参考。项目重点关注学生在升学信息获取、家庭经验支持、学校资源差异和自我目标形成过程中的真实困境。我参与问卷设计和访谈提纲设计，围绕家庭教育资源、学校咨询支持、线上信息来源、同伴影响和情绪压力等变量设计问题，并协助整理 312 份有效问卷，完成基础描述统计和交叉分析。在访谈部分，我参与 26 名学生、家长和教师的半结构化访谈，使用 NVivo 对访谈文本进行初步编码，将学生困境归纳为信息渠道不足、家庭经验有限、同伴信息偏差、线上信息过载、心理压力缺少出口等类型。报告撰写阶段，我主要负责“学生信息获取路径”和“家庭支持差异”两个章节，整理 18 个典型案例，并将访谈材料与问卷结果进行交叉验证。最终团队输出约 2.4 万字阶段性调研报告，归纳出 5 类升学信息差来源，为公益组织后续设计高中生成长支持活动、线上讲座和个案陪伴机制提供参考。',0),(18,5,'社区老年人数字服务使用障碍研究','项目协调与访谈整理','2023-10','2024-02','围绕社区老年人在使用线上挂号、缴费、出行、政务服务等数字化工具时遇到的障碍，开展访谈、观察记录和问题归纳，并形成面向社区服务站的建议材料。项目不是简单判断老年人“不会用手机”，而是尝试理解数字服务流程、信息提示、线下兜底和即时帮助机制对老年用户的影响。我协助联系社区工作人员，安排访谈时间和调研流程，参与 18 名老年居民和 5 名社区工作人员访谈，记录他们在健康码、线上挂号、公交乘车码、政务小程序、线上缴费等场景中的具体困难。整理过程中，我将问题归类为操作步骤复杂、信息提示不清、记忆负担较重、担心误操作、对子女协助依赖和线下兜底不足六类，并参与制作社区数字服务协助卡片和简易操作说明。最终团队输出 12 页调研简报，提交给社区服务站作为数字服务志愿活动参考，并协助设计 4 张常用服务操作说明卡片。该项目让我意识到，公共服务体验问题往往不只是技术能力不足，也包括信息设计、支持体系、心理安全感和服务兜底机制。',1),(19,5,'高校学生阅读支持计划','内容策划与活动组织','2024-03','2024-06','参与组织一个面向本科生的阅读支持计划，通过主题书单、共读小组、读书会和阶段复盘，帮助同学建立更稳定的阅读习惯，并促进社会科学主题的交流讨论。项目主要面向想读书但难以持续、缺少讨论氛围和不知道如何选择书目的学生。我参与设计 4 期主题书单，包括社会科学入门、城市与生活、教育与成长、女性与社会，负责报名表、活动说明、共读规则和复盘问题设计，并维护共读小组的日常交流。活动过程中，我整理成员阅读反馈、讨论问题和中断原因，撰写读书会总结推文和阶段复盘材料，并通过问卷收集参与者对活动节奏、书目难度、讨论形式和组织方式的反馈。4 期活动累计报名 126 人，稳定参与 48 人，公众号活动总结平均阅读量约 800，最高单篇超过 1500。通过反馈发现，相比强制打卡，开放讨论、阶段性目标和有质量的复盘问题更能提高参与者的持续性。项目最终沉淀出一套活动流程模板，便于后续学生社团继续组织类似阅读支持活动。',2),(20,5,'高校学生公共事务参与意愿访谈','访谈设计与分析整理','2025-01','2025-03','围绕高校学生参与志愿服务、学生组织、校园议题讨论和公共事务活动的动机与阻力，完成一项小规模访谈研究。项目希望理解学生为什么愿意或不愿意参与公共事务，以及时间成本、组织氛围、反馈机制和个人价值感如何影响参与持续性。我设计访谈提纲，围绕参与动机、退出原因、组织体验、获得感、压力来源和对活动改进的期待展开访谈，共整理 16 份访谈记录。分析过程中，我将学生参与阻力归纳为时间安排冲突、活动目标模糊、组织反馈不足、任务分工不清和长期价值感较弱五类，也发现部分学生对“能直接帮助具体人”“能沉淀清晰成果”“能和稳定团队长期合作”的活动更有持续参与意愿。最终输出 9 页访谈分析报告和 1 份校园公共事务活动优化建议清单，提出明确活动目标、降低初次参与门槛、建立阶段反馈和减少无效会议等建议。这个项目进一步确认了我对组织运行、公共参与和长期服务议题的兴趣。',3),(21,7,'校园失物招领系统','后端开发','2024-03','2024-06','面向校内学生失物招领场景，开发一个校园失物招领系统，支持用户注册登录、失物信息发布、失物列表查询、关键词搜索、留言评论和状态修改等功能。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis、JWT 和 Swagger 实现，我主要负责后端接口开发、数据库表设计和前后端联调。\n\n项目中设计了用户表、失物信息表、留言表和操作记录表，完成用户注册登录、失物信息发布、失物分页查询、关键词搜索、留言提交、状态修改等接口。登录部分使用 JWT 保存用户登录状态，并对发布失物、留言和修改状态等接口增加登录校验。为了方便前端同学联调，我使用 Swagger 补充接口路径、请求参数和返回字段说明。项目后期根据测试反馈修复了空参数提交、分页页码异常、未登录用户发布信息、普通用户修改他人失物状态等问题。\n\n该项目最终完成基础前后端联调，模拟录入 100 余条失物信息和 30 余条留言记录。通过这个项目，我第一次比较完整地练习了从需求拆分、数据库建表、接口开发、接口文档到联调修复的后端开发流程，也开始理解登录鉴权、参数校验和资源归属校验的重要性。',0),(22,7,'个人博客与学习笔记系统','个人开发者','2024-08','2024-10','为了整理自己的技术学习笔记，开发一个个人博客与学习笔记系统，支持文章发布、文章分类、标签筛选、评论管理和后台登录等功能。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis 和 Vue 实现，我独立完成后端接口、数据库设计和基础页面联调。\n\n项目中设计了文章表、分类表、标签表、评论表和用户表，实现文章增删改查、文章分页查询、分类筛选、标签筛选、评论提交、评论审核和后台登录等接口。为了减少首页文章列表和文章详情的重复查询，我尝试使用 Redis 缓存热门文章详情和首页文章列表，并在文章更新后手动清理对应缓存。评论模块增加了审核状态，避免评论提交后直接展示。后台接口增加登录校验，防止未登录用户访问管理接口。\n\n该项目虽然规模不大，但帮助我进一步熟悉了 Spring Boot、MyBatis、MySQL 和 Redis 的基础使用，也让我对数据库表关系、分页查询、缓存更新、后台权限校验和接口测试有了更具体的理解。项目完成后，我整理了接口文档和本地启动说明，方便后续继续迭代。',1),(23,8,'校园失物招领系统','后端开发','2024-03','2024-06','面向校内学生失物招领场景，开发校园失物招领系统，支持用户注册登录、失物信息发布、失物列表查询、关键词搜索、留言评论、认领申请和状态修改等功能。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis、JWT 和 Swagger 实现，我主要负责后端接口开发、数据库表设计、登录鉴权和前后端联调。\n\n项目中设计了用户表、失物信息表、留言表、认领申请表和操作记录表，完成用户注册登录、失物信息发布、分页查询、关键词搜索、留言提交、认领申请提交、状态修改等接口。登录部分使用 JWT 保存用户登录状态，并对发布失物、提交留言、提交认领申请和修改状态等接口增加登录校验。为了避免普通用户修改他人发布的信息，我在修改和删除接口中补充资源归属校验，先根据失物信息 ID 查询发布人，再判断当前登录用户是否有操作权限。为了方便前端联调，我使用 Swagger 维护接口路径、请求参数、返回字段和异常状态说明。\n\n项目后期根据测试反馈修复了空参数提交、分页页码异常、未登录用户发布信息、普通用户修改他人失物状态、重复提交认领申请等问题。最终项目完成基础前后端联调，模拟录入 100 余条失物信息、30 余条留言记录和 20 余条认领申请记录。通过这个项目，我比较完整地练习了需求拆分、数据库建表、接口开发、登录鉴权、资源归属校验、接口文档和联调修复流程。',0),(24,8,'个人博客与学习笔记系统','个人开发者','2024-08','2024-10','为了整理自己的技术学习笔记，开发个人博客与学习笔记系统，支持文章发布、文章分类、标签筛选、评论管理、后台登录、Markdown 内容展示和文章浏览统计。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis 和 Vue 实现，我独立完成后端接口、数据库设计和基础页面联调。\n\n项目中设计了文章表、分类表、标签表、评论表、用户表和文章浏览记录表，实现文章增删改查、文章分页查询、分类筛选、标签筛选、评论提交、评论审核、后台登录和文章浏览量统计等接口。为了减少首页文章列表和文章详情的重复查询，我使用 Redis 缓存热门文章详情和首页文章列表，并在文章更新、删除和评论状态变更后清理相关缓存。评论模块增加审核状态，避免评论提交后直接展示；后台接口增加登录校验，防止未登录用户访问管理接口。\n\n项目完成后，我整理了接口文档、本地启动说明和常见问题记录。通过该项目，我进一步熟悉了 Spring Boot、MyBatis、MySQL 和 Redis 的基础使用，也对数据库表关系、分页查询、缓存更新、后台权限校验和接口测试有了更具体的理解。',1),(25,8,'接口重复提交与幂等处理练习','个人开发者','2025-02','2025-02','为了理解后端接口在重复点击、网络重试和并发请求场景下可能出现的数据重复问题，完成一个接口重复提交与幂等处理练习项目，模拟认领申请提交、评论提交和订单提交等业务场景。项目使用 Java、Spring Boot、Redis 和 MySQL 实现。\n\n项目中设计了请求 token 生成、Redis 校验、业务处理和 token 失效流程，使用 Redis 的 SETNX 思路对短时间内重复提交进行拦截。针对认领申请提交场景，我额外增加业务唯一键校验，避免同一用户对同一失物重复提交认领申请。测试过程中，我分别验证了正常提交、连续点击提交、刷新重试、请求参数缺失和业务处理异常等场景，并记录接口返回结果。该练习让我理解幂等处理不是简单禁用按钮，而是需要结合前端交互、请求唯一标识、业务唯一键、事务处理和异常返回共同设计。',2);
