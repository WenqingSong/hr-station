UNLOCK TABLES;
DROP TABLE IF EXISTS `jobs`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `jobs` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `title` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL,
  `department` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `city` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `direction` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `category` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `job_type` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `application_type` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '申请类型：应届实习/校园招聘等',
  `application_project` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '申请项目：实习生/应届生等',
  `application_subtype` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '申请子类型',
  `slogan` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '岗位宣传语',
  `summary` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT '岗位概要',
  `description` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `requirements` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `responsibilities_json` json DEFAULT NULL COMMENT '职责列表 JSON',
  `must_have_json` json DEFAULT NULL COMMENT '必备要求 JSON',
  `nice_to_have_json` json DEFAULT NULL COMMENT '了解项 JSON',
  `bonus_points_json` json DEFAULT NULL COMMENT '加分项 JSON',
  `notes_json` json DEFAULT NULL COMMENT '备注 JSON',
  `skill_keywords_json` json DEFAULT NULL COMMENT '技能关键词 JSON（旧兼容）',
  `skills_json` json DEFAULT NULL COMMENT '技能列表 JSON',
  `organizations_json` json DEFAULT NULL COMMENT '事业群/部门 JSON [{code,name}]',
  `locations_json` json DEFAULT NULL COMMENT '工作城市 JSON',
  `interview_locations_json` json DEFAULT NULL COMMENT '面试城市 JSON',
  `facets_json` json DEFAULT NULL COMMENT '筛选聚合原始 JSON',
  `status` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'active',
  `external_source` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'local_mock' COMMENT '数据来源：local_mock / manual_curated / tencent_join',
  `external_id` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '外部岗位ID',
  `external_inner_id` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '外部系统内部ID',
  `source_url` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '来源页面URL',
  `source_name` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '数据来源名称',
  `raw_json` json DEFAULT NULL COMMENT '完整原始岗位JSON',
  `data_quality` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'manual_enriched' COMMENT '数据质量',
  `collected_at` datetime DEFAULT NULL COMMENT '数据采集时间',
  `is_featured` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否Demo精选岗位',
  `synced_at` timestamp NULL DEFAULT NULL COMMENT '外部岗位同步时间',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_jobs_external_source_id` (`external_source`,`external_id`),
  KEY `idx_jobs_city` (`city`),
  KEY `idx_jobs_direction` (`direction`),
  KEY `idx_jobs_category` (`category`),
  KEY `idx_jobs_title` (`title`),
  KEY `idx_jobs_external_source` (`external_source`),
  KEY `idx_jobs_data_quality` (`data_quality`),
  KEY `idx_jobs_is_featured` (`is_featured`),
  KEY `idx_jobs_job_type` (`job_type`),
  KEY `idx_jobs_application_type` (`application_type`),
  KEY `idx_jobs_status` (`status`)
) ENGINE=InnoDB AUTO_INCREMENT=10047 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='岗位表';
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `jobs` WRITE;
/*!40000 ALTER TABLE `jobs` DISABLE KEYS */;
INSERT INTO `jobs` VALUES (10001,'软件开发-后台开发方向','企业发展事业群','深圳总部','软件开发','后台开发','技术','应届实习','实习生','应届实习','你是腾讯产品「背后」的英雄，打造出更稳定安全、高效可靠的后台支撑体系，守护海量用户的笑容！','负责实现和优化公司的产品功能，以及构建和维护关键服务与基础设施。','负责实现和优化公司的产品功能，以及构建和维护关键服务与基础设施。','【必备要求】\n扎实的编程能力\n熟练掌握 C/C++/Java/Go 等其中一门开发语言\n熟悉 TCP/UDP 网络协议及相关编程、进程间通讯编程\n具备算法、操作系统、软件工程、设计模式、数据结构、数据库系统、网络安全等专业软件知识\n\n【了解项】\n了解 Python、Shell、Perl 等脚本语言\n了解 MySQL 及 SQL 编程\n了解 NoSQL、Key-Value 存储原理\n\n【加分项】\n了解分布式系统设计与开发、负载均衡、系统容灾、高可用系统等知识\n对云原生相关技术有所了解','[\"深入理解业务需求和产品设计，高效地实现并优化产品功能\", \"持续优化架构，提升关键服务和基础设施的稳定性与可用性\", \"通过引入新的工具和流程，提升团队的开发效率和代码质量\", \"通过与产品和前端工程师的紧密合作，共同推进产品的迭代与优化\", \"对线上问题进行快速定位并解决，对服务性能进行监控与优化\", \"参与新技术的研究和探索，为团队的技术进步和产品创新提供支持\"]','[\"扎实的编程能力\", \"熟练掌握 C/C++/Java/Go 等其中一门开发语言\", \"熟悉 TCP/UDP 网络协议及相关编程、进程间通讯编程\", \"具备算法、操作系统、软件工程、设计模式、数据结构、数据库系统、网络安全等专业软件知识\"]','[\"了解 Python、Shell、Perl 等脚本语言\", \"了解 MySQL 及 SQL 编程\", \"了解 NoSQL、Key-Value 存储原理\"]','[\"了解分布式系统设计与开发、负载均衡、系统容灾、高可用系统等知识\", \"对云原生相关技术有所了解\"]','null','[\"C/C++\", \"Java\", \"Go\", \"TCP/UDP\", \"MySQL\", \"NoSQL\", \"分布式系统\", \"云原生\", \"高可用\"]','[\"C/C++\", \"Java\", \"Go\", \"TCP/UDP\", \"MySQL\", \"NoSQL\", \"分布式系统\", \"云原生\", \"高可用\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}, {\"code\": \"S2\", \"name\": \"职能系统－财经线\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"武汉\", \"杭州\"]','[\"上海\", \"远程面试\"]',NULL,'open','manual_curated','tencent-backend-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-backend-intern-2026-001\", \"title\": \"软件开发-后台开发方向\", \"slogan\": \"你是腾讯产品「背后」的英雄，打造出更稳定安全、高效可靠的后台支撑体系，守护海量用户的笑容！\", \"status\": \"open\", \"category\": \"后台开发\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"武汉\", \"杭州\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"后台开发\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\", \"S1\", \"S2\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"C/C++\", \"Java\", \"Go\", \"TCP/UDP\", \"MySQL\", \"NoSQL\", \"分布式系统\", \"云原生\", \"高可用\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"武汉\", \"杭州\"], \"description\": {\"summary\": \"负责实现和优化公司的产品功能，以及构建和维护关键服务与基础设施。\", \"responsibilities\": [\"深入理解业务需求和产品设计，高效地实现并优化产品功能\", \"持续优化架构，提升关键服务和基础设施的稳定性与可用性\", \"通过引入新的工具和流程，提升团队的开发效率和代码质量\", \"通过与产品和前端工程师的紧密合作，共同推进产品的迭代与优化\", \"对线上问题进行快速定位并解决，对服务性能进行监控与优化\", \"参与新技术的研究和探索，为团队的技术进步和产品创新提供支持\"]}, \"requirements\": {\"must_have\": [\"扎实的编程能力\", \"熟练掌握 C/C++/Java/Go 等其中一门开发语言\", \"熟悉 TCP/UDP 网络协议及相关编程、进程间通讯编程\", \"具备算法、操作系统、软件工程、设计模式、数据结构、数据库系统、网络安全等专业软件知识\"], \"bonus_points\": [\"了解分布式系统设计与开发、负载均衡、系统容灾、高可用系统等知识\", \"对云原生相关技术有所了解\"], \"nice_to_have\": [\"了解 Python、Shell、Perl 等脚本语言\", \"了解 MySQL 及 SQL 编程\", \"了解 NoSQL、Key-Value 存储原理\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}, {\"code\": \"S2\", \"name\": \"职能系统－财经线\"}], \"interview_locations\": [\"上海\", \"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10002,'算法-多模态方向','企业发展事业群','深圳总部','算法','多模态','技术','应届实习','实习生','应届实习','对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！','负责多模态处理算法和模型的研究与开发，覆盖图像、视频、3D生成、声学信号理解与生成、多模态信息与文本信息对齐和整合等方向。','负责多模态处理算法和模型的研究与开发，覆盖图像、视频、3D生成、声学信号理解与生成、多模态信息与文本信息对齐和整合等方向。','【必备要求】\n包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\n熟练掌握计算机视觉和图像处理相关的基本算法及应用\n熟悉 Caffe、TensorFlow、PyTorch 等至少一个深度学习框架\n较强的工程实现能力\n熟练掌握 C/C++ 编程\n熟悉 Shell、Python、Matlab 至少一种编程语言\n\n【了解项】\n熟悉多模态、NLP、CV 等方向的前沿技术\n具备图像、视频、3D生成、声学信号、多模态对齐等相关项目经验\n\n【加分项】\n在 CVPR、ICCV、ECCV、ACL、NeurIPS、ICLR 等学术会议或期刊以第一作者发表过文章\n有丰富项目经验','[\"研究和开发多模态处理算法和模型，包括图像、视频、3D生成、声学信号的理解与生成、多模态信息和文本信息的对齐与整合\", \"设计和优化现有算法，提高性能和准确性，确保高质量的用户体验\", \"深入调研和关注多模态、NLP、CV 等方向的前沿技术，及时将新技术应用到产品中\"]','[\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握计算机视觉和图像处理相关的基本算法及应用\", \"熟悉 Caffe、TensorFlow、PyTorch 等至少一个深度学习框架\", \"较强的工程实现能力\", \"熟练掌握 C/C++ 编程\", \"熟悉 Shell、Python、Matlab 至少一种编程语言\"]','[\"熟悉多模态、NLP、CV 等方向的前沿技术\", \"具备图像、视频、3D生成、声学信号、多模态对齐等相关项目经验\"]','[\"在 CVPR、ICCV、ECCV、ACL、NeurIPS、ICLR 等学术会议或期刊以第一作者发表过文章\", \"有丰富项目经验\"]','null','[\"多模态\", \"计算机视觉\", \"图像处理\", \"视频理解\", \"3D生成\", \"声学信号处理\", \"NLP\", \"CV\", \"C/C++\", \"Python\", \"Shell\", \"Matlab\", \"Caffe\", \"TensorFlow\", \"PyTorch\", \"深度学习\"]','[\"多模态\", \"计算机视觉\", \"图像处理\", \"视频理解\", \"3D生成\", \"声学信号处理\", \"NLP\", \"CV\", \"C/C++\", \"Python\", \"Shell\", \"Matlab\", \"Caffe\", \"TensorFlow\", \"PyTorch\", \"深度学习\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-algorithm-multimodal-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-algorithm-multimodal-intern-2026-001\", \"title\": \"算法-多模态方向\", \"slogan\": \"对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！\", \"status\": \"open\", \"category\": \"多模态\", \"job_type\": \"技术\", \"direction\": \"算法\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"job_type\": \"技术\", \"direction\": \"算法\", \"job_category\": \"多模态\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"多模态\", \"计算机视觉\", \"图像处理\", \"视频理解\", \"3D生成\", \"声学信号处理\", \"NLP\", \"CV\", \"C/C++\", \"Python\", \"Shell\", \"Matlab\", \"Caffe\", \"TensorFlow\", \"PyTorch\", \"深度学习\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"description\": {\"summary\": \"负责多模态处理算法和模型的研究与开发，覆盖图像、视频、3D生成、声学信号理解与生成、多模态信息与文本信息对齐和整合等方向。\", \"responsibilities\": [\"研究和开发多模态处理算法和模型，包括图像、视频、3D生成、声学信号的理解与生成、多模态信息和文本信息的对齐与整合\", \"设计和优化现有算法，提高性能和准确性，确保高质量的用户体验\", \"深入调研和关注多模态、NLP、CV 等方向的前沿技术，及时将新技术应用到产品中\"]}, \"requirements\": {\"must_have\": [\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握计算机视觉和图像处理相关的基本算法及应用\", \"熟悉 Caffe、TensorFlow、PyTorch 等至少一个深度学习框架\", \"较强的工程实现能力\", \"熟练掌握 C/C++ 编程\", \"熟悉 Shell、Python、Matlab 至少一种编程语言\"], \"bonus_points\": [\"在 CVPR、ICCV、ECCV、ACL、NeurIPS、ICLR 等学术会议或期刊以第一作者发表过文章\", \"有丰富项目经验\"], \"nice_to_have\": [\"熟悉多模态、NLP、CV 等方向的前沿技术\", \"具备图像、视频、3D生成、声学信号、多模态对齐等相关项目经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10003,'算法-自然语言处理方向','企业发展事业群','深圳总部','算法','自然语言处理','技术','应届实习','实习生','应届实习','对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！','负责自然语言处理相关算法研发，覆盖语义分析、意图识别、人机对话、机器翻译、知识图谱、命名实体识别、自然语言生成等方向。','负责自然语言处理相关算法研发，覆盖语义分析、意图识别、人机对话、机器翻译、知识图谱、命名实体识别、自然语言生成等方向。','【必备要求】\n包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\n熟练掌握 NLP 基础理论和算法\n在一个或多个 NLP 领域能够独立开展研发工作，如对话系统、文本分类、语义理解、知识图谱构建、篇章理解、情感分析、自然语言生成等\n熟悉至少一种编程语言，包括 Java、C/C++、C#、Python 等\n熟练使用一种或几种深度学习框架，如 TensorFlow、Caffe、MXNet、PyTorch 等\n\n【了解项】\n熟悉对话系统、文本分类、语义理解、知识图谱构建、篇章理解、情感分析、自然语言生成等一个或多个 NLP 方向\n具备深度学习学术或工程项目经验\n\n【加分项】\n在 ACL、EMNLP、SIGIR、NAACL、COLING、IJCAI、AAAI 等学术会议或期刊以第一作者发表过文章\n有深度学习学术或工程项目经验','[\"负责自然语言处理的算法研发，包括语义分析、意图识别、人机对话、语义挖掘、机器翻译、知识图谱、命名实体识别等\", \"负责对话系统，尤其是任务导向型对话系统的技术研究，包括自然语言理解、对话状态跟踪、对话策略学习、自然语言生成、encoder-decoder 模型等\", \"负责知识图谱相关关键技术研究，解决知识图谱和自然语言深层次表示、理解与计算问题\", \"负责 NLP 前沿问题的研究，结合未来实际应用场景，提供技术解决方案\"]','[\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握 NLP 基础理论和算法\", \"在一个或多个 NLP 领域能够独立开展研发工作，如对话系统、文本分类、语义理解、知识图谱构建、篇章理解、情感分析、自然语言生成等\", \"熟悉至少一种编程语言，包括 Java、C/C++、C#、Python 等\", \"熟练使用一种或几种深度学习框架，如 TensorFlow、Caffe、MXNet、PyTorch 等\"]','[\"熟悉对话系统、文本分类、语义理解、知识图谱构建、篇章理解、情感分析、自然语言生成等一个或多个 NLP 方向\", \"具备深度学习学术或工程项目经验\"]','[\"在 ACL、EMNLP、SIGIR、NAACL、COLING、IJCAI、AAAI 等学术会议或期刊以第一作者发表过文章\", \"有深度学习学术或工程项目经验\"]','null','[\"NLP\", \"自然语言处理\", \"语义分析\", \"意图识别\", \"人机对话\", \"任务导向型对话系统\", \"自然语言理解\", \"对话状态跟踪\", \"对话策略学习\", \"自然语言生成\", \"encoder-decoder\", \"机器翻译\", \"知识图谱\", \"命名实体识别\", \"文本分类\", \"情感分析\", \"Java\", \"C/C++\", \"C#\", \"Python\", \"TensorFlow\", \"Caffe\", \"MXNet\", \"PyTorch\", \"深度学习\"]','[\"NLP\", \"自然语言处理\", \"语义分析\", \"意图识别\", \"人机对话\", \"任务导向型对话系统\", \"自然语言理解\", \"对话状态跟踪\", \"对话策略学习\", \"自然语言生成\", \"encoder-decoder\", \"机器翻译\", \"知识图谱\", \"命名实体识别\", \"文本分类\", \"情感分析\", \"Java\", \"C/C++\", \"C#\", \"Python\", \"TensorFlow\", \"Caffe\", \"MXNet\", \"PyTorch\", \"深度学习\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-algorithm-nlp-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-algorithm-nlp-intern-2026-001\", \"title\": \"算法-自然语言处理方向\", \"slogan\": \"对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！\", \"status\": \"open\", \"category\": \"自然语言处理\", \"job_type\": \"技术\", \"direction\": \"算法\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"算法\", \"job_category\": \"自然语言处理\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\", \"S1\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"NLP\", \"自然语言处理\", \"语义分析\", \"意图识别\", \"人机对话\", \"任务导向型对话系统\", \"自然语言理解\", \"对话状态跟踪\", \"对话策略学习\", \"自然语言生成\", \"encoder-decoder\", \"机器翻译\", \"知识图谱\", \"命名实体识别\", \"文本分类\", \"情感分析\", \"Java\", \"C/C++\", \"C#\", \"Python\", \"TensorFlow\", \"Caffe\", \"MXNet\", \"PyTorch\", \"深度学习\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责自然语言处理相关算法研发，覆盖语义分析、意图识别、人机对话、机器翻译、知识图谱、命名实体识别、自然语言生成等方向。\", \"responsibilities\": [\"负责自然语言处理的算法研发，包括语义分析、意图识别、人机对话、语义挖掘、机器翻译、知识图谱、命名实体识别等\", \"负责对话系统，尤其是任务导向型对话系统的技术研究，包括自然语言理解、对话状态跟踪、对话策略学习、自然语言生成、encoder-decoder 模型等\", \"负责知识图谱相关关键技术研究，解决知识图谱和自然语言深层次表示、理解与计算问题\", \"负责 NLP 前沿问题的研究，结合未来实际应用场景，提供技术解决方案\"]}, \"requirements\": {\"must_have\": [\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握 NLP 基础理论和算法\", \"在一个或多个 NLP 领域能够独立开展研发工作，如对话系统、文本分类、语义理解、知识图谱构建、篇章理解、情感分析、自然语言生成等\", \"熟悉至少一种编程语言，包括 Java、C/C++、C#、Python 等\", \"熟练使用一种或几种深度学习框架，如 TensorFlow、Caffe、MXNet、PyTorch 等\"], \"bonus_points\": [\"在 ACL、EMNLP、SIGIR、NAACL、COLING、IJCAI、AAAI 等学术会议或期刊以第一作者发表过文章\", \"有深度学习学术或工程项目经验\"], \"nice_to_have\": [\"熟悉对话系统、文本分类、语义理解、知识图谱构建、篇章理解、情感分析、自然语言生成等一个或多个 NLP 方向\", \"具备深度学习学术或工程项目经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10004,'技术研究-高性能计算方向','企业发展事业群','深圳总部','技术研究','高性能计算','技术','应届实习','实习生','应届实习','对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！','负责 GPU、网络、大模型工程框架等高性能计算方向的技术研究与工程优化，解决算力瓶颈、通信延迟、分布式系统扩展性等问题。','负责 GPU、网络、大模型工程框架等高性能计算方向的技术研究与工程优化，解决算力瓶颈、通信延迟、分布式系统扩展性等问题。','【必备要求】\n扎实的计算机体系结构基础\n熟悉并行计算、数据密集型系统设计\n良好的数学基础，包括线性代数、数值分析、算法复杂度优化\n\n【了解项】\n熟悉 GPU 集群调度、混合精度计算、模型量化等 GPU 加速技术\n熟悉低延迟、高吞吐分布式网络架构\n熟悉大模型训练框架与分布式训练策略\n\n【加分项】\n有 TensorRT、Triton Inference Server 等推理框架经验者优先\n深入理解 TCP/IP、RDMA 协议栈者优先\n熟悉 DPDK、SPDK 开发者优先\n有超算中心或云计算网络调优经验者优先\n熟悉 Transformer 架构及主流大模型训练流程','[\"针对业务需求，解决算力瓶颈、通信延迟、分布式系统扩展性等问题\", \"协同算法、硬件及运维团队，构建高效、稳定的计算基础设施\", \"研究 GPU 集群调度策略，优化资源利用率，探索混合精度计算、模型量化等 GPU 加速技术\", \"设计低延迟、高吞吐的分布式网络架构，如 InfiniBand、RoCE、DPU\", \"优化 MPI、NCCL 等通信库性能，解决大规模集群中的网络拥塞问题\", \"开发或优化大模型训练框架，如 PyTorch、TensorFlow、DeepSpeed、Megatron-LM\", \"设计分布式训练策略，包括模型并行、流水线并行、混合并行，提升千亿级参数模型训练效率\", \"研究训练加速技术，包括梯度压缩、显存优化、动态计算图调度\"]','[\"扎实的计算机体系结构基础\", \"熟悉并行计算、数据密集型系统设计\", \"良好的数学基础，包括线性代数、数值分析、算法复杂度优化\"]','[\"熟悉 GPU 集群调度、混合精度计算、模型量化等 GPU 加速技术\", \"熟悉低延迟、高吞吐分布式网络架构\", \"熟悉大模型训练框架与分布式训练策略\"]','[\"有 TensorRT、Triton Inference Server 等推理框架经验者优先\", \"深入理解 TCP/IP、RDMA 协议栈者优先\", \"熟悉 DPDK、SPDK 开发者优先\", \"有超算中心或云计算网络调优经验者优先\", \"熟悉 Transformer 架构及主流大模型训练流程\"]','null','[\"高性能计算\", \"GPU\", \"GPU集群调度\", \"并行计算\", \"数据密集型系统\", \"分布式系统\", \"计算机体系结构\", \"混合精度计算\", \"模型量化\", \"InfiniBand\", \"RoCE\", \"DPU\", \"MPI\", \"NCCL\", \"PyTorch\", \"TensorFlow\", \"DeepSpeed\", \"Megatron-LM\", \"模型并行\", \"流水线并行\", \"混合并行\", \"梯度压缩\", \"显存优化\", \"动态计算图调度\", \"TensorRT\", \"Triton Inference Server\", \"TCP/IP\", \"RDMA\", \"DPDK\", \"SPDK\", \"Transformer\", \"大模型训练\"]','[\"高性能计算\", \"GPU\", \"GPU集群调度\", \"并行计算\", \"数据密集型系统\", \"分布式系统\", \"计算机体系结构\", \"混合精度计算\", \"模型量化\", \"InfiniBand\", \"RoCE\", \"DPU\", \"MPI\", \"NCCL\", \"PyTorch\", \"TensorFlow\", \"DeepSpeed\", \"Megatron-LM\", \"模型并行\", \"流水线并行\", \"混合并行\", \"梯度压缩\", \"显存优化\", \"动态计算图调度\", \"TensorRT\", \"Triton Inference Server\", \"TCP/IP\", \"RDMA\", \"DPDK\", \"SPDK\", \"Transformer\", \"大模型训练\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"合肥\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-tech-research-hpc-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-tech-research-hpc-intern-2026-001\", \"title\": \"技术研究-高性能计算方向\", \"slogan\": \"对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！\", \"status\": \"open\", \"category\": \"高性能计算\", \"job_type\": \"技术\", \"direction\": \"技术研究\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"合肥\"], \"job_type\": \"技术\", \"direction\": \"技术研究\", \"job_category\": \"高性能计算\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"高性能计算\", \"GPU\", \"GPU集群调度\", \"并行计算\", \"数据密集型系统\", \"分布式系统\", \"计算机体系结构\", \"混合精度计算\", \"模型量化\", \"InfiniBand\", \"RoCE\", \"DPU\", \"MPI\", \"NCCL\", \"PyTorch\", \"TensorFlow\", \"DeepSpeed\", \"Megatron-LM\", \"模型并行\", \"流水线并行\", \"混合并行\", \"梯度压缩\", \"显存优化\", \"动态计算图调度\", \"TensorRT\", \"Triton Inference Server\", \"TCP/IP\", \"RDMA\", \"DPDK\", \"SPDK\", \"Transformer\", \"大模型训练\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"合肥\"], \"description\": {\"summary\": \"负责 GPU、网络、大模型工程框架等高性能计算方向的技术研究与工程优化，解决算力瓶颈、通信延迟、分布式系统扩展性等问题。\", \"responsibilities\": [\"针对业务需求，解决算力瓶颈、通信延迟、分布式系统扩展性等问题\", \"协同算法、硬件及运维团队，构建高效、稳定的计算基础设施\", \"研究 GPU 集群调度策略，优化资源利用率，探索混合精度计算、模型量化等 GPU 加速技术\", \"设计低延迟、高吞吐的分布式网络架构，如 InfiniBand、RoCE、DPU\", \"优化 MPI、NCCL 等通信库性能，解决大规模集群中的网络拥塞问题\", \"开发或优化大模型训练框架，如 PyTorch、TensorFlow、DeepSpeed、Megatron-LM\", \"设计分布式训练策略，包括模型并行、流水线并行、混合并行，提升千亿级参数模型训练效率\", \"研究训练加速技术，包括梯度压缩、显存优化、动态计算图调度\"]}, \"requirements\": {\"must_have\": [\"扎实的计算机体系结构基础\", \"熟悉并行计算、数据密集型系统设计\", \"良好的数学基础，包括线性代数、数值分析、算法复杂度优化\"], \"bonus_points\": [\"有 TensorRT、Triton Inference Server 等推理框架经验者优先\", \"深入理解 TCP/IP、RDMA 协议栈者优先\", \"熟悉 DPDK、SPDK 开发者优先\", \"有超算中心或云计算网络调优经验者优先\", \"熟悉 Transformer 架构及主流大模型训练流程\"], \"nice_to_have\": [\"熟悉 GPU 集群调度、混合精度计算、模型量化等 GPU 加速技术\", \"熟悉低延迟、高吞吐分布式网络架构\", \"熟悉大模型训练框架与分布式训练策略\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10005,'解决方案-行业咨询方向','云与智慧产业事业群','深圳总部','解决方案','行业咨询','技术','应届实习','实习生','应届实习','你将在充满机遇与挑战的工作中，成为客户与技术产品间的桥梁，为产业发展提供多元价值。深耕产业，拥抱未来！','负责学习和理解技术、产品及应用场景，挖掘客户需求，结合腾讯平台能力提供行业解决方案，并参与售前咨询、项目交付、售后服务等环节。','负责学习和理解技术、产品及应用场景，挖掘客户需求，结合腾讯平台能力提供行业解决方案，并参与售前咨询、项目交付、售后服务等环节。','【必备要求】\n理工科专业\n具有出色的书面和口头沟通能力、人际沟通能力\n富有创造性、灵活性及自信心\n具备快速学习能力，能够快速获取、整理及分析信息\n逻辑性强，具有良好的商业意识和客户服务意识\n目标感强，自我驱动，以结果为导向\n能接受出差\n\n【了解项】\n熟悉云计算、大数据、人工智能等技术优先\n具备产品架构设计、售前咨询、项目交付、售后服务相关理解或实践经验\n具备企业数字化转型解决方案相关理解\n\n【加分项】\n同等条件下，有腾讯云从业资格认证者优先','[\"学习和理解技术、产品及应用场景，挖掘和引导客户需求，结合腾讯平台能力为客户提供解决方案\", \"深度参与产品架构设计、售前咨询、项目交付、售后服务其中一个或多个环节，保障解决方案落地，解决客户问题，助力客户成功\", \"学习解决方案的最佳实践，并通过实战经验积累，沉淀面向企业数字化转型的通用方案能力与优势\", \"保持市场洞察，感知行业动态，不断提升公司产品和解决方案的行业竞争力\"]','[\"理工科专业\", \"具有出色的书面和口头沟通能力、人际沟通能力\", \"富有创造性、灵活性及自信心\", \"具备快速学习能力，能够快速获取、整理及分析信息\", \"逻辑性强，具有良好的商业意识和客户服务意识\", \"目标感强，自我驱动，以结果为导向\", \"能接受出差\"]','[\"熟悉云计算、大数据、人工智能等技术优先\", \"具备产品架构设计、售前咨询、项目交付、售后服务相关理解或实践经验\", \"具备企业数字化转型解决方案相关理解\"]','[\"同等条件下，有腾讯云从业资格认证者优先\"]','null','[\"解决方案\", \"行业咨询\", \"云计算\", \"大数据\", \"人工智能\", \"售前咨询\", \"项目交付\", \"售后服务\", \"产品架构设计\", \"客户需求分析\", \"企业数字化转型\", \"市场洞察\", \"商业意识\", \"客户服务\", \"沟通表达\", \"信息整理分析\"]','[\"解决方案\", \"行业咨询\", \"云计算\", \"大数据\", \"人工智能\", \"售前咨询\", \"项目交付\", \"售后服务\", \"产品架构设计\", \"客户需求分析\", \"企业数字化转型\", \"市场洞察\", \"商业意识\", \"客户服务\", \"沟通表达\", \"信息整理分析\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}]','[\"深圳总部\", \"上海\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-solution-industry-consulting-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-solution-industry-consulting-intern-2026-001\", \"title\": \"解决方案-行业咨询方向\", \"slogan\": \"你将在充满机遇与挑战的工作中，成为客户与技术产品间的桥梁，为产业发展提供多元价值。深耕产业，拥抱未来！\", \"status\": \"open\", \"category\": \"行业咨询\", \"job_type\": \"技术\", \"direction\": \"解决方案\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"上海\"], \"job_type\": \"技术\", \"direction\": \"解决方案\", \"job_category\": \"行业咨询\", \"business_groups\": [\"CSIG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"解决方案\", \"行业咨询\", \"云计算\", \"大数据\", \"人工智能\", \"售前咨询\", \"项目交付\", \"售后服务\", \"产品架构设计\", \"客户需求分析\", \"企业数字化转型\", \"市场洞察\", \"商业意识\", \"客户服务\", \"沟通表达\", \"信息整理分析\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"上海\"], \"description\": {\"summary\": \"负责学习和理解技术、产品及应用场景，挖掘客户需求，结合腾讯平台能力提供行业解决方案，并参与售前咨询、项目交付、售后服务等环节。\", \"responsibilities\": [\"学习和理解技术、产品及应用场景，挖掘和引导客户需求，结合腾讯平台能力为客户提供解决方案\", \"深度参与产品架构设计、售前咨询、项目交付、售后服务其中一个或多个环节，保障解决方案落地，解决客户问题，助力客户成功\", \"学习解决方案的最佳实践，并通过实战经验积累，沉淀面向企业数字化转型的通用方案能力与优势\", \"保持市场洞察，感知行业动态，不断提升公司产品和解决方案的行业竞争力\"]}, \"requirements\": {\"must_have\": [\"理工科专业\", \"具有出色的书面和口头沟通能力、人际沟通能力\", \"富有创造性、灵活性及自信心\", \"具备快速学习能力，能够快速获取、整理及分析信息\", \"逻辑性强，具有良好的商业意识和客户服务意识\", \"目标感强，自我驱动，以结果为导向\", \"能接受出差\"], \"bonus_points\": [\"同等条件下，有腾讯云从业资格认证者优先\"], \"nice_to_have\": [\"熟悉云计算、大数据、人工智能等技术优先\", \"具备产品架构设计、售前咨询、项目交付、售后服务相关理解或实践经验\", \"具备企业数字化转型解决方案相关理解\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10006,'CSIG技术产品商务培训生','云与智慧产业事业群','青岛','技术产品商务','商务培训生','市场','应届实习','实习生','应届实习','一起投身到产业互联网浪潮中，以领先数字平台产品点亮智慧未来，遇见坚定稳步成长的自己！','加入 CSIG 技术产品商务培训生专项，面向国内外机构、企业组织和个人开发者，推广腾讯云核心产品和解决方案，挖掘潜在商机，参与完整客户业务合作过程。','加入 CSIG 技术产品商务培训生专项，面向国内外机构、企业组织和个人开发者，推广腾讯云核心产品和解决方案，挖掘潜在商机，参与完整客户业务合作过程。','【必备要求】\n具备良好的综合素质\n具备优秀的沟通和团队协作能力\n热爱挑战，能在复杂环境中探索解决路径\n愿意将给客户提供优秀的技术产品并达成商务目标作为个人职业发展方向\n积极拥抱云、大数据、人工智能等技术产品领域的变化\n具备快速学习能力及敏锐的市场洞察意识\n\n【了解项】\n计算机、信息技术、计算机交叉学科等相关专业背景优先\n商科专业背景，同时愿意快速学习技术产品知识\n具备云、大数据、人工智能等技术产品相关理解\n具备客户合作、商务拓展、市场洞察或解决方案相关实践经验\n\n【加分项】\n同等条件下，有腾讯云从业资格认证者优先\n曾担任过校园学生干部\n有校内活动组织、校外社会实践经验\n有大型互联网、IT 相关科技企业实习经历','[\"面向国内外各机构、企业组织和个人开发者，推广腾讯云的核心产品和解决方案\", \"综合直销和渠道分销等形式，挖掘潜在商机，助力团队共同实现业务目标\", \"代表公司深度参与完整的客户业务合作全过程\", \"完成深度的行业洞察、挖掘商机客群、制定和参与全方位的云与技术解决方案\", \"通过一线实践体验，实现个人快速提升和成长\"]','[\"具备良好的综合素质\", \"具备优秀的沟通和团队协作能力\", \"热爱挑战，能在复杂环境中探索解决路径\", \"愿意将给客户提供优秀的技术产品并达成商务目标作为个人职业发展方向\", \"积极拥抱云、大数据、人工智能等技术产品领域的变化\", \"具备快速学习能力及敏锐的市场洞察意识\"]','[\"计算机、信息技术、计算机交叉学科等相关专业背景优先\", \"商科专业背景，同时愿意快速学习技术产品知识\", \"具备云、大数据、人工智能等技术产品相关理解\", \"具备客户合作、商务拓展、市场洞察或解决方案相关实践经验\"]','[\"同等条件下，有腾讯云从业资格认证者优先\", \"曾担任过校园学生干部\", \"有校内活动组织、校外社会实践经验\", \"有大型互联网、IT 相关科技企业实习经历\"]','[\"从 2024 年开始，实习留用将成为获得 CSIG 技术产品商务培训生正式校招 offer 的唯一途径，也是必经之路\", \"期待投入至少 1.5 个月的实习时间\", \"实习期间由经验丰富导师 1v1 带教，并提供完善课程等培养资源\", \"实习期间有机会提前获得校招 Offer\"]','[\"技术产品商务\", \"商务拓展\", \"客户合作\", \"腾讯云\", \"云计算\", \"大数据\", \"人工智能\", \"产业互联网\", \"解决方案\", \"直销\", \"渠道分销\", \"商机挖掘\", \"行业洞察\", \"市场洞察\", \"客户需求分析\", \"沟通表达\", \"团队协作\", \"快速学习\", \"商务目标管理\"]','[\"技术产品商务\", \"商务拓展\", \"客户合作\", \"腾讯云\", \"云计算\", \"大数据\", \"人工智能\", \"产业互联网\", \"解决方案\", \"直销\", \"渠道分销\", \"商机挖掘\", \"行业洞察\", \"市场洞察\", \"客户需求分析\", \"沟通表达\", \"团队协作\", \"快速学习\", \"商务目标管理\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}]','[\"青岛\", \"深圳总部\", \"郑州\", \"北京\", \"上海\", \"广州\", \"成都\", \"杭州\", \"南京\", \"中国香港\", \"西安\", \"重庆\", \"厦门\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-csig-tech-product-business-trainee-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-csig-tech-product-business-trainee-intern-2026-001\", \"title\": \"CSIG技术产品商务培训生\", \"slogan\": \"一起投身到产业互联网浪潮中，以领先数字平台产品点亮智慧未来，遇见坚定稳步成长的自己！\", \"status\": \"open\", \"category\": \"商务培训生\", \"job_type\": \"市场\", \"direction\": \"技术产品商务\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"青岛\", \"深圳总部\", \"郑州\", \"北京\", \"上海\", \"广州\", \"成都\", \"杭州\", \"南京\", \"中国香港\", \"西安\", \"重庆\", \"厦门\"], \"job_type\": \"市场\", \"direction\": \"技术产品商务\", \"job_category\": \"商务培训生\", \"business_groups\": [\"CSIG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"技术产品商务\", \"商务拓展\", \"客户合作\", \"腾讯云\", \"云计算\", \"大数据\", \"人工智能\", \"产业互联网\", \"解决方案\", \"直销\", \"渠道分销\", \"商机挖掘\", \"行业洞察\", \"市场洞察\", \"客户需求分析\", \"沟通表达\", \"团队协作\", \"快速学习\", \"商务目标管理\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"青岛\", \"深圳总部\", \"郑州\", \"北京\", \"上海\", \"广州\", \"成都\", \"杭州\", \"南京\", \"中国香港\", \"西安\", \"重庆\", \"厦门\"], \"description\": {\"summary\": \"加入 CSIG 技术产品商务培训生专项，面向国内外机构、企业组织和个人开发者，推广腾讯云核心产品和解决方案，挖掘潜在商机，参与完整客户业务合作过程。\", \"responsibilities\": [\"面向国内外各机构、企业组织和个人开发者，推广腾讯云的核心产品和解决方案\", \"综合直销和渠道分销等形式，挖掘潜在商机，助力团队共同实现业务目标\", \"代表公司深度参与完整的客户业务合作全过程\", \"完成深度的行业洞察、挖掘商机客群、制定和参与全方位的云与技术解决方案\", \"通过一线实践体验，实现个人快速提升和成长\"]}, \"requirements\": {\"notes\": [\"从 2024 年开始，实习留用将成为获得 CSIG 技术产品商务培训生正式校招 offer 的唯一途径，也是必经之路\", \"期待投入至少 1.5 个月的实习时间\", \"实习期间由经验丰富导师 1v1 带教，并提供完善课程等培养资源\", \"实习期间有机会提前获得校招 Offer\"], \"must_have\": [\"具备良好的综合素质\", \"具备优秀的沟通和团队协作能力\", \"热爱挑战，能在复杂环境中探索解决路径\", \"愿意将给客户提供优秀的技术产品并达成商务目标作为个人职业发展方向\", \"积极拥抱云、大数据、人工智能等技术产品领域的变化\", \"具备快速学习能力及敏锐的市场洞察意识\"], \"bonus_points\": [\"同等条件下，有腾讯云从业资格认证者优先\", \"曾担任过校园学生干部\", \"有校内活动组织、校外社会实践经验\", \"有大型互联网、IT 相关科技企业实习经历\"], \"nice_to_have\": [\"计算机、信息技术、计算机交叉学科等相关专业背景优先\", \"商科专业背景，同时愿意快速学习技术产品知识\", \"具备云、大数据、人工智能等技术产品相关理解\", \"具备客户合作、商务拓展、市场洞察或解决方案相关实践经验\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10007,'项目管理','云与智慧产业事业群','深圳总部','项目管理','项目管理','产品','应届实习','实习生','应届实习','项目的达成需要你的推动与把控，你是项目推进的“大总管”，也是推动项目实现的多面手！','负责参与项目管理与统筹，协助团队推进需求落地、项目进度把控、风险预警、资源配置、流程优化和项目复盘，保障项目目标高效达成。','负责参与项目管理与统筹，协助团队推进需求落地、项目进度把控、风险预警、资源配置、流程优化和项目复盘，保障项目目标高效达成。','【必备要求】\n本科及以上学历\n了解项目开发过程、敏捷项目管理理论\n乐观开朗、善于沟通、擅长协作\n乐于用自己的能量感染他人\n拥有明确的职业规划，立足于项目管理岗位长期发展\n\n【了解项】\n具备项目管理、需求管理、资源协调、流程优化相关理解或实践经验\n熟悉敏捷项目管理、项目复盘、风险预警、成本分析等方法\n\n【加分项】\n有软件工程实习经历背景\n积极参与学生社团相关工作，担任过主要职务','[\"参与项目的管理与统筹，帮助团队合理理解、判断需求及方向，并进行内外资源部署，推动项目和需求落地，确保高效达成项目目标\", \"协助合理规划项目、相关团队及合作机制，把控项目进度，进行风险预警和资源配置，关注合作细节，推动解决问题\", \"协助项目的复盘和总结\", \"协助优化团队资源结构，进行需求、人力、成本分析\", \"负责制定和优化工作流程，运用工具将人工推进事务逐步标准化、流程化、高效化\"]','[\"本科及以上学历\", \"了解项目开发过程、敏捷项目管理理论\", \"乐观开朗、善于沟通、擅长协作\", \"乐于用自己的能量感染他人\", \"拥有明确的职业规划，立足于项目管理岗位长期发展\"]','[\"具备项目管理、需求管理、资源协调、流程优化相关理解或实践经验\", \"熟悉敏捷项目管理、项目复盘、风险预警、成本分析等方法\"]','[\"有软件工程实习经历背景\", \"积极参与学生社团相关工作，担任过主要职务\"]','null','[\"项目管理\", \"敏捷项目管理\", \"项目统筹\", \"需求管理\", \"资源协调\", \"进度把控\", \"风险预警\", \"资源配置\", \"流程优化\", \"项目复盘\", \"需求分析\", \"人力分析\", \"成本分析\", \"团队协作\", \"沟通表达\", \"问题推动\", \"标准化流程\"]','[\"项目管理\", \"敏捷项目管理\", \"项目统筹\", \"需求管理\", \"资源协调\", \"进度把控\", \"风险预警\", \"资源配置\", \"流程优化\", \"项目复盘\", \"需求分析\", \"人力分析\", \"成本分析\", \"团队协作\", \"沟通表达\", \"问题推动\", \"标准化流程\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"杭州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-project-management-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-project-management-intern-2026-001\", \"title\": \"项目管理\", \"slogan\": \"项目的达成需要你的推动与把控，你是项目推进的“大总管”，也是推动项目实现的多面手！\", \"status\": \"open\", \"category\": \"项目管理\", \"job_type\": \"产品\", \"direction\": \"项目管理\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"杭州\"], \"job_type\": \"产品\", \"direction\": \"项目管理\", \"job_category\": \"项目管理\", \"business_groups\": [\"CSIG\", \"IEG\", \"PCG\", \"TEG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"项目管理\", \"敏捷项目管理\", \"项目统筹\", \"需求管理\", \"资源协调\", \"进度把控\", \"风险预警\", \"资源配置\", \"流程优化\", \"项目复盘\", \"需求分析\", \"人力分析\", \"成本分析\", \"团队协作\", \"沟通表达\", \"问题推动\", \"标准化流程\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"杭州\"], \"description\": {\"summary\": \"负责参与项目管理与统筹，协助团队推进需求落地、项目进度把控、风险预警、资源配置、流程优化和项目复盘，保障项目目标高效达成。\", \"responsibilities\": [\"参与项目的管理与统筹，帮助团队合理理解、判断需求及方向，并进行内外资源部署，推动项目和需求落地，确保高效达成项目目标\", \"协助合理规划项目、相关团队及合作机制，把控项目进度，进行风险预警和资源配置，关注合作细节，推动解决问题\", \"协助项目的复盘和总结\", \"协助优化团队资源结构，进行需求、人力、成本分析\", \"负责制定和优化工作流程，运用工具将人工推进事务逐步标准化、流程化、高效化\"]}, \"requirements\": {\"must_have\": [\"本科及以上学历\", \"了解项目开发过程、敏捷项目管理理论\", \"乐观开朗、善于沟通、擅长协作\", \"乐于用自己的能量感染他人\", \"拥有明确的职业规划，立足于项目管理岗位长期发展\"], \"bonus_points\": [\"有软件工程实习经历背景\", \"积极参与学生社团相关工作，担任过主要职务\"], \"nice_to_have\": [\"具备项目管理、需求管理、资源协调、流程优化相关理解或实践经验\", \"熟悉敏捷项目管理、项目复盘、风险预警、成本分析等方法\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10008,'行业运营','企业发展事业群','深圳总部','行业运营','行业运营','产品','应届实习','实习生','应届实习','你将作为连接市场与产品的桥梁，互联网的市场先锋、业务发展的“啄木鸟”。下一个伟大，由你开始！','负责行业市场扫描、行业机会识别、目标客户分析、商机跟踪、解决方案推动、客户价值提升、经营指标分析和业务风险预警，促进业务目标达成。','负责行业市场扫描、行业机会识别、目标客户分析、商机跟踪、解决方案推动、客户价值提升、经营指标分析和业务风险预警，促进业务目标达成。','【必备要求】\n本科及以上学历\n热爱互联网行业\n具备优秀的分析问题、解决问题、信息整合、数据挖掘、逻辑组织和观点提炼能力\n具备一定方案撰写能力\n具备一定 Excel 建模能力\n具备良好的沟通能力和团队合作精神\n\n【了解项】\n具备行业分析、市场洞察、商业模式分析相关理解或实践经验\n具备客户需求分析、解决方案推动、商机跟踪相关理解或实践经验\n具备经营分析、KPI 分析、数据报告输出或业务风险预警相关理解','[\"扫描行业市场，关注行业前沿动态，分析行业产业结构，识别行业新机会点\", \"洞察商业模式变化趋势，探索新的商业模式，通过市场深入分析了解产品在行业中的定位与价值，促进业务发展\", \"通过行业目标客户圈定和特点分析，发现和跟踪商机，深入分析客户需求和应用场景\", \"提供解决方案和产品能力并推动实施，使产品具备较好的商业交付能力\", \"协调公司内外部资源达成目标，内部衔接销售、产品，外部衔接客户、服务商等\", \"建立行业作战地图，跟踪客户转化和渗透提升，不断提升客户价值，积累大客户标杆，驱动整体目标达成\", \"协同业务团队战略规划，明确经营指标体系建设\", \"周期性进行经营指标分析及报告数据输出，分析 KPI 达成情况、机会和风险，建立业务风险预警机制\"]','[\"本科及以上学历\", \"热爱互联网行业\", \"具备优秀的分析问题、解决问题、信息整合、数据挖掘、逻辑组织和观点提炼能力\", \"具备一定方案撰写能力\", \"具备一定 Excel 建模能力\", \"具备良好的沟通能力和团队合作精神\"]','[\"具备行业分析、市场洞察、商业模式分析相关理解或实践经验\", \"具备客户需求分析、解决方案推动、商机跟踪相关理解或实践经验\", \"具备经营分析、KPI 分析、数据报告输出或业务风险预警相关理解\"]','[]','null','[\"行业运营\", \"市场分析\", \"行业分析\", \"行业洞察\", \"商业模式分析\", \"客户需求分析\", \"目标客户圈定\", \"商机挖掘\", \"商机跟踪\", \"解决方案\", \"产品能力推动\", \"商业交付\", \"资源协调\", \"客户转化\", \"客户渗透\", \"大客户标杆\", \"战略规划\", \"经营指标分析\", \"KPI分析\", \"数据报告\", \"业务风险预警\", \"信息整合\", \"数据挖掘\", \"方案撰写\", \"Excel建模\", \"沟通表达\", \"团队合作\"]','[\"行业运营\", \"市场分析\", \"行业分析\", \"行业洞察\", \"商业模式分析\", \"客户需求分析\", \"目标客户圈定\", \"商机挖掘\", \"商机跟踪\", \"解决方案\", \"产品能力推动\", \"商业交付\", \"资源协调\", \"客户转化\", \"客户渗透\", \"大客户标杆\", \"战略规划\", \"经营指标分析\", \"KPI分析\", \"数据报告\", \"业务风险预警\", \"信息整合\", \"数据挖掘\", \"方案撰写\", \"Excel建模\", \"沟通表达\", \"团队合作\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-industry-operations-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-industry-operations-intern-2026-001\", \"title\": \"行业运营\", \"slogan\": \"你将作为连接市场与产品的桥梁，互联网的市场先锋、业务发展的“啄木鸟”。下一个伟大，由你开始！\", \"status\": \"open\", \"category\": \"行业运营\", \"job_type\": \"产品\", \"direction\": \"行业运营\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"产品\", \"direction\": \"行业运营\", \"job_category\": \"行业运营\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"行业运营\", \"市场分析\", \"行业分析\", \"行业洞察\", \"商业模式分析\", \"客户需求分析\", \"目标客户圈定\", \"商机挖掘\", \"商机跟踪\", \"解决方案\", \"产品能力推动\", \"商业交付\", \"资源协调\", \"客户转化\", \"客户渗透\", \"大客户标杆\", \"战略规划\", \"经营指标分析\", \"KPI分析\", \"数据报告\", \"业务风险预警\", \"信息整合\", \"数据挖掘\", \"方案撰写\", \"Excel建模\", \"沟通表达\", \"团队合作\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责行业市场扫描、行业机会识别、目标客户分析、商机跟踪、解决方案推动、客户价值提升、经营指标分析和业务风险预警，促进业务目标达成。\", \"responsibilities\": [\"扫描行业市场，关注行业前沿动态，分析行业产业结构，识别行业新机会点\", \"洞察商业模式变化趋势，探索新的商业模式，通过市场深入分析了解产品在行业中的定位与价值，促进业务发展\", \"通过行业目标客户圈定和特点分析，发现和跟踪商机，深入分析客户需求和应用场景\", \"提供解决方案和产品能力并推动实施，使产品具备较好的商业交付能力\", \"协调公司内外部资源达成目标，内部衔接销售、产品，外部衔接客户、服务商等\", \"建立行业作战地图，跟踪客户转化和渗透提升，不断提升客户价值，积累大客户标杆，驱动整体目标达成\", \"协同业务团队战略规划，明确经营指标体系建设\", \"周期性进行经营指标分析及报告数据输出，分析 KPI 达成情况、机会和风险，建立业务风险预警机制\"]}, \"requirements\": {\"must_have\": [\"本科及以上学历\", \"热爱互联网行业\", \"具备优秀的分析问题、解决问题、信息整合、数据挖掘、逻辑组织和观点提炼能力\", \"具备一定方案撰写能力\", \"具备一定 Excel 建模能力\", \"具备良好的沟通能力和团队合作精神\"], \"bonus_points\": [], \"nice_to_have\": [\"具备行业分析、市场洞察、商业模式分析相关理解或实践经验\", \"具备客户需求分析、解决方案推动、商机跟踪相关理解或实践经验\", \"具备经营分析、KPI 分析、数据报告输出或业务风险预警相关理解\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10009,'投资分析','企业发展事业群','北京','投资分析','投资分析','市场','应届实习','实习生','应届实习','You are a key player in connecting investment decisions with market dynamics. Here, you will apply your insight and judgment to provide objective and accurate investment advice.','负责互联网领域的行业与经济研究，参与投资项目挖掘、评估、尽职调查、交易执行、投后公司研究及团队知识库建设。','负责互联网领域的行业与经济研究，参与投资项目挖掘、评估、尽职调查、交易执行、投后公司研究及团队知识库建设。','【必备要求】\n对互联网、投资和腾讯有强烈兴趣、热情和商业敏感度\n具备高度诚信、投入度和自我驱动力\n顶尖院校本科或硕士学历，专业不限\n具备优秀的问题解决能力\n具备扎实的批判性思维能力\n中英文流利\n\n【了解项】\n具备互联网行业研究、经济研究、投资分析、商业分析相关理解或实践经验\n具备交易评估、尽职调查、投后研究或知识库建设相关理解\n\n【加分项】\n有顶尖咨询公司或投资银行实习经历者优先','[\"主导互联网领域相关行业和经济研究\", \"参与并支持投资项目的来源挖掘、评估、尽职调查和交易执行流程\", \"参与并支持投后公司研究活动\", \"增强并维护团队知识库\"]','[\"对互联网、投资和腾讯有强烈兴趣、热情和商业敏感度\", \"具备高度诚信、投入度和自我驱动力\", \"顶尖院校本科或硕士学历，专业不限\", \"具备优秀的问题解决能力\", \"具备扎实的批判性思维能力\", \"中英文流利\"]','[\"具备互联网行业研究、经济研究、投资分析、商业分析相关理解或实践经验\", \"具备交易评估、尽职调查、投后研究或知识库建设相关理解\"]','[\"有顶尖咨询公司或投资银行实习经历者优先\"]','[\"该岗位要求上传 PDF 版本简历\"]','[\"投资分析\", \"行业研究\", \"经济研究\", \"互联网行业\", \"商业分析\", \"投资判断\", \"Deal Sourcing\", \"项目评估\", \"尽职调查\", \"交易执行\", \"投后研究\", \"知识库建设\", \"问题解决\", \"批判性思维\", \"商业敏感度\", \"英文沟通\", \"中文沟通\", \"Consulting\", \"Investment Banking\"]','[\"投资分析\", \"行业研究\", \"经济研究\", \"互联网行业\", \"商业分析\", \"投资判断\", \"Deal Sourcing\", \"项目评估\", \"尽职调查\", \"交易执行\", \"投后研究\", \"知识库建设\", \"问题解决\", \"批判性思维\", \"商业敏感度\", \"英文沟通\", \"中文沟通\", \"Consulting\", \"Investment Banking\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}]','[\"北京\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-investment-analysis-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-investment-analysis-intern-2026-001\", \"title\": \"投资分析\", \"slogan\": \"You are a key player in connecting investment decisions with market dynamics. Here, you will apply your insight and judgment to provide objective and accurate investment advice.\", \"status\": \"open\", \"category\": \"投资分析\", \"job_type\": \"市场\", \"direction\": \"投资分析\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"北京\"], \"job_type\": \"市场\", \"direction\": \"投资分析\", \"job_category\": \"投资分析\", \"business_groups\": [\"CDG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"投资分析\", \"行业研究\", \"经济研究\", \"互联网行业\", \"商业分析\", \"投资判断\", \"Deal Sourcing\", \"项目评估\", \"尽职调查\", \"交易执行\", \"投后研究\", \"知识库建设\", \"问题解决\", \"批判性思维\", \"商业敏感度\", \"英文沟通\", \"中文沟通\", \"Consulting\", \"Investment Banking\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"北京\"], \"description\": {\"summary\": \"负责互联网领域的行业与经济研究，参与投资项目挖掘、评估、尽职调查、交易执行、投后公司研究及团队知识库建设。\", \"responsibilities\": [\"主导互联网领域相关行业和经济研究\", \"参与并支持投资项目的来源挖掘、评估、尽职调查和交易执行流程\", \"参与并支持投后公司研究活动\", \"增强并维护团队知识库\"]}, \"requirements\": {\"notes\": [\"该岗位要求上传 PDF 版本简历\"], \"must_have\": [\"对互联网、投资和腾讯有强烈兴趣、热情和商业敏感度\", \"具备高度诚信、投入度和自我驱动力\", \"顶尖院校本科或硕士学历，专业不限\", \"具备优秀的问题解决能力\", \"具备扎实的批判性思维能力\", \"中英文流利\"], \"bonus_points\": [\"有顶尖咨询公司或投资银行实习经历者优先\"], \"nice_to_have\": [\"具备互联网行业研究、经济研究、投资分析、商业分析相关理解或实践经验\", \"具备交易评估、尽职调查、投后研究或知识库建设相关理解\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10010,'投资分析(技术方向)','企业发展事业群','北京','投资分析','技术投资分析','市场','应届实习','实习生','应届实习','这是一个连接投资决策与市场动态的关键角色。在这里，你将运用自己的洞察力和判断力，提供客观且精准的投资建议。','负责科技领域为主的行业及经济研究，参与项目搜寻、评估、尽职调查、交易执行、投后标的公司研究及团队知识库体系建设。','负责科技领域为主的行业及经济研究，参与项目搜寻、评估、尽职调查、交易执行、投后标的公司研究及团队知识库体系建设。','【必备要求】\n对科技投资领域及腾讯业务具有浓厚兴趣、热情及商业洞察力\n理工科专业背景，包括但不限于计算机科学与技术、电子信息工程、数学与统计学、数据科学与大数据技术、微电子学与集成电路、电子科学与技术、材料科学与工程、物理学等技术类专业\n具备高度诚信、敬业精神与自我驱动力\n具备出色的解决问题能力\n具备扎实的批判性思维\n中英文流利\n\n【了解项】\n具备科技行业研究、经济研究、投资分析、商业分析相关理解或实践经验\n具备项目搜寻、项目评估、尽职调查、交易执行或投后研究相关理解\n具备技术背景与商业分析结合能力','[\"主导以科技领域为主的行业及经济研究工作\", \"参与并助力项目搜寻、评估、尽职调查及交易执行全流程\", \"参与并助力交易完成后的标的公司研究工作\", \"完善并维护团队的知识库体系\"]','[\"对科技投资领域及腾讯业务具有浓厚兴趣、热情及商业洞察力\", \"理工科专业背景，包括但不限于计算机科学与技术、电子信息工程、数学与统计学、数据科学与大数据技术、微电子学与集成电路、电子科学与技术、材料科学与工程、物理学等技术类专业\", \"具备高度诚信、敬业精神与自我驱动力\", \"具备出色的解决问题能力\", \"具备扎实的批判性思维\", \"中英文流利\"]','[\"具备科技行业研究、经济研究、投资分析、商业分析相关理解或实践经验\", \"具备项目搜寻、项目评估、尽职调查、交易执行或投后研究相关理解\", \"具备技术背景与商业分析结合能力\"]','[]','[\"本岗位需上传 PDF 格式简历\"]','[\"投资分析\", \"技术投资\", \"科技行业研究\", \"经济研究\", \"商业分析\", \"项目搜寻\", \"项目评估\", \"尽职调查\", \"交易执行\", \"投后研究\", \"知识库建设\", \"计算机科学与技术\", \"电子信息工程\", \"数学与统计学\", \"数据科学与大数据技术\", \"微电子学与集成电路\", \"电子科学与技术\", \"材料科学与工程\", \"物理学\", \"商业洞察力\", \"问题解决\", \"批判性思维\", \"中文沟通\", \"英文沟通\"]','[\"投资分析\", \"技术投资\", \"科技行业研究\", \"经济研究\", \"商业分析\", \"项目搜寻\", \"项目评估\", \"尽职调查\", \"交易执行\", \"投后研究\", \"知识库建设\", \"计算机科学与技术\", \"电子信息工程\", \"数学与统计学\", \"数据科学与大数据技术\", \"微电子学与集成电路\", \"电子科学与技术\", \"材料科学与工程\", \"物理学\", \"商业洞察力\", \"问题解决\", \"批判性思维\", \"中文沟通\", \"英文沟通\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}]','[\"北京\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-investment-analysis-tech-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-investment-analysis-tech-intern-2026-001\", \"title\": \"投资分析(技术方向)\", \"slogan\": \"这是一个连接投资决策与市场动态的关键角色。在这里，你将运用自己的洞察力和判断力，提供客观且精准的投资建议。\", \"status\": \"open\", \"category\": \"技术投资分析\", \"job_type\": \"市场\", \"direction\": \"投资分析\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"北京\"], \"job_type\": \"市场\", \"direction\": \"投资分析\", \"job_category\": \"技术投资分析\", \"business_groups\": [\"CDG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"投资分析\", \"技术投资\", \"科技行业研究\", \"经济研究\", \"商业分析\", \"项目搜寻\", \"项目评估\", \"尽职调查\", \"交易执行\", \"投后研究\", \"知识库建设\", \"计算机科学与技术\", \"电子信息工程\", \"数学与统计学\", \"数据科学与大数据技术\", \"微电子学与集成电路\", \"电子科学与技术\", \"材料科学与工程\", \"物理学\", \"商业洞察力\", \"问题解决\", \"批判性思维\", \"中文沟通\", \"英文沟通\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"北京\"], \"description\": {\"summary\": \"负责科技领域为主的行业及经济研究，参与项目搜寻、评估、尽职调查、交易执行、投后标的公司研究及团队知识库体系建设。\", \"responsibilities\": [\"主导以科技领域为主的行业及经济研究工作\", \"参与并助力项目搜寻、评估、尽职调查及交易执行全流程\", \"参与并助力交易完成后的标的公司研究工作\", \"完善并维护团队的知识库体系\"]}, \"requirements\": {\"notes\": [\"本岗位需上传 PDF 格式简历\"], \"must_have\": [\"对科技投资领域及腾讯业务具有浓厚兴趣、热情及商业洞察力\", \"理工科专业背景，包括但不限于计算机科学与技术、电子信息工程、数学与统计学、数据科学与大数据技术、微电子学与集成电路、电子科学与技术、材料科学与工程、物理学等技术类专业\", \"具备高度诚信、敬业精神与自我驱动力\", \"具备出色的解决问题能力\", \"具备扎实的批判性思维\", \"中英文流利\"], \"bonus_points\": [], \"nice_to_have\": [\"具备科技行业研究、经济研究、投资分析、商业分析相关理解或实践经验\", \"具备项目搜寻、项目评估、尽职调查、交易执行或投后研究相关理解\", \"具备技术背景与商业分析结合能力\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10011,'秘书','企业发展事业群','深圳总部','秘书','秘书','职能','应届实习','实习生','应届实习','你是部门里的重要担当，你眼观六路，大事小事，都放心上。你耳听八方，一切细节，尽在把握。你聚合团队，温暖人心。有你，更有爱！','负责部门管理者日程、会议、差旅等支持工作，承担部门职能事务统筹、流程制度协助、文化建设、信息传达及体系级活动组织支持。','负责部门管理者日程、会议、差旅等支持工作，承担部门职能事务统筹、流程制度协助、文化建设、信息传达及体系级活动组织支持。','【必备要求】\n本科及以上学历\n热情开朗，为人正直\n具备高效执行力，抗压性强\n具备良好的时间管理、情绪管理及沟通能力\n具备优秀的服务意识、高度责任感及团队合作精神\n能够与同事保持良好的工作关系\n工作例行化程度高，做事清晰有条理\n具有全局观及项目预见性、前瞻意识\n熟练运用各种日常办公软件及办公设备\n能独立组织大型团队活动并有创新意识\n\n【了解项】\n具备行政、人事、采购、资产、费用、合同、文档、资料管理等职能事务理解或实践经验\n具备部门文化建设、活动组织、流程优化、团队融合相关经验\n具备大型团队活动独立组织能力\n\n【加分项】\n有大型公司文秘实习经验\n英语能力突出','[\"负责部门管理者的日程管理、会议支持、差旅支持等工作，并协助管理者做好部门管理及团队融合\", \"担任部门内各项职能类工作接口人，包括行政、人事、采购、资产、费用、合同、文档、资料管理等，统筹管理相关事务\", \"根据部门管理要求，协助制定并实施部门级管理规章制度及各项流程，并定期优化\", \"负责部门文化建设，结合组织需求，通过活动组织、氛围建设、荣誉激励等方式建立良好的组织氛围，提升组织活力\", \"及时传达公司下发的各类管理规定及要求，保障管理要求在部门落地\", \"参与体系级活动组织，协助体系组织建设及文化落地\"]','[\"本科及以上学历\", \"热情开朗，为人正直\", \"具备高效执行力，抗压性强\", \"具备良好的时间管理、情绪管理及沟通能力\", \"具备优秀的服务意识、高度责任感及团队合作精神\", \"能够与同事保持良好的工作关系\", \"工作例行化程度高，做事清晰有条理\", \"具有全局观及项目预见性、前瞻意识\", \"熟练运用各种日常办公软件及办公设备\", \"能独立组织大型团队活动并有创新意识\"]','[\"具备行政、人事、采购、资产、费用、合同、文档、资料管理等职能事务理解或实践经验\", \"具备部门文化建设、活动组织、流程优化、团队融合相关经验\", \"具备大型团队活动独立组织能力\"]','[\"有大型公司文秘实习经验\", \"英语能力突出\"]','null','[\"秘书\", \"行政支持\", \"日程管理\", \"会议支持\", \"差旅支持\", \"部门管理支持\", \"团队融合\", \"行政事务\", \"人事事务\", \"采购事务\", \"资产管理\", \"费用管理\", \"合同管理\", \"文档管理\", \"资料管理\", \"流程制度建设\", \"流程优化\", \"部门文化建设\", \"活动组织\", \"氛围建设\", \"荣誉激励\", \"组织建设\", \"服务意识\", \"责任感\", \"时间管理\", \"情绪管理\", \"沟通表达\", \"团队合作\", \"办公软件\", \"办公设备\", \"英语能力\"]','[\"秘书\", \"行政支持\", \"日程管理\", \"会议支持\", \"差旅支持\", \"部门管理支持\", \"团队融合\", \"行政事务\", \"人事事务\", \"采购事务\", \"资产管理\", \"费用管理\", \"合同管理\", \"文档管理\", \"资料管理\", \"流程制度建设\", \"流程优化\", \"部门文化建设\", \"活动组织\", \"氛围建设\", \"荣誉激励\", \"组织建设\", \"服务意识\", \"责任感\", \"时间管理\", \"情绪管理\", \"沟通表达\", \"团队合作\", \"办公软件\", \"办公设备\", \"英语能力\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}]','[\"深圳总部\", \"北京\", \"广州\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-secretary-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-secretary-intern-2026-001\", \"title\": \"秘书\", \"slogan\": \"你是部门里的重要担当，你眼观六路，大事小事，都放心上。你耳听八方，一切细节，尽在把握。你聚合团队，温暖人心。有你，更有爱！\", \"status\": \"open\", \"category\": \"秘书\", \"job_type\": \"职能\", \"direction\": \"秘书\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"广州\", \"成都\"], \"job_type\": \"职能\", \"direction\": \"秘书\", \"job_category\": \"秘书\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\", \"S1\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"秘书\", \"行政支持\", \"日程管理\", \"会议支持\", \"差旅支持\", \"部门管理支持\", \"团队融合\", \"行政事务\", \"人事事务\", \"采购事务\", \"资产管理\", \"费用管理\", \"合同管理\", \"文档管理\", \"资料管理\", \"流程制度建设\", \"流程优化\", \"部门文化建设\", \"活动组织\", \"氛围建设\", \"荣誉激励\", \"组织建设\", \"服务意识\", \"责任感\", \"时间管理\", \"情绪管理\", \"沟通表达\", \"团队合作\", \"办公软件\", \"办公设备\", \"英语能力\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"广州\", \"成都\"], \"description\": {\"summary\": \"负责部门管理者日程、会议、差旅等支持工作，承担部门职能事务统筹、流程制度协助、文化建设、信息传达及体系级活动组织支持。\", \"responsibilities\": [\"负责部门管理者的日程管理、会议支持、差旅支持等工作，并协助管理者做好部门管理及团队融合\", \"担任部门内各项职能类工作接口人，包括行政、人事、采购、资产、费用、合同、文档、资料管理等，统筹管理相关事务\", \"根据部门管理要求，协助制定并实施部门级管理规章制度及各项流程，并定期优化\", \"负责部门文化建设，结合组织需求，通过活动组织、氛围建设、荣誉激励等方式建立良好的组织氛围，提升组织活力\", \"及时传达公司下发的各类管理规定及要求，保障管理要求在部门落地\", \"参与体系级活动组织，协助体系组织建设及文化落地\"]}, \"requirements\": {\"must_have\": [\"本科及以上学历\", \"热情开朗，为人正直\", \"具备高效执行力，抗压性强\", \"具备良好的时间管理、情绪管理及沟通能力\", \"具备优秀的服务意识、高度责任感及团队合作精神\", \"能够与同事保持良好的工作关系\", \"工作例行化程度高，做事清晰有条理\", \"具有全局观及项目预见性、前瞻意识\", \"熟练运用各种日常办公软件及办公设备\", \"能独立组织大型团队活动并有创新意识\"], \"bonus_points\": [\"有大型公司文秘实习经验\", \"英语能力突出\"], \"nice_to_have\": [\"具备行政、人事、采购、资产、费用、合同、文档、资料管理等职能事务理解或实践经验\", \"具备部门文化建设、活动组织、流程优化、团队融合相关经验\", \"具备大型团队活动独立组织能力\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10012,'设施设备管理','职能系统－职能线','深圳总部','设施设备管理','设施设备管理','职能','应届实习','实习生','应届实习','加入腾讯，让世界看到你的影响力！','负责协助集团机电相关工程系统质量检查、验收，管理在用项目机电设施设备，并参与供应商、暖通合同、工程预算、验收及问题判断等工作。','负责协助集团机电相关工程系统质量检查、验收，管理在用项目机电设施设备，并参与供应商、暖通合同、工程预算、验收及问题判断等工作。','【必备要求】\n本科及以上学历\n掌握 CAD 等制图软件\n对国家施工规范有一定了解\n\n【了解项】\n建筑环境与能源应用工程等相关专业优先\n具备机电工程、暖通工程、设施设备管理、工程验收相关理解或实践经验\n具备供应商管理、合同管理、工程预算相关理解','[\"协助完成集团机电相关工程系统质量检查、验收\", \"管理集团在用项目机电相关设施设备\", \"负责供应商管理、暖通专业合同管理，工程预算、验收及问题判断\"]','[\"本科及以上学历\", \"掌握 CAD 等制图软件\", \"对国家施工规范有一定了解\"]','[\"建筑环境与能源应用工程等相关专业优先\", \"具备机电工程、暖通工程、设施设备管理、工程验收相关理解或实践经验\", \"具备供应商管理、合同管理、工程预算相关理解\"]','[]','null','[\"设施设备管理\", \"机电工程\", \"工程系统质量检查\", \"工程验收\", \"设施管理\", \"机电设施设备\", \"供应商管理\", \"暖通工程\", \"合同管理\", \"工程预算\", \"问题判断\", \"CAD\", \"施工规范\", \"建筑环境与能源应用工程\"]','[\"设施设备管理\", \"机电工程\", \"工程系统质量检查\", \"工程验收\", \"设施管理\", \"机电设施设备\", \"供应商管理\", \"暖通工程\", \"合同管理\", \"工程预算\", \"问题判断\", \"CAD\", \"施工规范\", \"建筑环境与能源应用工程\"]','[{\"code\": \"S1\", \"name\": \"职能系统－职能线\"}]','[\"深圳总部\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-facility-equipment-management-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-facility-equipment-management-intern-2026-001\", \"title\": \"设施设备管理\", \"slogan\": \"加入腾讯，让世界看到你的影响力！\", \"status\": \"open\", \"category\": \"设施设备管理\", \"job_type\": \"职能\", \"direction\": \"设施设备管理\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\"], \"job_type\": \"职能\", \"direction\": \"设施设备管理\", \"job_category\": \"设施设备管理\", \"business_groups\": [\"S1\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"设施设备管理\", \"机电工程\", \"工程系统质量检查\", \"工程验收\", \"设施管理\", \"机电设施设备\", \"供应商管理\", \"暖通工程\", \"合同管理\", \"工程预算\", \"问题判断\", \"CAD\", \"施工规范\", \"建筑环境与能源应用工程\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\"], \"description\": {\"summary\": \"负责协助集团机电相关工程系统质量检查、验收，管理在用项目机电设施设备，并参与供应商、暖通合同、工程预算、验收及问题判断等工作。\", \"responsibilities\": [\"协助完成集团机电相关工程系统质量检查、验收\", \"管理集团在用项目机电相关设施设备\", \"负责供应商管理、暖通专业合同管理，工程预算、验收及问题判断\"]}, \"requirements\": {\"must_have\": [\"本科及以上学历\", \"掌握 CAD 等制图软件\", \"对国家施工规范有一定了解\"], \"bonus_points\": [], \"nice_to_have\": [\"建筑环境与能源应用工程等相关专业优先\", \"具备机电工程、暖通工程、设施设备管理、工程验收相关理解或实践经验\", \"具备供应商管理、合同管理、工程预算相关理解\"]}, \"organizations\": [{\"code\": \"S1\", \"name\": \"职能系统－职能线\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10013,'视觉设计','企业发展事业群','深圳总部','视觉设计','视觉设计','设计','应届实习','实习生','应届实习','在这里，你的设计意味着触动亿万人的情感和引领互联网时尚潮流。设计，不止于此！','负责参与公司产品的视觉内容设计，包括 UI、多媒体、品牌等方向，参与概念创意、视觉风格制定、设计规范建设、产品实现推动及阶段性品牌推广。','负责参与公司产品的视觉内容设计，包括 UI、多媒体、品牌等方向，参与概念创意、视觉风格制定、设计规范建设、产品实现推动及阶段性品牌推广。','【必备要求】\n美术、设计相关专业本科或研究生\n能够熟练使用 Photoshop、Figma、After Effects、Illustrator、Sketch 等软件\n综合素质扎实，热爱设计行业\n富于创新、思维灵活\n对先进的设计理念和技术有较强的理解能力\n有一定的设计理论知识和对流行趋势敏锐的洞察力\n具有良好的沟通能力和团队协作精神\n\n【了解项】\n具备 UI、多媒体、品牌等视觉内容设计能力\n具备跨平台及多终端设计能力\n具备产品概念创意、整体视觉风格制定、品牌推广相关理解或实践经验\n具备设计标准与设计规范制定能力\n具备用户体验思维\n熟练掌握 AIGC 等多形态创意工具\n\n【加分项】\n有设计相关行业经验或实习经验','[\"负责参与公司产品的视觉内容，包括 UI、多媒体、品牌等设计，具备一定的跨平台及多终端设计能力\", \"负责产品前期的概念创意，整体视觉风格的制定，推动产品实现及进行阶段性的品牌推广\", \"负责制定设计标准及规范，保障产品体验及设计的一致性\", \"具备较好的用户体验思维，熟练掌握如 AIGC 等多形态的创意工具，具备较强的能力扩展性\"]','[\"美术、设计相关专业本科或研究生\", \"能够熟练使用 Photoshop、Figma、After Effects、Illustrator、Sketch 等软件\", \"综合素质扎实，热爱设计行业\", \"富于创新、思维灵活\", \"对先进的设计理念和技术有较强的理解能力\", \"有一定的设计理论知识和对流行趋势敏锐的洞察力\", \"具有良好的沟通能力和团队协作精神\"]','[\"具备 UI、多媒体、品牌等视觉内容设计能力\", \"具备跨平台及多终端设计能力\", \"具备产品概念创意、整体视觉风格制定、品牌推广相关理解或实践经验\", \"具备设计标准与设计规范制定能力\", \"具备用户体验思维\", \"熟练掌握 AIGC 等多形态创意工具\"]','[\"有设计相关行业经验或实习经验\"]','[\"需上传个人过往作品集，大小控制在 30M 以下\"]','[\"视觉设计\", \"UI设计\", \"多媒体设计\", \"品牌设计\", \"跨平台设计\", \"多终端设计\", \"概念创意\", \"视觉风格制定\", \"品牌推广\", \"设计标准\", \"设计规范\", \"用户体验\", \"AIGC\", \"Photoshop\", \"Figma\", \"After Effects\", \"Illustrator\", \"Sketch\", \"设计理论\", \"流行趋势洞察\", \"沟通表达\", \"团队协作\"]','[\"视觉设计\", \"UI设计\", \"多媒体设计\", \"品牌设计\", \"跨平台设计\", \"多终端设计\", \"概念创意\", \"视觉风格制定\", \"品牌推广\", \"设计标准\", \"设计规范\", \"用户体验\", \"AIGC\", \"Photoshop\", \"Figma\", \"After Effects\", \"Illustrator\", \"Sketch\", \"设计理论\", \"流行趋势洞察\", \"沟通表达\", \"团队协作\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-visual-design-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-visual-design-intern-2026-001\", \"title\": \"视觉设计\", \"slogan\": \"在这里，你的设计意味着触动亿万人的情感和引领互联网时尚潮流。设计，不止于此！\", \"status\": \"open\", \"category\": \"视觉设计\", \"job_type\": \"设计\", \"direction\": \"视觉设计\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"广州\"], \"job_type\": \"设计\", \"direction\": \"视觉设计\", \"job_category\": \"视觉设计\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"视觉设计\", \"UI设计\", \"多媒体设计\", \"品牌设计\", \"跨平台设计\", \"多终端设计\", \"概念创意\", \"视觉风格制定\", \"品牌推广\", \"设计标准\", \"设计规范\", \"用户体验\", \"AIGC\", \"Photoshop\", \"Figma\", \"After Effects\", \"Illustrator\", \"Sketch\", \"设计理论\", \"流行趋势洞察\", \"沟通表达\", \"团队协作\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"广州\"], \"description\": {\"summary\": \"负责参与公司产品的视觉内容设计，包括 UI、多媒体、品牌等方向，参与概念创意、视觉风格制定、设计规范建设、产品实现推动及阶段性品牌推广。\", \"responsibilities\": [\"负责参与公司产品的视觉内容，包括 UI、多媒体、品牌等设计，具备一定的跨平台及多终端设计能力\", \"负责产品前期的概念创意，整体视觉风格的制定，推动产品实现及进行阶段性的品牌推广\", \"负责制定设计标准及规范，保障产品体验及设计的一致性\", \"具备较好的用户体验思维，熟练掌握如 AIGC 等多形态的创意工具，具备较强的能力扩展性\"]}, \"requirements\": {\"notes\": [\"需上传个人过往作品集，大小控制在 30M 以下\"], \"must_have\": [\"美术、设计相关专业本科或研究生\", \"能够熟练使用 Photoshop、Figma、After Effects、Illustrator、Sketch 等软件\", \"综合素质扎实，热爱设计行业\", \"富于创新、思维灵活\", \"对先进的设计理念和技术有较强的理解能力\", \"有一定的设计理论知识和对流行趋势敏锐的洞察力\", \"具有良好的沟通能力和团队协作精神\"], \"bonus_points\": [\"有设计相关行业经验或实习经验\"], \"nice_to_have\": [\"具备 UI、多媒体、品牌等视觉内容设计能力\", \"具备跨平台及多终端设计能力\", \"具备产品概念创意、整体视觉风格制定、品牌推广相关理解或实践经验\", \"具备设计标准与设计规范制定能力\", \"具备用户体验思维\", \"熟练掌握 AIGC 等多形态创意工具\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10014,'用户研究','云与智慧产业事业群','深圳总部','用户研究','用户研究','设计','应届实习','实习生','应届实习','你的招式千变万化，无数业内高手与你对决高下，在这场以用户价值为依归的擂台上，你直击亿万心灵。','负责用户研究项目的设计、执行与推进，通过定量和定性研究方法洞察行业动态、用户行为趋势和用户需求，为产品迭代与创新提供数据支持和策略建议。','负责用户研究项目的设计、执行与推进，通过定量和定性研究方法洞察行业动态、用户行为趋势和用户需求，为产品迭代与创新提供数据支持和策略建议。','【必备要求】\n本科及以上学历\n熟悉定性及定量的用户研究方法，如问卷调查、用户访谈、可用性测试、启发式评估、眼动测试等\n具备大局观，逻辑思维能力强\n主动性高，有高效的执行力\n具备优秀的理解、沟通与协调能力\n具备一定的文字表达能力\n国家英语四级及以上水平\n\n【了解项】\n具备用户研究、行业研究、用户行为趋势分析相关理解或实践经验\n具备产品迭代、产品创新、数据支持、策略建议相关理解\n具备研究项目执行、项目推进、研究成果落地相关经验\n\n【加分项】\n人机交互、认知心理学、社会学、统计学、市场营销或计算机相关专业','[\"从研究需求出发，与业务方沟通并明确研究目的，完成项目的研究设计\", \"负责跟踪并研究行业动态及用户行为趋势\", \"通过定量和定性研究方法，深入挖掘用户需求，为产品迭代和创新提供数据支持和策略建议\", \"负责研究项目的执行与推进，跟进研究成果在业务方的应用\"]','[\"本科及以上学历\", \"熟悉定性及定量的用户研究方法，如问卷调查、用户访谈、可用性测试、启发式评估、眼动测试等\", \"具备大局观，逻辑思维能力强\", \"主动性高，有高效的执行力\", \"具备优秀的理解、沟通与协调能力\", \"具备一定的文字表达能力\", \"国家英语四级及以上水平\"]','[\"具备用户研究、行业研究、用户行为趋势分析相关理解或实践经验\", \"具备产品迭代、产品创新、数据支持、策略建议相关理解\", \"具备研究项目执行、项目推进、研究成果落地相关经验\"]','[\"人机交互、认知心理学、社会学、统计学、市场营销或计算机相关专业\"]','null','[\"用户研究\", \"定性研究\", \"定量研究\", \"问卷调查\", \"用户访谈\", \"可用性测试\", \"启发式评估\", \"眼动测试\", \"行业动态研究\", \"用户行为分析\", \"用户需求洞察\", \"产品迭代\", \"产品创新\", \"数据支持\", \"策略建议\", \"研究设计\", \"研究项目执行\", \"研究成果落地\", \"逻辑思维\", \"沟通协调\", \"文字表达\", \"英语四级\", \"人机交互\", \"认知心理学\", \"社会学\", \"统计学\", \"市场营销\", \"计算机\"]','[\"用户研究\", \"定性研究\", \"定量研究\", \"问卷调查\", \"用户访谈\", \"可用性测试\", \"启发式评估\", \"眼动测试\", \"行业动态研究\", \"用户行为分析\", \"用户需求洞察\", \"产品迭代\", \"产品创新\", \"数据支持\", \"策略建议\", \"研究设计\", \"研究项目执行\", \"研究成果落地\", \"逻辑思维\", \"沟通协调\", \"文字表达\", \"英语四级\", \"人机交互\", \"认知心理学\", \"社会学\", \"统计学\", \"市场营销\", \"计算机\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-user-research-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-user-research-intern-2026-001\", \"title\": \"用户研究\", \"slogan\": \"你的招式千变万化，无数业内高手与你对决高下，在这场以用户价值为依归的擂台上，你直击亿万心灵。\", \"status\": \"open\", \"category\": \"用户研究\", \"job_type\": \"设计\", \"direction\": \"用户研究\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\"], \"job_type\": \"设计\", \"direction\": \"用户研究\", \"job_category\": \"用户研究\", \"business_groups\": [\"CSIG\", \"IEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"用户研究\", \"定性研究\", \"定量研究\", \"问卷调查\", \"用户访谈\", \"可用性测试\", \"启发式评估\", \"眼动测试\", \"行业动态研究\", \"用户行为分析\", \"用户需求洞察\", \"产品迭代\", \"产品创新\", \"数据支持\", \"策略建议\", \"研究设计\", \"研究项目执行\", \"研究成果落地\", \"逻辑思维\", \"沟通协调\", \"文字表达\", \"英语四级\", \"人机交互\", \"认知心理学\", \"社会学\", \"统计学\", \"市场营销\", \"计算机\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\"], \"description\": {\"summary\": \"负责用户研究项目的设计、执行与推进，通过定量和定性研究方法洞察行业动态、用户行为趋势和用户需求，为产品迭代与创新提供数据支持和策略建议。\", \"responsibilities\": [\"从研究需求出发，与业务方沟通并明确研究目的，完成项目的研究设计\", \"负责跟踪并研究行业动态及用户行为趋势\", \"通过定量和定性研究方法，深入挖掘用户需求，为产品迭代和创新提供数据支持和策略建议\", \"负责研究项目的执行与推进，跟进研究成果在业务方的应用\"]}, \"requirements\": {\"must_have\": [\"本科及以上学历\", \"熟悉定性及定量的用户研究方法，如问卷调查、用户访谈、可用性测试、启发式评估、眼动测试等\", \"具备大局观，逻辑思维能力强\", \"主动性高，有高效的执行力\", \"具备优秀的理解、沟通与协调能力\", \"具备一定的文字表达能力\", \"国家英语四级及以上水平\"], \"bonus_points\": [\"人机交互、认知心理学、社会学、统计学、市场营销或计算机相关专业\"], \"nice_to_have\": [\"具备用户研究、行业研究、用户行为趋势分析相关理解或实践经验\", \"具备产品迭代、产品创新、数据支持、策略建议相关理解\", \"具备研究项目执行、项目推进、研究成果落地相关经验\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10015,'交互设计','企业发展事业群','深圳总部','交互设计','交互设计','设计','应届实习','实习生','应届实习','用户需求、使用场景、商业目标、技术限制是你的支点，你将撬动及改变亿万级用户的使用体验！','负责互联网类产品跨端多场景的交互设计，参与需求讨论，定义人机界面交互框架，输出交互设计方案，并建立用户体验指标、设计规范和体验标准。','负责互联网类产品跨端多场景的交互设计，参与需求讨论，定义人机界面交互框架，输出交互设计方案，并建立用户体验指标、设计规范和体验标准。','【必备要求】\n工业设计、交互设计、计算机、人机交互等相关专业本科及以上学历\n熟悉体验设计的基本流程和方法论\n具备大局观，逻辑思维能力强\n主动性高，具备优秀的理解、沟通与协调能力\n具备一定的文字表达能力\n富有创造力和激情\n热衷于互联网，喜爱动手实践，并乐于尝试不同的产品\n\n【了解项】\n具备互联网类产品跨端多场景交互设计相关理解或实践经验\n具备产品需求讨论、人机界面交互框架定义、交互设计方案输出能力\n具备用户体验指标建设、数据分析、产品可用性优化相关理解\n具备用户体验标准、设计规范建设和设计方法沉淀相关经验','[\"负责参与公司互联网类产品跨端多场景的交互设计\", \"负责参与产品需求讨论，定义人机界面交互框架，输出符合设计原则及用户使用场景的交互设计方案\", \"负责建立产品的用户体验指标和数据分析，以用户为中心，持续优化产品可用性，改善用户体验\", \"负责建立和维护相关的用户体验标准及设计规范，沉淀设计方法\"]','[\"工业设计、交互设计、计算机、人机交互等相关专业本科及以上学历\", \"熟悉体验设计的基本流程和方法论\", \"具备大局观，逻辑思维能力强\", \"主动性高，具备优秀的理解、沟通与协调能力\", \"具备一定的文字表达能力\", \"富有创造力和激情\", \"热衷于互联网，喜爱动手实践，并乐于尝试不同的产品\"]','[\"具备互联网类产品跨端多场景交互设计相关理解或实践经验\", \"具备产品需求讨论、人机界面交互框架定义、交互设计方案输出能力\", \"具备用户体验指标建设、数据分析、产品可用性优化相关理解\", \"具备用户体验标准、设计规范建设和设计方法沉淀相关经验\"]','[]','null','[\"交互设计\", \"体验设计\", \"互联网产品设计\", \"跨端设计\", \"多场景设计\", \"产品需求分析\", \"人机界面\", \"交互框架\", \"交互设计方案\", \"设计原则\", \"用户使用场景\", \"用户体验指标\", \"数据分析\", \"产品可用性\", \"用户体验优化\", \"体验标准\", \"设计规范\", \"设计方法论\", \"工业设计\", \"人机交互\", \"计算机\", \"逻辑思维\", \"沟通协调\", \"文字表达\", \"创造力\"]','[\"交互设计\", \"体验设计\", \"互联网产品设计\", \"跨端设计\", \"多场景设计\", \"产品需求分析\", \"人机界面\", \"交互框架\", \"交互设计方案\", \"设计原则\", \"用户使用场景\", \"用户体验指标\", \"数据分析\", \"产品可用性\", \"用户体验优化\", \"体验标准\", \"设计规范\", \"设计方法论\", \"工业设计\", \"人机交互\", \"计算机\", \"逻辑思维\", \"沟通协调\", \"文字表达\", \"创造力\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}]','[\"深圳总部\", \"上海\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-interaction-design-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-interaction-design-intern-2026-001\", \"title\": \"交互设计\", \"slogan\": \"用户需求、使用场景、商业目标、技术限制是你的支点，你将撬动及改变亿万级用户的使用体验！\", \"status\": \"open\", \"category\": \"交互设计\", \"job_type\": \"设计\", \"direction\": \"交互设计\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"上海\"], \"job_type\": \"设计\", \"direction\": \"交互设计\", \"job_category\": \"交互设计\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"交互设计\", \"体验设计\", \"互联网产品设计\", \"跨端设计\", \"多场景设计\", \"产品需求分析\", \"人机界面\", \"交互框架\", \"交互设计方案\", \"设计原则\", \"用户使用场景\", \"用户体验指标\", \"数据分析\", \"产品可用性\", \"用户体验优化\", \"体验标准\", \"设计规范\", \"设计方法论\", \"工业设计\", \"人机交互\", \"计算机\", \"逻辑思维\", \"沟通协调\", \"文字表达\", \"创造力\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"上海\"], \"description\": {\"summary\": \"负责互联网类产品跨端多场景的交互设计，参与需求讨论，定义人机界面交互框架，输出交互设计方案，并建立用户体验指标、设计规范和体验标准。\", \"responsibilities\": [\"负责参与公司互联网类产品跨端多场景的交互设计\", \"负责参与产品需求讨论，定义人机界面交互框架，输出符合设计原则及用户使用场景的交互设计方案\", \"负责建立产品的用户体验指标和数据分析，以用户为中心，持续优化产品可用性，改善用户体验\", \"负责建立和维护相关的用户体验标准及设计规范，沉淀设计方法\"]}, \"requirements\": {\"must_have\": [\"工业设计、交互设计、计算机、人机交互等相关专业本科及以上学历\", \"熟悉体验设计的基本流程和方法论\", \"具备大局观，逻辑思维能力强\", \"主动性高，具备优秀的理解、沟通与协调能力\", \"具备一定的文字表达能力\", \"富有创造力和激情\", \"热衷于互联网，喜爱动手实践，并乐于尝试不同的产品\"], \"bonus_points\": [], \"nice_to_have\": [\"具备互联网类产品跨端多场景交互设计相关理解或实践经验\", \"具备产品需求讨论、人机界面交互框架定义、交互设计方案输出能力\", \"具备用户体验指标建设、数据分析、产品可用性优化相关理解\", \"具备用户体验标准、设计规范建设和设计方法沉淀相关经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10016,'产品策划','企业发展事业群','深圳总部','产品策划','产品策划','产品','应届实习','实习生','应届实习','在这里，以用户为初心，在这里，做影响亿万用户的产品，下一个伟大，由你开始！','负责产品规划、方案设计、产品策略优化、业务数据监控体系建设、用户需求挖掘、开发进度跟进、上线后反馈分析和持续迭代优化。','负责产品规划、方案设计、产品策略优化、业务数据监控体系建设、用户需求挖掘、开发进度跟进、上线后反馈分析和持续迭代优化。','【必备要求】\n本科或以上学历\n对开发、测试、运营、设计有一定了解\n对互联网产品极度热爱，怀揣做出优秀互联网产品的梦想\n具备敏捷的洞察和思维能力\n具备把思考变为现实以满足用户需求的勇气和能力\n具备优秀的创造力、想象力、逻辑思维与系统分析能力\n具备突出的文字组织能力和沟通能力\n\n【了解项】\n具备产品规划、方案设计、产品策略优化相关理解或实践经验\n具备行业动态分析、市场需求分析、竞争环境分析相关能力\n具备业务数据监控体系建设、实验设计、关键指标分析相关理解\n具备用户反馈分析、产品迭代、跨团队协同相关经验\n\n【加分项】\n开发设计过个人产品并有一定影响\n在全国互联网产品或创业大赛中获得三等奖及以上\n在互联网公司有产品策划或运营工作实习经历\n在实验室或校园技术团队有互联网产品策划项目','[\"负责产品规划和方案设计，持续打磨产品功能和用户体验，提高产品市场竞争力，追求用户体验和商业价值提升\", \"深入了解行业动态、市场需求和竞争环境，评估产品市场表现，优化产品策略\", \"负责构建产品业务数据监控体系，通过实验设计和关键指标分析等手段挖掘用户需求\", \"负责跟进产品开发进度，与设计、研发等团队密切协同，确保产品按计划、高质量上线\", \"收集和分析产品上线后的用户反馈和数据，优化产品功能和用户体验，推动产品持续迭代和优化\"]','[\"本科或以上学历\", \"对开发、测试、运营、设计有一定了解\", \"对互联网产品极度热爱，怀揣做出优秀互联网产品的梦想\", \"具备敏捷的洞察和思维能力\", \"具备把思考变为现实以满足用户需求的勇气和能力\", \"具备优秀的创造力、想象力、逻辑思维与系统分析能力\", \"具备突出的文字组织能力和沟通能力\"]','[\"具备产品规划、方案设计、产品策略优化相关理解或实践经验\", \"具备行业动态分析、市场需求分析、竞争环境分析相关能力\", \"具备业务数据监控体系建设、实验设计、关键指标分析相关理解\", \"具备用户反馈分析、产品迭代、跨团队协同相关经验\"]','[\"开发设计过个人产品并有一定影响\", \"在全国互联网产品或创业大赛中获得三等奖及以上\", \"在互联网公司有产品策划或运营工作实习经历\", \"在实验室或校园技术团队有互联网产品策划项目\"]','null','[\"产品策划\", \"产品规划\", \"方案设计\", \"产品功能设计\", \"用户体验\", \"商业价值\", \"市场竞争力\", \"行业分析\", \"市场需求分析\", \"竞争环境分析\", \"产品策略\", \"业务数据监控\", \"实验设计\", \"关键指标分析\", \"用户需求挖掘\", \"产品开发进度跟进\", \"跨团队协同\", \"用户反馈分析\", \"产品迭代\", \"开发理解\", \"测试理解\", \"运营理解\", \"设计理解\", \"创造力\", \"想象力\", \"逻辑思维\", \"系统分析\", \"文字组织\", \"沟通表达\"]','[\"产品策划\", \"产品规划\", \"方案设计\", \"产品功能设计\", \"用户体验\", \"商业价值\", \"市场竞争力\", \"行业分析\", \"市场需求分析\", \"竞争环境分析\", \"产品策略\", \"业务数据监控\", \"实验设计\", \"关键指标分析\", \"用户需求挖掘\", \"产品开发进度跟进\", \"跨团队协同\", \"用户反馈分析\", \"产品迭代\", \"开发理解\", \"测试理解\", \"运营理解\", \"设计理解\", \"创造力\", \"想象力\", \"逻辑思维\", \"系统分析\", \"文字组织\", \"沟通表达\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-product-planning-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-product-planning-intern-2026-001\", \"title\": \"产品策划\", \"slogan\": \"在这里，以用户为初心，在这里，做影响亿万用户的产品，下一个伟大，由你开始！\", \"status\": \"open\", \"category\": \"产品策划\", \"job_type\": \"产品\", \"direction\": \"产品策划\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"job_type\": \"产品\", \"direction\": \"产品策划\", \"job_category\": \"产品策划\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\", \"S1\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"产品策划\", \"产品规划\", \"方案设计\", \"产品功能设计\", \"用户体验\", \"商业价值\", \"市场竞争力\", \"行业分析\", \"市场需求分析\", \"竞争环境分析\", \"产品策略\", \"业务数据监控\", \"实验设计\", \"关键指标分析\", \"用户需求挖掘\", \"产品开发进度跟进\", \"跨团队协同\", \"用户反馈分析\", \"产品迭代\", \"开发理解\", \"测试理解\", \"运营理解\", \"设计理解\", \"创造力\", \"想象力\", \"逻辑思维\", \"系统分析\", \"文字组织\", \"沟通表达\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"description\": {\"summary\": \"负责产品规划、方案设计、产品策略优化、业务数据监控体系建设、用户需求挖掘、开发进度跟进、上线后反馈分析和持续迭代优化。\", \"responsibilities\": [\"负责产品规划和方案设计，持续打磨产品功能和用户体验，提高产品市场竞争力，追求用户体验和商业价值提升\", \"深入了解行业动态、市场需求和竞争环境，评估产品市场表现，优化产品策略\", \"负责构建产品业务数据监控体系，通过实验设计和关键指标分析等手段挖掘用户需求\", \"负责跟进产品开发进度，与设计、研发等团队密切协同，确保产品按计划、高质量上线\", \"收集和分析产品上线后的用户反馈和数据，优化产品功能和用户体验，推动产品持续迭代和优化\"]}, \"requirements\": {\"must_have\": [\"本科或以上学历\", \"对开发、测试、运营、设计有一定了解\", \"对互联网产品极度热爱，怀揣做出优秀互联网产品的梦想\", \"具备敏捷的洞察和思维能力\", \"具备把思考变为现实以满足用户需求的勇气和能力\", \"具备优秀的创造力、想象力、逻辑思维与系统分析能力\", \"具备突出的文字组织能力和沟通能力\"], \"bonus_points\": [\"开发设计过个人产品并有一定影响\", \"在全国互联网产品或创业大赛中获得三等奖及以上\", \"在互联网公司有产品策划或运营工作实习经历\", \"在实验室或校园技术团队有互联网产品策划项目\"], \"nice_to_have\": [\"具备产品规划、方案设计、产品策略优化相关理解或实践经验\", \"具备行业动态分析、市场需求分析、竞争环境分析相关能力\", \"具备业务数据监控体系建设、实验设计、关键指标分析相关理解\", \"具备用户反馈分析、产品迭代、跨团队协同相关经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10017,'商务拓展','企业发展事业群','深圳总部','商务拓展','商务拓展','市场','应届实习','实习生','应届实习','你是聚焦行业，洞察机遇的观察者，是关注客户，懂他人之所需的好伙伴，是并肩作战，协同拓展业务的老战友，来腾讯，做商务拓展人！','负责细分行业洞察、竞品与市场反馈分析、客情建设、商机拓展、产品与技术价值传递、项目协同推进及客户需求驱动的产品策略优化。','负责细分行业洞察、竞品与市场反馈分析、客情建设、商机拓展、产品与技术价值传递、项目协同推进及客户需求驱动的产品策略优化。','【必备要求】\n综合素质优秀，热爱互联网\n熟悉互联网的主要发展方向和概念，并有敏锐的市场意识\n具有杰出的人际交往技巧\n具备优秀的沟通协调能力及谈判能力\n擅于合作，抗压能力强\n为人正直，工作积极主动\n具备高效的分析和执行能力\n学习能力强，有强烈的责任心\n抱有公司内创业精神\n对自身项目有高度主人翁意识，并时刻保持业务敏感度\n\n【了解项】\n具备行业洞察、市场分析、竞品分析相关理解或实践经验\n具备客情建设、商机拓展、商务谈判、客户需求分析相关经验\n具备跨部门项目推进、产品策略优化或业务支持相关理解','[\"专精自己的细分行业，深度接触行业内各层级、各类型业务，敏锐反馈行业变化，精准找出对应解法\", \"熟悉同类产品业务与自身业务的差异、优劣势，并关注市场对同类产品、自身业务的反馈，从实操角度分析业务未来走向\", \"负责客情建设和商机拓展，传递产品和技术价值，做好业务支持\", \"协同各部门推进项目，实现项目从计划到落地、后期维护的全方位护航\", \"通过对市场和客户需求的分析理解，协助产品改进或导入新产品策略，确保业务竞争力持续提升\"]','[\"综合素质优秀，热爱互联网\", \"熟悉互联网的主要发展方向和概念，并有敏锐的市场意识\", \"具有杰出的人际交往技巧\", \"具备优秀的沟通协调能力及谈判能力\", \"擅于合作，抗压能力强\", \"为人正直，工作积极主动\", \"具备高效的分析和执行能力\", \"学习能力强，有强烈的责任心\", \"抱有公司内创业精神\", \"对自身项目有高度主人翁意识，并时刻保持业务敏感度\"]','[\"具备行业洞察、市场分析、竞品分析相关理解或实践经验\", \"具备客情建设、商机拓展、商务谈判、客户需求分析相关经验\", \"具备跨部门项目推进、产品策略优化或业务支持相关理解\"]','[]','null','[\"商务拓展\", \"行业洞察\", \"市场分析\", \"竞品分析\", \"客户需求分析\", \"客情建设\", \"商机拓展\", \"产品价值传递\", \"技术价值传递\", \"业务支持\", \"项目推进\", \"项目落地\", \"后期维护\", \"产品改进\", \"新产品策略\", \"业务竞争力\", \"市场意识\", \"人际交往\", \"沟通协调\", \"商务谈判\", \"团队合作\", \"抗压能力\", \"分析能力\", \"执行能力\", \"学习能力\", \"责任心\", \"主人翁意识\", \"业务敏感度\"]','[\"商务拓展\", \"行业洞察\", \"市场分析\", \"竞品分析\", \"客户需求分析\", \"客情建设\", \"商机拓展\", \"产品价值传递\", \"技术价值传递\", \"业务支持\", \"项目推进\", \"项目落地\", \"后期维护\", \"产品改进\", \"新产品策略\", \"业务竞争力\", \"市场意识\", \"人际交往\", \"沟通协调\", \"商务谈判\", \"团队合作\", \"抗压能力\", \"分析能力\", \"执行能力\", \"学习能力\", \"责任心\", \"主人翁意识\", \"业务敏感度\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-business-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-business-development-intern-2026-001\", \"title\": \"商务拓展\", \"slogan\": \"你是聚焦行业，洞察机遇的观察者，是关注客户，懂他人之所需的好伙伴，是并肩作战，协同拓展业务的老战友，来腾讯，做商务拓展人！\", \"status\": \"open\", \"category\": \"商务拓展\", \"job_type\": \"市场\", \"direction\": \"商务拓展\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"市场\", \"direction\": \"商务拓展\", \"job_category\": \"商务拓展\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"商务拓展\", \"行业洞察\", \"市场分析\", \"竞品分析\", \"客户需求分析\", \"客情建设\", \"商机拓展\", \"产品价值传递\", \"技术价值传递\", \"业务支持\", \"项目推进\", \"项目落地\", \"后期维护\", \"产品改进\", \"新产品策略\", \"业务竞争力\", \"市场意识\", \"人际交往\", \"沟通协调\", \"商务谈判\", \"团队合作\", \"抗压能力\", \"分析能力\", \"执行能力\", \"学习能力\", \"责任心\", \"主人翁意识\", \"业务敏感度\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责细分行业洞察、竞品与市场反馈分析、客情建设、商机拓展、产品与技术价值传递、项目协同推进及客户需求驱动的产品策略优化。\", \"responsibilities\": [\"专精自己的细分行业，深度接触行业内各层级、各类型业务，敏锐反馈行业变化，精准找出对应解法\", \"熟悉同类产品业务与自身业务的差异、优劣势，并关注市场对同类产品、自身业务的反馈，从实操角度分析业务未来走向\", \"负责客情建设和商机拓展，传递产品和技术价值，做好业务支持\", \"协同各部门推进项目，实现项目从计划到落地、后期维护的全方位护航\", \"通过对市场和客户需求的分析理解，协助产品改进或导入新产品策略，确保业务竞争力持续提升\"]}, \"requirements\": {\"must_have\": [\"综合素质优秀，热爱互联网\", \"熟悉互联网的主要发展方向和概念，并有敏锐的市场意识\", \"具有杰出的人际交往技巧\", \"具备优秀的沟通协调能力及谈判能力\", \"擅于合作，抗压能力强\", \"为人正直，工作积极主动\", \"具备高效的分析和执行能力\", \"学习能力强，有强烈的责任心\", \"抱有公司内创业精神\", \"对自身项目有高度主人翁意识，并时刻保持业务敏感度\"], \"bonus_points\": [], \"nice_to_have\": [\"具备行业洞察、市场分析、竞品分析相关理解或实践经验\", \"具备客情建设、商机拓展、商务谈判、客户需求分析相关经验\", \"具备跨部门项目推进、产品策略优化或业务支持相关理解\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10018,'软件开发-测试开发方向','企业发展事业群','深圳总部','软件开发','测试开发','技术','应届实习','实习生','应届实习','你将一马当先，积极挑战新技术。大量机器与海量进程在你的指挥下井然有序，你就是测试开发的先锋人！','负责测试工具与测试平台开发，覆盖客户端和后台等跨平台项目质量保障、自动化测试工具落地、性能分析、安全漏洞分析、缺陷自动化定位及全流程自动化体系建设。','负责测试工具与测试平台开发，覆盖客户端和后台等跨平台项目质量保障、自动化测试工具落地、性能分析、安全漏洞分析、缺陷自动化定位及全流程自动化体系建设。','【必备要求】\n计算机或相关专业本科及以上学历\n熟练掌握 C/C++、Java、Go、Python、C 等开发语言\n理解操作系统、计算机网络、算法与数据结构等专业知识\n极具专研精神\n具备主动积极的责任心\n具备良好的团队合作精神\n\n【了解项】\n了解图像处理原理或者计算机图形学\n了解网络信息安全知识\n具备测试工具开发、测试平台建设、自动化测试落地相关理解或实践经验\n具备客户端或后台项目质量保障相关理解\n\n【加分项】\n有 Android、iOS 开发经验\n有 Linux 后台开发经验\n有自动化测试工具开发经验\n有客户端性能或者后台性能分析经验','[\"负责开发测试工具与测试平台，帮助更快速和更有效发现缺陷\", \"负责客户端和后台等跨平台项目质量保障，能深入理解项目实现并推进质量持续改进\", \"负责单元测试、接口测试、协议测试、安全测试、后台测试等自动化测试工具的开发和落地执行\", \"负责客户端性能深度分析和后台性能深度分析、安全漏洞分析，并在此基础上实现缺陷的自动化分析与定位\", \"探索前沿技术，并应用到质量保障的各环节，建设全流程自动化体系\"]','[\"计算机或相关专业本科及以上学历\", \"熟练掌握 C/C++、Java、Go、Python、C 等开发语言\", \"理解操作系统、计算机网络、算法与数据结构等专业知识\", \"极具专研精神\", \"具备主动积极的责任心\", \"具备良好的团队合作精神\"]','[\"了解图像处理原理或者计算机图形学\", \"了解网络信息安全知识\", \"具备测试工具开发、测试平台建设、自动化测试落地相关理解或实践经验\", \"具备客户端或后台项目质量保障相关理解\"]','[\"有 Android、iOS 开发经验\", \"有 Linux 后台开发经验\", \"有自动化测试工具开发经验\", \"有客户端性能或者后台性能分析经验\"]','null','[\"测试开发\", \"测试工具开发\", \"测试平台\", \"质量保障\", \"跨平台测试\", \"客户端测试\", \"后台测试\", \"单元测试\", \"接口测试\", \"协议测试\", \"安全测试\", \"自动化测试\", \"性能分析\", \"客户端性能分析\", \"后台性能分析\", \"安全漏洞分析\", \"缺陷分析\", \"缺陷定位\", \"全流程自动化\", \"C\", \"C/C++\", \"Java\", \"Go\", \"Python\", \"操作系统\", \"计算机网络\", \"算法与数据结构\", \"图像处理\", \"计算机图形学\", \"网络信息安全\", \"Android\", \"iOS\", \"Linux后台开发\"]','[\"测试开发\", \"测试工具开发\", \"测试平台\", \"质量保障\", \"跨平台测试\", \"客户端测试\", \"后台测试\", \"单元测试\", \"接口测试\", \"协议测试\", \"安全测试\", \"自动化测试\", \"性能分析\", \"客户端性能分析\", \"后台性能分析\", \"安全漏洞分析\", \"缺陷分析\", \"缺陷定位\", \"全流程自动化\", \"C\", \"C/C++\", \"Java\", \"Go\", \"Python\", \"操作系统\", \"计算机网络\", \"算法与数据结构\", \"图像处理\", \"计算机图形学\", \"网络信息安全\", \"Android\", \"iOS\", \"Linux后台开发\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-test-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-test-development-intern-2026-001\", \"title\": \"软件开发-测试开发方向\", \"slogan\": \"你将一马当先，积极挑战新技术。大量机器与海量进程在你的指挥下井然有序，你就是测试开发的先锋人！\", \"status\": \"open\", \"category\": \"测试开发\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"测试开发\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"测试开发\", \"测试工具开发\", \"测试平台\", \"质量保障\", \"跨平台测试\", \"客户端测试\", \"后台测试\", \"单元测试\", \"接口测试\", \"协议测试\", \"安全测试\", \"自动化测试\", \"性能分析\", \"客户端性能分析\", \"后台性能分析\", \"安全漏洞分析\", \"缺陷分析\", \"缺陷定位\", \"全流程自动化\", \"C\", \"C/C++\", \"Java\", \"Go\", \"Python\", \"操作系统\", \"计算机网络\", \"算法与数据结构\", \"图像处理\", \"计算机图形学\", \"网络信息安全\", \"Android\", \"iOS\", \"Linux后台开发\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"description\": {\"summary\": \"负责测试工具与测试平台开发，覆盖客户端和后台等跨平台项目质量保障、自动化测试工具落地、性能分析、安全漏洞分析、缺陷自动化定位及全流程自动化体系建设。\", \"responsibilities\": [\"负责开发测试工具与测试平台，帮助更快速和更有效发现缺陷\", \"负责客户端和后台等跨平台项目质量保障，能深入理解项目实现并推进质量持续改进\", \"负责单元测试、接口测试、协议测试、安全测试、后台测试等自动化测试工具的开发和落地执行\", \"负责客户端性能深度分析和后台性能深度分析、安全漏洞分析，并在此基础上实现缺陷的自动化分析与定位\", \"探索前沿技术，并应用到质量保障的各环节，建设全流程自动化体系\"]}, \"requirements\": {\"must_have\": [\"计算机或相关专业本科及以上学历\", \"熟练掌握 C/C++、Java、Go、Python、C 等开发语言\", \"理解操作系统、计算机网络、算法与数据结构等专业知识\", \"极具专研精神\", \"具备主动积极的责任心\", \"具备良好的团队合作精神\"], \"bonus_points\": [\"有 Android、iOS 开发经验\", \"有 Linux 后台开发经验\", \"有自动化测试工具开发经验\", \"有客户端性能或者后台性能分析经验\"], \"nice_to_have\": [\"了解图像处理原理或者计算机图形学\", \"了解网络信息安全知识\", \"具备测试工具开发、测试平台建设、自动化测试落地相关理解或实践经验\", \"具备客户端或后台项目质量保障相关理解\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10019,'软件开发-游戏客户端开发方向','互动娱乐事业群','深圳总部','软件开发','游戏客户端开发','技术','应届实习','实习生','应届实习','玩家的一流体验，将是你努力的勋章。性能流畅的游戏客户端，将是你才华的成果。有你稳住，就能赢！','负责游戏客户端框架及功能设计，实现稳定可维护的功能与配套工具链，参与游戏体验技术方案优化，并在网络、性能、音视频、输入输出、下载升级、构建发布等基础技术方向提供解决方案。','负责游戏客户端框架及功能设计，实现稳定可维护的功能与配套工具链，参与游戏体验技术方案优化，并在网络、性能、音视频、输入输出、下载升级、构建发布等基础技术方向提供解决方案。','【必备要求】\n计算机科学、计算机工程相关专业\n熟悉算法、数据结构、操作系统等基础知识\n热爱编程，至少掌握一种游戏开发常用的编程语言\n具备良好的沟通表达能力和团队合作意识\n对于创新和解决有挑战性的问题充满激情\n具备较强的学习能力、分析及解决问题能力\n\n【了解项】\n具备游戏客户端框架设计、功能开发、工具链建设相关理解或实践经验\n具备编辑器、检查机制、性能优化、可测试支持相关理解\n具备网络、音视频、输入输出、下载升级、构建发布相关基础技术理解\n具备 3C、AI 等游戏体验相关技术方案理解\n\n【加分项】\n热爱游戏\n有独立完成一个游戏 Demo 或参与开源游戏开发经验\n有图形、物理等算法基本功','[\"针对产品需求进行框架及功能设计\", \"实现稳定可维护的功能，并提供配套的编辑器、检查机制、性能优化、可测试支持等完整解决方案\", \"与策划一起讨论并提出技术方案，迭代优化游戏细节体验，如 3C、AI 等\", \"在网络、性能优化、音视频、输入输出、下载升级等基础技术上提供解决方案，支撑游戏所需体验\", \"提供构建程序包、发布、版本升级等整套技术，优化整套构建发布效率\"]','[\"计算机科学、计算机工程相关专业\", \"熟悉算法、数据结构、操作系统等基础知识\", \"热爱编程，至少掌握一种游戏开发常用的编程语言\", \"具备良好的沟通表达能力和团队合作意识\", \"对于创新和解决有挑战性的问题充满激情\", \"具备较强的学习能力、分析及解决问题能力\"]','[\"具备游戏客户端框架设计、功能开发、工具链建设相关理解或实践经验\", \"具备编辑器、检查机制、性能优化、可测试支持相关理解\", \"具备网络、音视频、输入输出、下载升级、构建发布相关基础技术理解\", \"具备 3C、AI 等游戏体验相关技术方案理解\"]','[\"热爱游戏\", \"有独立完成一个游戏 Demo 或参与开源游戏开发经验\", \"有图形、物理等算法基本功\"]','null','[\"游戏客户端开发\", \"客户端开发\", \"游戏开发\", \"框架设计\", \"功能设计\", \"功能实现\", \"编辑器开发\", \"检查机制\", \"性能优化\", \"可测试支持\", \"3C\", \"AI\", \"网络\", \"音视频\", \"输入输出\", \"下载升级\", \"构建程序包\", \"版本发布\", \"版本升级\", \"构建发布效率优化\", \"算法\", \"数据结构\", \"操作系统\", \"图形算法\", \"物理算法\", \"游戏Demo\", \"开源游戏开发\", \"沟通表达\", \"团队合作\", \"学习能力\", \"问题分析\", \"问题解决\"]','[\"游戏客户端开发\", \"客户端开发\", \"游戏开发\", \"框架设计\", \"功能设计\", \"功能实现\", \"编辑器开发\", \"检查机制\", \"性能优化\", \"可测试支持\", \"3C\", \"AI\", \"网络\", \"音视频\", \"输入输出\", \"下载升级\", \"构建程序包\", \"版本发布\", \"版本升级\", \"构建发布效率优化\", \"算法\", \"数据结构\", \"操作系统\", \"图形算法\", \"物理算法\", \"游戏Demo\", \"开源游戏开发\", \"沟通表达\", \"团队合作\", \"学习能力\", \"问题分析\", \"问题解决\"]','[{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"杭州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-game-client-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-game-client-development-intern-2026-001\", \"title\": \"软件开发-游戏客户端开发方向\", \"slogan\": \"玩家的一流体验，将是你努力的勋章。性能流畅的游戏客户端，将是你才华的成果。有你稳住，就能赢！\", \"status\": \"open\", \"category\": \"游戏客户端开发\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"杭州\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"游戏客户端开发\", \"business_groups\": [\"IEG\", \"TEG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"游戏客户端开发\", \"客户端开发\", \"游戏开发\", \"框架设计\", \"功能设计\", \"功能实现\", \"编辑器开发\", \"检查机制\", \"性能优化\", \"可测试支持\", \"3C\", \"AI\", \"网络\", \"音视频\", \"输入输出\", \"下载升级\", \"构建程序包\", \"版本发布\", \"版本升级\", \"构建发布效率优化\", \"算法\", \"数据结构\", \"操作系统\", \"图形算法\", \"物理算法\", \"游戏Demo\", \"开源游戏开发\", \"沟通表达\", \"团队合作\", \"学习能力\", \"问题分析\", \"问题解决\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"杭州\"], \"description\": {\"summary\": \"负责游戏客户端框架及功能设计，实现稳定可维护的功能与配套工具链，参与游戏体验技术方案优化，并在网络、性能、音视频、输入输出、下载升级、构建发布等基础技术方向提供解决方案。\", \"responsibilities\": [\"针对产品需求进行框架及功能设计\", \"实现稳定可维护的功能，并提供配套的编辑器、检查机制、性能优化、可测试支持等完整解决方案\", \"与策划一起讨论并提出技术方案，迭代优化游戏细节体验，如 3C、AI 等\", \"在网络、性能优化、音视频、输入输出、下载升级等基础技术上提供解决方案，支撑游戏所需体验\", \"提供构建程序包、发布、版本升级等整套技术，优化整套构建发布效率\"]}, \"requirements\": {\"must_have\": [\"计算机科学、计算机工程相关专业\", \"熟悉算法、数据结构、操作系统等基础知识\", \"热爱编程，至少掌握一种游戏开发常用的编程语言\", \"具备良好的沟通表达能力和团队合作意识\", \"对于创新和解决有挑战性的问题充满激情\", \"具备较强的学习能力、分析及解决问题能力\"], \"bonus_points\": [\"热爱游戏\", \"有独立完成一个游戏 Demo 或参与开源游戏开发经验\", \"有图形、物理等算法基本功\"], \"nice_to_have\": [\"具备游戏客户端框架设计、功能开发、工具链建设相关理解或实践经验\", \"具备编辑器、检查机制、性能优化、可测试支持相关理解\", \"具备网络、音视频、输入输出、下载升级、构建发布相关基础技术理解\", \"具备 3C、AI 等游戏体验相关技术方案理解\"]}, \"organizations\": [{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10020,'软件开发-游戏引擎开发方向','互动娱乐事业群','深圳总部','软件开发','游戏引擎开发','技术','应届实习','实习生','应届实习','你将探索 AI 与引擎的深度融合，优化打磨前沿技术，攻克渲染、动画等难题，好的游戏与次世代体验，离不开你！','负责游戏引擎模块和工具链研发，探索 AI 技术在游戏引擎中的深度应用，覆盖下一代图形渲染、物理动画底座、智能化工具链、跨平台架构与极限性能优化等方向。','负责游戏引擎模块和工具链研发，探索 AI 技术在游戏引擎中的深度应用，覆盖下一代图形渲染、物理动画底座、智能化工具链、跨平台架构与极限性能优化等方向。','【必备要求】\n计算机科学、计算机工程、应用数学等相关专业\n深入理解数据结构、算法、操作系统与计算机体系结构\n热爱编程，至少熟练掌握一种游戏开发常用的编程语言，如 C++、C# 等\n具备优秀的系统编程素养\n对图形学、物理仿真、计算机动画、引擎架构或游戏 AI 等某一领域比较熟悉\n熟悉或了解 Unreal、Unity 等主流商业引擎的架构与运作机制\n具备良好的数学功底\n具备英文学术或技术文档阅读能力\n具备良好的沟通表达能力和团队合作意识\n热爱游戏，对于创新和解决极具挑战性的硬核问题充满激情\n具备极强的学习、分析及解决问题能力\n\n【了解项】\n具备游戏引擎模块研发、工具链研发相关理解或实践经验\n熟悉核心渲染管线、图形算法、实时渲染相关技术\n熟悉神经渲染、AI 超分、光线追踪等图形学与 AI 交叉方向\n熟悉碰撞检测、实时物理仿真、物理驱动动画、角色行为系统相关技术\n具备资源管线、引擎编辑器、AIGC 工具流、PCG 工具流相关理解\n具备跨平台架构设计、操作系统底层、硬件底层、性能优化相关理解\n\n【加分项】\n拥有丰富的 C/C++ 深入开发和复杂系统性能调试经验\n熟练使用 CodeBuddy、Codex、Claude Code 等工具，能驾驭 AI 产出高质量的工业级系统代码','[\"负责引擎模块以及工具链部分的研发，探索 AI 技术在游戏引擎中的深度应用\", \"迭代核心渲染管线与图形算法，打磨极致的光影效果\", \"探索前沿图形学与 AI 的交叉领域，如神经渲染、AI 超分、光线追踪在实时渲染中的落地\", \"研发高拟真的碰撞检测与实时物理仿真\", \"探索结合机器学习的物理驱动动画与角色行为系统\", \"构建高效的资源管线\", \"推动 AIGC 能力与引擎编辑器的深度结合，打造加速美术生产与 PCG 的智能化工具流\", \"深入操作系统与硬件底层，负责跨平台架构设计与极限性能优化\", \"保持对学术界和工业界最新技术的敏锐嗅觉，将其转化为引擎的实际生产力\"]','[\"计算机科学、计算机工程、应用数学等相关专业\", \"深入理解数据结构、算法、操作系统与计算机体系结构\", \"热爱编程，至少熟练掌握一种游戏开发常用的编程语言，如 C++、C# 等\", \"具备优秀的系统编程素养\", \"对图形学、物理仿真、计算机动画、引擎架构或游戏 AI 等某一领域比较熟悉\", \"熟悉或了解 Unreal、Unity 等主流商业引擎的架构与运作机制\", \"具备良好的数学功底\", \"具备英文学术或技术文档阅读能力\", \"具备良好的沟通表达能力和团队合作意识\", \"热爱游戏，对于创新和解决极具挑战性的硬核问题充满激情\", \"具备极强的学习、分析及解决问题能力\"]','[\"具备游戏引擎模块研发、工具链研发相关理解或实践经验\", \"熟悉核心渲染管线、图形算法、实时渲染相关技术\", \"熟悉神经渲染、AI 超分、光线追踪等图形学与 AI 交叉方向\", \"熟悉碰撞检测、实时物理仿真、物理驱动动画、角色行为系统相关技术\", \"具备资源管线、引擎编辑器、AIGC 工具流、PCG 工具流相关理解\", \"具备跨平台架构设计、操作系统底层、硬件底层、性能优化相关理解\"]','[\"拥有丰富的 C/C++ 深入开发和复杂系统性能调试经验\", \"熟练使用 CodeBuddy、Codex、Claude Code 等工具，能驾驭 AI 产出高质量的工业级系统代码\"]','null','[\"游戏引擎开发\", \"引擎模块研发\", \"工具链研发\", \"AI引擎融合\", \"图形学\", \"渲染管线\", \"图形算法\", \"实时渲染\", \"神经渲染\", \"AI超分\", \"光线追踪\", \"物理仿真\", \"碰撞检测\", \"计算机动画\", \"物理驱动动画\", \"角色行为系统\", \"资源管线\", \"AIGC\", \"引擎编辑器\", \"PCG\", \"智能化工具流\", \"跨平台架构\", \"极限性能优化\", \"操作系统\", \"硬件底层\", \"数据结构\", \"算法\", \"计算机体系结构\", \"系统编程\", \"C++\", \"C#\", \"C/C++\", \"Unreal\", \"Unity\", \"游戏AI\", \"数学基础\", \"英文技术文档阅读\", \"CodeBuddy\", \"Codex\", \"Claude Code\", \"复杂系统性能调试\", \"沟通表达\", \"团队合作\", \"问题分析\", \"问题解决\"]','[\"游戏引擎开发\", \"引擎模块研发\", \"工具链研发\", \"AI引擎融合\", \"图形学\", \"渲染管线\", \"图形算法\", \"实时渲染\", \"神经渲染\", \"AI超分\", \"光线追踪\", \"物理仿真\", \"碰撞检测\", \"计算机动画\", \"物理驱动动画\", \"角色行为系统\", \"资源管线\", \"AIGC\", \"引擎编辑器\", \"PCG\", \"智能化工具流\", \"跨平台架构\", \"极限性能优化\", \"操作系统\", \"硬件底层\", \"数据结构\", \"算法\", \"计算机体系结构\", \"系统编程\", \"C++\", \"C#\", \"C/C++\", \"Unreal\", \"Unity\", \"游戏AI\", \"数学基础\", \"英文技术文档阅读\", \"CodeBuddy\", \"Codex\", \"Claude Code\", \"复杂系统性能调试\", \"沟通表达\", \"团队合作\", \"问题分析\", \"问题解决\"]','[{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"杭州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-game-engine-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-game-engine-development-intern-2026-001\", \"title\": \"软件开发-游戏引擎开发方向\", \"slogan\": \"你将探索 AI 与引擎的深度融合，优化打磨前沿技术，攻克渲染、动画等难题，好的游戏与次世代体验，离不开你！\", \"status\": \"open\", \"category\": \"游戏引擎开发\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"杭州\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"游戏引擎开发\", \"business_groups\": [\"IEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"游戏引擎开发\", \"引擎模块研发\", \"工具链研发\", \"AI引擎融合\", \"图形学\", \"渲染管线\", \"图形算法\", \"实时渲染\", \"神经渲染\", \"AI超分\", \"光线追踪\", \"物理仿真\", \"碰撞检测\", \"计算机动画\", \"物理驱动动画\", \"角色行为系统\", \"资源管线\", \"AIGC\", \"引擎编辑器\", \"PCG\", \"智能化工具流\", \"跨平台架构\", \"极限性能优化\", \"操作系统\", \"硬件底层\", \"数据结构\", \"算法\", \"计算机体系结构\", \"系统编程\", \"C++\", \"C#\", \"C/C++\", \"Unreal\", \"Unity\", \"游戏AI\", \"数学基础\", \"英文技术文档阅读\", \"CodeBuddy\", \"Codex\", \"Claude Code\", \"复杂系统性能调试\", \"沟通表达\", \"团队合作\", \"问题分析\", \"问题解决\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"杭州\"], \"description\": {\"summary\": \"负责游戏引擎模块和工具链研发，探索 AI 技术在游戏引擎中的深度应用，覆盖下一代图形渲染、物理动画底座、智能化工具链、跨平台架构与极限性能优化等方向。\", \"responsibilities\": [\"负责引擎模块以及工具链部分的研发，探索 AI 技术在游戏引擎中的深度应用\", \"迭代核心渲染管线与图形算法，打磨极致的光影效果\", \"探索前沿图形学与 AI 的交叉领域，如神经渲染、AI 超分、光线追踪在实时渲染中的落地\", \"研发高拟真的碰撞检测与实时物理仿真\", \"探索结合机器学习的物理驱动动画与角色行为系统\", \"构建高效的资源管线\", \"推动 AIGC 能力与引擎编辑器的深度结合，打造加速美术生产与 PCG 的智能化工具流\", \"深入操作系统与硬件底层，负责跨平台架构设计与极限性能优化\", \"保持对学术界和工业界最新技术的敏锐嗅觉，将其转化为引擎的实际生产力\"]}, \"requirements\": {\"must_have\": [\"计算机科学、计算机工程、应用数学等相关专业\", \"深入理解数据结构、算法、操作系统与计算机体系结构\", \"热爱编程，至少熟练掌握一种游戏开发常用的编程语言，如 C++、C# 等\", \"具备优秀的系统编程素养\", \"对图形学、物理仿真、计算机动画、引擎架构或游戏 AI 等某一领域比较熟悉\", \"熟悉或了解 Unreal、Unity 等主流商业引擎的架构与运作机制\", \"具备良好的数学功底\", \"具备英文学术或技术文档阅读能力\", \"具备良好的沟通表达能力和团队合作意识\", \"热爱游戏，对于创新和解决极具挑战性的硬核问题充满激情\", \"具备极强的学习、分析及解决问题能力\"], \"bonus_points\": [\"拥有丰富的 C/C++ 深入开发和复杂系统性能调试经验\", \"熟练使用 CodeBuddy、Codex、Claude Code 等工具，能驾驭 AI 产出高质量的工业级系统代码\"], \"nice_to_have\": [\"具备游戏引擎模块研发、工具链研发相关理解或实践经验\", \"熟悉核心渲染管线、图形算法、实时渲染相关技术\", \"熟悉神经渲染、AI 超分、光线追踪等图形学与 AI 交叉方向\", \"熟悉碰撞检测、实时物理仿真、物理驱动动画、角色行为系统相关技术\", \"具备资源管线、引擎编辑器、AIGC 工具流、PCG 工具流相关理解\", \"具备跨平台架构设计、操作系统底层、硬件底层、性能优化相关理解\"]}, \"organizations\": [{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10021,'算法-推荐算法方向','企业发展事业群','深圳总部','算法','推荐算法','技术','应届实习','实习生','应届实习','对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！','负责推荐系统中召回、排序等模型算法及策略设计与优化，结合业务场景和数据洞察持续提升用户体验与业务指标，并探索推荐多模态大模型、图神经网络、多任务学习、超长序列建模、强化学习等前沿推荐技术。','负责推荐系统中召回、排序等模型算法及策略设计与优化，结合业务场景和数据洞察持续提升用户体验与业务指标，并探索推荐多模态大模型、图神经网络、多任务学习、超长序列建模、强化学习等前沿推荐技术。','【必备要求】\n本科及以上学历，计算机、数学、人工智能等相关专业\n具备扎实的编程能力和算法功底\n熟练掌握 Python、C++、Java 等至少一种编程语言\n具备扎实的机器学习和深度学习理论基础\n熟练掌握 TensorFlow、PyTorch 等至少一种主流深度学习框架\n了解 Hadoop、Spark、Flink 等大数据平台工具的使用\n具备优秀的逻辑思维能力\n具备优秀的分析问题与解决问题的能力\n对解决具有挑战性问题充满激情\n善于沟通，工作积极主动，责任心强，自驱力强，能持续学习\n具备良好的团队协作能力\n\n【了解项】\n具备推荐系统召回、排序、策略优化相关理解或实践经验\n具备大规模深度神经网络模型、机器学习系统相关理解\n熟悉推荐多模态大模型、图神经网络、多任务学习、超长序列建模、强化学习等方向\n具备大数据平台 Hadoop、Spark、Flink 使用经验\n\n【加分项】\n在顶级学术会议或期刊发表论文\n在 ACM 编程竞赛、机器学习等竞赛中获奖\n有大规模推荐系统、计算广告、搜索引擎等核心算法项目经验','[\"负责推荐系统中具体推荐业务的召回、排序等模型算法及策略的设计与优化\", \"深入理解业务场景，通过对数据的敏锐洞察挖掘产品潜在价值和需求\", \"针对现有业务场景特点优化推荐策略和模型，不断提升用户体验和业务指标\", \"基于超大规模深度神经网络模型和机器学习系统，探索业界前沿推荐技术研发工作\", \"通过技术创新推动产品成长，方向包括但不限于推荐多模态大模型、图神经网络、多任务学习、超长序列建模、强化学习等\"]','[\"本科及以上学历，计算机、数学、人工智能等相关专业\", \"具备扎实的编程能力和算法功底\", \"熟练掌握 Python、C++、Java 等至少一种编程语言\", \"具备扎实的机器学习和深度学习理论基础\", \"熟练掌握 TensorFlow、PyTorch 等至少一种主流深度学习框架\", \"了解 Hadoop、Spark、Flink 等大数据平台工具的使用\", \"具备优秀的逻辑思维能力\", \"具备优秀的分析问题与解决问题的能力\", \"对解决具有挑战性问题充满激情\", \"善于沟通，工作积极主动，责任心强，自驱力强，能持续学习\", \"具备良好的团队协作能力\"]','[\"具备推荐系统召回、排序、策略优化相关理解或实践经验\", \"具备大规模深度神经网络模型、机器学习系统相关理解\", \"熟悉推荐多模态大模型、图神经网络、多任务学习、超长序列建模、强化学习等方向\", \"具备大数据平台 Hadoop、Spark、Flink 使用经验\"]','[\"在顶级学术会议或期刊发表论文\", \"在 ACM 编程竞赛、机器学习等竞赛中获奖\", \"有大规模推荐系统、计算广告、搜索引擎等核心算法项目经验\"]','null','[\"推荐算法\", \"推荐系统\", \"召回\", \"排序\", \"推荐策略\", \"模型优化\", \"机器学习\", \"深度学习\", \"超大规模深度神经网络\", \"机器学习系统\", \"推荐多模态大模型\", \"图神经网络\", \"多任务学习\", \"超长序列建模\", \"强化学习\", \"数据洞察\", \"用户体验优化\", \"业务指标优化\", \"Python\", \"C++\", \"Java\", \"TensorFlow\", \"PyTorch\", \"Hadoop\", \"Spark\", \"Flink\", \"大规模推荐系统\", \"计算广告\", \"搜索引擎\", \"算法功底\", \"逻辑思维\", \"问题分析\", \"问题解决\", \"沟通表达\", \"团队协作\"]','[\"推荐算法\", \"推荐系统\", \"召回\", \"排序\", \"推荐策略\", \"模型优化\", \"机器学习\", \"深度学习\", \"超大规模深度神经网络\", \"机器学习系统\", \"推荐多模态大模型\", \"图神经网络\", \"多任务学习\", \"超长序列建模\", \"强化学习\", \"数据洞察\", \"用户体验优化\", \"业务指标优化\", \"Python\", \"C++\", \"Java\", \"TensorFlow\", \"PyTorch\", \"Hadoop\", \"Spark\", \"Flink\", \"大规模推荐系统\", \"计算广告\", \"搜索引擎\", \"算法功底\", \"逻辑思维\", \"问题分析\", \"问题解决\", \"沟通表达\", \"团队协作\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-algorithm-recommendation-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-algorithm-recommendation-intern-2026-001\", \"title\": \"算法-推荐算法方向\", \"slogan\": \"对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！\", \"status\": \"open\", \"category\": \"推荐算法\", \"job_type\": \"技术\", \"direction\": \"算法\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"算法\", \"job_category\": \"推荐算法\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"推荐算法\", \"推荐系统\", \"召回\", \"排序\", \"推荐策略\", \"模型优化\", \"机器学习\", \"深度学习\", \"超大规模深度神经网络\", \"机器学习系统\", \"推荐多模态大模型\", \"图神经网络\", \"多任务学习\", \"超长序列建模\", \"强化学习\", \"数据洞察\", \"用户体验优化\", \"业务指标优化\", \"Python\", \"C++\", \"Java\", \"TensorFlow\", \"PyTorch\", \"Hadoop\", \"Spark\", \"Flink\", \"大规模推荐系统\", \"计算广告\", \"搜索引擎\", \"算法功底\", \"逻辑思维\", \"问题分析\", \"问题解决\", \"沟通表达\", \"团队协作\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责推荐系统中召回、排序等模型算法及策略设计与优化，结合业务场景和数据洞察持续提升用户体验与业务指标，并探索推荐多模态大模型、图神经网络、多任务学习、超长序列建模、强化学习等前沿推荐技术。\", \"responsibilities\": [\"负责推荐系统中具体推荐业务的召回、排序等模型算法及策略的设计与优化\", \"深入理解业务场景，通过对数据的敏锐洞察挖掘产品潜在价值和需求\", \"针对现有业务场景特点优化推荐策略和模型，不断提升用户体验和业务指标\", \"基于超大规模深度神经网络模型和机器学习系统，探索业界前沿推荐技术研发工作\", \"通过技术创新推动产品成长，方向包括但不限于推荐多模态大模型、图神经网络、多任务学习、超长序列建模、强化学习等\"]}, \"requirements\": {\"must_have\": [\"本科及以上学历，计算机、数学、人工智能等相关专业\", \"具备扎实的编程能力和算法功底\", \"熟练掌握 Python、C++、Java 等至少一种编程语言\", \"具备扎实的机器学习和深度学习理论基础\", \"熟练掌握 TensorFlow、PyTorch 等至少一种主流深度学习框架\", \"了解 Hadoop、Spark、Flink 等大数据平台工具的使用\", \"具备优秀的逻辑思维能力\", \"具备优秀的分析问题与解决问题的能力\", \"对解决具有挑战性问题充满激情\", \"善于沟通，工作积极主动，责任心强，自驱力强，能持续学习\", \"具备良好的团队协作能力\"], \"bonus_points\": [\"在顶级学术会议或期刊发表论文\", \"在 ACM 编程竞赛、机器学习等竞赛中获奖\", \"有大规模推荐系统、计算广告、搜索引擎等核心算法项目经验\"], \"nice_to_have\": [\"具备推荐系统召回、排序、策略优化相关理解或实践经验\", \"具备大规模深度神经网络模型、机器学习系统相关理解\", \"熟悉推荐多模态大模型、图神经网络、多任务学习、超长序列建模、强化学习等方向\", \"具备大数据平台 Hadoop、Spark、Flink 使用经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10022,'算法-数据科学方向','企业发展事业群','深圳总部','算法','数据科学','技术','应届实习','实习生','应届实习','对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！','负责海量数据场景下的业务数据分析、数据模型构建、指标体系和分析体系建设，通过实验科学、因果推断、用户画像、特征工程等方法驱动业务增长，并跟进广告、推荐、NLP、复杂网络等领域前沿技术落地。','负责海量数据场景下的业务数据分析、数据模型构建、指标体系和分析体系建设，通过实验科学、因果推断、用户画像、特征工程等方法驱动业务增长，并跟进广告、推荐、NLP、复杂网络等领域前沿技术落地。','【必备要求】\n本科以上学历，数学、统计、运筹学、计算机、经济学、通信等相关专业\n具备严谨的逻辑思维能力和扎实的数理专业知识基础\n掌握常见的统计分析、实验设计、机器学习等领域的基础理论\n具备优秀的编码能力\n具备扎实的数据结构和算法功底\n熟练掌握至少一种编程语言，如 Java、Scala、C++、R、Python 等\n熟悉大数据基础工具的使用，能处理较大规模的数据\n具备优秀的分析问题和解决问题的能力\n对解决具有挑战性问题充满激情\n熟悉机器学习、自然语言处理、数据挖掘中一项或多项\n沟通表达清晰\n具备高效的协作能力\n积极主动，自驱力强\n思维严谨、系统，具备批判性思维\n\n【了解项】\n具备机器学习、自然语言处理、数据挖掘相关实践项目经验者优先\n具备业务数据分析、数据模型构建、指标体系建设相关理解或实践经验\n具备实验设计、因果推断、策略评估相关理解或实践经验\n具备用户画像、特征工程、线上数据服务优化相关理解\n熟悉广告、推荐、NLP、复杂网络等一个或多个方向\n\n【加分项】\n在相关领域的顶会或核心刊物上发表过高水平论文\n有相关实习经历\n在业界公认的主流竞赛中取得过排名靠前的比赛成绩','[\"基于海量数据场景，参与业务数据分析及数据模型构建，驱动业务增长\", \"负责规划和搭建业务数据指标体系和分析体系，建设智能决策方法论，寻找业务收入增长点\", \"通过实验科学、因果推断等方法验证评估策略的效果和价值\", \"建设用户画像、构建特征工程实施方案，不断优化和改进数据模型，提升线上数据服务效果\", \"跟进业界最新的广告、推荐、NLP、复杂网络等领域进展，快速实现并应用于实际任务中\"]','[\"本科以上学历，数学、统计、运筹学、计算机、经济学、通信等相关专业\", \"具备严谨的逻辑思维能力和扎实的数理专业知识基础\", \"掌握常见的统计分析、实验设计、机器学习等领域的基础理论\", \"具备优秀的编码能力\", \"具备扎实的数据结构和算法功底\", \"熟练掌握至少一种编程语言，如 Java、Scala、C++、R、Python 等\", \"熟悉大数据基础工具的使用，能处理较大规模的数据\", \"具备优秀的分析问题和解决问题的能力\", \"对解决具有挑战性问题充满激情\", \"熟悉机器学习、自然语言处理、数据挖掘中一项或多项\", \"沟通表达清晰\", \"具备高效的协作能力\", \"积极主动，自驱力强\", \"思维严谨、系统，具备批判性思维\"]','[\"具备机器学习、自然语言处理、数据挖掘相关实践项目经验者优先\", \"具备业务数据分析、数据模型构建、指标体系建设相关理解或实践经验\", \"具备实验设计、因果推断、策略评估相关理解或实践经验\", \"具备用户画像、特征工程、线上数据服务优化相关理解\", \"熟悉广告、推荐、NLP、复杂网络等一个或多个方向\"]','[\"在相关领域的顶会或核心刊物上发表过高水平论文\", \"有相关实习经历\", \"在业界公认的主流竞赛中取得过排名靠前的比赛成绩\"]','null','[\"数据科学\", \"业务数据分析\", \"数据模型\", \"指标体系\", \"分析体系\", \"智能决策\", \"业务增长\", \"实验科学\", \"实验设计\", \"因果推断\", \"策略评估\", \"用户画像\", \"特征工程\", \"数据服务优化\", \"统计分析\", \"机器学习\", \"深度学习\", \"自然语言处理\", \"数据挖掘\", \"广告算法\", \"推荐算法\", \"复杂网络\", \"Java\", \"Scala\", \"C++\", \"R\", \"Python\", \"大数据工具\", \"数据结构\", \"算法\", \"数学\", \"统计学\", \"运筹学\", \"经济学\", \"通信\", \"逻辑思维\", \"批判性思维\", \"问题分析\", \"问题解决\", \"沟通表达\", \"团队协作\"]','[\"数据科学\", \"业务数据分析\", \"数据模型\", \"指标体系\", \"分析体系\", \"智能决策\", \"业务增长\", \"实验科学\", \"实验设计\", \"因果推断\", \"策略评估\", \"用户画像\", \"特征工程\", \"数据服务优化\", \"统计分析\", \"机器学习\", \"深度学习\", \"自然语言处理\", \"数据挖掘\", \"广告算法\", \"推荐算法\", \"复杂网络\", \"Java\", \"Scala\", \"C++\", \"R\", \"Python\", \"大数据工具\", \"数据结构\", \"算法\", \"数学\", \"统计学\", \"运筹学\", \"经济学\", \"通信\", \"逻辑思维\", \"批判性思维\", \"问题分析\", \"问题解决\", \"沟通表达\", \"团队协作\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-algorithm-data-science-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-algorithm-data-science-intern-2026-001\", \"title\": \"算法-数据科学方向\", \"slogan\": \"对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！\", \"status\": \"open\", \"category\": \"数据科学\", \"job_type\": \"技术\", \"direction\": \"算法\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"job_type\": \"技术\", \"direction\": \"算法\", \"job_category\": \"数据科学\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"数据科学\", \"业务数据分析\", \"数据模型\", \"指标体系\", \"分析体系\", \"智能决策\", \"业务增长\", \"实验科学\", \"实验设计\", \"因果推断\", \"策略评估\", \"用户画像\", \"特征工程\", \"数据服务优化\", \"统计分析\", \"机器学习\", \"深度学习\", \"自然语言处理\", \"数据挖掘\", \"广告算法\", \"推荐算法\", \"复杂网络\", \"Java\", \"Scala\", \"C++\", \"R\", \"Python\", \"大数据工具\", \"数据结构\", \"算法\", \"数学\", \"统计学\", \"运筹学\", \"经济学\", \"通信\", \"逻辑思维\", \"批判性思维\", \"问题分析\", \"问题解决\", \"沟通表达\", \"团队协作\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"description\": {\"summary\": \"负责海量数据场景下的业务数据分析、数据模型构建、指标体系和分析体系建设，通过实验科学、因果推断、用户画像、特征工程等方法驱动业务增长，并跟进广告、推荐、NLP、复杂网络等领域前沿技术落地。\", \"responsibilities\": [\"基于海量数据场景，参与业务数据分析及数据模型构建，驱动业务增长\", \"负责规划和搭建业务数据指标体系和分析体系，建设智能决策方法论，寻找业务收入增长点\", \"通过实验科学、因果推断等方法验证评估策略的效果和价值\", \"建设用户画像、构建特征工程实施方案，不断优化和改进数据模型，提升线上数据服务效果\", \"跟进业界最新的广告、推荐、NLP、复杂网络等领域进展，快速实现并应用于实际任务中\"]}, \"requirements\": {\"must_have\": [\"本科以上学历，数学、统计、运筹学、计算机、经济学、通信等相关专业\", \"具备严谨的逻辑思维能力和扎实的数理专业知识基础\", \"掌握常见的统计分析、实验设计、机器学习等领域的基础理论\", \"具备优秀的编码能力\", \"具备扎实的数据结构和算法功底\", \"熟练掌握至少一种编程语言，如 Java、Scala、C++、R、Python 等\", \"熟悉大数据基础工具的使用，能处理较大规模的数据\", \"具备优秀的分析问题和解决问题的能力\", \"对解决具有挑战性问题充满激情\", \"熟悉机器学习、自然语言处理、数据挖掘中一项或多项\", \"沟通表达清晰\", \"具备高效的协作能力\", \"积极主动，自驱力强\", \"思维严谨、系统，具备批判性思维\"], \"bonus_points\": [\"在相关领域的顶会或核心刊物上发表过高水平论文\", \"有相关实习经历\", \"在业界公认的主流竞赛中取得过排名靠前的比赛成绩\"], \"nice_to_have\": [\"具备机器学习、自然语言处理、数据挖掘相关实践项目经验者优先\", \"具备业务数据分析、数据模型构建、指标体系建设相关理解或实践经验\", \"具备实验设计、因果推断、策略评估相关理解或实践经验\", \"具备用户画像、特征工程、线上数据服务优化相关理解\", \"熟悉广告、推荐、NLP、复杂网络等一个或多个方向\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10023,'软件开发-数据工程','企业发展事业群','深圳总部','软件开发','数据工程','技术','应届实习','实习生','应届实习','你相信数据的力量！海量数据无疑是你的梦想乐园！你将发现海量用户背后的洞察，让数据引导产品的前进方向！','负责数据平台及工具研发与优化、数据处理、数仓建设、数据治理等工作，利用数据辅助产品运营决策，并为产品迭代、数据科学和算法研究提供工程支持。','负责数据平台及工具研发与优化、数据处理、数仓建设、数据治理等工作，利用数据辅助产品运营决策，并为产品迭代、数据科学和算法研究提供工程支持。','【必备要求】\n本科以上学历，数学、统计、运筹学、计算机等相关专业\n了解至少一种大数据常用组件及技术，如 MapReduce、Spark、Flink、TensorFlow 等\n熟悉至少一种编程语言，如 Java、C++、Python、Shell 等\n熟练掌握 SQL 及其性能优化\n能够清晰沟通表达，具备对事物完成抽象与概述的能力\n具备逻辑推理思维和分析问题能力\n热爱数据领域，面对技术难点，能主动学习相关知识\n\n【了解项】\n具备数据平台、数据工具、大数据基础组件研发相关理解或实践经验\n具备数据处理、数据清洗、数据转换、数据集成、数据建模相关理解或实践经验\n具备数据仓库建设、数据治理、数据质量优化相关理解\n具备业务数据需求交付、数据解决方案设计、数据资产价值挖掘相关经验\n熟悉常见 ETL 工具和流程\n\n【加分项】\n在相关领域的顶会或核心刊物上发表过高水平论文\n有相关实习经历，并具有数据仓库、数据处理项目经验\n对数据仓库理论和数据建模有深入理解\n熟悉常见的 ETL 工具和流程\n在 GitHub 上参与过开源项目并做出过代码贡献\n在业界公认的主流竞赛中取得过排名靠前的比赛成绩','[\"建设和优化常用的大数据基础组件及平台，提升数据团队整体的海量数据处理能力和处理效率\", \"通过建设数据平台及工具，降低业务团队使用海量数据的门槛\", \"与业务团队紧密合作，理解业务需求，设计并实现高效、可扩展的数据解决方案\", \"承接业务直接的数据需求交付\", \"对数据进行清洗、转换、集成和建模，为产品迭代、数据科学、算法研究等提供系统化的工程支持，达到工业界应用的工程水平\", \"通过技术和机制进行数据治理工作，提升数据质量，优化数据处理流程和数据质量\", \"确保数据的准确性和一致性，建设工具流程保障数据合规，挖掘数据资产价值\"]','[\"本科以上学历，数学、统计、运筹学、计算机等相关专业\", \"了解至少一种大数据常用组件及技术，如 MapReduce、Spark、Flink、TensorFlow 等\", \"熟悉至少一种编程语言，如 Java、C++、Python、Shell 等\", \"熟练掌握 SQL 及其性能优化\", \"能够清晰沟通表达，具备对事物完成抽象与概述的能力\", \"具备逻辑推理思维和分析问题能力\", \"热爱数据领域，面对技术难点，能主动学习相关知识\"]','[\"具备数据平台、数据工具、大数据基础组件研发相关理解或实践经验\", \"具备数据处理、数据清洗、数据转换、数据集成、数据建模相关理解或实践经验\", \"具备数据仓库建设、数据治理、数据质量优化相关理解\", \"具备业务数据需求交付、数据解决方案设计、数据资产价值挖掘相关经验\", \"熟悉常见 ETL 工具和流程\"]','[\"在相关领域的顶会或核心刊物上发表过高水平论文\", \"有相关实习经历，并具有数据仓库、数据处理项目经验\", \"对数据仓库理论和数据建模有深入理解\", \"熟悉常见的 ETL 工具和流程\", \"在 GitHub 上参与过开源项目并做出过代码贡献\", \"在业界公认的主流竞赛中取得过排名靠前的比赛成绩\"]','null','[\"数据工程\", \"数据平台\", \"数据工具研发\", \"大数据基础组件\", \"海量数据处理\", \"数据处理效率优化\", \"数据解决方案\", \"数据需求交付\", \"数据清洗\", \"数据转换\", \"数据集成\", \"数据建模\", \"数据仓库\", \"数仓建设\", \"数据治理\", \"数据质量\", \"数据准确性\", \"数据一致性\", \"数据合规\", \"数据资产\", \"ETL\", \"MapReduce\", \"Spark\", \"Flink\", \"TensorFlow\", \"SQL\", \"SQL性能优化\", \"Java\", \"C++\", \"Python\", \"Shell\", \"数学\", \"统计学\", \"运筹学\", \"计算机\", \"逻辑推理\", \"问题分析\", \"沟通表达\", \"抽象概述能力\"]','[\"数据工程\", \"数据平台\", \"数据工具研发\", \"大数据基础组件\", \"海量数据处理\", \"数据处理效率优化\", \"数据解决方案\", \"数据需求交付\", \"数据清洗\", \"数据转换\", \"数据集成\", \"数据建模\", \"数据仓库\", \"数仓建设\", \"数据治理\", \"数据质量\", \"数据准确性\", \"数据一致性\", \"数据合规\", \"数据资产\", \"ETL\", \"MapReduce\", \"Spark\", \"Flink\", \"TensorFlow\", \"SQL\", \"SQL性能优化\", \"Java\", \"C++\", \"Python\", \"Shell\", \"数学\", \"统计学\", \"运筹学\", \"计算机\", \"逻辑推理\", \"问题分析\", \"沟通表达\", \"抽象概述能力\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-data-engineering-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-data-engineering-intern-2026-001\", \"title\": \"软件开发-数据工程\", \"slogan\": \"你相信数据的力量！海量数据无疑是你的梦想乐园！你将发现海量用户背后的洞察，让数据引导产品的前进方向！\", \"status\": \"open\", \"category\": \"数据工程\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"数据工程\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"WXG\", \"S1\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"数据工程\", \"数据平台\", \"数据工具研发\", \"大数据基础组件\", \"海量数据处理\", \"数据处理效率优化\", \"数据解决方案\", \"数据需求交付\", \"数据清洗\", \"数据转换\", \"数据集成\", \"数据建模\", \"数据仓库\", \"数仓建设\", \"数据治理\", \"数据质量\", \"数据准确性\", \"数据一致性\", \"数据合规\", \"数据资产\", \"ETL\", \"MapReduce\", \"Spark\", \"Flink\", \"TensorFlow\", \"SQL\", \"SQL性能优化\", \"Java\", \"C++\", \"Python\", \"Shell\", \"数学\", \"统计学\", \"运筹学\", \"计算机\", \"逻辑推理\", \"问题分析\", \"沟通表达\", \"抽象概述能力\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责数据平台及工具研发与优化、数据处理、数仓建设、数据治理等工作，利用数据辅助产品运营决策，并为产品迭代、数据科学和算法研究提供工程支持。\", \"responsibilities\": [\"建设和优化常用的大数据基础组件及平台，提升数据团队整体的海量数据处理能力和处理效率\", \"通过建设数据平台及工具，降低业务团队使用海量数据的门槛\", \"与业务团队紧密合作，理解业务需求，设计并实现高效、可扩展的数据解决方案\", \"承接业务直接的数据需求交付\", \"对数据进行清洗、转换、集成和建模，为产品迭代、数据科学、算法研究等提供系统化的工程支持，达到工业界应用的工程水平\", \"通过技术和机制进行数据治理工作，提升数据质量，优化数据处理流程和数据质量\", \"确保数据的准确性和一致性，建设工具流程保障数据合规，挖掘数据资产价值\"]}, \"requirements\": {\"must_have\": [\"本科以上学历，数学、统计、运筹学、计算机等相关专业\", \"了解至少一种大数据常用组件及技术，如 MapReduce、Spark、Flink、TensorFlow 等\", \"熟悉至少一种编程语言，如 Java、C++、Python、Shell 等\", \"熟练掌握 SQL 及其性能优化\", \"能够清晰沟通表达，具备对事物完成抽象与概述的能力\", \"具备逻辑推理思维和分析问题能力\", \"热爱数据领域，面对技术难点，能主动学习相关知识\"], \"bonus_points\": [\"在相关领域的顶会或核心刊物上发表过高水平论文\", \"有相关实习经历，并具有数据仓库、数据处理项目经验\", \"对数据仓库理论和数据建模有深入理解\", \"熟悉常见的 ETL 工具和流程\", \"在 GitHub 上参与过开源项目并做出过代码贡献\", \"在业界公认的主流竞赛中取得过排名靠前的比赛成绩\"], \"nice_to_have\": [\"具备数据平台、数据工具、大数据基础组件研发相关理解或实践经验\", \"具备数据处理、数据清洗、数据转换、数据集成、数据建模相关理解或实践经验\", \"具备数据仓库建设、数据治理、数据质量优化相关理解\", \"具备业务数据需求交付、数据解决方案设计、数据资产价值挖掘相关经验\", \"熟悉常见 ETL 工具和流程\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10024,'软件开发-移动客户端开发方向','企业发展事业群','深圳总部','软件开发','移动客户端开发','技术','应届实习','实习生','应届实习','方寸之间，大有可为！你将在移动客户端开发岗位，成为移动互联网发展的 C 位见证者！','负责手机、平板电脑、手表、车机等移动客户端软件的架构设计、功能开发、性能优化、基础组件与基础架构研发，并改进客户端稳定性和安全性，探索大模型、深度合成、VR 等新技术在业务中的应用。','负责手机、平板电脑、手表、车机等移动客户端软件的架构设计、功能开发、性能优化、基础组件与基础架构研发，并改进客户端稳定性和安全性，探索大模型、深度合成、VR 等新技术在业务中的应用。','【必备要求】\n计算机软件相关专业本科及以上学历\n对于创新及解决具有挑战性的问题充满激情\n热爱编程，基础扎实\n理解算法和数据结构相关知识\n至少掌握一种编程语言\n\n【了解项】\n具备移动客户端软件架构设计、功能开发相关理解或实践经验\n具备移动客户端性能优化、用户体验优化相关理解\n具备客户端基础组件、基础架构研发相关理解\n具备客户端稳定性、安全性、系统漏洞和故障治理相关理解\n了解大模型、深度合成、VR 等新技术在移动端业务中的应用\n\n【加分项】\n有 C/C++、Java、Kotlin、Obj-C、Swift、Dart 编程经验\n有 iOS、Android、鸿蒙、Flutter、大前端开发经验','[\"负责手机、平板电脑、手表、车机等移动客户端软件的架构设计和功能开发\", \"负责移动客户端的性能优化，提升用户体验\", \"负责客户端基础组件及基础架构研发，提升研发效率\", \"负责改进客户端稳定性和安全性，减少系统漏洞和故障\", \"追踪学界及业界新技术，如大模型、深度合成、VR 等，探索新技术在业务中的应用\"]','[\"计算机软件相关专业本科及以上学历\", \"对于创新及解决具有挑战性的问题充满激情\", \"热爱编程，基础扎实\", \"理解算法和数据结构相关知识\", \"至少掌握一种编程语言\"]','[\"具备移动客户端软件架构设计、功能开发相关理解或实践经验\", \"具备移动客户端性能优化、用户体验优化相关理解\", \"具备客户端基础组件、基础架构研发相关理解\", \"具备客户端稳定性、安全性、系统漏洞和故障治理相关理解\", \"了解大模型、深度合成、VR 等新技术在移动端业务中的应用\"]','[\"有 C/C++、Java、Kotlin、Obj-C、Swift、Dart 编程经验\", \"有 iOS、Android、鸿蒙、Flutter、大前端开发经验\"]','null','[\"移动客户端开发\", \"客户端开发\", \"移动端架构设计\", \"功能开发\", \"性能优化\", \"用户体验优化\", \"基础组件\", \"基础架构\", \"研发效率提升\", \"客户端稳定性\", \"客户端安全性\", \"系统漏洞治理\", \"故障治理\", \"手机应用开发\", \"平板应用开发\", \"手表应用开发\", \"车机应用开发\", \"大模型\", \"深度合成\", \"VR\", \"算法\", \"数据结构\", \"C/C++\", \"Java\", \"Kotlin\", \"Obj-C\", \"Swift\", \"Dart\", \"iOS\", \"Android\", \"鸿蒙\", \"Flutter\", \"大前端\"]','[\"移动客户端开发\", \"客户端开发\", \"移动端架构设计\", \"功能开发\", \"性能优化\", \"用户体验优化\", \"基础组件\", \"基础架构\", \"研发效率提升\", \"客户端稳定性\", \"客户端安全性\", \"系统漏洞治理\", \"故障治理\", \"手机应用开发\", \"平板应用开发\", \"手表应用开发\", \"车机应用开发\", \"大模型\", \"深度合成\", \"VR\", \"算法\", \"数据结构\", \"C/C++\", \"Java\", \"Kotlin\", \"Obj-C\", \"Swift\", \"Dart\", \"iOS\", \"Android\", \"鸿蒙\", \"Flutter\", \"大前端\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"合肥\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-mobile-client-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-mobile-client-development-intern-2026-001\", \"title\": \"软件开发-移动客户端开发方向\", \"slogan\": \"方寸之间，大有可为！你将在移动客户端开发岗位，成为移动互联网发展的 C 位见证者！\", \"status\": \"open\", \"category\": \"移动客户端开发\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"合肥\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"移动客户端开发\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"移动客户端开发\", \"客户端开发\", \"移动端架构设计\", \"功能开发\", \"性能优化\", \"用户体验优化\", \"基础组件\", \"基础架构\", \"研发效率提升\", \"客户端稳定性\", \"客户端安全性\", \"系统漏洞治理\", \"故障治理\", \"手机应用开发\", \"平板应用开发\", \"手表应用开发\", \"车机应用开发\", \"大模型\", \"深度合成\", \"VR\", \"算法\", \"数据结构\", \"C/C++\", \"Java\", \"Kotlin\", \"Obj-C\", \"Swift\", \"Dart\", \"iOS\", \"Android\", \"鸿蒙\", \"Flutter\", \"大前端\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"合肥\"], \"description\": {\"summary\": \"负责手机、平板电脑、手表、车机等移动客户端软件的架构设计、功能开发、性能优化、基础组件与基础架构研发，并改进客户端稳定性和安全性，探索大模型、深度合成、VR 等新技术在业务中的应用。\", \"responsibilities\": [\"负责手机、平板电脑、手表、车机等移动客户端软件的架构设计和功能开发\", \"负责移动客户端的性能优化，提升用户体验\", \"负责客户端基础组件及基础架构研发，提升研发效率\", \"负责改进客户端稳定性和安全性，减少系统漏洞和故障\", \"追踪学界及业界新技术，如大模型、深度合成、VR 等，探索新技术在业务中的应用\"]}, \"requirements\": {\"must_have\": [\"计算机软件相关专业本科及以上学历\", \"对于创新及解决具有挑战性的问题充满激情\", \"热爱编程，基础扎实\", \"理解算法和数据结构相关知识\", \"至少掌握一种编程语言\"], \"bonus_points\": [\"有 C/C++、Java、Kotlin、Obj-C、Swift、Dart 编程经验\", \"有 iOS、Android、鸿蒙、Flutter、大前端开发经验\"], \"nice_to_have\": [\"具备移动客户端软件架构设计、功能开发相关理解或实践经验\", \"具备移动客户端性能优化、用户体验优化相关理解\", \"具备客户端基础组件、基础架构研发相关理解\", \"具备客户端稳定性、安全性、系统漏洞和故障治理相关理解\", \"了解大模型、深度合成、VR 等新技术在移动端业务中的应用\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10025,'软件开发-前端开发方向','企业发展事业群','深圳总部','软件开发','前端开发','技术','应届实习','实习生','应届实习','你将开发维护各种不可思议的客户端产品，以技术力量创造更美好的生活体验。让你的前端技术，服务顶尖产品！','负责 Web 页面、小程序以及跨平台框架等前端相关技术研发，通过技术方案优化、通用组件抽离复用和前沿技术探索，提升产品体验、开发效率与行业影响力。','负责 Web 页面、小程序以及跨平台框架等前端相关技术研发，通过技术方案优化、通用组件抽离复用和前沿技术探索，提升产品体验、开发效率与行业影响力。','【必备要求】\n计算机相关专业本科及以上学历；如非计算机相关专业，必须自修过计算机专业相关必修课\n热爱计算机编程，具备丰富的编码实战经验\n熟悉 JS、TS、HTML、CSS 等前端开发语言\n了解一门后台技术，如 JSP、Python、PHP、Node.js\n了解常见前端开发框架以及 DevOps 工具\n了解常见的 Web、App、小程序前后端系统架构\n掌握常见的算法能力\n掌握常见网络协议和相关底层网络协议的全面知识\n\n【了解项】\n具备 Web 页面、小程序、跨平台框架相关前端研发经验\n具备技术方案优化、产品体验优化相关理解或实践经验\n具备通用组件抽离、组件复用、前端工程化相关理解\n具备前端框架、DevOps 工具、前后端系统架构相关实践经验','[\"负责 Web 页面、小程序以及跨平台框架等前端相关技术的研发\", \"通过优化技术方案，提升产品体验\", \"抽离通用组件进行复用，提升开发效率与行业影响力\", \"探索前沿技术、跟进行业发展，力争为用户带来跨时代的产品体验\"]','[\"计算机相关专业本科及以上学历；如非计算机相关专业，必须自修过计算机专业相关必修课\", \"热爱计算机编程，具备丰富的编码实战经验\", \"熟悉 JS、TS、HTML、CSS 等前端开发语言\", \"了解一门后台技术，如 JSP、Python、PHP、Node.js\", \"了解常见前端开发框架以及 DevOps 工具\", \"了解常见的 Web、App、小程序前后端系统架构\", \"掌握常见的算法能力\", \"掌握常见网络协议和相关底层网络协议的全面知识\"]','[\"具备 Web 页面、小程序、跨平台框架相关前端研发经验\", \"具备技术方案优化、产品体验优化相关理解或实践经验\", \"具备通用组件抽离、组件复用、前端工程化相关理解\", \"具备前端框架、DevOps 工具、前后端系统架构相关实践经验\"]','[]','null','[\"前端开发\", \"Web开发\", \"小程序开发\", \"跨平台框架\", \"客户端产品\", \"技术方案优化\", \"产品体验优化\", \"通用组件\", \"组件复用\", \"开发效率提升\", \"前沿技术探索\", \"JS\", \"JavaScript\", \"TS\", \"TypeScript\", \"HTML\", \"CSS\", \"JSP\", \"Python\", \"PHP\", \"Node.js\", \"前端开发框架\", \"DevOps\", \"Web系统架构\", \"App系统架构\", \"小程序系统架构\", \"前后端系统架构\", \"算法\", \"网络协议\", \"底层网络协议\", \"编码实战\"]','[\"前端开发\", \"Web开发\", \"小程序开发\", \"跨平台框架\", \"客户端产品\", \"技术方案优化\", \"产品体验优化\", \"通用组件\", \"组件复用\", \"开发效率提升\", \"前沿技术探索\", \"JS\", \"JavaScript\", \"TS\", \"TypeScript\", \"HTML\", \"CSS\", \"JSP\", \"Python\", \"PHP\", \"Node.js\", \"前端开发框架\", \"DevOps\", \"Web系统架构\", \"App系统架构\", \"小程序系统架构\", \"前后端系统架构\", \"算法\", \"网络协议\", \"底层网络协议\", \"编码实战\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"武汉\"]','[\"武汉\", \"远程面试\"]',NULL,'open','manual_curated','tencent-frontend-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-frontend-development-intern-2026-001\", \"title\": \"软件开发-前端开发方向\", \"slogan\": \"你将开发维护各种不可思议的客户端产品，以技术力量创造更美好的生活体验。让你的前端技术，服务顶尖产品！\", \"status\": \"open\", \"category\": \"前端开发\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"武汉\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"前端开发\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"WXG\", \"S1\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"前端开发\", \"Web开发\", \"小程序开发\", \"跨平台框架\", \"客户端产品\", \"技术方案优化\", \"产品体验优化\", \"通用组件\", \"组件复用\", \"开发效率提升\", \"前沿技术探索\", \"JS\", \"JavaScript\", \"TS\", \"TypeScript\", \"HTML\", \"CSS\", \"JSP\", \"Python\", \"PHP\", \"Node.js\", \"前端开发框架\", \"DevOps\", \"Web系统架构\", \"App系统架构\", \"小程序系统架构\", \"前后端系统架构\", \"算法\", \"网络协议\", \"底层网络协议\", \"编码实战\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\", \"武汉\"], \"description\": {\"summary\": \"负责 Web 页面、小程序以及跨平台框架等前端相关技术研发，通过技术方案优化、通用组件抽离复用和前沿技术探索，提升产品体验、开发效率与行业影响力。\", \"responsibilities\": [\"负责 Web 页面、小程序以及跨平台框架等前端相关技术的研发\", \"通过优化技术方案，提升产品体验\", \"抽离通用组件进行复用，提升开发效率与行业影响力\", \"探索前沿技术、跟进行业发展，力争为用户带来跨时代的产品体验\"]}, \"requirements\": {\"must_have\": [\"计算机相关专业本科及以上学历；如非计算机相关专业，必须自修过计算机专业相关必修课\", \"热爱计算机编程，具备丰富的编码实战经验\", \"熟悉 JS、TS、HTML、CSS 等前端开发语言\", \"了解一门后台技术，如 JSP、Python、PHP、Node.js\", \"了解常见前端开发框架以及 DevOps 工具\", \"了解常见的 Web、App、小程序前后端系统架构\", \"掌握常见的算法能力\", \"掌握常见网络协议和相关底层网络协议的全面知识\"], \"bonus_points\": [], \"nice_to_have\": [\"具备 Web 页面、小程序、跨平台框架相关前端研发经验\", \"具备技术方案优化、产品体验优化相关理解或实践经验\", \"具备通用组件抽离、组件复用、前端工程化相关理解\", \"具备前端框架、DevOps 工具、前后端系统架构相关实践经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}, {\"code\": \"S1\", \"name\": \"职能系统－职能线\"}], \"interview_locations\": [\"武汉\", \"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10026,'算法-计算机视觉方向','企业发展事业群','深圳总部','算法','计算机视觉','技术','应届实习','实习生','应届实习','对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！','负责图像和视频相关算法研究与开发，覆盖深度学习、机器学习、图像理解、计算机视觉系统研发及平台建设，并结合实际应用场景提供技术解决方案。','负责图像和视频相关算法研究与开发，覆盖深度学习、机器学习、图像理解、计算机视觉系统研发及平台建设，并结合实际应用场景提供技术解决方案。','【必备要求】\n包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\n熟练掌握计算机视觉和图像处理相关的基本算法及应用\n熟悉 Caffe、TensorFlow、PyTorch 等至少一个深度学习框架\n具备较强的工程实现能力\n熟练掌握 C/C++ 编程\n熟悉 Shell、Python、Matlab 至少一种编程语言\n\n【了解项】\n具备图像或视频算法研究与开发相关经验\n熟悉深度学习和常用机器学习方法在机器视觉中的应用\n熟悉人脸识别、目标检测、图像分类、语义分割、图像处理、OCR 等一个或多个计算机视觉方向\n具备计算机视觉算法系统研发、平台建设或技术解决方案相关经验\n\n【加分项】\n在 CVPR、ICCV、ECCV、ICML、NeurIPS、COLT 等计算机视觉、机器学习学术会议或期刊以第一作者发表过文章\n有丰富项目经验','[\"负责图像和视频相关算法的研究与开发，包括深度学习以及常用机器学习方法在机器视觉中的应用\", \"负责计算机视觉相关的技术研发工作，包括人脸识别、物体检测、分类、语义分割、图像处理、人体或活体识别等方向\", \"负责车辆与人员的检测、识别与跟踪相关算法和系统研发\", \"负责图像或视频搜索、视频语义分析、视频特征提取与识别相关算法和系统研发\", \"负责页面分析与自动合成、OCR 等算法与系统研发\", \"负责深度学习、图像理解、机器学习等前沿技术的研发储备和平台建设\", \"结合未来实际应用场景，提供计算机视觉相关技术解决方案\"]','[\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握计算机视觉和图像处理相关的基本算法及应用\", \"熟悉 Caffe、TensorFlow、PyTorch 等至少一个深度学习框架\", \"具备较强的工程实现能力\", \"熟练掌握 C/C++ 编程\", \"熟悉 Shell、Python、Matlab 至少一种编程语言\"]','[\"具备图像或视频算法研究与开发相关经验\", \"熟悉深度学习和常用机器学习方法在机器视觉中的应用\", \"熟悉人脸识别、目标检测、图像分类、语义分割、图像处理、OCR 等一个或多个计算机视觉方向\", \"具备计算机视觉算法系统研发、平台建设或技术解决方案相关经验\"]','[\"在 CVPR、ICCV、ECCV、ICML、NeurIPS、COLT 等计算机视觉、机器学习学术会议或期刊以第一作者发表过文章\", \"有丰富项目经验\"]','null','[\"计算机视觉\", \"图像处理\", \"图像算法\", \"视频算法\", \"深度学习\", \"机器学习\", \"机器视觉\", \"图像理解\", \"人脸识别\", \"物体检测\", \"目标检测\", \"图像分类\", \"语义分割\", \"人体识别\", \"活体识别\", \"车辆检测\", \"人员检测\", \"目标识别\", \"目标跟踪\", \"图像搜索\", \"视频搜索\", \"视频语义分析\", \"视频特征提取\", \"页面分析\", \"自动合成\", \"OCR\", \"C/C++\", \"Shell\", \"Python\", \"Matlab\", \"Caffe\", \"TensorFlow\", \"PyTorch\", \"算法研发\", \"系统研发\", \"平台建设\"]','[\"计算机视觉\", \"图像处理\", \"图像算法\", \"视频算法\", \"深度学习\", \"机器学习\", \"机器视觉\", \"图像理解\", \"人脸识别\", \"物体检测\", \"目标检测\", \"图像分类\", \"语义分割\", \"人体识别\", \"活体识别\", \"车辆检测\", \"人员检测\", \"目标识别\", \"目标跟踪\", \"图像搜索\", \"视频搜索\", \"视频语义分析\", \"视频特征提取\", \"页面分析\", \"自动合成\", \"OCR\", \"C/C++\", \"Shell\", \"Python\", \"Matlab\", \"Caffe\", \"TensorFlow\", \"PyTorch\", \"算法研发\", \"系统研发\", \"平台建设\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-algorithm-computer-vision-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-algorithm-computer-vision-intern-2026-001\", \"title\": \"算法-计算机视觉方向\", \"slogan\": \"对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！\", \"status\": \"open\", \"category\": \"计算机视觉\", \"job_type\": \"技术\", \"direction\": \"算法\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"job_type\": \"技术\", \"direction\": \"算法\", \"job_category\": \"计算机视觉\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"计算机视觉\", \"图像处理\", \"图像算法\", \"视频算法\", \"深度学习\", \"机器学习\", \"机器视觉\", \"图像理解\", \"人脸识别\", \"物体检测\", \"目标检测\", \"图像分类\", \"语义分割\", \"人体识别\", \"活体识别\", \"车辆检测\", \"人员检测\", \"目标识别\", \"目标跟踪\", \"图像搜索\", \"视频搜索\", \"视频语义分析\", \"视频特征提取\", \"页面分析\", \"自动合成\", \"OCR\", \"C/C++\", \"Shell\", \"Python\", \"Matlab\", \"Caffe\", \"TensorFlow\", \"PyTorch\", \"算法研发\", \"系统研发\", \"平台建设\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"description\": {\"summary\": \"负责图像和视频相关算法研究与开发，覆盖深度学习、机器学习、图像理解、计算机视觉系统研发及平台建设，并结合实际应用场景提供技术解决方案。\", \"responsibilities\": [\"负责图像和视频相关算法的研究与开发，包括深度学习以及常用机器学习方法在机器视觉中的应用\", \"负责计算机视觉相关的技术研发工作，包括人脸识别、物体检测、分类、语义分割、图像处理、人体或活体识别等方向\", \"负责车辆与人员的检测、识别与跟踪相关算法和系统研发\", \"负责图像或视频搜索、视频语义分析、视频特征提取与识别相关算法和系统研发\", \"负责页面分析与自动合成、OCR 等算法与系统研发\", \"负责深度学习、图像理解、机器学习等前沿技术的研发储备和平台建设\", \"结合未来实际应用场景，提供计算机视觉相关技术解决方案\"]}, \"requirements\": {\"must_have\": [\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握计算机视觉和图像处理相关的基本算法及应用\", \"熟悉 Caffe、TensorFlow、PyTorch 等至少一个深度学习框架\", \"具备较强的工程实现能力\", \"熟练掌握 C/C++ 编程\", \"熟悉 Shell、Python、Matlab 至少一种编程语言\"], \"bonus_points\": [\"在 CVPR、ICCV、ECCV、ICML、NeurIPS、COLT 等计算机视觉、机器学习学术会议或期刊以第一作者发表过文章\", \"有丰富项目经验\"], \"nice_to_have\": [\"具备图像或视频算法研究与开发相关经验\", \"熟悉深度学习和常用机器学习方法在机器视觉中的应用\", \"熟悉人脸识别、目标检测、图像分类、语义分割、图像处理、OCR 等一个或多个计算机视觉方向\", \"具备计算机视觉算法系统研发、平台建设或技术解决方案相关经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10027,'算法-计算机图形学方向','互动娱乐事业群','深圳总部','算法','计算机图形学','技术','应届实习','实习生','应届实习','对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！','负责计算机图形学方向的基础理论、算法与系统研发，覆盖几何、纹理、材质、渲染、虚拟现实、人机交互、并行计算、可视化分析、媒体语义挖掘与检索等方向。','负责计算机图形学方向的基础理论、算法与系统研发，覆盖几何、纹理、材质、渲染、虚拟现实、人机交互、并行计算、可视化分析、媒体语义挖掘与检索等方向。','【必备要求】\n包含但不限于计算机、软件工程、数字媒体技术、信息工程、自动化、电子工程、应用数学、信号与信息处理等专业的博士和优秀硕士\n熟练掌握计算机图形学基础理论和算法\n在一个或多个领域能够独立开展研发工作，如几何表达、材质建模、光照算法、虚拟现实、人机交互、并行计算、可视化等\n熟悉至少一种编程语言，包括 C/C++、Python、Java、C#、Rust 等\n\n【了解项】\n具备几何表达、材质建模、光照算法、渲染算法相关研究或工程经验\n熟悉虚拟现实、增强现实、混合现实、人机交互等方向\n熟悉异构众核并行计算、并行环境编程语言、开发工具或数据结构高效实现\n具备可视化分析、数据挖掘、媒体语义挖掘与检索相关理解或实践经验\n具备智能信息处理和可视化分析平台研发经验\n\n【加分项】\n在 SigGraph、EuroGraph、SigGraph Asia、ECCV、CVPR、ACM Transactions on Graphics、IEEE Transactions on Visualization and Computer Graphics 等相关一流学术会议或期刊以第一或通讯作者发表过文章\n有深度学习学术或工程项目经验','[\"研究几何、纹理、材质的获取、处理、表示和渲染的基础理论与算法，解决复杂对象的高效构建和逼真呈现等关键问题\", \"研究虚拟现实环境构建、绘制、显示、人机交互、增强现实、混合现实等关键技术\", \"研究异构众核并行环境下的编程语言、开发工具和常用数据结构的设计和高效实现\", \"探索可视化与数据挖掘相结合的新型可视分析理论与算法\", \"研究海量媒体的语义挖掘与检索的理论与方法\", \"研发面向领域的智能信息处理和可视化分析平台\"]','[\"包含但不限于计算机、软件工程、数字媒体技术、信息工程、自动化、电子工程、应用数学、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握计算机图形学基础理论和算法\", \"在一个或多个领域能够独立开展研发工作，如几何表达、材质建模、光照算法、虚拟现实、人机交互、并行计算、可视化等\", \"熟悉至少一种编程语言，包括 C/C++、Python、Java、C#、Rust 等\"]','[\"具备几何表达、材质建模、光照算法、渲染算法相关研究或工程经验\", \"熟悉虚拟现实、增强现实、混合现实、人机交互等方向\", \"熟悉异构众核并行计算、并行环境编程语言、开发工具或数据结构高效实现\", \"具备可视化分析、数据挖掘、媒体语义挖掘与检索相关理解或实践经验\", \"具备智能信息处理和可视化分析平台研发经验\"]','[\"在 SigGraph、EuroGraph、SigGraph Asia、ECCV、CVPR、ACM Transactions on Graphics、IEEE Transactions on Visualization and Computer Graphics 等相关一流学术会议或期刊以第一或通讯作者发表过文章\", \"有深度学习学术或工程项目经验\"]','null','[\"计算机图形学\", \"几何表达\", \"几何处理\", \"纹理处理\", \"材质建模\", \"光照算法\", \"渲染算法\", \"实时渲染\", \"虚拟现实\", \"增强现实\", \"混合现实\", \"人机交互\", \"并行计算\", \"异构众核\", \"编程语言\", \"开发工具\", \"数据结构\", \"可视化\", \"可视分析\", \"数据挖掘\", \"媒体语义挖掘\", \"信息检索\", \"智能信息处理\", \"可视化分析平台\", \"深度学习\", \"C/C++\", \"Python\", \"Java\", \"C#\", \"Rust\", \"算法研发\", \"系统研发\"]','[\"计算机图形学\", \"几何表达\", \"几何处理\", \"纹理处理\", \"材质建模\", \"光照算法\", \"渲染算法\", \"实时渲染\", \"虚拟现实\", \"增强现实\", \"混合现实\", \"人机交互\", \"并行计算\", \"异构众核\", \"编程语言\", \"开发工具\", \"数据结构\", \"可视化\", \"可视分析\", \"数据挖掘\", \"媒体语义挖掘\", \"信息检索\", \"智能信息处理\", \"可视化分析平台\", \"深度学习\", \"C/C++\", \"Python\", \"Java\", \"C#\", \"Rust\", \"算法研发\", \"系统研发\"]','[{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"上海\", \"广州\", \"杭州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-algorithm-computer-graphics-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-algorithm-computer-graphics-intern-2026-001\", \"title\": \"算法-计算机图形学方向\", \"slogan\": \"对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！\", \"status\": \"open\", \"category\": \"计算机图形学\", \"job_type\": \"技术\", \"direction\": \"算法\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"上海\", \"广州\", \"杭州\"], \"job_type\": \"技术\", \"direction\": \"算法\", \"job_category\": \"计算机图形学\", \"business_groups\": [\"IEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"计算机图形学\", \"几何表达\", \"几何处理\", \"纹理处理\", \"材质建模\", \"光照算法\", \"渲染算法\", \"实时渲染\", \"虚拟现实\", \"增强现实\", \"混合现实\", \"人机交互\", \"并行计算\", \"异构众核\", \"编程语言\", \"开发工具\", \"数据结构\", \"可视化\", \"可视分析\", \"数据挖掘\", \"媒体语义挖掘\", \"信息检索\", \"智能信息处理\", \"可视化分析平台\", \"深度学习\", \"C/C++\", \"Python\", \"Java\", \"C#\", \"Rust\", \"算法研发\", \"系统研发\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"上海\", \"广州\", \"杭州\"], \"description\": {\"summary\": \"负责计算机图形学方向的基础理论、算法与系统研发，覆盖几何、纹理、材质、渲染、虚拟现实、人机交互、并行计算、可视化分析、媒体语义挖掘与检索等方向。\", \"responsibilities\": [\"研究几何、纹理、材质的获取、处理、表示和渲染的基础理论与算法，解决复杂对象的高效构建和逼真呈现等关键问题\", \"研究虚拟现实环境构建、绘制、显示、人机交互、增强现实、混合现实等关键技术\", \"研究异构众核并行环境下的编程语言、开发工具和常用数据结构的设计和高效实现\", \"探索可视化与数据挖掘相结合的新型可视分析理论与算法\", \"研究海量媒体的语义挖掘与检索的理论与方法\", \"研发面向领域的智能信息处理和可视化分析平台\"]}, \"requirements\": {\"must_have\": [\"包含但不限于计算机、软件工程、数字媒体技术、信息工程、自动化、电子工程、应用数学、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握计算机图形学基础理论和算法\", \"在一个或多个领域能够独立开展研发工作，如几何表达、材质建模、光照算法、虚拟现实、人机交互、并行计算、可视化等\", \"熟悉至少一种编程语言，包括 C/C++、Python、Java、C#、Rust 等\"], \"bonus_points\": [\"在 SigGraph、EuroGraph、SigGraph Asia、ECCV、CVPR、ACM Transactions on Graphics、IEEE Transactions on Visualization and Computer Graphics 等相关一流学术会议或期刊以第一或通讯作者发表过文章\", \"有深度学习学术或工程项目经验\"], \"nice_to_have\": [\"具备几何表达、材质建模、光照算法、渲染算法相关研究或工程经验\", \"熟悉虚拟现实、增强现实、混合现实、人机交互等方向\", \"熟悉异构众核并行计算、并行环境编程语言、开发工具或数据结构高效实现\", \"具备可视化分析、数据挖掘、媒体语义挖掘与检索相关理解或实践经验\", \"具备智能信息处理和可视化分析平台研发经验\"]}, \"organizations\": [{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10028,'技术运营','企业发展事业群','深圳总部','技术运营','SRE','技术','应届实习','实习生','应届实习','你将通过技术和才华，让用户无论在哪个位置，都能稳定、低延迟访问产品。好的产品，永远不“掉线”！','负责公司海量服务和平台的高可用、高可靠保障与优化，覆盖 DevOps、AIOps、持续部署、容量管理、监控定位、故障恢复、资源管理、容灾架构、研发保障以及 CI/CD/CO 平台和工具建设。','负责公司海量服务和平台的高可用、高可靠保障与优化，覆盖 DevOps、AIOps、持续部署、容量管理、监控定位、故障恢复、资源管理、容灾架构、研发保障以及 CI/CD/CO 平台和工具建设。','【必备要求】\n熟悉计算机网络、体系架构、计算机原理\n熟悉 Linux、Windows 操作系统及常用命令\n至少掌握一门编程语言，例如 Python、Java、Go、Shell 等\n具备良好的编码规范\n具备出色的数据分析和深度思考能力\n不畏困难，能够推进问题解决\n责任心强，能抗压\n具备良好的用户意识、沟通能力和团队协作能力\n乐于尝试新技术和学习新知识\n爱钻研、乐实践、愿分享\n\n【了解项】\n具备 SRE、DevOps、AIOps、平台工程相关理解或实践经验\n具备持续部署、容量管理、监控定位、故障恢复相关理解\n具备公有云、基础设施规划、云厂商选型、云区域选址、资源适配相关理解\n具备计算、存储、CDN、网络、数据库、PaaS 平台等资源管理相关理解\n具备稳定性保障、容灾架构设计、发布变更、故障处理相关经验\n具备 CI、CD、CO 平台或工具设计研发相关理解','[\"负责公司海量服务和平台的高可用、高可靠保障和优化，通过 DevOps、AIOps 平台和工具建设，实现高效稳定的持续部署、容量管理、监控定位和故障恢复\", \"负责业务在公司基础设施及公有云上的规划及构建，包括云厂商选型、机房节点或云区域选址、程序资源适配等\", \"通过平台工程和工具研发能力，打造面向全球的低成本、高可靠、优体验的运营基础环境\", \"负责公司百亿规模运营资源管理，引领业务资源与基础架构的合理使用及前瞻规划，覆盖计算、存储、CDN 加速、网络、数据库、PaaS 平台等\", \"持续提升资源管理效率并降低运营成本\", \"负责业务稳定性保障、玩家体验优化、发布变更、故障处理，提升故障快速恢复能力，并提供持续优化的稳定性架构方案\", \"负责业务容灾架构的设计和落地、容量管理、资源筹备等工作\", \"负责与研发团队协作解决研发过程问题，提升研发效率，提供稳定高效的研发保障服务\", \"负责 CI、CD、CO 等领域 PaaS 平台和 SaaS 工具的设计与研发\", \"负责 CI、CD、CO 等领域的平台 SRE 工作，包括高可用架构设计优化、可靠性保障等\"]','[\"熟悉计算机网络、体系架构、计算机原理\", \"熟悉 Linux、Windows 操作系统及常用命令\", \"至少掌握一门编程语言，例如 Python、Java、Go、Shell 等\", \"具备良好的编码规范\", \"具备出色的数据分析和深度思考能力\", \"不畏困难，能够推进问题解决\", \"责任心强，能抗压\", \"具备良好的用户意识、沟通能力和团队协作能力\", \"乐于尝试新技术和学习新知识\", \"爱钻研、乐实践、愿分享\"]','[\"具备 SRE、DevOps、AIOps、平台工程相关理解或实践经验\", \"具备持续部署、容量管理、监控定位、故障恢复相关理解\", \"具备公有云、基础设施规划、云厂商选型、云区域选址、资源适配相关理解\", \"具备计算、存储、CDN、网络、数据库、PaaS 平台等资源管理相关理解\", \"具备稳定性保障、容灾架构设计、发布变更、故障处理相关经验\", \"具备 CI、CD、CO 平台或工具设计研发相关理解\"]','[]','null','[\"技术运营\", \"SRE\", \"DevOps\", \"AIOps\", \"平台工程\", \"高可用\", \"高可靠\", \"持续部署\", \"容量管理\", \"监控定位\", \"故障恢复\", \"故障处理\", \"稳定性保障\", \"稳定性架构\", \"容灾架构\", \"资源管理\", \"基础设施规划\", \"公有云\", \"云厂商选型\", \"云区域选址\", \"程序资源适配\", \"计算资源\", \"存储资源\", \"CDN加速\", \"网络\", \"数据库\", \"PaaS平台\", \"SaaS工具\", \"CI\", \"CD\", \"CO\", \"研发保障\", \"研发效率提升\", \"发布变更\", \"玩家体验优化\", \"计算机网络\", \"体系架构\", \"计算机原理\", \"Linux\", \"Windows\", \"Python\", \"Java\", \"Go\", \"Shell\", \"数据分析\", \"问题解决\", \"沟通表达\", \"团队协作\", \"用户意识\"]','[\"技术运营\", \"SRE\", \"DevOps\", \"AIOps\", \"平台工程\", \"高可用\", \"高可靠\", \"持续部署\", \"容量管理\", \"监控定位\", \"故障恢复\", \"故障处理\", \"稳定性保障\", \"稳定性架构\", \"容灾架构\", \"资源管理\", \"基础设施规划\", \"公有云\", \"云厂商选型\", \"云区域选址\", \"程序资源适配\", \"计算资源\", \"存储资源\", \"CDN加速\", \"网络\", \"数据库\", \"PaaS平台\", \"SaaS工具\", \"CI\", \"CD\", \"CO\", \"研发保障\", \"研发效率提升\", \"发布变更\", \"玩家体验优化\", \"计算机网络\", \"体系架构\", \"计算机原理\", \"Linux\", \"Windows\", \"Python\", \"Java\", \"Go\", \"Shell\", \"数据分析\", \"问题解决\", \"沟通表达\", \"团队协作\", \"用户意识\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"韶关\", \"成都\", \"芜湖\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-technical-operations-sre-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-technical-operations-sre-intern-2026-001\", \"title\": \"技术运营\", \"slogan\": \"你将通过技术和才华，让用户无论在哪个位置，都能稳定、低延迟访问产品。好的产品，永远不“掉线”！\", \"status\": \"open\", \"category\": \"SRE\", \"job_type\": \"技术\", \"direction\": \"技术运营\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"韶关\", \"成都\", \"芜湖\"], \"job_type\": \"技术\", \"direction\": \"技术运营\", \"job_category\": \"SRE\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"技术运营\", \"SRE\", \"DevOps\", \"AIOps\", \"平台工程\", \"高可用\", \"高可靠\", \"持续部署\", \"容量管理\", \"监控定位\", \"故障恢复\", \"故障处理\", \"稳定性保障\", \"稳定性架构\", \"容灾架构\", \"资源管理\", \"基础设施规划\", \"公有云\", \"云厂商选型\", \"云区域选址\", \"程序资源适配\", \"计算资源\", \"存储资源\", \"CDN加速\", \"网络\", \"数据库\", \"PaaS平台\", \"SaaS工具\", \"CI\", \"CD\", \"CO\", \"研发保障\", \"研发效率提升\", \"发布变更\", \"玩家体验优化\", \"计算机网络\", \"体系架构\", \"计算机原理\", \"Linux\", \"Windows\", \"Python\", \"Java\", \"Go\", \"Shell\", \"数据分析\", \"问题解决\", \"沟通表达\", \"团队协作\", \"用户意识\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"韶关\", \"成都\", \"芜湖\"], \"description\": {\"summary\": \"负责公司海量服务和平台的高可用、高可靠保障与优化，覆盖 DevOps、AIOps、持续部署、容量管理、监控定位、故障恢复、资源管理、容灾架构、研发保障以及 CI/CD/CO 平台和工具建设。\", \"responsibilities\": [\"负责公司海量服务和平台的高可用、高可靠保障和优化，通过 DevOps、AIOps 平台和工具建设，实现高效稳定的持续部署、容量管理、监控定位和故障恢复\", \"负责业务在公司基础设施及公有云上的规划及构建，包括云厂商选型、机房节点或云区域选址、程序资源适配等\", \"通过平台工程和工具研发能力，打造面向全球的低成本、高可靠、优体验的运营基础环境\", \"负责公司百亿规模运营资源管理，引领业务资源与基础架构的合理使用及前瞻规划，覆盖计算、存储、CDN 加速、网络、数据库、PaaS 平台等\", \"持续提升资源管理效率并降低运营成本\", \"负责业务稳定性保障、玩家体验优化、发布变更、故障处理，提升故障快速恢复能力，并提供持续优化的稳定性架构方案\", \"负责业务容灾架构的设计和落地、容量管理、资源筹备等工作\", \"负责与研发团队协作解决研发过程问题，提升研发效率，提供稳定高效的研发保障服务\", \"负责 CI、CD、CO 等领域 PaaS 平台和 SaaS 工具的设计与研发\", \"负责 CI、CD、CO 等领域的平台 SRE 工作，包括高可用架构设计优化、可靠性保障等\"]}, \"requirements\": {\"must_have\": [\"熟悉计算机网络、体系架构、计算机原理\", \"熟悉 Linux、Windows 操作系统及常用命令\", \"至少掌握一门编程语言，例如 Python、Java、Go、Shell 等\", \"具备良好的编码规范\", \"具备出色的数据分析和深度思考能力\", \"不畏困难，能够推进问题解决\", \"责任心强，能抗压\", \"具备良好的用户意识、沟通能力和团队协作能力\", \"乐于尝试新技术和学习新知识\", \"爱钻研、乐实践、愿分享\"], \"bonus_points\": [], \"nice_to_have\": [\"具备 SRE、DevOps、AIOps、平台工程相关理解或实践经验\", \"具备持续部署、容量管理、监控定位、故障恢复相关理解\", \"具备公有云、基础设施规划、云厂商选型、云区域选址、资源适配相关理解\", \"具备计算、存储、CDN、网络、数据库、PaaS 平台等资源管理相关理解\", \"具备稳定性保障、容灾架构设计、发布变更、故障处理相关经验\", \"具备 CI、CD、CO 平台或工具设计研发相关理解\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10029,'测试与质量管理','云与智慧产业事业群','深圳总部','测试与质量管理','测试与质量管理','技术','应届实习','实习生','应届实习','质量是腾讯的命脉，决定产品的未来！作为腾讯产品质量的“守护者”，守护用户的笑容，有你在才安心！','负责产品需求和架构分析、测试方法与测试用例设计、功能测试、性能测试、兼容性测试、API 接口测试、专项测试、自动化测试、持续集成、测试工具平台建设及质量评估模型构建。','负责产品需求和架构分析、测试方法与测试用例设计、功能测试、性能测试、兼容性测试、API 接口测试、专项测试、自动化测试、持续集成、测试工具平台建设及质量评估模型构建。','【必备要求】\n计算机软件相关专业本科或及以上学历\n逻辑思维能力强\n具备较好的沟通协调能力和推动力\n掌握软件工程基础知识\n熟悉软件测试理论和方法\n有扎实的计算机理论基础\n熟练掌握操作系统及网络的基本原理\n掌握 1 门以上编程语言\n具备扎实的代码编写和走读能力\n熟悉各类常用 debug 类工具\n追求卓越，工作细致\n能站在用户的角度思考\n坚持原则，具备良好的学习能力和独立思考习惯\n\n【了解项】\n具备产品需求分析、架构分析、测试方法设计、测试用例设计相关理解或实践经验\n具备功能测试、性能测试、兼容性测试、API 接口测试相关经验\n具备自动化测试、持续集成、测试工具平台搭建相关理解\n具备稳定性分析、系统可靠性测试、质量评估模型、量化分析相关理解','[\"负责分析产品需求和架构，设计测试方法和测试用例\", \"负责产品功能、系统性能、平台兼容性、API 接口测试等测试工作\", \"在产品运营过程中发现、收集、暴露质量问题，并推动和跟踪问题解决\", \"负责同类产品分析、稳定性分析、系统可靠性等专项测试工作，对具体测试活动进行规划实施\", \"负责对测试过程实施自动化和持续集成，提升测试和项目工程效率\", \"负责行业优秀自动化测试工具平台的引入及搭建，提升整体交付质量\", \"负责构建有效的评估模型和评估方法，结合业务特点进行量化分析\"]','[\"计算机软件相关专业本科或及以上学历\", \"逻辑思维能力强\", \"具备较好的沟通协调能力和推动力\", \"掌握软件工程基础知识\", \"熟悉软件测试理论和方法\", \"有扎实的计算机理论基础\", \"熟练掌握操作系统及网络的基本原理\", \"掌握 1 门以上编程语言\", \"具备扎实的代码编写和走读能力\", \"熟悉各类常用 debug 类工具\", \"追求卓越，工作细致\", \"能站在用户的角度思考\", \"坚持原则，具备良好的学习能力和独立思考习惯\"]','[\"具备产品需求分析、架构分析、测试方法设计、测试用例设计相关理解或实践经验\", \"具备功能测试、性能测试、兼容性测试、API 接口测试相关经验\", \"具备自动化测试、持续集成、测试工具平台搭建相关理解\", \"具备稳定性分析、系统可靠性测试、质量评估模型、量化分析相关理解\"]','[]','null','[\"测试与质量管理\", \"软件测试\", \"质量保障\", \"需求分析\", \"架构分析\", \"测试方法设计\", \"测试用例设计\", \"功能测试\", \"系统性能测试\", \"平台兼容性测试\", \"API接口测试\", \"质量问题跟踪\", \"同类产品分析\", \"稳定性分析\", \"系统可靠性测试\", \"专项测试\", \"测试规划\", \"自动化测试\", \"持续集成\", \"测试工具平台\", \"交付质量\", \"评估模型\", \"评估方法\", \"量化分析\", \"软件工程\", \"操作系统\", \"计算机网络\", \"编程语言\", \"代码编写\", \"代码走读\", \"Debug工具\", \"逻辑思维\", \"沟通协调\", \"问题推动\", \"用户意识\", \"学习能力\", \"独立思考\"]','[\"测试与质量管理\", \"软件测试\", \"质量保障\", \"需求分析\", \"架构分析\", \"测试方法设计\", \"测试用例设计\", \"功能测试\", \"系统性能测试\", \"平台兼容性测试\", \"API接口测试\", \"质量问题跟踪\", \"同类产品分析\", \"稳定性分析\", \"系统可靠性测试\", \"专项测试\", \"测试规划\", \"自动化测试\", \"持续集成\", \"测试工具平台\", \"交付质量\", \"评估模型\", \"评估方法\", \"量化分析\", \"软件工程\", \"操作系统\", \"计算机网络\", \"编程语言\", \"代码编写\", \"代码走读\", \"Debug工具\", \"逻辑思维\", \"沟通协调\", \"问题推动\", \"用户意识\", \"学习能力\", \"独立思考\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-test-quality-management-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-test-quality-management-intern-2026-001\", \"title\": \"测试与质量管理\", \"slogan\": \"质量是腾讯的命脉，决定产品的未来！作为腾讯产品质量的“守护者”，守护用户的笑容，有你在才安心！\", \"status\": \"open\", \"category\": \"测试与质量管理\", \"job_type\": \"技术\", \"direction\": \"测试与质量管理\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"测试与质量管理\", \"job_category\": \"测试与质量管理\", \"business_groups\": [\"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"测试与质量管理\", \"软件测试\", \"质量保障\", \"需求分析\", \"架构分析\", \"测试方法设计\", \"测试用例设计\", \"功能测试\", \"系统性能测试\", \"平台兼容性测试\", \"API接口测试\", \"质量问题跟踪\", \"同类产品分析\", \"稳定性分析\", \"系统可靠性测试\", \"专项测试\", \"测试规划\", \"自动化测试\", \"持续集成\", \"测试工具平台\", \"交付质量\", \"评估模型\", \"评估方法\", \"量化分析\", \"软件工程\", \"操作系统\", \"计算机网络\", \"编程语言\", \"代码编写\", \"代码走读\", \"Debug工具\", \"逻辑思维\", \"沟通协调\", \"问题推动\", \"用户意识\", \"学习能力\", \"独立思考\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"广州\"], \"description\": {\"summary\": \"负责产品需求和架构分析、测试方法与测试用例设计、功能测试、性能测试、兼容性测试、API 接口测试、专项测试、自动化测试、持续集成、测试工具平台建设及质量评估模型构建。\", \"responsibilities\": [\"负责分析产品需求和架构，设计测试方法和测试用例\", \"负责产品功能、系统性能、平台兼容性、API 接口测试等测试工作\", \"在产品运营过程中发现、收集、暴露质量问题，并推动和跟踪问题解决\", \"负责同类产品分析、稳定性分析、系统可靠性等专项测试工作，对具体测试活动进行规划实施\", \"负责对测试过程实施自动化和持续集成，提升测试和项目工程效率\", \"负责行业优秀自动化测试工具平台的引入及搭建，提升整体交付质量\", \"负责构建有效的评估模型和评估方法，结合业务特点进行量化分析\"]}, \"requirements\": {\"must_have\": [\"计算机软件相关专业本科或及以上学历\", \"逻辑思维能力强\", \"具备较好的沟通协调能力和推动力\", \"掌握软件工程基础知识\", \"熟悉软件测试理论和方法\", \"有扎实的计算机理论基础\", \"熟练掌握操作系统及网络的基本原理\", \"掌握 1 门以上编程语言\", \"具备扎实的代码编写和走读能力\", \"熟悉各类常用 debug 类工具\", \"追求卓越，工作细致\", \"能站在用户的角度思考\", \"坚持原则，具备良好的学习能力和独立思考习惯\"], \"bonus_points\": [], \"nice_to_have\": [\"具备产品需求分析、架构分析、测试方法设计、测试用例设计相关理解或实践经验\", \"具备功能测试、性能测试、兼容性测试、API 接口测试相关经验\", \"具备自动化测试、持续集成、测试工具平台搭建相关理解\", \"具备稳定性分析、系统可靠性测试、质量评估模型、量化分析相关理解\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10030,'硬件开发-系统设计和验证方向','云与智慧产业事业群','深圳总部','硬件开发','系统设计和验证','技术','应届实习','实习生','应届实习','你将置身于一个充满无限可能的领域，从微小的芯片到庞大的数据中心，每一处都凝聚着你的智慧与汗水！','负责自研服务器单板设计开发、服务器研发技术文档编写、板卡原理图设计、PCB 布局布线检查、单板调试测试、ODM 测试报告评审、问题攻关定位及服务器相关技术支持。','负责自研服务器单板设计开发、服务器研发技术文档编写、板卡原理图设计、PCB 布局布线检查、单板调试测试、ODM 测试报告评审、问题攻关定位及服务器相关技术支持。','【必备要求】\n电气工程、电子工程或者计算机等专业优先\n熟悉计算机体系结构\n熟悉电路设计，包括数字电路、模拟电路\n熟悉 PCB 布局布线\n了解内存、硬盘、闪存、电源和时钟的基础知识\n具备基本的信号完整性知识\n了解常用高速和低速接口，如 PCIE、SATA、I2C、I3C、SPI、UART\n了解硬件开发、测试和维护的基本流程\n会使用万用表、示波器、数字电源等常用工具\n自学能力强，对技术有热情\n具备良好的沟通及团队协作能力\n能够自我驱动，持续学习\n\n【了解项】\n具备服务器单板设计开发、板卡调试测试相关理解或实践经验\n具备原理图设计、PCB 布局布线检查相关理解\n具备 ODM 测试报告评审、硬件问题定位、产品质量保障相关理解\n具备服务器硬件技术支持相关经验\n\n【加分项】\n了解 x86 和 ARM 处理器架构者优先\n有电路板设计经验者优先','[\"负责自研服务器单板的设计和开发\", \"负责服务器研发技术文档编写，包括产品规格、模块接口定义等\", \"负责服务器板卡的原理图设计、PCB 布局布线检查、单板调试和测试\", \"评审 ODM 的测试报告，进行问题攻关和定位，确保产品质量满足要求\", \"给内部其他部门提供服务器相关的技术支持\"]','[\"电气工程、电子工程或者计算机等专业优先\", \"熟悉计算机体系结构\", \"熟悉电路设计，包括数字电路、模拟电路\", \"熟悉 PCB 布局布线\", \"了解内存、硬盘、闪存、电源和时钟的基础知识\", \"具备基本的信号完整性知识\", \"了解常用高速和低速接口，如 PCIE、SATA、I2C、I3C、SPI、UART\", \"了解硬件开发、测试和维护的基本流程\", \"会使用万用表、示波器、数字电源等常用工具\", \"自学能力强，对技术有热情\", \"具备良好的沟通及团队协作能力\", \"能够自我驱动，持续学习\"]','[\"具备服务器单板设计开发、板卡调试测试相关理解或实践经验\", \"具备原理图设计、PCB 布局布线检查相关理解\", \"具备 ODM 测试报告评审、硬件问题定位、产品质量保障相关理解\", \"具备服务器硬件技术支持相关经验\"]','[\"了解 x86 和 ARM 处理器架构者优先\", \"有电路板设计经验者优先\"]','null','[\"硬件开发\", \"系统设计\", \"系统验证\", \"服务器单板设计\", \"服务器研发\", \"技术文档编写\", \"产品规格\", \"模块接口定义\", \"原理图设计\", \"PCB布局布线\", \"单板调试\", \"单板测试\", \"ODM测试报告评审\", \"问题攻关\", \"问题定位\", \"技术支持\", \"计算机体系结构\", \"数字电路\", \"模拟电路\", \"电路设计\", \"内存\", \"硬盘\", \"闪存\", \"电源\", \"时钟\", \"信号完整性\", \"PCIE\", \"SATA\", \"I2C\", \"I3C\", \"SPI\", \"UART\", \"硬件测试\", \"硬件维护\", \"万用表\", \"示波器\", \"数字电源\", \"x86\", \"ARM\", \"电路板设计\", \"沟通协作\", \"自驱学习\"]','[\"硬件开发\", \"系统设计\", \"系统验证\", \"服务器单板设计\", \"服务器研发\", \"技术文档编写\", \"产品规格\", \"模块接口定义\", \"原理图设计\", \"PCB布局布线\", \"单板调试\", \"单板测试\", \"ODM测试报告评审\", \"问题攻关\", \"问题定位\", \"技术支持\", \"计算机体系结构\", \"数字电路\", \"模拟电路\", \"电路设计\", \"内存\", \"硬盘\", \"闪存\", \"电源\", \"时钟\", \"信号完整性\", \"PCIE\", \"SATA\", \"I2C\", \"I3C\", \"SPI\", \"UART\", \"硬件测试\", \"硬件维护\", \"万用表\", \"示波器\", \"数字电源\", \"x86\", \"ARM\", \"电路板设计\", \"沟通协作\", \"自驱学习\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}]','[\"深圳总部\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-hardware-system-design-verification-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-hardware-system-design-verification-intern-2026-001\", \"title\": \"硬件开发-系统设计和验证方向\", \"slogan\": \"你将置身于一个充满无限可能的领域，从微小的芯片到庞大的数据中心，每一处都凝聚着你的智慧与汗水！\", \"status\": \"open\", \"category\": \"系统设计和验证\", \"job_type\": \"技术\", \"direction\": \"硬件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\"], \"job_type\": \"技术\", \"direction\": \"硬件开发\", \"job_category\": \"系统设计和验证\", \"business_groups\": [\"CSIG\", \"IEG\", \"TEG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"硬件开发\", \"系统设计\", \"系统验证\", \"服务器单板设计\", \"服务器研发\", \"技术文档编写\", \"产品规格\", \"模块接口定义\", \"原理图设计\", \"PCB布局布线\", \"单板调试\", \"单板测试\", \"ODM测试报告评审\", \"问题攻关\", \"问题定位\", \"技术支持\", \"计算机体系结构\", \"数字电路\", \"模拟电路\", \"电路设计\", \"内存\", \"硬盘\", \"闪存\", \"电源\", \"时钟\", \"信号完整性\", \"PCIE\", \"SATA\", \"I2C\", \"I3C\", \"SPI\", \"UART\", \"硬件测试\", \"硬件维护\", \"万用表\", \"示波器\", \"数字电源\", \"x86\", \"ARM\", \"电路板设计\", \"沟通协作\", \"自驱学习\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\"], \"description\": {\"summary\": \"负责自研服务器单板设计开发、服务器研发技术文档编写、板卡原理图设计、PCB 布局布线检查、单板调试测试、ODM 测试报告评审、问题攻关定位及服务器相关技术支持。\", \"responsibilities\": [\"负责自研服务器单板的设计和开发\", \"负责服务器研发技术文档编写，包括产品规格、模块接口定义等\", \"负责服务器板卡的原理图设计、PCB 布局布线检查、单板调试和测试\", \"评审 ODM 的测试报告，进行问题攻关和定位，确保产品质量满足要求\", \"给内部其他部门提供服务器相关的技术支持\"]}, \"requirements\": {\"must_have\": [\"电气工程、电子工程或者计算机等专业优先\", \"熟悉计算机体系结构\", \"熟悉电路设计，包括数字电路、模拟电路\", \"熟悉 PCB 布局布线\", \"了解内存、硬盘、闪存、电源和时钟的基础知识\", \"具备基本的信号完整性知识\", \"了解常用高速和低速接口，如 PCIE、SATA、I2C、I3C、SPI、UART\", \"了解硬件开发、测试和维护的基本流程\", \"会使用万用表、示波器、数字电源等常用工具\", \"自学能力强，对技术有热情\", \"具备良好的沟通及团队协作能力\", \"能够自我驱动，持续学习\"], \"bonus_points\": [\"了解 x86 和 ARM 处理器架构者优先\", \"有电路板设计经验者优先\"], \"nice_to_have\": [\"具备服务器单板设计开发、板卡调试测试相关理解或实践经验\", \"具备原理图设计、PCB 布局布线检查相关理解\", \"具备 ODM 测试报告评审、硬件问题定位、产品质量保障相关理解\", \"具备服务器硬件技术支持相关经验\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10031,'软件开发-运营开发方向','企业发展事业群','深圳总部','软件开发','运营开发','技术','应届实习','实习生','应届实习','你将打造出强大的运营架构云平台，建起日理万“机”的管控系统，你就是腾讯最佳运营开发工程师！','负责 DevOps 相关平台的架构设计、功能开发、稳定性优化和流程效率提升，覆盖研效过程管理、云资源运营、监控可观测、大数据平台建设及运营服务平台建设。','负责 DevOps 相关平台的架构设计、功能开发、稳定性优化和流程效率提升，覆盖研效过程管理、云资源运营、监控可观测、大数据平台建设及运营服务平台建设。','【必备要求】\n计算机相关专业本科或及以上学历\n具备扎实的计算机编程、优化及问题排查能力\n熟悉 Java、Go、Python、C++、Shell 等一种或多种后端编程语言\n熟悉 JS、Vue、React 等一种或多种前端编程语言或框架\n接触过相应的开源组件并有一定理解\n熟悉操作系统、网络等相关系统知识\n对 Kubernetes 云原生技术有基本了解\n\n【了解项】\n具备 DevOps 平台架构设计、功能开发、稳定性优化相关理解或实践经验\n具备研效过程管理、持续交付、系统测试、上线流程优化相关理解\n具备 IaaS、PaaS、SaaS 资源运营、监控可观测、调度操作平台建设相关经验\n具备大数据采集、传输、存储、应用平台建设相关理解\n具备运营服务平台、接入流程平台、全栈开发相关实践经验\n\n【加分项】\n开源社区活跃贡献者\n具备前后端全栈开发能力\n熟悉云路由组件、消息队列、数据库、云存储等技术，并有实操经验\n具备分布式架构、高并发调优、大数据处理等项目实战经验','[\"负责 DevOps 相关平台的架构设计、功能开发、稳定性优化、流程效率提升等建设工作\", \"负责从需求、版本研发、系统测试到现网上线的全流程研效过程管理与提效\", \"负责 IaaS、PaaS、SaaS 相关资源与系统稳定运营、监控可观测、调度操作等平台建设\", \"负责海量大数据相关采集、传输、存储、应用等相关平台建设\", \"负责为客户提供安全可控、个性自助、高效便捷的接入流程与运营服务平台\"]','[\"计算机相关专业本科或及以上学历\", \"具备扎实的计算机编程、优化及问题排查能力\", \"熟悉 Java、Go、Python、C++、Shell 等一种或多种后端编程语言\", \"熟悉 JS、Vue、React 等一种或多种前端编程语言或框架\", \"接触过相应的开源组件并有一定理解\", \"熟悉操作系统、网络等相关系统知识\", \"对 Kubernetes 云原生技术有基本了解\"]','[\"具备 DevOps 平台架构设计、功能开发、稳定性优化相关理解或实践经验\", \"具备研效过程管理、持续交付、系统测试、上线流程优化相关理解\", \"具备 IaaS、PaaS、SaaS 资源运营、监控可观测、调度操作平台建设相关经验\", \"具备大数据采集、传输、存储、应用平台建设相关理解\", \"具备运营服务平台、接入流程平台、全栈开发相关实践经验\"]','[\"开源社区活跃贡献者\", \"具备前后端全栈开发能力\", \"熟悉云路由组件、消息队列、数据库、云存储等技术，并有实操经验\", \"具备分布式架构、高并发调优、大数据处理等项目实战经验\"]','null','[\"运营开发\", \"DevOps\", \"平台架构设计\", \"功能开发\", \"稳定性优化\", \"流程效率提升\", \"研效管理\", \"需求管理\", \"版本研发\", \"系统测试\", \"现网上线\", \"IaaS\", \"PaaS\", \"SaaS\", \"资源运营\", \"系统稳定运营\", \"监控可观测\", \"调度操作\", \"大数据采集\", \"大数据传输\", \"大数据存储\", \"大数据应用\", \"运营服务平台\", \"接入流程\", \"Java\", \"Go\", \"Python\", \"C++\", \"Shell\", \"JS\", \"JavaScript\", \"Vue\", \"React\", \"开源组件\", \"操作系统\", \"计算机网络\", \"Kubernetes\", \"云原生\", \"全栈开发\", \"云路由组件\", \"消息队列\", \"数据库\", \"云存储\", \"分布式架构\", \"高并发调优\", \"大数据处理\", \"问题排查\", \"性能优化\"]','[\"运营开发\", \"DevOps\", \"平台架构设计\", \"功能开发\", \"稳定性优化\", \"流程效率提升\", \"研效管理\", \"需求管理\", \"版本研发\", \"系统测试\", \"现网上线\", \"IaaS\", \"PaaS\", \"SaaS\", \"资源运营\", \"系统稳定运营\", \"监控可观测\", \"调度操作\", \"大数据采集\", \"大数据传输\", \"大数据存储\", \"大数据应用\", \"运营服务平台\", \"接入流程\", \"Java\", \"Go\", \"Python\", \"C++\", \"Shell\", \"JS\", \"JavaScript\", \"Vue\", \"React\", \"开源组件\", \"操作系统\", \"计算机网络\", \"Kubernetes\", \"云原生\", \"全栈开发\", \"云路由组件\", \"消息队列\", \"数据库\", \"云存储\", \"分布式架构\", \"高并发调优\", \"大数据处理\", \"问题排查\", \"性能优化\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-operations-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-operations-development-intern-2026-001\", \"title\": \"软件开发-运营开发方向\", \"slogan\": \"你将打造出强大的运营架构云平台，建起日理万“机”的管控系统，你就是腾讯最佳运营开发工程师！\", \"status\": \"open\", \"category\": \"运营开发\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"运营开发\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"运营开发\", \"DevOps\", \"平台架构设计\", \"功能开发\", \"稳定性优化\", \"流程效率提升\", \"研效管理\", \"需求管理\", \"版本研发\", \"系统测试\", \"现网上线\", \"IaaS\", \"PaaS\", \"SaaS\", \"资源运营\", \"系统稳定运营\", \"监控可观测\", \"调度操作\", \"大数据采集\", \"大数据传输\", \"大数据存储\", \"大数据应用\", \"运营服务平台\", \"接入流程\", \"Java\", \"Go\", \"Python\", \"C++\", \"Shell\", \"JS\", \"JavaScript\", \"Vue\", \"React\", \"开源组件\", \"操作系统\", \"计算机网络\", \"Kubernetes\", \"云原生\", \"全栈开发\", \"云路由组件\", \"消息队列\", \"数据库\", \"云存储\", \"分布式架构\", \"高并发调优\", \"大数据处理\", \"问题排查\", \"性能优化\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责 DevOps 相关平台的架构设计、功能开发、稳定性优化和流程效率提升，覆盖研效过程管理、云资源运营、监控可观测、大数据平台建设及运营服务平台建设。\", \"responsibilities\": [\"负责 DevOps 相关平台的架构设计、功能开发、稳定性优化、流程效率提升等建设工作\", \"负责从需求、版本研发、系统测试到现网上线的全流程研效过程管理与提效\", \"负责 IaaS、PaaS、SaaS 相关资源与系统稳定运营、监控可观测、调度操作等平台建设\", \"负责海量大数据相关采集、传输、存储、应用等相关平台建设\", \"负责为客户提供安全可控、个性自助、高效便捷的接入流程与运营服务平台\"]}, \"requirements\": {\"must_have\": [\"计算机相关专业本科或及以上学历\", \"具备扎实的计算机编程、优化及问题排查能力\", \"熟悉 Java、Go、Python、C++、Shell 等一种或多种后端编程语言\", \"熟悉 JS、Vue、React 等一种或多种前端编程语言或框架\", \"接触过相应的开源组件并有一定理解\", \"熟悉操作系统、网络等相关系统知识\", \"对 Kubernetes 云原生技术有基本了解\"], \"bonus_points\": [\"开源社区活跃贡献者\", \"具备前后端全栈开发能力\", \"熟悉云路由组件、消息队列、数据库、云存储等技术，并有实操经验\", \"具备分布式架构、高并发调优、大数据处理等项目实战经验\"], \"nice_to_have\": [\"具备 DevOps 平台架构设计、功能开发、稳定性优化相关理解或实践经验\", \"具备研效过程管理、持续交付、系统测试、上线流程优化相关理解\", \"具备 IaaS、PaaS、SaaS 资源运营、监控可观测、调度操作平台建设相关经验\", \"具备大数据采集、传输、存储、应用平台建设相关理解\", \"具备运营服务平台、接入流程平台、全栈开发相关实践经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10032,'软件开发-全栈开发方向','企业发展事业群','深圳总部','软件开发','全栈开发','技术','应届实习','实习生','应届实习','你充满魔力的双手，设计并建造出高可靠的站点架构，你的努力，让亿万互联网用户享受便利，安心前行！','负责公司 IT 产品技术架构建设、关键 IT 服务与 IT 基础设施构建维护，覆盖内部 IT 系统、对外业务管理系统、企业核心管理、办公、研发过程管理和业务后台管理等方向。','负责公司 IT 产品技术架构建设、关键 IT 服务与 IT 基础设施构建维护，覆盖内部 IT 系统、对外业务管理系统、企业核心管理、办公、研发过程管理和业务后台管理等方向。','【必备要求】\n熟练掌握 React、Vue 等前端技术\n熟悉 Java、C++、Python、Go 等主流编程语言\n接触过相应的开发框架并有一定理解\n能熟练使用 MySQL、MongoDB 等数据库\n具备较强的学习能力\n具备较强的分析及解决问题能力\n具备良好的团队合作意识\n心态好，有责任心\n\n【了解项】\n具备前端开发、后端开发、数据库设计、系统开发相关理解或实践经验\n具备内部 IT 系统、业务管理系统、业务后台管理系统开发相关经验\n具备基础架构设计、方案规划、系统开发相关理解\n具备业务与技术结合的方案设计能力\n\n【加分项】\n有 jQuery、Node.js 等 JS 框架使用及扩展编写经验\n了解 Redis、Memcache 等缓存中间件\n有性能优化方面的经验','[\"负责实现和优化公司 IT 产品的技术架构建设\", \"负责构建和维护关键 IT 服务与 IT 基础设施\", \"负责公司内部 IT 系统和对外业务管理系统的基础架构设计、方案规划和系统开发\", \"参与内部 IT 建设、企业核心管理领域、内部办公、研发过程管理、业务后台管理系统等方向建设\", \"通过对专业领域的理解和规划，结合自身 IT 能力，提供业务与技术结合的全方案\", \"解决专业领域 IT 化和落地实施的问题\"]','[\"熟练掌握 React、Vue 等前端技术\", \"熟悉 Java、C++、Python、Go 等主流编程语言\", \"接触过相应的开发框架并有一定理解\", \"能熟练使用 MySQL、MongoDB 等数据库\", \"具备较强的学习能力\", \"具备较强的分析及解决问题能力\", \"具备良好的团队合作意识\", \"心态好，有责任心\"]','[\"具备前端开发、后端开发、数据库设计、系统开发相关理解或实践经验\", \"具备内部 IT 系统、业务管理系统、业务后台管理系统开发相关经验\", \"具备基础架构设计、方案规划、系统开发相关理解\", \"具备业务与技术结合的方案设计能力\"]','[\"有 jQuery、Node.js 等 JS 框架使用及扩展编写经验\", \"了解 Redis、Memcache 等缓存中间件\", \"有性能优化方面的经验\"]','null','[\"全栈开发\", \"前端开发\", \"后端开发\", \"IT系统开发\", \"技术架构\", \"基础架构设计\", \"方案规划\", \"系统开发\", \"IT服务\", \"IT基础设施\", \"内部IT建设\", \"企业核心管理系统\", \"内部办公系统\", \"研发过程管理\", \"业务后台管理系统\", \"对外业务管理系统\", \"业务技术方案\", \"React\", \"Vue\", \"Java\", \"C++\", \"Python\", \"Go\", \"MySQL\", \"MongoDB\", \"jQuery\", \"Node.js\", \"Redis\", \"Memcache\", \"缓存中间件\", \"性能优化\", \"问题分析\", \"问题解决\", \"学习能力\", \"团队合作\", \"责任心\"]','[\"全栈开发\", \"前端开发\", \"后端开发\", \"IT系统开发\", \"技术架构\", \"基础架构设计\", \"方案规划\", \"系统开发\", \"IT服务\", \"IT基础设施\", \"内部IT建设\", \"企业核心管理系统\", \"内部办公系统\", \"研发过程管理\", \"业务后台管理系统\", \"对外业务管理系统\", \"业务技术方案\", \"React\", \"Vue\", \"Java\", \"C++\", \"Python\", \"Go\", \"MySQL\", \"MongoDB\", \"jQuery\", \"Node.js\", \"Redis\", \"Memcache\", \"缓存中间件\", \"性能优化\", \"问题分析\", \"问题解决\", \"学习能力\", \"团队合作\", \"责任心\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-fullstack-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-fullstack-development-intern-2026-001\", \"title\": \"软件开发-全栈开发方向\", \"slogan\": \"你充满魔力的双手，设计并建造出高可靠的站点架构，你的努力，让亿万互联网用户享受便利，安心前行！\", \"status\": \"open\", \"category\": \"全栈开发\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"成都\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"全栈开发\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"全栈开发\", \"前端开发\", \"后端开发\", \"IT系统开发\", \"技术架构\", \"基础架构设计\", \"方案规划\", \"系统开发\", \"IT服务\", \"IT基础设施\", \"内部IT建设\", \"企业核心管理系统\", \"内部办公系统\", \"研发过程管理\", \"业务后台管理系统\", \"对外业务管理系统\", \"业务技术方案\", \"React\", \"Vue\", \"Java\", \"C++\", \"Python\", \"Go\", \"MySQL\", \"MongoDB\", \"jQuery\", \"Node.js\", \"Redis\", \"Memcache\", \"缓存中间件\", \"性能优化\", \"问题分析\", \"问题解决\", \"学习能力\", \"团队合作\", \"责任心\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"成都\"], \"description\": {\"summary\": \"负责公司 IT 产品技术架构建设、关键 IT 服务与 IT 基础设施构建维护，覆盖内部 IT 系统、对外业务管理系统、企业核心管理、办公、研发过程管理和业务后台管理等方向。\", \"responsibilities\": [\"负责实现和优化公司 IT 产品的技术架构建设\", \"负责构建和维护关键 IT 服务与 IT 基础设施\", \"负责公司内部 IT 系统和对外业务管理系统的基础架构设计、方案规划和系统开发\", \"参与内部 IT 建设、企业核心管理领域、内部办公、研发过程管理、业务后台管理系统等方向建设\", \"通过对专业领域的理解和规划，结合自身 IT 能力，提供业务与技术结合的全方案\", \"解决专业领域 IT 化和落地实施的问题\"]}, \"requirements\": {\"must_have\": [\"熟练掌握 React、Vue 等前端技术\", \"熟悉 Java、C++、Python、Go 等主流编程语言\", \"接触过相应的开发框架并有一定理解\", \"能熟练使用 MySQL、MongoDB 等数据库\", \"具备较强的学习能力\", \"具备较强的分析及解决问题能力\", \"具备良好的团队合作意识\", \"心态好，有责任心\"], \"bonus_points\": [\"有 jQuery、Node.js 等 JS 框架使用及扩展编写经验\", \"了解 Redis、Memcache 等缓存中间件\", \"有性能优化方面的经验\"], \"nice_to_have\": [\"具备前端开发、后端开发、数据库设计、系统开发相关理解或实践经验\", \"具备内部 IT 系统、业务管理系统、业务后台管理系统开发相关经验\", \"具备基础架构设计、方案规划、系统开发相关理解\", \"具备业务与技术结合的方案设计能力\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10033,'算法-机器学习方向','企业发展事业群','深圳总部','算法','机器学习','技术','应届实习','实习生','应届实习','对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！','负责海量数据分析与挖掘、用户画像模型构建、机器学习和深度学习算法模型开发、分布式算法加速、前沿机器学习技术研究，并为计算机视觉、语音识别、自然语言处理、精准推荐等领域提供模型支持和落地方案。','负责海量数据分析与挖掘、用户画像模型构建、机器学习和深度学习算法模型开发、分布式算法加速、前沿机器学习技术研究，并为计算机视觉、语音识别、自然语言处理、精准推荐等领域提供模型支持和落地方案。','【必备要求】\n包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\n熟悉常用机器学习算法，尤其是深度学习、增强学习等相关领域\n对模式识别、概率统计、最优化等算法原理及应用有扎实基础、深入理解和浓厚兴趣\n熟练掌握 C/C++、Java、Python 等至少一门编程语言\n具备较强动手能力\n了解 Spark、XGBoost、Caffe、TensorFlow 等常见机器学习或深度学习框架中的一个或多个\n乐于动手，有良好的逻辑思维能力和数据敏感度\n能够熟练阅读和编写英文论文\n具有优秀的新技术研究能力\n\n【了解项】\n具备海量数据分析、数据挖掘、用户画像模型构建相关理解或实践经验\n具备神经网络模型设计、超参数优化、学习方法和优化方法实验相关经验\n具备分布式算法实现、模型加速、公用并行算法库建设相关理解\n熟悉计算机视觉、语音识别、自然语言处理、精准推荐等一个或多个应用方向\n具备机器学习或深度学习技术解决方案设计与落地经验\n\n【加分项】\n在 NeurIPS、ICML、KDD、AAAI、IJCAI、UAI、AISTATS、ICLR、ECML、SIGIR 等机器学习领域会议或期刊以第一作者发表过文章\n有相关的开源项目贡献经验','[\"了解腾讯的数据，负责海量数据的分析和挖掘工作，构建多个业务领域内的用户画像模型\", \"负责机器学习，尤其是深度学习领域的算法和模型开发，包括神经网络模型设计、超参数优化、各种学习和优化方法尝试\", \"对业务方已有的算法和模型的分布式实现进行加速，丰富公司内部的公用并行算法库\", \"对机器学习尤其是深度学习前沿问题进行探索与研究，结合未来实际应用场景，提供全面的技术解决方案\", \"对计算机视觉、语音识别、自然语言处理、精准推荐等领域提供模型支持，进行创新应用试验和落地产品开发\"]','[\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟悉常用机器学习算法，尤其是深度学习、增强学习等相关领域\", \"对模式识别、概率统计、最优化等算法原理及应用有扎实基础、深入理解和浓厚兴趣\", \"熟练掌握 C/C++、Java、Python 等至少一门编程语言\", \"具备较强动手能力\", \"了解 Spark、XGBoost、Caffe、TensorFlow 等常见机器学习或深度学习框架中的一个或多个\", \"乐于动手，有良好的逻辑思维能力和数据敏感度\", \"能够熟练阅读和编写英文论文\", \"具有优秀的新技术研究能力\"]','[\"具备海量数据分析、数据挖掘、用户画像模型构建相关理解或实践经验\", \"具备神经网络模型设计、超参数优化、学习方法和优化方法实验相关经验\", \"具备分布式算法实现、模型加速、公用并行算法库建设相关理解\", \"熟悉计算机视觉、语音识别、自然语言处理、精准推荐等一个或多个应用方向\", \"具备机器学习或深度学习技术解决方案设计与落地经验\"]','[\"在 NeurIPS、ICML、KDD、AAAI、IJCAI、UAI、AISTATS、ICLR、ECML、SIGIR 等机器学习领域会议或期刊以第一作者发表过文章\", \"有相关的开源项目贡献经验\"]','null','[\"机器学习\", \"深度学习\", \"增强学习\", \"海量数据分析\", \"数据挖掘\", \"用户画像\", \"神经网络\", \"模型设计\", \"超参数优化\", \"学习方法\", \"优化方法\", \"分布式实现\", \"模型加速\", \"并行算法库\", \"模式识别\", \"概率统计\", \"最优化\", \"计算机视觉\", \"语音识别\", \"自然语言处理\", \"精准推荐\", \"创新应用试验\", \"产品落地\", \"C/C++\", \"Java\", \"Python\", \"Spark\", \"XGBoost\", \"Caffe\", \"TensorFlow\", \"算法研发\", \"模型开发\", \"技术解决方案\", \"数据敏感度\", \"英文论文阅读\", \"英文论文写作\", \"新技术研究\"]','[\"机器学习\", \"深度学习\", \"增强学习\", \"海量数据分析\", \"数据挖掘\", \"用户画像\", \"神经网络\", \"模型设计\", \"超参数优化\", \"学习方法\", \"优化方法\", \"分布式实现\", \"模型加速\", \"并行算法库\", \"模式识别\", \"概率统计\", \"最优化\", \"计算机视觉\", \"语音识别\", \"自然语言处理\", \"精准推荐\", \"创新应用试验\", \"产品落地\", \"C/C++\", \"Java\", \"Python\", \"Spark\", \"XGBoost\", \"Caffe\", \"TensorFlow\", \"算法研发\", \"模型开发\", \"技术解决方案\", \"数据敏感度\", \"英文论文阅读\", \"英文论文写作\", \"新技术研究\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-algorithm-machine-learning-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-algorithm-machine-learning-intern-2026-001\", \"title\": \"算法-机器学习方向\", \"slogan\": \"对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！\", \"status\": \"open\", \"category\": \"机器学习\", \"job_type\": \"技术\", \"direction\": \"算法\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"job_type\": \"技术\", \"direction\": \"算法\", \"job_category\": \"机器学习\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"机器学习\", \"深度学习\", \"增强学习\", \"海量数据分析\", \"数据挖掘\", \"用户画像\", \"神经网络\", \"模型设计\", \"超参数优化\", \"学习方法\", \"优化方法\", \"分布式实现\", \"模型加速\", \"并行算法库\", \"模式识别\", \"概率统计\", \"最优化\", \"计算机视觉\", \"语音识别\", \"自然语言处理\", \"精准推荐\", \"创新应用试验\", \"产品落地\", \"C/C++\", \"Java\", \"Python\", \"Spark\", \"XGBoost\", \"Caffe\", \"TensorFlow\", \"算法研发\", \"模型开发\", \"技术解决方案\", \"数据敏感度\", \"英文论文阅读\", \"英文论文写作\", \"新技术研究\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"description\": {\"summary\": \"负责海量数据分析与挖掘、用户画像模型构建、机器学习和深度学习算法模型开发、分布式算法加速、前沿机器学习技术研究，并为计算机视觉、语音识别、自然语言处理、精准推荐等领域提供模型支持和落地方案。\", \"responsibilities\": [\"了解腾讯的数据，负责海量数据的分析和挖掘工作，构建多个业务领域内的用户画像模型\", \"负责机器学习，尤其是深度学习领域的算法和模型开发，包括神经网络模型设计、超参数优化、各种学习和优化方法尝试\", \"对业务方已有的算法和模型的分布式实现进行加速，丰富公司内部的公用并行算法库\", \"对机器学习尤其是深度学习前沿问题进行探索与研究，结合未来实际应用场景，提供全面的技术解决方案\", \"对计算机视觉、语音识别、自然语言处理、精准推荐等领域提供模型支持，进行创新应用试验和落地产品开发\"]}, \"requirements\": {\"must_have\": [\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟悉常用机器学习算法，尤其是深度学习、增强学习等相关领域\", \"对模式识别、概率统计、最优化等算法原理及应用有扎实基础、深入理解和浓厚兴趣\", \"熟练掌握 C/C++、Java、Python 等至少一门编程语言\", \"具备较强动手能力\", \"了解 Spark、XGBoost、Caffe、TensorFlow 等常见机器学习或深度学习框架中的一个或多个\", \"乐于动手，有良好的逻辑思维能力和数据敏感度\", \"能够熟练阅读和编写英文论文\", \"具有优秀的新技术研究能力\"], \"bonus_points\": [\"在 NeurIPS、ICML、KDD、AAAI、IJCAI、UAI、AISTATS、ICLR、ECML、SIGIR 等机器学习领域会议或期刊以第一作者发表过文章\", \"有相关的开源项目贡献经验\"], \"nice_to_have\": [\"具备海量数据分析、数据挖掘、用户画像模型构建相关理解或实践经验\", \"具备神经网络模型设计、超参数优化、学习方法和优化方法实验相关经验\", \"具备分布式算法实现、模型加速、公用并行算法库建设相关理解\", \"熟悉计算机视觉、语音识别、自然语言处理、精准推荐等一个或多个应用方向\", \"具备机器学习或深度学习技术解决方案设计与落地经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10034,'算法-多媒体处理方向','企业发展事业群','深圳总部','算法','多媒体处理','技术','应届实习','实习生','应届实习','对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！','负责多媒体方向算法研究与开发，覆盖口语语言理解、用户意图理解、对话模型、人机对话、语音识别与合成、领域知识图谱、智能问答、视频编解码标准研究及视频处理技术方案落地。','负责多媒体方向算法研究与开发，覆盖口语语言理解、用户意图理解、对话模型、人机对话、语音识别与合成、领域知识图谱、智能问答、视频编解码标准研究及视频处理技术方案落地。','【必备要求】\n包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\n熟练掌握至少一种编程语言，包括 Java、C/C++、C#、Python 等\n有声学、语音信号背景知识\n具备语音识别、语音分离、语音合成、说话人识别相关研发经验，或熟悉 HEVC、AVS2 等视频编码标准\n有 VVC 或 AVS3 标准研究经验，具有扎实的图像、视频处理基础\n\n【了解项】\n具备口语语言理解、用户意图理解、对话模型、人机对话相关研究或工程经验\n熟悉深度学习、深度强化学习等算法方向\n具备语音前端处理、声学模型、语言模型、语言解码、TTS 相关理解或实践经验\n具备领域知识图谱建设、智能问答相关经验\n具备视频编解码算法实现、视频编码标准研究、视频处理技术相关经验\n\n【加分项】\n在 ICASSP、INTERSPEECH、ISCSLP、ASRU、JVET、iWAENC、WASPAA、AES Convention 等学术会议或期刊以第一作者发表过文章\n有丰富项目经验','[\"负责口语语言理解、用户意图理解、对话模型、人机对话、深度学习、深度强化学习等算法研究和开发\", \"负责语音识别和语音合成方向的技术研发工作，包括语音前端处理、声学模型、语言模型建立、语言解码、语音合成 TTS 等\", \"负责针对对话交互的领域知识图谱建设和智能问答\", \"负责下一代视频编解码标准研究，负责视频编解码算法实现及优化\", \"负责语音识别和语音合成方向、前沿视频编码技术和前沿视频处理技术等问题的探索与研究，结合未来实际应用场景，提供全面的技术解决方案\"]','[\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握至少一种编程语言，包括 Java、C/C++、C#、Python 等\", \"有声学、语音信号背景知识\", \"具备语音识别、语音分离、语音合成、说话人识别相关研发经验，或熟悉 HEVC、AVS2 等视频编码标准\", \"有 VVC 或 AVS3 标准研究经验，具有扎实的图像、视频处理基础\"]','[\"具备口语语言理解、用户意图理解、对话模型、人机对话相关研究或工程经验\", \"熟悉深度学习、深度强化学习等算法方向\", \"具备语音前端处理、声学模型、语言模型、语言解码、TTS 相关理解或实践经验\", \"具备领域知识图谱建设、智能问答相关经验\", \"具备视频编解码算法实现、视频编码标准研究、视频处理技术相关经验\"]','[\"在 ICASSP、INTERSPEECH、ISCSLP、ASRU、JVET、iWAENC、WASPAA、AES Convention 等学术会议或期刊以第一作者发表过文章\", \"有丰富项目经验\"]','null','[\"多媒体处理\", \"口语语言理解\", \"用户意图理解\", \"对话模型\", \"人机对话\", \"深度学习\", \"深度强化学习\", \"语音识别\", \"语音合成\", \"TTS\", \"语音前端处理\", \"声学模型\", \"语言模型\", \"语言解码\", \"语音分离\", \"说话人识别\", \"声学\", \"语音信号处理\", \"领域知识图谱\", \"智能问答\", \"视频编解码\", \"视频编码标准\", \"视频编解码算法\", \"视频处理\", \"HEVC\", \"AVS2\", \"VVC\", \"AVS3\", \"图像处理\", \"Java\", \"C/C++\", \"C#\", \"Python\", \"算法研发\", \"技术解决方案\"]','[\"多媒体处理\", \"口语语言理解\", \"用户意图理解\", \"对话模型\", \"人机对话\", \"深度学习\", \"深度强化学习\", \"语音识别\", \"语音合成\", \"TTS\", \"语音前端处理\", \"声学模型\", \"语言模型\", \"语言解码\", \"语音分离\", \"说话人识别\", \"声学\", \"语音信号处理\", \"领域知识图谱\", \"智能问答\", \"视频编解码\", \"视频编码标准\", \"视频编解码算法\", \"视频处理\", \"HEVC\", \"AVS2\", \"VVC\", \"AVS3\", \"图像处理\", \"Java\", \"C/C++\", \"C#\", \"Python\", \"算法研发\", \"技术解决方案\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-algorithm-multimedia-processing-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-algorithm-multimedia-processing-intern-2026-001\", \"title\": \"算法-多媒体处理方向\", \"slogan\": \"对一个研究者来说，丰富的应用场景、全谱领域的技术积累、追求极致的氛围都很重要，而你正是其中一员！\", \"status\": \"open\", \"category\": \"多媒体处理\", \"job_type\": \"技术\", \"direction\": \"算法\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"算法\", \"job_category\": \"多媒体处理\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"多媒体处理\", \"口语语言理解\", \"用户意图理解\", \"对话模型\", \"人机对话\", \"深度学习\", \"深度强化学习\", \"语音识别\", \"语音合成\", \"TTS\", \"语音前端处理\", \"声学模型\", \"语言模型\", \"语言解码\", \"语音分离\", \"说话人识别\", \"声学\", \"语音信号处理\", \"领域知识图谱\", \"智能问答\", \"视频编解码\", \"视频编码标准\", \"视频编解码算法\", \"视频处理\", \"HEVC\", \"AVS2\", \"VVC\", \"AVS3\", \"图像处理\", \"Java\", \"C/C++\", \"C#\", \"Python\", \"算法研发\", \"技术解决方案\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责多媒体方向算法研究与开发，覆盖口语语言理解、用户意图理解、对话模型、人机对话、语音识别与合成、领域知识图谱、智能问答、视频编解码标准研究及视频处理技术方案落地。\", \"responsibilities\": [\"负责口语语言理解、用户意图理解、对话模型、人机对话、深度学习、深度强化学习等算法研究和开发\", \"负责语音识别和语音合成方向的技术研发工作，包括语音前端处理、声学模型、语言模型建立、语言解码、语音合成 TTS 等\", \"负责针对对话交互的领域知识图谱建设和智能问答\", \"负责下一代视频编解码标准研究，负责视频编解码算法实现及优化\", \"负责语音识别和语音合成方向、前沿视频编码技术和前沿视频处理技术等问题的探索与研究，结合未来实际应用场景，提供全面的技术解决方案\"]}, \"requirements\": {\"must_have\": [\"包含但不限于计算机、信息工程、模式识别、人工智能、自动化、软件工程、电子工程、统计学、应用数学、物理学/量子计算、信息安全、信号与信息处理等专业的博士和优秀硕士\", \"熟练掌握至少一种编程语言，包括 Java、C/C++、C#、Python 等\", \"有声学、语音信号背景知识\", \"具备语音识别、语音分离、语音合成、说话人识别相关研发经验，或熟悉 HEVC、AVS2 等视频编码标准\", \"有 VVC 或 AVS3 标准研究经验，具有扎实的图像、视频处理基础\"], \"bonus_points\": [\"在 ICASSP、INTERSPEECH、ISCSLP、ASRU、JVET、iWAENC、WASPAA、AES Convention 等学术会议或期刊以第一作者发表过文章\", \"有丰富项目经验\"], \"nice_to_have\": [\"具备口语语言理解、用户意图理解、对话模型、人机对话相关研究或工程经验\", \"熟悉深度学习、深度强化学习等算法方向\", \"具备语音前端处理、声学模型、语言模型、语言解码、TTS 相关理解或实践经验\", \"具备领域知识图谱建设、智能问答相关经验\", \"具备视频编解码算法实现、视频编码标准研究、视频处理技术相关经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10035,'软件开发-PC客户端开发方向','云与智慧产业事业群','深圳总部','软件开发','PC客户端开发','技术','应届实习','实习生','应届实习','你将设计并研发高性能、高稳定、高体验的 PC 客户端，为亿万用户提供高品质服务，实现技术创造价值！','负责 Windows、Mac、Linux 等桌面端软件的界面设计、功能开发、性能优化、基础组件与架构设计、稳定性和安全性改进，并结合 VisionPro、裸眼 3D 渲染等新交互形态迭代产品功能。','负责 Windows、Mac、Linux 等桌面端软件的界面设计、功能开发、性能优化、基础组件与架构设计、稳定性和安全性改进，并结合 VisionPro、裸眼 3D 渲染等新交互形态迭代产品功能。','【必备要求】\n计算机软件或相关专业本科或以上学历\n具有扎实的编程基础\n对算法和数据结构有深入理解\n熟练掌握 C/C++ 和 STL 编程语言\n具备 Windows、macOS、Linux 下网络编程的实际经验\n具有客户端开发与调试技能\n在至少一种主要操作系统，如 Windows、macOS、Linux 上有实操经验\n对追求技术创新和解决挑战性问题保持持续热情\n\n【了解项】\n具备桌面端软件界面设计、功能开发与优化相关理解或实践经验\n具备客户端性能优化、响应速度优化、稳定性和安全性治理相关经验\n具备客户端基础组件、客户端架构设计相关理解\n具备 VisionPro、裸眼 3D 渲染等新交互形态相关理解\n\n【加分项】\n了解 Windows、macOS、Linux 操作系统的内存管理、文件系统、进程和线程调度\n了解 Windows、macOS、Linux 界面实现机制\n有实际的 Windows、macOS、Linux 应用软件开发经验','[\"负责 Windows、Mac、Linux 等桌面端软件的界面设计和功能开发\", \"负责客户端的性能优化和响应速度提升，确保软件流畅稳定地运行\", \"负责客户端基础组件及架构设计，提升研发效率\", \"负责改进客户端稳定性和安全性，减少系统漏洞和故障\", \"响应适配市场变化及新的交互形态，迭代更新产品功能以满足用户需求，如 VisionPro、裸眼 3D 渲染等\"]','[\"计算机软件或相关专业本科或以上学历\", \"具有扎实的编程基础\", \"对算法和数据结构有深入理解\", \"熟练掌握 C/C++ 和 STL 编程语言\", \"具备 Windows、macOS、Linux 下网络编程的实际经验\", \"具有客户端开发与调试技能\", \"在至少一种主要操作系统，如 Windows、macOS、Linux 上有实操经验\", \"对追求技术创新和解决挑战性问题保持持续热情\"]','[\"具备桌面端软件界面设计、功能开发与优化相关理解或实践经验\", \"具备客户端性能优化、响应速度优化、稳定性和安全性治理相关经验\", \"具备客户端基础组件、客户端架构设计相关理解\", \"具备 VisionPro、裸眼 3D 渲染等新交互形态相关理解\"]','[\"了解 Windows、macOS、Linux 操作系统的内存管理、文件系统、进程和线程调度\", \"了解 Windows、macOS、Linux 界面实现机制\", \"有实际的 Windows、macOS、Linux 应用软件开发经验\"]','null','[\"PC客户端开发\", \"桌面端开发\", \"客户端开发\", \"界面设计\", \"功能开发\", \"性能优化\", \"响应速度优化\", \"客户端基础组件\", \"客户端架构设计\", \"研发效率提升\", \"客户端稳定性\", \"客户端安全性\", \"系统漏洞治理\", \"故障治理\", \"Windows\", \"macOS\", \"Linux\", \"网络编程\", \"客户端调试\", \"C/C++\", \"STL\", \"算法\", \"数据结构\", \"内存管理\", \"文件系统\", \"进程调度\", \"线程调度\", \"界面实现机制\", \"VisionPro\", \"裸眼3D渲染\", \"技术创新\", \"问题解决\"]','[\"PC客户端开发\", \"桌面端开发\", \"客户端开发\", \"界面设计\", \"功能开发\", \"性能优化\", \"响应速度优化\", \"客户端基础组件\", \"客户端架构设计\", \"研发效率提升\", \"客户端稳定性\", \"客户端安全性\", \"系统漏洞治理\", \"故障治理\", \"Windows\", \"macOS\", \"Linux\", \"网络编程\", \"客户端调试\", \"C/C++\", \"STL\", \"算法\", \"数据结构\", \"内存管理\", \"文件系统\", \"进程调度\", \"线程调度\", \"界面实现机制\", \"VisionPro\", \"裸眼3D渲染\", \"技术创新\", \"问题解决\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-pc-client-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-pc-client-development-intern-2026-001\", \"title\": \"软件开发-PC客户端开发方向\", \"slogan\": \"你将设计并研发高性能、高稳定、高体验的 PC 客户端，为亿万用户提供高品质服务，实现技术创造价值！\", \"status\": \"open\", \"category\": \"PC客户端开发\", \"job_type\": \"技术\", \"direction\": \"软件开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"软件开发\", \"job_category\": \"PC客户端开发\", \"business_groups\": [\"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"PC客户端开发\", \"桌面端开发\", \"客户端开发\", \"界面设计\", \"功能开发\", \"性能优化\", \"响应速度优化\", \"客户端基础组件\", \"客户端架构设计\", \"研发效率提升\", \"客户端稳定性\", \"客户端安全性\", \"系统漏洞治理\", \"故障治理\", \"Windows\", \"macOS\", \"Linux\", \"网络编程\", \"客户端调试\", \"C/C++\", \"STL\", \"算法\", \"数据结构\", \"内存管理\", \"文件系统\", \"进程调度\", \"线程调度\", \"界面实现机制\", \"VisionPro\", \"裸眼3D渲染\", \"技术创新\", \"问题解决\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责 Windows、Mac、Linux 等桌面端软件的界面设计、功能开发、性能优化、基础组件与架构设计、稳定性和安全性改进，并结合 VisionPro、裸眼 3D 渲染等新交互形态迭代产品功能。\", \"responsibilities\": [\"负责 Windows、Mac、Linux 等桌面端软件的界面设计和功能开发\", \"负责客户端的性能优化和响应速度提升，确保软件流畅稳定地运行\", \"负责客户端基础组件及架构设计，提升研发效率\", \"负责改进客户端稳定性和安全性，减少系统漏洞和故障\", \"响应适配市场变化及新的交互形态，迭代更新产品功能以满足用户需求，如 VisionPro、裸眼 3D 渲染等\"]}, \"requirements\": {\"must_have\": [\"计算机软件或相关专业本科或以上学历\", \"具有扎实的编程基础\", \"对算法和数据结构有深入理解\", \"熟练掌握 C/C++ 和 STL 编程语言\", \"具备 Windows、macOS、Linux 下网络编程的实际经验\", \"具有客户端开发与调试技能\", \"在至少一种主要操作系统，如 Windows、macOS、Linux 上有实操经验\", \"对追求技术创新和解决挑战性问题保持持续热情\"], \"bonus_points\": [\"了解 Windows、macOS、Linux 操作系统的内存管理、文件系统、进程和线程调度\", \"了解 Windows、macOS、Linux 界面实现机制\", \"有实际的 Windows、macOS、Linux 应用软件开发经验\"], \"nice_to_have\": [\"具备桌面端软件界面设计、功能开发与优化相关理解或实践经验\", \"具备客户端性能优化、响应速度优化、稳定性和安全性治理相关经验\", \"具备客户端基础组件、客户端架构设计相关理解\", \"具备 VisionPro、裸眼 3D 渲染等新交互形态相关理解\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10036,'安全技术','云与智慧产业事业群','深圳总部','安全技术','安全技术','技术','应届实习','实习生','应届实习','你将研究业界最新的网络安全攻防技术，为所有业务、产品与用户保驾护航，安全技术是你秉持的一份责任！','负责研究和落地前沿网络安全攻防技术，为通信社交、数字内容、金融科技、工具软件等产品和服务定制安全方案，开展安全工具开发运营、安全风险评估、安全事件响应和数据生命周期安全建设。','负责研究和落地前沿网络安全攻防技术，为通信社交、数字内容、金融科技、工具软件等产品和服务定制安全方案，开展安全工具开发运营、安全风险评估、安全事件响应和数据生命周期安全建设。','【必备要求】\n专业不限，有技术洞察力\n对安全技术有强烈追求，对新技术有热忱\n有意愿在安全领域长期保持专注和投入\n熟悉漏洞挖掘、网络安全攻防技术\n了解常见黑客攻击手法\n熟练使用 C/C++、Rust 等至少一门语言\n熟悉 Python、Java、PHP、Go 等至少一种程序开发语言\n对数据库、操作系统、网络原理等计算机学科基础知识有较好储备\n\n【了解项】\n具备网络安全攻防、安全方案设计、安全工具开发相关理解或实践经验\n具备安全风险评估、安全事件应急响应、安全风险治理相关理解\n具备反入侵、反攻击、反劫持、审计系统工具开发运营相关经验\n具备数据生命周期安全建设相关理解\n\n【加分项】\n拥有实际软件逆向、漏洞分析利用或对抗方案开发经验\n拥有大数据安全风控、红蓝对抗、主机安全、流量安全等项目或实习经验\n拥有安全渗透测试、安全威胁分析和应急响应处置经验','[\"负责跟进研究业界顶尖网络安全攻防技术，结合业务需求进行落地，保持关键安全技术竞争力优势\", \"负责为通信与社交、数字内容、金融科技、工具软件等产品及服务定制安全方案\", \"负责反入侵、反攻击、反劫持和审计等系统工具开发、运营和优化\", \"负责安全风险评估与安全方案规划设计及落地\", \"负责安全事件应急响应，分析跟踪事件，定位问题并制定解决方案\", \"进行数据生命周期安全建设，梳理安全风险并推进治理\"]','[\"专业不限，有技术洞察力\", \"对安全技术有强烈追求，对新技术有热忱\", \"有意愿在安全领域长期保持专注和投入\", \"熟悉漏洞挖掘、网络安全攻防技术\", \"了解常见黑客攻击手法\", \"熟练使用 C/C++、Rust 等至少一门语言\", \"熟悉 Python、Java、PHP、Go 等至少一种程序开发语言\", \"对数据库、操作系统、网络原理等计算机学科基础知识有较好储备\"]','[\"具备网络安全攻防、安全方案设计、安全工具开发相关理解或实践经验\", \"具备安全风险评估、安全事件应急响应、安全风险治理相关理解\", \"具备反入侵、反攻击、反劫持、审计系统工具开发运营相关经验\", \"具备数据生命周期安全建设相关理解\"]','[\"拥有实际软件逆向、漏洞分析利用或对抗方案开发经验\", \"拥有大数据安全风控、红蓝对抗、主机安全、流量安全等项目或实习经验\", \"拥有安全渗透测试、安全威胁分析和应急响应处置经验\"]','null','[\"安全技术\", \"网络安全\", \"网络安全攻防\", \"漏洞挖掘\", \"黑客攻击手法\", \"安全方案\", \"反入侵\", \"反攻击\", \"反劫持\", \"安全审计\", \"系统工具开发\", \"安全工具运营\", \"安全风险评估\", \"安全方案规划\", \"安全事件应急响应\", \"事件分析\", \"问题定位\", \"数据生命周期安全\", \"安全风险治理\", \"软件逆向\", \"漏洞分析利用\", \"对抗方案开发\", \"大数据安全风控\", \"红蓝对抗\", \"主机安全\", \"流量安全\", \"安全渗透测试\", \"安全威胁分析\", \"应急响应处置\", \"C/C++\", \"Rust\", \"Python\", \"Java\", \"PHP\", \"Go\", \"数据库\", \"操作系统\", \"网络原理\"]','[\"安全技术\", \"网络安全\", \"网络安全攻防\", \"漏洞挖掘\", \"黑客攻击手法\", \"安全方案\", \"反入侵\", \"反攻击\", \"反劫持\", \"安全审计\", \"系统工具开发\", \"安全工具运营\", \"安全风险评估\", \"安全方案规划\", \"安全事件应急响应\", \"事件分析\", \"问题定位\", \"数据生命周期安全\", \"安全风险治理\", \"软件逆向\", \"漏洞分析利用\", \"对抗方案开发\", \"大数据安全风控\", \"红蓝对抗\", \"主机安全\", \"流量安全\", \"安全渗透测试\", \"安全威胁分析\", \"应急响应处置\", \"C/C++\", \"Rust\", \"Python\", \"Java\", \"PHP\", \"Go\", \"数据库\", \"操作系统\", \"网络原理\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-security-technology-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-security-technology-intern-2026-001\", \"title\": \"安全技术\", \"slogan\": \"你将研究业界最新的网络安全攻防技术，为所有业务、产品与用户保驾护航，安全技术是你秉持的一份责任！\", \"status\": \"open\", \"category\": \"安全技术\", \"job_type\": \"技术\", \"direction\": \"安全技术\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"安全技术\", \"job_category\": \"安全技术\", \"business_groups\": [\"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"安全技术\", \"网络安全\", \"网络安全攻防\", \"漏洞挖掘\", \"黑客攻击手法\", \"安全方案\", \"反入侵\", \"反攻击\", \"反劫持\", \"安全审计\", \"系统工具开发\", \"安全工具运营\", \"安全风险评估\", \"安全方案规划\", \"安全事件应急响应\", \"事件分析\", \"问题定位\", \"数据生命周期安全\", \"安全风险治理\", \"软件逆向\", \"漏洞分析利用\", \"对抗方案开发\", \"大数据安全风控\", \"红蓝对抗\", \"主机安全\", \"流量安全\", \"安全渗透测试\", \"安全威胁分析\", \"应急响应处置\", \"C/C++\", \"Rust\", \"Python\", \"Java\", \"PHP\", \"Go\", \"数据库\", \"操作系统\", \"网络原理\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责研究和落地前沿网络安全攻防技术，为通信社交、数字内容、金融科技、工具软件等产品和服务定制安全方案，开展安全工具开发运营、安全风险评估、安全事件响应和数据生命周期安全建设。\", \"responsibilities\": [\"负责跟进研究业界顶尖网络安全攻防技术，结合业务需求进行落地，保持关键安全技术竞争力优势\", \"负责为通信与社交、数字内容、金融科技、工具软件等产品及服务定制安全方案\", \"负责反入侵、反攻击、反劫持和审计等系统工具开发、运营和优化\", \"负责安全风险评估与安全方案规划设计及落地\", \"负责安全事件应急响应，分析跟踪事件，定位问题并制定解决方案\", \"进行数据生命周期安全建设，梳理安全风险并推进治理\"]}, \"requirements\": {\"must_have\": [\"专业不限，有技术洞察力\", \"对安全技术有强烈追求，对新技术有热忱\", \"有意愿在安全领域长期保持专注和投入\", \"熟悉漏洞挖掘、网络安全攻防技术\", \"了解常见黑客攻击手法\", \"熟练使用 C/C++、Rust 等至少一门语言\", \"熟悉 Python、Java、PHP、Go 等至少一种程序开发语言\", \"对数据库、操作系统、网络原理等计算机学科基础知识有较好储备\"], \"bonus_points\": [\"拥有实际软件逆向、漏洞分析利用或对抗方案开发经验\", \"拥有大数据安全风控、红蓝对抗、主机安全、流量安全等项目或实习经验\", \"拥有安全渗透测试、安全威胁分析和应急响应处置经验\"], \"nice_to_have\": [\"具备网络安全攻防、安全方案设计、安全工具开发相关理解或实践经验\", \"具备安全风险评估、安全事件应急响应、安全风险治理相关理解\", \"具备反入侵、反攻击、反劫持、审计系统工具开发运营相关经验\", \"具备数据生命周期安全建设相关理解\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10037,'产品运营','企业发展事业群','深圳总部','产品运营','产品运营','产品','应届实习','实习生','应届实习','在这里，以用户为初心，在这里，做影响亿万用户的产品，下一个伟大，由你开始！','负责产品推广、平台运营、运营策略制定与迭代、数据监控体系建设、IT 支持及客服体系、渠道和营销体系建设，并推动产品和服务团队落实运营规划，提升产品与服务质量。','负责产品推广、平台运营、运营策略制定与迭代、数据监控体系建设、IT 支持及客服体系、渠道和营销体系建设，并推动产品和服务团队落实运营规划，提升产品与服务质量。','【必备要求】\n本科或以上学历\n对开发、测试、运营、设计有一定了解\n对互联网产品极度热爱，怀揣做出优秀互联网产品的梦想\n具备敏捷的洞察和思维能力\n具备把思考变为现实以满足用户需求的勇气和能力\n具备优秀的创造力、想象力、逻辑思维与系统分析能力\n具备突出的文字组织能力和沟通能力\n\n【了解项】\n具备产品推广、平台运营、用户增长、收入增长、市场份额提升相关理解或实践经验\n具备行业动态分析、竞品分析、公关政策、竞争性策略相关理解\n具备数据监控体系、IT 支持体系、客服体系、渠道和营销体系建设相关经验\n具备运营效率优化、成本优化、销售转化效率提升相关理解\n具备跨团队协同推动运营规划落地相关能力\n\n【加分项】\n开发设计过个人产品并有一定影响\n在全国互联网产品或创业大赛中获得三等奖及以上\n在互联网公司有产品策划或运营工作实习经历\n在实验室或校园技术团队有互联网产品策划项目','[\"负责产品的推广和平台运营，为用户规模、收入、市场份额负责\", \"关注行业动态、同类产品动向，制定运营相关的公关政策、竞争性策略，降低业务运营风险\", \"推动运营策略迭代，促进业务发展\", \"构建运营相关的数据监控体系、IT 支持及客服体系、渠道和营销体系\", \"持续改善系统架构、运营效率和成本、销售转化效率\", \"推动相关产品和服务团队按计划落实运营规划，并最终反馈到产品及服务质量提升\"]','[\"本科或以上学历\", \"对开发、测试、运营、设计有一定了解\", \"对互联网产品极度热爱，怀揣做出优秀互联网产品的梦想\", \"具备敏捷的洞察和思维能力\", \"具备把思考变为现实以满足用户需求的勇气和能力\", \"具备优秀的创造力、想象力、逻辑思维与系统分析能力\", \"具备突出的文字组织能力和沟通能力\"]','[\"具备产品推广、平台运营、用户增长、收入增长、市场份额提升相关理解或实践经验\", \"具备行业动态分析、竞品分析、公关政策、竞争性策略相关理解\", \"具备数据监控体系、IT 支持体系、客服体系、渠道和营销体系建设相关经验\", \"具备运营效率优化、成本优化、销售转化效率提升相关理解\", \"具备跨团队协同推动运营规划落地相关能力\"]','[\"开发设计过个人产品并有一定影响\", \"在全国互联网产品或创业大赛中获得三等奖及以上\", \"在互联网公司有产品策划或运营工作实习经历\", \"在实验室或校园技术团队有互联网产品策划项目\"]','null','[\"产品运营\", \"平台运营\", \"产品推广\", \"用户增长\", \"收入增长\", \"市场份额\", \"行业动态分析\", \"竞品分析\", \"公关政策\", \"竞争性策略\", \"运营风险控制\", \"运营策略\", \"业务发展\", \"数据监控体系\", \"IT支持体系\", \"客服体系\", \"渠道体系\", \"营销体系\", \"系统架构优化\", \"运营效率优化\", \"成本优化\", \"销售转化效率\", \"运营规划\", \"产品质量提升\", \"服务质量提升\", \"开发理解\", \"测试理解\", \"运营理解\", \"设计理解\", \"创造力\", \"想象力\", \"逻辑思维\", \"系统分析\", \"文字组织\", \"沟通表达\"]','[\"产品运营\", \"平台运营\", \"产品推广\", \"用户增长\", \"收入增长\", \"市场份额\", \"行业动态分析\", \"竞品分析\", \"公关政策\", \"竞争性策略\", \"运营风险控制\", \"运营策略\", \"业务发展\", \"数据监控体系\", \"IT支持体系\", \"客服体系\", \"渠道体系\", \"营销体系\", \"系统架构优化\", \"运营效率优化\", \"成本优化\", \"销售转化效率\", \"运营规划\", \"产品质量提升\", \"服务质量提升\", \"开发理解\", \"测试理解\", \"运营理解\", \"设计理解\", \"创造力\", \"想象力\", \"逻辑思维\", \"系统分析\", \"文字组织\", \"沟通表达\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-product-operations-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-product-operations-intern-2026-001\", \"title\": \"产品运营\", \"slogan\": \"在这里，以用户为初心，在这里，做影响亿万用户的产品，下一个伟大，由你开始！\", \"status\": \"open\", \"category\": \"产品运营\", \"job_type\": \"产品\", \"direction\": \"产品运营\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"job_type\": \"产品\", \"direction\": \"产品运营\", \"job_category\": \"产品运营\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"产品运营\", \"平台运营\", \"产品推广\", \"用户增长\", \"收入增长\", \"市场份额\", \"行业动态分析\", \"竞品分析\", \"公关政策\", \"竞争性策略\", \"运营风险控制\", \"运营策略\", \"业务发展\", \"数据监控体系\", \"IT支持体系\", \"客服体系\", \"渠道体系\", \"营销体系\", \"系统架构优化\", \"运营效率优化\", \"成本优化\", \"销售转化效率\", \"运营规划\", \"产品质量提升\", \"服务质量提升\", \"开发理解\", \"测试理解\", \"运营理解\", \"设计理解\", \"创造力\", \"想象力\", \"逻辑思维\", \"系统分析\", \"文字组织\", \"沟通表达\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\", \"成都\"], \"description\": {\"summary\": \"负责产品推广、平台运营、运营策略制定与迭代、数据监控体系建设、IT 支持及客服体系、渠道和营销体系建设，并推动产品和服务团队落实运营规划，提升产品与服务质量。\", \"responsibilities\": [\"负责产品的推广和平台运营，为用户规模、收入、市场份额负责\", \"关注行业动态、同类产品动向，制定运营相关的公关政策、竞争性策略，降低业务运营风险\", \"推动运营策略迭代，促进业务发展\", \"构建运营相关的数据监控体系、IT 支持及客服体系、渠道和营销体系\", \"持续改善系统架构、运营效率和成本、销售转化效率\", \"推动相关产品和服务团队按计划落实运营规划，并最终反馈到产品及服务质量提升\"]}, \"requirements\": {\"must_have\": [\"本科或以上学历\", \"对开发、测试、运营、设计有一定了解\", \"对互联网产品极度热爱，怀揣做出优秀互联网产品的梦想\", \"具备敏捷的洞察和思维能力\", \"具备把思考变为现实以满足用户需求的勇气和能力\", \"具备优秀的创造力、想象力、逻辑思维与系统分析能力\", \"具备突出的文字组织能力和沟通能力\"], \"bonus_points\": [\"开发设计过个人产品并有一定影响\", \"在全国互联网产品或创业大赛中获得三等奖及以上\", \"在互联网公司有产品策划或运营工作实习经历\", \"在实验室或校园技术团队有互联网产品策划项目\"], \"nice_to_have\": [\"具备产品推广、平台运营、用户增长、收入增长、市场份额提升相关理解或实践经验\", \"具备行业动态分析、竞品分析、公关政策、竞争性策略相关理解\", \"具备数据监控体系、IT 支持体系、客服体系、渠道和营销体系建设相关经验\", \"具备运营效率优化、成本优化、销售转化效率提升相关理解\", \"具备跨团队协同推动运营规划落地相关能力\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10038,'安全技术-风控算法方向','企业发展事业群','深圳总部','安全技术','风控算法','技术','应届实习','实习生','应届实习','你将研究业界最新的安全攻防技术，为所有业务、产品与用户保驾护航，安全技术是你秉持的一份责任！','负责运用前沿 AI 技术建设智能风险识别和产品风控方案，覆盖账号安全、内容安全、流量安全、支付安全、大模型安全、游戏安全、广告安全等场景，并跟踪黑灰产演进与前沿风控技术落地。','负责运用前沿 AI 技术建设智能风险识别和产品风控方案，覆盖账号安全、内容安全、流量安全、支付安全、大模型安全、游戏安全、广告安全等场景，并跟踪黑灰产演进与前沿风控技术落地。','【必备要求】\n包括但不限于计算机科学与技术、软件工程、人工智能、信息安全、模式识别、数据科学等相关专业本科及以上学历\n具备扎实的数据分析、机器学习、深度学习理论基础\n熟练进行特征工程、模型训练、评估与优化\n熟练掌握 Python 编程语言\n熟悉 SQL、Spark、Hive 等大数据处理工具\n了解 TensorFlow、PyTorch 等至少一种主流深度学习框架\n具备较强的业务理解能力和风险敏感度\n能够将复杂业务风险问题抽象为技术问题，并设计有效的解决方案\n具备良好的逻辑思维能力和数据敏感度\n具备优秀的跨团队沟通协作能力\n\n【了解项】\n有大模型 LLM、图神经网络、强化学习等应用经验者优先\n具备账号安全、内容安全、流量安全、支付安全、大模型安全、游戏安全、广告安全等风险识别相关经验\n具备智能风控方案、产品风险评估机制、风控策略落地与迭代相关理解或实践经验\n具备黑灰产分析、反欺诈、业务安全风险建模相关理解\n具备大数据处理、机器学习建模、深度学习模型优化相关实践经验\n\n【加分项】\n在 NeurIPS、ICML、KDD、AAAI、IJCAI、UAI、AISTATS、ICLR、ECML-PKDD、SIGIR 等人工智能领域顶级会议或期刊以第一作者发表过文章\n有相关的开源项目贡献经验\n有反欺诈、内容安全或支付安全等相关经验','[\"洞察业务安全风险问题，通过数据分析和 AI 技术手段建立智能风险识别方案\", \"识别账号安全、内容安全、流量安全、支付安全、大模型安全以及业务特性安全等领域的潜在风险\", \"建立产品风险评估机制，提出建设性的产品风控方案\", \"推动风控策略落地实施与持续迭代，实现风险可控与业务体验的平衡\", \"持续跟踪黑灰产演进态势与业界前沿风控技术\", \"探索大模型等新技术在风控场景的应用\"]','[\"包括但不限于计算机科学与技术、软件工程、人工智能、信息安全、模式识别、数据科学等相关专业本科及以上学历\", \"具备扎实的数据分析、机器学习、深度学习理论基础\", \"熟练进行特征工程、模型训练、评估与优化\", \"熟练掌握 Python 编程语言\", \"熟悉 SQL、Spark、Hive 等大数据处理工具\", \"了解 TensorFlow、PyTorch 等至少一种主流深度学习框架\", \"具备较强的业务理解能力和风险敏感度\", \"能够将复杂业务风险问题抽象为技术问题，并设计有效的解决方案\", \"具备良好的逻辑思维能力和数据敏感度\", \"具备优秀的跨团队沟通协作能力\"]','[\"有大模型 LLM、图神经网络、强化学习等应用经验者优先\", \"具备账号安全、内容安全、流量安全、支付安全、大模型安全、游戏安全、广告安全等风险识别相关经验\", \"具备智能风控方案、产品风险评估机制、风控策略落地与迭代相关理解或实践经验\", \"具备黑灰产分析、反欺诈、业务安全风险建模相关理解\", \"具备大数据处理、机器学习建模、深度学习模型优化相关实践经验\"]','[\"在 NeurIPS、ICML、KDD、AAAI、IJCAI、UAI、AISTATS、ICLR、ECML-PKDD、SIGIR 等人工智能领域顶级会议或期刊以第一作者发表过文章\", \"有相关的开源项目贡献经验\", \"有反欺诈、内容安全或支付安全等相关经验\"]','null','[\"安全技术\", \"风控算法\", \"AI风控\", \"业务安全\", \"智能风险识别\", \"风险识别\", \"风险评估\", \"风控策略\", \"产品风控\", \"账号安全\", \"内容安全\", \"流量安全\", \"支付安全\", \"大模型安全\", \"游戏安全\", \"广告安全\", \"黑灰产分析\", \"反欺诈\", \"数据分析\", \"机器学习\", \"深度学习\", \"特征工程\", \"模型训练\", \"模型评估\", \"模型优化\", \"大模型\", \"LLM\", \"图神经网络\", \"强化学习\", \"Python\", \"SQL\", \"Spark\", \"Hive\", \"TensorFlow\", \"PyTorch\", \"大数据处理\", \"业务理解\", \"风险敏感度\", \"逻辑思维\", \"数据敏感度\", \"跨团队协作\", \"问题抽象\", \"解决方案设计\"]','[\"安全技术\", \"风控算法\", \"AI风控\", \"业务安全\", \"智能风险识别\", \"风险识别\", \"风险评估\", \"风控策略\", \"产品风控\", \"账号安全\", \"内容安全\", \"流量安全\", \"支付安全\", \"大模型安全\", \"游戏安全\", \"广告安全\", \"黑灰产分析\", \"反欺诈\", \"数据分析\", \"机器学习\", \"深度学习\", \"特征工程\", \"模型训练\", \"模型评估\", \"模型优化\", \"大模型\", \"LLM\", \"图神经网络\", \"强化学习\", \"Python\", \"SQL\", \"Spark\", \"Hive\", \"TensorFlow\", \"PyTorch\", \"大数据处理\", \"业务理解\", \"风险敏感度\", \"逻辑思维\", \"数据敏感度\", \"跨团队协作\", \"问题抽象\", \"解决方案设计\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-security-risk-control-algorithm-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-security-risk-control-algorithm-intern-2026-001\", \"title\": \"安全技术-风控算法方向\", \"slogan\": \"你将研究业界最新的安全攻防技术，为所有业务、产品与用户保驾护航，安全技术是你秉持的一份责任！\", \"status\": \"open\", \"category\": \"风控算法\", \"job_type\": \"技术\", \"direction\": \"安全技术\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"安全技术\", \"job_category\": \"风控算法\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"安全技术\", \"风控算法\", \"AI风控\", \"业务安全\", \"智能风险识别\", \"风险识别\", \"风险评估\", \"风控策略\", \"产品风控\", \"账号安全\", \"内容安全\", \"流量安全\", \"支付安全\", \"大模型安全\", \"游戏安全\", \"广告安全\", \"黑灰产分析\", \"反欺诈\", \"数据分析\", \"机器学习\", \"深度学习\", \"特征工程\", \"模型训练\", \"模型评估\", \"模型优化\", \"大模型\", \"LLM\", \"图神经网络\", \"强化学习\", \"Python\", \"SQL\", \"Spark\", \"Hive\", \"TensorFlow\", \"PyTorch\", \"大数据处理\", \"业务理解\", \"风险敏感度\", \"逻辑思维\", \"数据敏感度\", \"跨团队协作\", \"问题抽象\", \"解决方案设计\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"广州\"], \"description\": {\"summary\": \"负责运用前沿 AI 技术建设智能风险识别和产品风控方案，覆盖账号安全、内容安全、流量安全、支付安全、大模型安全、游戏安全、广告安全等场景，并跟踪黑灰产演进与前沿风控技术落地。\", \"responsibilities\": [\"洞察业务安全风险问题，通过数据分析和 AI 技术手段建立智能风险识别方案\", \"识别账号安全、内容安全、流量安全、支付安全、大模型安全以及业务特性安全等领域的潜在风险\", \"建立产品风险评估机制，提出建设性的产品风控方案\", \"推动风控策略落地实施与持续迭代，实现风险可控与业务体验的平衡\", \"持续跟踪黑灰产演进态势与业界前沿风控技术\", \"探索大模型等新技术在风控场景的应用\"]}, \"requirements\": {\"must_have\": [\"包括但不限于计算机科学与技术、软件工程、人工智能、信息安全、模式识别、数据科学等相关专业本科及以上学历\", \"具备扎实的数据分析、机器学习、深度学习理论基础\", \"熟练进行特征工程、模型训练、评估与优化\", \"熟练掌握 Python 编程语言\", \"熟悉 SQL、Spark、Hive 等大数据处理工具\", \"了解 TensorFlow、PyTorch 等至少一种主流深度学习框架\", \"具备较强的业务理解能力和风险敏感度\", \"能够将复杂业务风险问题抽象为技术问题，并设计有效的解决方案\", \"具备良好的逻辑思维能力和数据敏感度\", \"具备优秀的跨团队沟通协作能力\"], \"bonus_points\": [\"在 NeurIPS、ICML、KDD、AAAI、IJCAI、UAI、AISTATS、ICLR、ECML-PKDD、SIGIR 等人工智能领域顶级会议或期刊以第一作者发表过文章\", \"有相关的开源项目贡献经验\", \"有反欺诈、内容安全或支付安全等相关经验\"], \"nice_to_have\": [\"有大模型 LLM、图神经网络、强化学习等应用经验者优先\", \"具备账号安全、内容安全、流量安全、支付安全、大模型安全、游戏安全、广告安全等风险识别相关经验\", \"具备智能风控方案、产品风险评估机制、风控策略落地与迭代相关理解或实践经验\", \"具备黑灰产分析、反欺诈、业务安全风险建模相关理解\", \"具备大数据处理、机器学习建模、深度学习模型优化相关实践经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10039,'AI应用开发','企业发展事业群','深圳总部','AI应用开发','AI应用开发','技术','应届实习','实习生','应届实习','加入腾讯，让世界看到你的影响力！','负责 AI 应用产品的设计、开发与迭代，将大语言模型能力落地到实际业务场景，参与智能 Agent、Prompt 工程、知识库系统建设，并探索 AI 前沿技术创新应用。','负责 AI 应用产品的设计、开发与迭代，将大语言模型能力落地到实际业务场景，参与智能 Agent、Prompt 工程、知识库系统建设，并探索 AI 前沿技术创新应用。','【必备要求】\n了解主流 Agent 建设框架平台的使用与二次开发知识\n了解 LLM 的部署和调用\n对提示词工程建设、调优有一定经验与心得\n了解 Embedding 模型原理与应用\n熟悉向量数据库使用\n了解知识召回策略，如混合检索、Rerank 等\n具备良好的沟通表达能力和团队协作精神\n思维敏捷，善于举一反三\n\n【了解项】\n具备 AI 应用产品设计、开发与迭代相关理解或实践经验\n具备大语言模型能力业务落地相关经验\n具备智能 Agent 设计开发、Prompt 工程、知识库系统建设相关理解\n具备复杂任务 AI 自动化处理相关实践经验\n除 LLM 外，对传统机器学习、NLP、CV 等算法有一定了解和实践经验更佳','[\"参与 AI 应用产品的设计、开发与迭代，将大语言模型能力落地到实际业务场景\", \"参与智能 Agent 的设计与开发，通过 Prompt 工程、知识库系统建设实现复杂任务的 AI 自动化处理\", \"跟踪 AI 领域前沿技术，探索创新应用方案\"]','[\"了解主流 Agent 建设框架平台的使用与二次开发知识\", \"了解 LLM 的部署和调用\", \"对提示词工程建设、调优有一定经验与心得\", \"了解 Embedding 模型原理与应用\", \"熟悉向量数据库使用\", \"了解知识召回策略，如混合检索、Rerank 等\", \"具备良好的沟通表达能力和团队协作精神\", \"思维敏捷，善于举一反三\"]','[\"具备 AI 应用产品设计、开发与迭代相关理解或实践经验\", \"具备大语言模型能力业务落地相关经验\", \"具备智能 Agent 设计开发、Prompt 工程、知识库系统建设相关理解\", \"具备复杂任务 AI 自动化处理相关实践经验\", \"除 LLM 外，对传统机器学习、NLP、CV 等算法有一定了解和实践经验更佳\"]','[]','null','[\"AI应用开发\", \"AI应用产品\", \"大语言模型\", \"LLM\", \"LLM部署\", \"LLM调用\", \"智能Agent\", \"Agent框架\", \"Agent二次开发\", \"Prompt工程\", \"提示词工程\", \"提示词调优\", \"知识库系统\", \"AI自动化处理\", \"Embedding\", \"向量数据库\", \"知识召回\", \"混合检索\", \"Rerank\", \"机器学习\", \"NLP\", \"CV\", \"创新应用\", \"业务落地\", \"沟通表达\", \"团队协作\", \"举一反三\"]','[\"AI应用开发\", \"AI应用产品\", \"大语言模型\", \"LLM\", \"LLM部署\", \"LLM调用\", \"智能Agent\", \"Agent框架\", \"Agent二次开发\", \"Prompt工程\", \"提示词工程\", \"提示词调优\", \"知识库系统\", \"AI自动化处理\", \"Embedding\", \"向量数据库\", \"知识召回\", \"混合检索\", \"Rerank\", \"机器学习\", \"NLP\", \"CV\", \"创新应用\", \"业务落地\", \"沟通表达\", \"团队协作\", \"举一反三\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"上海\", \"广州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-ai-application-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-ai-application-development-intern-2026-001\", \"title\": \"AI应用开发\", \"slogan\": \"加入腾讯，让世界看到你的影响力！\", \"status\": \"open\", \"category\": \"AI应用开发\", \"job_type\": \"技术\", \"direction\": \"AI应用开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"job_type\": \"技术\", \"direction\": \"AI应用开发\", \"job_category\": \"AI应用开发\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"AI应用开发\", \"AI应用产品\", \"大语言模型\", \"LLM\", \"LLM部署\", \"LLM调用\", \"智能Agent\", \"Agent框架\", \"Agent二次开发\", \"Prompt工程\", \"提示词工程\", \"提示词调优\", \"知识库系统\", \"AI自动化处理\", \"Embedding\", \"向量数据库\", \"知识召回\", \"混合检索\", \"Rerank\", \"机器学习\", \"NLP\", \"CV\", \"创新应用\", \"业务落地\", \"沟通表达\", \"团队协作\", \"举一反三\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\", \"广州\"], \"description\": {\"summary\": \"负责 AI 应用产品的设计、开发与迭代，将大语言模型能力落地到实际业务场景，参与智能 Agent、Prompt 工程、知识库系统建设，并探索 AI 前沿技术创新应用。\", \"responsibilities\": [\"参与 AI 应用产品的设计、开发与迭代，将大语言模型能力落地到实际业务场景\", \"参与智能 Agent 的设计与开发，通过 Prompt 工程、知识库系统建设实现复杂任务的 AI 自动化处理\", \"跟踪 AI 领域前沿技术，探索创新应用方案\"]}, \"requirements\": {\"must_have\": [\"了解主流 Agent 建设框架平台的使用与二次开发知识\", \"了解 LLM 的部署和调用\", \"对提示词工程建设、调优有一定经验与心得\", \"了解 Embedding 模型原理与应用\", \"熟悉向量数据库使用\", \"了解知识召回策略，如混合检索、Rerank 等\", \"具备良好的沟通表达能力和团队协作精神\", \"思维敏捷，善于举一反三\"], \"bonus_points\": [], \"nice_to_have\": [\"具备 AI 应用产品设计、开发与迭代相关理解或实践经验\", \"具备大语言模型能力业务落地相关经验\", \"具备智能 Agent 设计开发、Prompt 工程、知识库系统建设相关理解\", \"具备复杂任务 AI 自动化处理相关实践经验\", \"除 LLM 外，对传统机器学习、NLP、CV 等算法有一定了解和实践经验更佳\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10040,'音频策划','互动娱乐事业群','深圳总部','音频策划','音频策划','产品','应届实习','实习生','应届实习','你将经历从声音设计到后期制作，你不仅是声音的编织者，更是情感的传递者、故事的讲述人！','负责游戏项目音频设计与资源整合，通过声音模块与项目团队协作，助力产品体验提升。','负责游戏项目音频设计与资源整合，通过声音模块与项目团队协作，助力产品体验提升。','【必备要求】\n具有良好的音频知识基础\n熟悉录音、拟音等基本操作流程\n能够熟练使用 Wwise 等音频中间件\n具有较强的责任心\n善于沟通及协作\n工作积极主动，有敬业精神\n有 Unity 或 Unreal 引擎使用经验\n\n【了解项】\n具备游戏项目音频设计、声音设计、后期制作相关理解或实践经验\n具备音频资源整合、声音模块协作、产品体验优化相关经验\n具备与项目团队、外部资源或供应商协同合作的能力\n\n【加分项】\n具备优秀的样本资源制作能力和声音审美\n能够合理利用外部资源，并与供应商保持良好合作\n在声音设计与创作上善于学习和积累，能够形成自己的思考与突破','[\"负责游戏项目的音频设计与资源整合工作\", \"与项目保持良好的沟通与合作，通过声音模块助力产品体验\"]','[\"具有良好的音频知识基础\", \"熟悉录音、拟音等基本操作流程\", \"能够熟练使用 Wwise 等音频中间件\", \"具有较强的责任心\", \"善于沟通及协作\", \"工作积极主动，有敬业精神\", \"有 Unity 或 Unreal 引擎使用经验\"]','[\"具备游戏项目音频设计、声音设计、后期制作相关理解或实践经验\", \"具备音频资源整合、声音模块协作、产品体验优化相关经验\", \"具备与项目团队、外部资源或供应商协同合作的能力\"]','[\"具备优秀的样本资源制作能力和声音审美\", \"能够合理利用外部资源，并与供应商保持良好合作\", \"在声音设计与创作上善于学习和积累，能够形成自己的思考与突破\"]','null','[\"音频策划\", \"游戏音频\", \"音频设计\", \"声音设计\", \"后期制作\", \"资源整合\", \"声音模块\", \"产品体验\", \"录音\", \"拟音\", \"Wwise\", \"音频中间件\", \"Unity\", \"Unreal\", \"样本资源制作\", \"声音审美\", \"供应商合作\", \"沟通协作\", \"责任心\", \"学习能力\", \"创作能力\"]','[\"音频策划\", \"游戏音频\", \"音频设计\", \"声音设计\", \"后期制作\", \"资源整合\", \"声音模块\", \"产品体验\", \"录音\", \"拟音\", \"Wwise\", \"音频中间件\", \"Unity\", \"Unreal\", \"样本资源制作\", \"声音审美\", \"供应商合作\", \"沟通协作\", \"责任心\", \"学习能力\", \"创作能力\"]','[{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}]','[\"深圳总部\", \"上海\", \"杭州\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-audio-planning-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-audio-planning-intern-2026-001\", \"title\": \"音频策划\", \"slogan\": \"你将经历从声音设计到后期制作，你不仅是声音的编织者，更是情感的传递者、故事的讲述人！\", \"status\": \"open\", \"category\": \"音频策划\", \"job_type\": \"产品\", \"direction\": \"音频策划\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"上海\", \"杭州\"], \"job_type\": \"产品\", \"direction\": \"音频策划\", \"job_category\": \"音频策划\", \"business_groups\": [\"IEG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"音频策划\", \"游戏音频\", \"音频设计\", \"声音设计\", \"后期制作\", \"资源整合\", \"声音模块\", \"产品体验\", \"录音\", \"拟音\", \"Wwise\", \"音频中间件\", \"Unity\", \"Unreal\", \"样本资源制作\", \"声音审美\", \"供应商合作\", \"沟通协作\", \"责任心\", \"学习能力\", \"创作能力\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"上海\", \"杭州\"], \"description\": {\"summary\": \"负责游戏项目音频设计与资源整合，通过声音模块与项目团队协作，助力产品体验提升。\", \"responsibilities\": [\"负责游戏项目的音频设计与资源整合工作\", \"与项目保持良好的沟通与合作，通过声音模块助力产品体验\"]}, \"requirements\": {\"must_have\": [\"具有良好的音频知识基础\", \"熟悉录音、拟音等基本操作流程\", \"能够熟练使用 Wwise 等音频中间件\", \"具有较强的责任心\", \"善于沟通及协作\", \"工作积极主动，有敬业精神\", \"有 Unity 或 Unreal 引擎使用经验\"], \"bonus_points\": [\"具备优秀的样本资源制作能力和声音审美\", \"能够合理利用外部资源，并与供应商保持良好合作\", \"在声音设计与创作上善于学习和积累，能够形成自己的思考与突破\"], \"nice_to_have\": [\"具备游戏项目音频设计、声音设计、后期制作相关理解或实践经验\", \"具备音频资源整合、声音模块协作、产品体验优化相关经验\", \"具备与项目团队、外部资源或供应商协同合作的能力\"]}, \"organizations\": [{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10041,'UI开发','云与智慧产业事业群','深圳总部','UI开发','UI开发','设计','应届实习','实习生','应届实习','你是设计与开发的综合体，将最前沿的产品设计理念付诸实现。为海量用户输出一个个令人惊叹的产品！','负责多端页面原型还原与优化、上下游需求沟通、页面性能优化、数据分析、图形化编程、AIGC 创新推演以及 UI 开发研发流程规范和方法论沉淀。','负责多端页面原型还原与优化、上下游需求沟通、页面性能优化、数据分析、图形化编程、AIGC 创新推演以及 UI 开发研发流程规范和方法论沉淀。','【必备要求】\n专业不限，综合素质扎实，学科成绩优秀\n精通 Web 前端跨平台开发技术，包括 HTML、CSS、JavaScript 等\n至少掌握一种 MVC 或 MVVM 框架，如 Vue、React、Angular 等\n对多端研发、工程化协同有经验\n对视觉编程有所研究，如游戏引擎使用、WebGL 编程、多媒体开发\n热爱互联网，经常了解业界前瞻信息及应用，并有浓厚兴趣和深入见解\n善于学习，有团队协作精神\n具备较强的逻辑分析能力和沟通表达能力\n勇于探索新领域，了解机器学习和 AIGC 相关知识\n\n【了解项】\n具备多端页面原型还原、页面优化、页面性能优化相关理解或实践经验\n具备上下游需求沟通、工程化协同、研发流程规范建设相关经验\n具备数据分析、体验优化、产品方案优化相关理解\n具备图形化编程、WebGL、多媒体开发、游戏引擎使用相关经验\n具备 AIGC、机器学习相关理解，并能用于创意或产品创新推演\n\n【加分项】\n有 Web App、App、小程序、小游戏的实际项目参与和开发经验','[\"负责参与多端页面原型的还原和优化工作\", \"负责参与上下游需求沟通，并具备相应的工程化思维\", \"负责优化页面性能，关注数据分析，并从专业角度结合数据对体验或产品方案进行建议和补充\", \"负责相关图形化编程工作，并结合 AIGC 等技术进行创新推演，尝试技术驱动创意或产品\", \"负责订立 UI 开发的研发、流程规范，沉淀相关的方法论\"]','[\"专业不限，综合素质扎实，学科成绩优秀\", \"精通 Web 前端跨平台开发技术，包括 HTML、CSS、JavaScript 等\", \"至少掌握一种 MVC 或 MVVM 框架，如 Vue、React、Angular 等\", \"对多端研发、工程化协同有经验\", \"对视觉编程有所研究，如游戏引擎使用、WebGL 编程、多媒体开发\", \"热爱互联网，经常了解业界前瞻信息及应用，并有浓厚兴趣和深入见解\", \"善于学习，有团队协作精神\", \"具备较强的逻辑分析能力和沟通表达能力\", \"勇于探索新领域，了解机器学习和 AIGC 相关知识\"]','[\"具备多端页面原型还原、页面优化、页面性能优化相关理解或实践经验\", \"具备上下游需求沟通、工程化协同、研发流程规范建设相关经验\", \"具备数据分析、体验优化、产品方案优化相关理解\", \"具备图形化编程、WebGL、多媒体开发、游戏引擎使用相关经验\", \"具备 AIGC、机器学习相关理解，并能用于创意或产品创新推演\"]','[\"有 Web App、App、小程序、小游戏的实际项目参与和开发经验\"]','null','[\"UI开发\", \"Web前端\", \"跨平台开发\", \"多端研发\", \"页面原型还原\", \"页面优化\", \"页面性能优化\", \"数据分析\", \"体验优化\", \"产品方案优化\", \"工程化思维\", \"工程化协同\", \"图形化编程\", \"视觉编程\", \"游戏引擎\", \"WebGL\", \"多媒体开发\", \"AIGC\", \"机器学习\", \"技术驱动创意\", \"研发流程规范\", \"方法论沉淀\", \"HTML\", \"CSS\", \"JavaScript\", \"MVC\", \"MVVM\", \"Vue\", \"React\", \"Angular\", \"Web App\", \"App\", \"小程序\", \"小游戏\", \"逻辑分析\", \"沟通表达\", \"团队协作\", \"学习能力\"]','[\"UI开发\", \"Web前端\", \"跨平台开发\", \"多端研发\", \"页面原型还原\", \"页面优化\", \"页面性能优化\", \"数据分析\", \"体验优化\", \"产品方案优化\", \"工程化思维\", \"工程化协同\", \"图形化编程\", \"视觉编程\", \"游戏引擎\", \"WebGL\", \"多媒体开发\", \"AIGC\", \"机器学习\", \"技术驱动创意\", \"研发流程规范\", \"方法论沉淀\", \"HTML\", \"CSS\", \"JavaScript\", \"MVC\", \"MVVM\", \"Vue\", \"React\", \"Angular\", \"Web App\", \"App\", \"小程序\", \"小游戏\", \"逻辑分析\", \"沟通表达\", \"团队协作\", \"学习能力\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}]','[\"深圳总部\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-ui-development-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-ui-development-intern-2026-001\", \"title\": \"UI开发\", \"slogan\": \"你是设计与开发的综合体，将最前沿的产品设计理念付诸实现。为海量用户输出一个个令人惊叹的产品！\", \"status\": \"open\", \"category\": \"UI开发\", \"job_type\": \"设计\", \"direction\": \"UI开发\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\"], \"job_type\": \"设计\", \"direction\": \"UI开发\", \"job_category\": \"UI开发\", \"business_groups\": [\"CSIG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"UI开发\", \"Web前端\", \"跨平台开发\", \"多端研发\", \"页面原型还原\", \"页面优化\", \"页面性能优化\", \"数据分析\", \"体验优化\", \"产品方案优化\", \"工程化思维\", \"工程化协同\", \"图形化编程\", \"视觉编程\", \"游戏引擎\", \"WebGL\", \"多媒体开发\", \"AIGC\", \"机器学习\", \"技术驱动创意\", \"研发流程规范\", \"方法论沉淀\", \"HTML\", \"CSS\", \"JavaScript\", \"MVC\", \"MVVM\", \"Vue\", \"React\", \"Angular\", \"Web App\", \"App\", \"小程序\", \"小游戏\", \"逻辑分析\", \"沟通表达\", \"团队协作\", \"学习能力\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\"], \"description\": {\"summary\": \"负责多端页面原型还原与优化、上下游需求沟通、页面性能优化、数据分析、图形化编程、AIGC 创新推演以及 UI 开发研发流程规范和方法论沉淀。\", \"responsibilities\": [\"负责参与多端页面原型的还原和优化工作\", \"负责参与上下游需求沟通，并具备相应的工程化思维\", \"负责优化页面性能，关注数据分析，并从专业角度结合数据对体验或产品方案进行建议和补充\", \"负责相关图形化编程工作，并结合 AIGC 等技术进行创新推演，尝试技术驱动创意或产品\", \"负责订立 UI 开发的研发、流程规范，沉淀相关的方法论\"]}, \"requirements\": {\"must_have\": [\"专业不限，综合素质扎实，学科成绩优秀\", \"精通 Web 前端跨平台开发技术，包括 HTML、CSS、JavaScript 等\", \"至少掌握一种 MVC 或 MVVM 框架，如 Vue、React、Angular 等\", \"对多端研发、工程化协同有经验\", \"对视觉编程有所研究，如游戏引擎使用、WebGL 编程、多媒体开发\", \"热爱互联网，经常了解业界前瞻信息及应用，并有浓厚兴趣和深入见解\", \"善于学习，有团队协作精神\", \"具备较强的逻辑分析能力和沟通表达能力\", \"勇于探索新领域，了解机器学习和 AIGC 相关知识\"], \"bonus_points\": [\"有 Web App、App、小程序、小游戏的实际项目参与和开发经验\"], \"nice_to_have\": [\"具备多端页面原型还原、页面优化、页面性能优化相关理解或实践经验\", \"具备上下游需求沟通、工程化协同、研发流程规范建设相关经验\", \"具备数据分析、体验优化、产品方案优化相关理解\", \"具备图形化编程、WebGL、多媒体开发、游戏引擎使用相关经验\", \"具备 AIGC、机器学习相关理解，并能用于创意或产品创新推演\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10042,'内容创作','互动娱乐事业群','深圳总部','内容创作','内容创作','产品','应届实习','实习生','应届实习','你是幕后的“推手”，项目策划与评估、合作方和版权供应商的协调沟通都离不开你。你在，精彩就在！','负责文学策划、短视频、直播、动漫等内容创作方向工作，覆盖热点跟进、内容制作、运营策划方案输出、视频拍摄剪辑、社交媒体爆款内容制作与传播。','负责文学策划、短视频、直播、动漫等内容创作方向工作，覆盖热点跟进、内容制作、运营策划方案输出、视频拍摄剪辑、社交媒体爆款内容制作与传播。','【必备要求】\n综合素质扎实\n新闻学、文学、广播电视、影视制片、节目编导、音乐等相关专业\n具备优秀的新闻素养和情怀\n具备扎实的文字写作功底\n具备新闻感知能力和沟通能力\n具备一定行业经验，如体育、财经、社会等\n文学策划类岗位要求关注并喜欢从事电视剧、电影、动漫、纪录片等领域，有充分看片量和扎实文字功底\n短视频直播动漫类岗位要求热爱互联网，是年轻化娱乐性互联网产品的重度用户，话题感强，喜欢娱乐，热点敏感度高，脑洞大，创意多\n\n【了解项】\n具备热点事件、热点话题跟进和内容制作相关经验\n具备运营策划、营销节点策划、大事件节点策划相关理解或实践经验\n具备视频拍摄、视频剪辑、短视频精编相关能力\n具备社交媒体内容传播、爆款内容制作相关经验\n具备文学策划、短视频、直播、动漫等内容方向相关实践经验','[\"对热点事件和话题保持敏感度，能够跟进内容制作\", \"具备策划能力，结合大事件节点、营销节点和业务需求输出运营策划方案\", \"具备一定的视频拍摄和剪辑能力，能够进行短视频精编\", \"擅长社交媒体爆款内容制作和传播\", \"参与文学策划类、短视频直播动漫类等方向的内容创作工作\"]','[\"综合素质扎实\", \"新闻学、文学、广播电视、影视制片、节目编导、音乐等相关专业\", \"具备优秀的新闻素养和情怀\", \"具备扎实的文字写作功底\", \"具备新闻感知能力和沟通能力\", \"具备一定行业经验，如体育、财经、社会等\", \"文学策划类岗位要求关注并喜欢从事电视剧、电影、动漫、纪录片等领域，有充分看片量和扎实文字功底\", \"短视频直播动漫类岗位要求热爱互联网，是年轻化娱乐性互联网产品的重度用户，话题感强，喜欢娱乐，热点敏感度高，脑洞大，创意多\"]','[\"具备热点事件、热点话题跟进和内容制作相关经验\", \"具备运营策划、营销节点策划、大事件节点策划相关理解或实践经验\", \"具备视频拍摄、视频剪辑、短视频精编相关能力\", \"具备社交媒体内容传播、爆款内容制作相关经验\", \"具备文学策划、短视频、直播、动漫等内容方向相关实践经验\"]','[]','null','[\"内容创作\", \"文学策划\", \"短视频\", \"直播\", \"动漫\", \"热点敏感度\", \"热点跟进\", \"内容制作\", \"运营策划\", \"营销节点策划\", \"大事件策划\", \"策划方案\", \"视频拍摄\", \"视频剪辑\", \"短视频精编\", \"社交媒体传播\", \"爆款内容制作\", \"新闻素养\", \"文字写作\", \"新闻感知\", \"沟通表达\", \"电视剧\", \"电影\", \"纪录片\", \"娱乐内容\", \"创意能力\", \"话题策划\", \"体育内容\", \"财经内容\", \"社会内容\"]','[\"内容创作\", \"文学策划\", \"短视频\", \"直播\", \"动漫\", \"热点敏感度\", \"热点跟进\", \"内容制作\", \"运营策划\", \"营销节点策划\", \"大事件策划\", \"策划方案\", \"视频拍摄\", \"视频剪辑\", \"短视频精编\", \"社交媒体传播\", \"爆款内容制作\", \"新闻素养\", \"文字写作\", \"新闻感知\", \"沟通表达\", \"电视剧\", \"电影\", \"纪录片\", \"娱乐内容\", \"创意能力\", \"话题策划\", \"体育内容\", \"财经内容\", \"社会内容\"]','[{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}]','[\"深圳总部\", \"北京\", \"上海\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-content-creation-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-content-creation-intern-2026-001\", \"title\": \"内容创作\", \"slogan\": \"你是幕后的“推手”，项目策划与评估、合作方和版权供应商的协调沟通都离不开你。你在，精彩就在！\", \"status\": \"open\", \"category\": \"内容创作\", \"job_type\": \"产品\", \"direction\": \"内容创作\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"上海\"], \"job_type\": \"产品\", \"direction\": \"内容创作\", \"job_category\": \"内容创作\", \"business_groups\": [\"IEG\", \"PCG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"内容创作\", \"文学策划\", \"短视频\", \"直播\", \"动漫\", \"热点敏感度\", \"热点跟进\", \"内容制作\", \"运营策划\", \"营销节点策划\", \"大事件策划\", \"策划方案\", \"视频拍摄\", \"视频剪辑\", \"短视频精编\", \"社交媒体传播\", \"爆款内容制作\", \"新闻素养\", \"文字写作\", \"新闻感知\", \"沟通表达\", \"电视剧\", \"电影\", \"纪录片\", \"娱乐内容\", \"创意能力\", \"话题策划\", \"体育内容\", \"财经内容\", \"社会内容\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"上海\"], \"description\": {\"summary\": \"负责文学策划、短视频、直播、动漫等内容创作方向工作，覆盖热点跟进、内容制作、运营策划方案输出、视频拍摄剪辑、社交媒体爆款内容制作与传播。\", \"responsibilities\": [\"对热点事件和话题保持敏感度，能够跟进内容制作\", \"具备策划能力，结合大事件节点、营销节点和业务需求输出运营策划方案\", \"具备一定的视频拍摄和剪辑能力，能够进行短视频精编\", \"擅长社交媒体爆款内容制作和传播\", \"参与文学策划类、短视频直播动漫类等方向的内容创作工作\"]}, \"requirements\": {\"must_have\": [\"综合素质扎实\", \"新闻学、文学、广播电视、影视制片、节目编导、音乐等相关专业\", \"具备优秀的新闻素养和情怀\", \"具备扎实的文字写作功底\", \"具备新闻感知能力和沟通能力\", \"具备一定行业经验，如体育、财经、社会等\", \"文学策划类岗位要求关注并喜欢从事电视剧、电影、动漫、纪录片等领域，有充分看片量和扎实文字功底\", \"短视频直播动漫类岗位要求热爱互联网，是年轻化娱乐性互联网产品的重度用户，话题感强，喜欢娱乐，热点敏感度高，脑洞大，创意多\"], \"bonus_points\": [], \"nice_to_have\": [\"具备热点事件、热点话题跟进和内容制作相关经验\", \"具备运营策划、营销节点策划、大事件节点策划相关理解或实践经验\", \"具备视频拍摄、视频剪辑、短视频精编相关能力\", \"具备社交媒体内容传播、爆款内容制作相关经验\", \"具备文学策划、短视频、直播、动漫等内容方向相关实践经验\"]}, \"organizations\": [{\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10043,'内容运营','企业发展事业群','深圳总部','内容运营','内容运营','产品','应届实习','实习生','应届实习','你推开窗口，让好的内容出现在用户的眼前，有你，就有精彩的内容生活。好的内容，值得被更多人看见！','负责内容策划、生产、分发和管理，围绕目标用户完成拉新、留存、转化，并通过 C 端收入目标设计、数据分析和用户洞察优化内容生产、产品路径和运营方案。','负责内容策划、生产、分发和管理，围绕目标用户完成拉新、留存、转化，并通过 C 端收入目标设计、数据分析和用户洞察优化内容生产、产品路径和运营方案。','【必备要求】\n综合素质扎实\n新闻学、文学、广播电视、影视制片、节目编导、音乐等相关专业\n有扎实的专业特长，如节目编导、编剧、文学创作、音乐制作等技能\n热爱互联网，是年轻化娱乐性互联网产品的重度用户\n热爱动漫和二次元，喜欢娱乐\n热点敏感度高，脑洞大，创意多\n具备良好的沟通能力\n\n【了解项】\n具备内容策划、内容生产、内容分发、内容管理相关理解或实践经验\n具备用户拉新、留存、转化相关运营经验\n具备 To C 收入目标设计、内容玩法框架设计、C 端收入增长相关理解\n具备数据分析、用户洞察、用户需求挖掘、用户痛点分析相关能力\n具备内容生产、产品路径、运营方案优化相关经验\n\n【加分项】\n有优秀的创作作品和实践经验\n具备 SQL、Python 等数据分析相关能力','[\"负责内容的策划、生产、分发和管理，完成对目标用户的拉新、留存和转化\", \"负责 To C 收入的目标设计和执行，从目标用户的消费习惯和诉求出发，设计 To C 内容与玩法框架，实现 C 端收入最大化\", \"负责数据分析与用户洞察，通过对内容和产品数据的相关分析，挖掘用户需求与痛点\", \"为内容生产、产品路径和运营方案优化提供参考\"]','[\"综合素质扎实\", \"新闻学、文学、广播电视、影视制片、节目编导、音乐等相关专业\", \"有扎实的专业特长，如节目编导、编剧、文学创作、音乐制作等技能\", \"热爱互联网，是年轻化娱乐性互联网产品的重度用户\", \"热爱动漫和二次元，喜欢娱乐\", \"热点敏感度高，脑洞大，创意多\", \"具备良好的沟通能力\"]','[\"具备内容策划、内容生产、内容分发、内容管理相关理解或实践经验\", \"具备用户拉新、留存、转化相关运营经验\", \"具备 To C 收入目标设计、内容玩法框架设计、C 端收入增长相关理解\", \"具备数据分析、用户洞察、用户需求挖掘、用户痛点分析相关能力\", \"具备内容生产、产品路径、运营方案优化相关经验\"]','[\"有优秀的创作作品和实践经验\", \"具备 SQL、Python 等数据分析相关能力\"]','null','[\"内容运营\", \"内容策划\", \"内容生产\", \"内容分发\", \"内容管理\", \"用户拉新\", \"用户留存\", \"用户转化\", \"To C运营\", \"C端收入\", \"收入目标设计\", \"内容玩法框架\", \"数据分析\", \"用户洞察\", \"用户需求挖掘\", \"用户痛点分析\", \"产品数据分析\", \"运营方案优化\", \"产品路径优化\", \"节目编导\", \"编剧\", \"文学创作\", \"音乐制作\", \"动漫\", \"二次元\", \"娱乐内容\", \"热点敏感度\", \"创意能力\", \"沟通表达\", \"SQL\", \"Python\"]','[\"内容运营\", \"内容策划\", \"内容生产\", \"内容分发\", \"内容管理\", \"用户拉新\", \"用户留存\", \"用户转化\", \"To C运营\", \"C端收入\", \"收入目标设计\", \"内容玩法框架\", \"数据分析\", \"用户洞察\", \"用户需求挖掘\", \"用户痛点分析\", \"产品数据分析\", \"运营方案优化\", \"产品路径优化\", \"节目编导\", \"编剧\", \"文学创作\", \"音乐制作\", \"动漫\", \"二次元\", \"娱乐内容\", \"热点敏感度\", \"创意能力\", \"沟通表达\", \"SQL\", \"Python\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}]','[\"深圳总部\", \"北京\", \"广州\", \"成都\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-content-operations-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-content-operations-intern-2026-001\", \"title\": \"内容运营\", \"slogan\": \"你推开窗口，让好的内容出现在用户的眼前，有你，就有精彩的内容生活。好的内容，值得被更多人看见！\", \"status\": \"open\", \"category\": \"内容运营\", \"job_type\": \"产品\", \"direction\": \"内容运营\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\", \"广州\", \"成都\"], \"job_type\": \"产品\", \"direction\": \"内容运营\", \"job_category\": \"内容运营\", \"business_groups\": [\"CDG\", \"CSIG\", \"IEG\", \"PCG\", \"TEG\", \"WXG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"内容运营\", \"内容策划\", \"内容生产\", \"内容分发\", \"内容管理\", \"用户拉新\", \"用户留存\", \"用户转化\", \"To C运营\", \"C端收入\", \"收入目标设计\", \"内容玩法框架\", \"数据分析\", \"用户洞察\", \"用户需求挖掘\", \"用户痛点分析\", \"产品数据分析\", \"运营方案优化\", \"产品路径优化\", \"节目编导\", \"编剧\", \"文学创作\", \"音乐制作\", \"动漫\", \"二次元\", \"娱乐内容\", \"热点敏感度\", \"创意能力\", \"沟通表达\", \"SQL\", \"Python\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\", \"广州\", \"成都\"], \"description\": {\"summary\": \"负责内容策划、生产、分发和管理，围绕目标用户完成拉新、留存、转化，并通过 C 端收入目标设计、数据分析和用户洞察优化内容生产、产品路径和运营方案。\", \"responsibilities\": [\"负责内容的策划、生产、分发和管理，完成对目标用户的拉新、留存和转化\", \"负责 To C 收入的目标设计和执行，从目标用户的消费习惯和诉求出发，设计 To C 内容与玩法框架，实现 C 端收入最大化\", \"负责数据分析与用户洞察，通过对内容和产品数据的相关分析，挖掘用户需求与痛点\", \"为内容生产、产品路径和运营方案优化提供参考\"]}, \"requirements\": {\"must_have\": [\"综合素质扎实\", \"新闻学、文学、广播电视、影视制片、节目编导、音乐等相关专业\", \"有扎实的专业特长，如节目编导、编剧、文学创作、音乐制作等技能\", \"热爱互联网，是年轻化娱乐性互联网产品的重度用户\", \"热爱动漫和二次元，喜欢娱乐\", \"热点敏感度高，脑洞大，创意多\", \"具备良好的沟通能力\"], \"bonus_points\": [\"有优秀的创作作品和实践经验\", \"具备 SQL、Python 等数据分析相关能力\"], \"nice_to_have\": [\"具备内容策划、内容生产、内容分发、内容管理相关理解或实践经验\", \"具备用户拉新、留存、转化相关运营经验\", \"具备 To C 收入目标设计、内容玩法框架设计、C 端收入增长相关理解\", \"具备数据分析、用户洞察、用户需求挖掘、用户痛点分析相关能力\", \"具备内容生产、产品路径、运营方案优化相关经验\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}, {\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}, {\"code\": \"TEG\", \"name\": \"技术工程事业群\"}, {\"code\": \"WXG\", \"name\": \"微信事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10044,'市场研究','云与智慧产业事业群','深圳总部','市场研究','市场研究','市场','应届实习','实习生','应届实习','你擅长捕捉每个声音，以好奇心创造价值。最近的市场在想什么，浪潮将驶向何方？问你，就对了！','负责行业趋势洞察、消费市场与用户变化研究，通过科学市场研究方法将市场和用户声音转化为决策信息，为公司战略、业务策略和各级业务决策提供判断依据与落地建议。','负责行业趋势洞察、消费市场与用户变化研究，通过科学市场研究方法将市场和用户声音转化为决策信息，为公司战略、业务策略和各级业务决策提供判断依据与落地建议。','【必备要求】\n心理学、社会学、市场营销学、统计学等专业或相关专业\n对事物有探索和钻研精神\n对从事研究分析工作有浓厚兴趣\n具备一定洞察能力\n在用户心理和行为探知方面有扎实的理论知识或实践经验\n喜欢与人交流访谈，并有良好的沟通技巧\n了解或学习过定性访谈的专业知识\n具备良好的问题分析和总结能力\n具备数据敏感意识及逻辑思考能力\n具备较好的沟通协调能力、书面表达能力及演讲能力\n\n【了解项】\n具备行业趋势研究、市场变化研究、用户变化研究相关理解或实践经验\n具备消费市场分析、市场需求变化分析、用户群体差异分析相关能力\n具备市场研究方法、用户访谈、定性研究、定量研究相关经验\n具备信息整合分析、用户洞察表达、决策建议输出和推动落地相关能力\n\n【加分项】\n了解市场调研的基础理论\n掌握问卷设计及常用统计分析专业知识\n掌握 SPSS、SAS、Excel 等数据处理软件','[\"洞察行业发展变化趋势，捕捉市场与用户变迁，为公司战略、业务策略提供前沿及独到的判断依据\", \"持续积累对整体消费市场时代革新、市场需求变化、用户群体差异等底层洞见，为业务挖掘机会、预警风险\", \"通过科学的市场研究方法，将市场与用户的声音转化为客观、全面的决策信息\", \"与时并进地优化获取市场与用户变化的方法与手段，更高效、敏感地抓住时代与行业迭代的信号\", \"通过强信息整合与分析能力、精准表达具备业务价值的用户洞察，为各级业务决策层提供所需的决策建议并推动落地\"]','[\"心理学、社会学、市场营销学、统计学等专业或相关专业\", \"对事物有探索和钻研精神\", \"对从事研究分析工作有浓厚兴趣\", \"具备一定洞察能力\", \"在用户心理和行为探知方面有扎实的理论知识或实践经验\", \"喜欢与人交流访谈，并有良好的沟通技巧\", \"了解或学习过定性访谈的专业知识\", \"具备良好的问题分析和总结能力\", \"具备数据敏感意识及逻辑思考能力\", \"具备较好的沟通协调能力、书面表达能力及演讲能力\"]','[\"具备行业趋势研究、市场变化研究、用户变化研究相关理解或实践经验\", \"具备消费市场分析、市场需求变化分析、用户群体差异分析相关能力\", \"具备市场研究方法、用户访谈、定性研究、定量研究相关经验\", \"具备信息整合分析、用户洞察表达、决策建议输出和推动落地相关能力\"]','[\"了解市场调研的基础理论\", \"掌握问卷设计及常用统计分析专业知识\", \"掌握 SPSS、SAS、Excel 等数据处理软件\"]','null','[\"市场研究\", \"市场调研\", \"行业趋势洞察\", \"市场变化分析\", \"用户研究\", \"用户洞察\", \"消费市场分析\", \"市场需求分析\", \"用户群体分析\", \"机会挖掘\", \"风险预警\", \"决策信息\", \"业务策略\", \"战略分析\", \"信息整合\", \"数据分析\", \"定性研究\", \"定量研究\", \"定性访谈\", \"用户访谈\", \"问卷设计\", \"统计分析\", \"用户心理\", \"用户行为\", \"问题分析\", \"总结能力\", \"逻辑思考\", \"数据敏感度\", \"沟通协调\", \"书面表达\", \"演讲能力\", \"心理学\", \"社会学\", \"市场营销学\", \"统计学\", \"SPSS\", \"SAS\", \"Excel\"]','[\"市场研究\", \"市场调研\", \"行业趋势洞察\", \"市场变化分析\", \"用户研究\", \"用户洞察\", \"消费市场分析\", \"市场需求分析\", \"用户群体分析\", \"机会挖掘\", \"风险预警\", \"决策信息\", \"业务策略\", \"战略分析\", \"信息整合\", \"数据分析\", \"定性研究\", \"定量研究\", \"定性访谈\", \"用户访谈\", \"问卷设计\", \"统计分析\", \"用户心理\", \"用户行为\", \"问题分析\", \"总结能力\", \"逻辑思考\", \"数据敏感度\", \"沟通协调\", \"书面表达\", \"演讲能力\", \"心理学\", \"社会学\", \"市场营销学\", \"统计学\", \"SPSS\", \"SAS\", \"Excel\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}]','[\"深圳总部\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-market-research-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-market-research-intern-2026-001\", \"title\": \"市场研究\", \"slogan\": \"你擅长捕捉每个声音，以好奇心创造价值。最近的市场在想什么，浪潮将驶向何方？问你，就对了！\", \"status\": \"open\", \"category\": \"市场研究\", \"job_type\": \"市场\", \"direction\": \"市场研究\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\"], \"job_type\": \"市场\", \"direction\": \"市场研究\", \"job_category\": \"市场研究\", \"business_groups\": [\"CSIG\", \"IEG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"市场研究\", \"市场调研\", \"行业趋势洞察\", \"市场变化分析\", \"用户研究\", \"用户洞察\", \"消费市场分析\", \"市场需求分析\", \"用户群体分析\", \"机会挖掘\", \"风险预警\", \"决策信息\", \"业务策略\", \"战略分析\", \"信息整合\", \"数据分析\", \"定性研究\", \"定量研究\", \"定性访谈\", \"用户访谈\", \"问卷设计\", \"统计分析\", \"用户心理\", \"用户行为\", \"问题分析\", \"总结能力\", \"逻辑思考\", \"数据敏感度\", \"沟通协调\", \"书面表达\", \"演讲能力\", \"心理学\", \"社会学\", \"市场营销学\", \"统计学\", \"SPSS\", \"SAS\", \"Excel\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\"], \"description\": {\"summary\": \"负责行业趋势洞察、消费市场与用户变化研究，通过科学市场研究方法将市场和用户声音转化为决策信息，为公司战略、业务策略和各级业务决策提供判断依据与落地建议。\", \"responsibilities\": [\"洞察行业发展变化趋势，捕捉市场与用户变迁，为公司战略、业务策略提供前沿及独到的判断依据\", \"持续积累对整体消费市场时代革新、市场需求变化、用户群体差异等底层洞见，为业务挖掘机会、预警风险\", \"通过科学的市场研究方法，将市场与用户的声音转化为客观、全面的决策信息\", \"与时并进地优化获取市场与用户变化的方法与手段，更高效、敏感地抓住时代与行业迭代的信号\", \"通过强信息整合与分析能力、精准表达具备业务价值的用户洞察，为各级业务决策层提供所需的决策建议并推动落地\"]}, \"requirements\": {\"must_have\": [\"心理学、社会学、市场营销学、统计学等专业或相关专业\", \"对事物有探索和钻研精神\", \"对从事研究分析工作有浓厚兴趣\", \"具备一定洞察能力\", \"在用户心理和行为探知方面有扎实的理论知识或实践经验\", \"喜欢与人交流访谈，并有良好的沟通技巧\", \"了解或学习过定性访谈的专业知识\", \"具备良好的问题分析和总结能力\", \"具备数据敏感意识及逻辑思考能力\", \"具备较好的沟通协调能力、书面表达能力及演讲能力\"], \"bonus_points\": [\"了解市场调研的基础理论\", \"掌握问卷设计及常用统计分析专业知识\", \"掌握 SPSS、SAS、Excel 等数据处理软件\"], \"nice_to_have\": [\"具备行业趋势研究、市场变化研究、用户变化研究相关理解或实践经验\", \"具备消费市场分析、市场需求变化分析、用户群体差异分析相关能力\", \"具备市场研究方法、用户访谈、定性研究、定量研究相关经验\", \"具备信息整合分析、用户洞察表达、决策建议输出和推动落地相关能力\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10045,'公关','企业发展事业群','深圳总部','公关','公关','市场','应届实习','实习生','应届实习','你是爱思考更爱表达的态度青年，传播的灵魂由你捕捉，话题的调性由你定义，产品经理和品牌经理是你的有力助攻，你打通内外，你是鹅厂公关人！','负责支持和参与公关传播项目，跟进内外部反馈与报道情况，参与外部利益相关人沟通、公关活动策划落地、新闻通稿及相关文稿撰写，并学习公关全流程工作。','负责支持和参与公关传播项目，跟进内外部反馈与报道情况，参与外部利益相关人沟通、公关活动策划落地、新闻通稿及相关文稿撰写，并学习公关全流程工作。','【必备要求】\n本科及以上学历\n为人正直，善于沟通\n有学习的热情和积极性，具有上进心\n具备严谨的逻辑思维能力\n对互联网有较强的理解力\n具有较强的团队合作能力和良好的沟通能力\n具备较强媒体策划能力、撰稿能力和执行力\n能够根据需要制定相应媒体方案并推动实施\n\n【了解项】\n具备公关传播项目、媒体沟通、传播活动策划相关理解或实践经验\n具备新闻通稿、传播文案、相关文稿撰写能力\n具备媒体、自媒体、KOL、专家等外部利益相关人沟通经验\n熟悉互联网行业热点、公司业务传播、公关全流程工作','[\"支持和参与各类公关传播项目，跟进内外部反馈和报道情况\", \"独立负责部分外部利益相关人沟通，包括媒体、自媒体、KOL 和各领域专家等\", \"负责策划和落地小型采访、发布会等公关传播活动\", \"独立撰写新闻通稿或相关文稿\", \"学习和了解公关全流程工作，熟悉公司业务和行业热点，建立对公关的全面认识\"]','[\"本科及以上学历\", \"为人正直，善于沟通\", \"有学习的热情和积极性，具有上进心\", \"具备严谨的逻辑思维能力\", \"对互联网有较强的理解力\", \"具有较强的团队合作能力和良好的沟通能力\", \"具备较强媒体策划能力、撰稿能力和执行力\", \"能够根据需要制定相应媒体方案并推动实施\"]','[\"具备公关传播项目、媒体沟通、传播活动策划相关理解或实践经验\", \"具备新闻通稿、传播文案、相关文稿撰写能力\", \"具备媒体、自媒体、KOL、专家等外部利益相关人沟通经验\", \"熟悉互联网行业热点、公司业务传播、公关全流程工作\"]','[]','null','[\"公关\", \"公关传播\", \"传播项目\", \"媒体沟通\", \"自媒体沟通\", \"KOL沟通\", \"专家沟通\", \"外部利益相关人沟通\", \"采访策划\", \"发布会策划\", \"公关活动\", \"新闻通稿\", \"文稿撰写\", \"媒体策划\", \"媒体方案\", \"报道跟进\", \"反馈跟进\", \"行业热点\", \"互联网理解\", \"逻辑思维\", \"沟通表达\", \"团队合作\", \"执行力\", \"学习能力\"]','[\"公关\", \"公关传播\", \"传播项目\", \"媒体沟通\", \"自媒体沟通\", \"KOL沟通\", \"专家沟通\", \"外部利益相关人沟通\", \"采访策划\", \"发布会策划\", \"公关活动\", \"新闻通稿\", \"文稿撰写\", \"媒体策划\", \"媒体方案\", \"报道跟进\", \"反馈跟进\", \"行业热点\", \"互联网理解\", \"逻辑思维\", \"沟通表达\", \"团队合作\", \"执行力\", \"学习能力\"]','[{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}]','[\"深圳总部\", \"北京\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-public-relations-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-public-relations-intern-2026-001\", \"title\": \"公关\", \"slogan\": \"你是爱思考更爱表达的态度青年，传播的灵魂由你捕捉，话题的调性由你定义，产品经理和品牌经理是你的有力助攻，你打通内外，你是鹅厂公关人！\", \"status\": \"open\", \"category\": \"公关\", \"job_type\": \"市场\", \"direction\": \"公关\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\", \"北京\"], \"job_type\": \"市场\", \"direction\": \"公关\", \"job_category\": \"公关\", \"business_groups\": [\"CDG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"公关\", \"公关传播\", \"传播项目\", \"媒体沟通\", \"自媒体沟通\", \"KOL沟通\", \"专家沟通\", \"外部利益相关人沟通\", \"采访策划\", \"发布会策划\", \"公关活动\", \"新闻通稿\", \"文稿撰写\", \"媒体策划\", \"媒体方案\", \"报道跟进\", \"反馈跟进\", \"行业热点\", \"互联网理解\", \"逻辑思维\", \"沟通表达\", \"团队合作\", \"执行力\", \"学习能力\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\", \"北京\"], \"description\": {\"summary\": \"负责支持和参与公关传播项目，跟进内外部反馈与报道情况，参与外部利益相关人沟通、公关活动策划落地、新闻通稿及相关文稿撰写，并学习公关全流程工作。\", \"responsibilities\": [\"支持和参与各类公关传播项目，跟进内外部反馈和报道情况\", \"独立负责部分外部利益相关人沟通，包括媒体、自媒体、KOL 和各领域专家等\", \"负责策划和落地小型采访、发布会等公关传播活动\", \"独立撰写新闻通稿或相关文稿\", \"学习和了解公关全流程工作，熟悉公司业务和行业热点，建立对公关的全面认识\"]}, \"requirements\": {\"must_have\": [\"本科及以上学历\", \"为人正直，善于沟通\", \"有学习的热情和积极性，具有上进心\", \"具备严谨的逻辑思维能力\", \"对互联网有较强的理解力\", \"具有较强的团队合作能力和良好的沟通能力\", \"具备较强媒体策划能力、撰稿能力和执行力\", \"能够根据需要制定相应媒体方案并推动实施\"], \"bonus_points\": [], \"nice_to_have\": [\"具备公关传播项目、媒体沟通、传播活动策划相关理解或实践经验\", \"具备新闻通稿、传播文案、相关文稿撰写能力\", \"具备媒体、自媒体、KOL、专家等外部利益相关人沟通经验\", \"熟悉互联网行业热点、公司业务传播、公关全流程工作\"]}, \"organizations\": [{\"code\": \"CDG\", \"name\": \"企业发展事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49'),(10046,'采购商务管理','云与智慧产业事业群','深圳总部','采购商务管理','采购商务管理','职能','应届实习','实习生','应届实习','加入S1，让世界看到你的影响力。','负责根据需求交付采购项目计划和采购任务，参与行业信息收集分析、供应商寻源开发与日常管理、商务谈判及合同执行跟进。','负责根据需求交付采购项目计划和采购任务，参与行业信息收集分析、供应商寻源开发与日常管理、商务谈判及合同执行跟进。','【必备要求】\n本科及以上学历\n对采购、供应链管理及相关专业知识有较深入的理论研究\n具备优秀的学习能力、逻辑能力、书面和口头表达沟通能力\n具备团队协作能力\n\n【了解项】\n具备采购项目计划、采购任务交付相关理解或实践经验\n具备行业信息收集分析、供应商寻源、供应商开发和供应商管理相关理解\n具备商务谈判、合同执行跟进相关经验\n\n【加分项】\n营销类、设计类、理工类与供应链管理类相关专业\n有在大中型企业采购或供应链部门实习经历','[\"根据需求交付采购项目计划及采购任务\", \"收集并分析行业信息，了解行业整体情况\", \"参与供应商寻源、开发及日常管理工作\", \"参与商务谈判，跟进合同执行\"]','[\"本科及以上学历\", \"对采购、供应链管理及相关专业知识有较深入的理论研究\", \"具备优秀的学习能力、逻辑能力、书面和口头表达沟通能力\", \"具备团队协作能力\"]','[\"具备采购项目计划、采购任务交付相关理解或实践经验\", \"具备行业信息收集分析、供应商寻源、供应商开发和供应商管理相关理解\", \"具备商务谈判、合同执行跟进相关经验\"]','[\"营销类、设计类、理工类与供应链管理类相关专业\", \"有在大中型企业采购或供应链部门实习经历\"]','null','[\"采购商务管理\", \"采购管理\", \"供应链管理\", \"采购项目计划\", \"采购任务交付\", \"行业信息收集\", \"行业信息分析\", \"供应商寻源\", \"供应商开发\", \"供应商管理\", \"商务谈判\", \"合同执行\", \"合同跟进\", \"学习能力\", \"逻辑能力\", \"书面表达\", \"口头表达\", \"沟通表达\", \"团队协作\", \"营销\", \"设计\", \"理工\", \"供应链\"]','[\"采购商务管理\", \"采购管理\", \"供应链管理\", \"采购项目计划\", \"采购任务交付\", \"行业信息收集\", \"行业信息分析\", \"供应商寻源\", \"供应商开发\", \"供应商管理\", \"商务谈判\", \"合同执行\", \"合同跟进\", \"学习能力\", \"逻辑能力\", \"书面表达\", \"口头表达\", \"沟通表达\", \"团队协作\", \"营销\", \"设计\", \"理工\", \"供应链\"]','[{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}]','[\"深圳总部\"]','[\"远程面试\"]',NULL,'open','manual_curated','tencent-procurement-business-management-intern-2026-001',NULL,'','tencent_campus_manual','{\"job\": {\"id\": \"tencent-procurement-business-management-intern-2026-001\", \"title\": \"采购商务管理\", \"slogan\": \"加入S1，让世界看到你的影响力。\", \"status\": \"open\", \"category\": \"采购商务管理\", \"job_type\": \"职能\", \"direction\": \"采购商务管理\", \"application_type\": \"应届实习\"}, \"facets\": {\"cities\": [\"深圳总部\"], \"job_type\": \"职能\", \"direction\": \"采购商务管理\", \"job_category\": \"采购商务管理\", \"business_groups\": [\"CSIG\", \"IEG\", \"PCG\"], \"application_project\": \"实习生\", \"application_subtype\": \"应届实习\"}, \"skills\": [\"采购商务管理\", \"采购管理\", \"供应链管理\", \"采购项目计划\", \"采购任务交付\", \"行业信息收集\", \"行业信息分析\", \"供应商寻源\", \"供应商开发\", \"供应商管理\", \"商务谈判\", \"合同执行\", \"合同跟进\", \"学习能力\", \"逻辑能力\", \"书面表达\", \"口头表达\", \"沟通表达\", \"团队协作\", \"营销\", \"设计\", \"理工\", \"供应链\"], \"source\": {\"source_url\": \"\", \"source_name\": \"tencent_campus_manual\", \"source_type\": \"manual_curated\", \"collected_at\": \"2026-06-01\", \"data_quality\": \"manual_verified\"}, \"locations\": [\"深圳总部\"], \"description\": {\"summary\": \"负责根据需求交付采购项目计划和采购任务，参与行业信息收集分析、供应商寻源开发与日常管理、商务谈判及合同执行跟进。\", \"responsibilities\": [\"根据需求交付采购项目计划及采购任务\", \"收集并分析行业信息，了解行业整体情况\", \"参与供应商寻源、开发及日常管理工作\", \"参与商务谈判，跟进合同执行\"]}, \"requirements\": {\"must_have\": [\"本科及以上学历\", \"对采购、供应链管理及相关专业知识有较深入的理论研究\", \"具备优秀的学习能力、逻辑能力、书面和口头表达沟通能力\", \"具备团队协作能力\"], \"bonus_points\": [\"营销类、设计类、理工类与供应链管理类相关专业\", \"有在大中型企业采购或供应链部门实习经历\"], \"nice_to_have\": [\"具备采购项目计划、采购任务交付相关理解或实践经验\", \"具备行业信息收集分析、供应商寻源、供应商开发和供应商管理相关理解\", \"具备商务谈判、合同执行跟进相关经验\"]}, \"organizations\": [{\"code\": \"CSIG\", \"name\": \"云与智慧产业事业群\"}, {\"code\": \"IEG\", \"name\": \"互动娱乐事业群\"}, {\"code\": \"PCG\", \"name\": \"平台与内容事业群\"}], \"interview_locations\": [\"远程面试\"]}','manual_verified',NULL,0,NULL,'2026-06-07 12:09:49','2026-06-07 12:09:49');
/*!40000 ALTER TABLE `jobs` ENABLE KEYS */;
UNLOCK TABLES;
DROP TABLE IF EXISTS `match_analyses`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `match_analyses` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `user_id` bigint unsigned NOT NULL,
  `resume_id` bigint unsigned NOT NULL,
  `job_id` bigint unsigned NOT NULL,
  `score` int NOT NULL DEFAULT '0',
  `result_json` json NOT NULL,
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `generation_tier` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'fast',
  `generated_by` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'mock_agent',
  `status` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'ready',
  `profile_type` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `profile_dominant_profile` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `updated_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `idx_match_user_created` (`user_id`,`created_at`),
  KEY `idx_match_job` (`job_id`),
  KEY `idx_match_resume` (`resume_id`),
  CONSTRAINT `fk_match_job` FOREIGN KEY (`job_id`) REFERENCES `jobs` (`id`),
  CONSTRAINT `fk_match_resume` FOREIGN KEY (`resume_id`) REFERENCES `resumes` (`id`),
  CONSTRAINT `fk_match_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=114 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='岗位匹配分析结果表';
/*!40101 SET character_set_client = @saved_cs_client */;

