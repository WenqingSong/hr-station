DROP TABLE IF EXISTS `resume_compare_results`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resume_compare_results` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `user_id` bigint unsigned NOT NULL,
  `from_resume_id` bigint unsigned NOT NULL,
  `to_resume_id` bigint unsigned NOT NULL,
  `result_json` json NOT NULL,
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `idx_compare_user_created` (`user_id`,`created_at`),
  KEY `idx_compare_from_to` (`from_resume_id`,`to_resume_id`),
  KEY `fk_compare_to` (`to_resume_id`),
  CONSTRAINT `fk_compare_from` FOREIGN KEY (`from_resume_id`) REFERENCES `resumes` (`id`),
  CONSTRAINT `fk_compare_to` FOREIGN KEY (`to_resume_id`) REFERENCES `resumes` (`id`),
  CONSTRAINT `fk_compare_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='简历对比结果表';
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resume_compare_results` WRITE;
/*!40000 ALTER TABLE `resume_compare_results` DISABLE KEYS */;
/*!40000 ALTER TABLE `resume_compare_results` ENABLE KEYS */;
UNLOCK TABLES;
DROP TABLE IF EXISTS `resume_educations`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resume_educations` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `resume_id` bigint unsigned NOT NULL,
  `school` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `degree` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `major` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `department` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `start_date` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `end_date` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `gpa` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `gpa_scale` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `rank_text` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `core_courses` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `research_direction` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `advisor` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '导师',
  `lab` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '实验室',
  `paper_summary` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `sort_order` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `idx_re_resume` (`resume_id`,`sort_order`),
  CONSTRAINT `fk_re_resume` FOREIGN KEY (`resume_id`) REFERENCES `resumes` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=10 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resume_educations` WRITE;
/*!40000 ALTER TABLE `resume_educations` DISABLE KEYS */;
INSERT INTO `resume_educations` VALUES (1,1,'清华大学','硕士','计算机科学与技术','计算机科学与技术系','2023-09','2026-06','3.78','4.0','前 15%','机器学习、深度学习、自然语言处理、信息检索、大规模数据挖掘、高级算法设计、推荐系统、凸优化、概率图模型','推荐系统、搜索排序、用户行为建模、表示学习、多目标排序','李教授','智能信息处理与推荐系统实验室','参与推荐系统方向论文实验与消融分析，主要负责用户行为序列建模、负采样策略对比、离线指标复现实验和误差样例分析。研究过程中围绕用户短期兴趣、长期偏好建模、多目标排序和样本构造策略进行实验，目前论文仍处于实验补充和投稿准备阶段，已整理实验记录、指标对比、消融分析和误差样例材料。',0),(2,1,'北京邮电大学','本科','软件工程','计算机学院','2019-09','2023-06','3.62','4.0','前 20%','数据结构、操作系统、数据库系统、计算机网络、概率论与数理统计、软件工程、Java 程序设计、算法设计与分析、数据库课程设计','','','','本科阶段主要完成软件工程、算法设计、数据库课程设计和数学建模竞赛相关项目，具备较好的编程基础、数据建模基础和工程协作意识，为后续推荐系统与机器学习方向研究打下基础。',1),(3,2,'武汉理工大学','本科','软件工程','计算机与人工智能学院','2022-09','2026-06','3.42','4.0','前 35%','数据结构、操作系统、计算机网络、数据库系统、Java 程序设计、软件工程、Web 应用开发、分布式系统导论、软件测试、Linux 操作系统基础','后端开发、数据库设计、缓存与接口性能优化','','','暂无正式论文发表。课程学习和项目实践主要围绕后端接口开发、数据库建模、缓存优化、登录鉴权、消息队列和服务部署展开，曾在课程综合项目中负责后端系统设计与接口实现，并整理项目接口文档、测试用例和部署说明。',0),(4,3,'浙江万里学院','本科','信息管理与信息系统','信息管理系','2022-09','2026-06','3.36','4.0','前 30%','管理信息系统、数据库原理、用户体验设计、电子商务概论、统计学、市场调研、数据分析基础、项目管理、消费者行为学、Python 数据分析基础','','','','暂无正式论文发表。课程项目和实践项目主要围绕校园服务产品、用户调研、业务流程梳理、产品原型设计和数据分析展开，曾完成校园活动报名、二手教材交易、学习打卡产品体验分析等项目，并沉淀产品需求文档、用户访谈记录、问卷分析和原型设计材料。',0),(5,4,'四川师范大学','本科','教育技术学','教育科学学院','2022-09','2026-06','3.48','4.0','前 30%','教育心理学、学习科学、教学设计、教育数据分析、用户体验基础、数字媒体技术、课程与教学论、统计学基础、教育传播学、在线课程设计','','','数字学习与教育技术创新工作室','暂无正式论文发表。课程项目和实践经历主要围绕数字化学习、学习体验、学生成长支持和校园社群运营展开，曾参与学院数字学习体验调研项目，协助完成学生访谈、问卷整理和学习平台使用问题归纳，重点关注学生在在线学习过程中的任务拖延、反馈获得感、学习动机和平台使用体验等问题。',0),(6,5,'南京大学','本科','社会学','社会学院','2022-09','2026-06','3.86','4.0','前 10%','社会学概论、社会研究方法、社会统计学、组织社会学、教育社会学、城市社会学、公共政策分析、质性研究方法、社会调查实务、社会心理学','青年发展、教育公平、公共服务、基层治理、组织运行机制','','社会调查与公共政策研究工作坊','暂无正式论文发表。参与县域高中学生升学选择与家庭支持调研、社区老年人数字服务使用障碍研究等项目，主要负责访谈提纲设计、访谈资料整理、问卷数据清洗、质性编码分析和阶段性报告撰写。个人长期关注青年成长、教育支持、公共服务可及性和组织运行机制，更希望在长期议题中持续积累研究和项目经验。',0),(7,6,'湖南科技大学','本科','软件工程','计算机科学与工程学院','2022-09','2026-06','3.31','4.0','前 40%','数据结构、Java 程序设计、数据库系统、计算机网络、操作系统、软件工程、Web 开发技术','','','','暂无正式论文发表。当前主要完成校内课程学习和基础编程练习，正在学习 Java 后端开发、数据库和 Web 开发相关内容。',0),(8,7,'湖南科技大学','本科','软件工程','计算机科学与工程学院','2022-09','2026-06','3.31','4.0','前 40%','数据结构、Java 程序设计、数据库系统、计算机网络、操作系统、软件工程、Web 开发技术、Linux 操作系统基础','','','',NULL,0),(9,8,'湖南科技大学','本科','软件工程','计算机科学与工程学院','2022-09','2026-06','3.31','4.0','前 40%','数据结构、Java 程序设计、数据库系统、计算机网络、操作系统、软件工程、Web 开发技术、Linux 操作系统基础、软件测试、数据库课程设计','','','','暂无正式论文发表。本科阶段主要围绕 Java 后端开发、数据库设计、接口开发、登录鉴权、缓存使用和前后端联调进行项目实践。已完成校园失物招领系统、个人博客与学习笔记系统等项目，并在企业实习中参与后台管理系统接口开发、测试反馈修复和接口文档维护。',0);
/*!40000 ALTER TABLE `resume_educations` ENABLE KEYS */;
UNLOCK TABLES;
DROP TABLE IF EXISTS `resume_internships`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resume_internships` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `resume_id` bigint unsigned NOT NULL,
  `company` varchar(150) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `position` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `start_date` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `end_date` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `description` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci,
  `sort_order` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `idx_ri_resume` (`resume_id`,`sort_order`),
  CONSTRAINT `fk_ri_resume` FOREIGN KEY (`resume_id`) REFERENCES `resumes` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=11 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resume_internships` WRITE;
/*!40000 ALTER TABLE `resume_internships` DISABLE KEYS */;
INSERT INTO `resume_internships` VALUES (1,1,'某头部内容平台','搜索推荐算法实习生','2024-07','2024-10','参与内容推荐场景的召回与排序实验，围绕用户短期兴趣变化、内容冷启动和负反馈样本处理进行实验分析。实习期间使用 Python、PyTorch、Spark、Hive 和 SQL 处理用户行为数据、构建实验样本、分析离线指标和整理实验结论。我主要参与用户行为特征统计、异常曝光样本定位、召回侧特征实验对比和小流量实验前的数据核验。在样本分析阶段，我使用 Hive 和 SQL 统计用户点击、曝光、停留时长、负反馈和内容发布时间等特征，定位 3 类异常曝光样本，并协助修正实验样本过滤规则。在召回侧特征实验中，我对比不同时间窗口下用户近期兴趣特征对点击率和召回覆盖的影响，整理离线指标变化和分层结果。针对冷启动内容样本，我按内容发布时间、曝光次数、类目和互动行为进行分层分析，输出低曝光内容的特征分布报告。实习期间参与 8 组离线实验，输出 4 份实验分析文档，其中 2 项特征策略进入小流量验证。通过这段经历，我理解了真实推荐业务中数据质量、样本口径、离线指标和小流量实验之间的关系，也意识到算法工程不仅是训练模型，还需要严谨的数据核验和实验复盘。',0),(2,2,'武汉某软件科技有限公司','后端开发实习生','2025-03','2025-05','参与企业内部管理系统的后端接口开发，项目主要面向公司内部员工信息维护、部门管理、审批记录查询和基础数据统计场景。实习期间使用 Java、Spring Boot、MyBatis、MySQL、Redis 进行后端开发，主要负责基础信息维护、列表查询、权限字段校验和部分统计接口。我参与员工信息、部门信息、审批记录、角色配置等模块开发，完成 12 个列表查询和详情接口，支持分页、条件筛选、状态过滤和时间范围查询。针对测试反馈较多的参数为空、分页异常、状态枚举不一致、时间格式错误等问题，我补充统一参数校验和异常提示，并完善 Swagger 字段说明。对于员工列表和审批记录等高频查询接口，我协助排查慢查询原因，对部门 ID、状态、创建时间等字段增加索引，并配合测试验证查询结果一致性。实习期间参与开发和维护 20 余个接口，修复测试阶段反馈问题 30 余项，负责模块最终在内部测试环境完成验收。通过这段经历，我熟悉了企业项目中的需求评审、分支开发、接口联调、测试反馈修复和上线前验收流程。',0),(3,2,'武汉某云服务技术有限公司','','2024-12','2025-02','参与云资源管理后台的部分接口维护工作，主要支持服务器资源列表、操作记录查询、告警信息展示和用户操作日志模块。实习期间使用 Go、MySQL、Redis 和 Linux 环境进行开发和问题排查。我主要负责补充资源列表筛选条件、优化操作日志分页查询、修复部分接口字段缺失和状态展示不一致问题。项目中根据前端联调反馈，补充实例状态、资源地域、创建时间、操作人等筛选字段，并统一返回结构中的分页信息和空列表格式。对于操作日志查询较慢的问题，我协助分析 SQL 执行计划，确认部分查询未命中索引，随后根据查询条件调整索引并限制最大分页大小，避免大页码查询拖慢接口。实习期间还参与整理接口变更说明和测试用例，记录 15 余条接口字段调整和异常场景。该经历让我接触到更接近真实后台系统的资源管理、日志查询和状态展示场景，也加深了对接口稳定性、字段兼容性和查询性能的理解。',1),(4,3,'杭州某教育科技公司','产品运营实习生','2025-03','2025-05','参与在线课程后台和学习打卡工具的日常运营支持，协助产品经理整理用户反馈、跟进小需求、测试功能改动和维护运营数据表。实习期间主要使用飞书、Excel、墨刀、禅道和 SQL 基础查询工具，围绕课程播放、作业提交、学习打卡、后台筛选和用户反馈处理等场景开展工作。我每周整理客服和运营反馈，将问题按登录、课程播放、作业提交、打卡提醒、数据展示和后台配置等类型进行分类，并标注影响范围、出现频次和处理状态，累计整理 230 余条用户反馈，输出 5 份周反馈汇总。需求协作方面，我协助产品经理补充 6 个小需求说明，包括字段规则、按钮状态、异常提示、后台筛选条件和验收标准；参与课程后台筛选功能和学习打卡提醒功能测试，记录并跟进 17 个问题。数据方面，我维护学习打卡数据表，统计用户打卡次数、连续打卡天数、中断原因和提醒触达情况，并根据用户反馈整理出“提醒时间不明显”“作业入口不清晰”“打卡成功反馈弱”等问题。最终协助完成 6 个小需求上线前验收，也让我更熟悉产品助理在真实团队中从用户反馈、需求记录、开发沟通到测试验收的基础工作流程。',0),(5,3,'杭州某本地生活服务公司','产品运营实习生','2024-07','2024-09','参与本地生活优惠活动的页面配置、用户反馈整理和基础数据复盘，主要服务校园周边餐饮、奶茶和休闲娱乐类商家活动。实习期间协助运营同学上线 10 余场优惠活动，负责核对活动标题、优惠价格、库存数量、使用时间、门店地址、核销规则和活动说明，减少用户因规则理解不清导致的咨询和投诉。用户反馈方面，我将活动咨询记录整理为优惠不可用、门店距离远、库存显示不及时、核销规则不清楚、页面入口不明显等类型，并每周输出问题归类表给运营和产品同学参考。数据复盘方面，我使用 Excel 统计活动曝光、点击、领取、核销和退款数据，协助分析不同活动标题、优惠力度和门店距离对转化的影响。实习期间共参与整理 8 份活动复盘表，并参与 2 次活动页面文案优化，其中一次将“领取后到店核销”的规则提示前置到活动卡片和详情页首屏，减少了部分重复咨询。该经历让我理解产品和运营并不是割裂的，页面信息结构、规则表达和数据反馈都会直接影响用户转化与体验。',1),(6,4,'成都某在线教育公司','用户运营实习生','2025-03','2025-06','参与在线学习社群和训练营运营，协助完成学员提醒、学习数据整理、社群活动策划和用户反馈收集。实习期间主要使用企业微信、飞书、Excel、问卷星和 Canva，服务对象为报名在线课程和训练营的学习用户。我每周整理学员学习进度表，标记未完成任务、连续缺勤、活跃学员和需要重点跟进的用户，并协助运营 3 个学习社群，负责每日提醒、问题收集、活动通知和阶段复盘。为了减少机械催促感，我根据学员反馈调整提醒文案，将单纯的“请完成任务”改为更具体的“今天建议完成第几节课、预计用时多少、完成后可以得到什么反馈”，提升提醒内容的可接受度。活动方面，我参与设计学习打卡活动和阶段复盘模板，整理学员对课程难度、作业量、直播时间和社群节奏的反馈，并输出 6 份周运营复盘。实习期间累计维护约 450 名学员的学习进度数据，协助完成 2 次学习活动策划，也让我理解用户运营不仅是发通知，更需要理解用户为什么中断、什么样的反馈能帮助用户继续学习，以及如何在运营动作中平衡效率和用户感受。',0),(7,4,'成都某青年成长服务机构','内容运营实习生','2024-07','2024-09','参与青年成长类公众号和社群内容运营，内容主题包括大学学习方法、时间管理、实习准备、情绪支持和城市生活体验。实习期间主要负责选题资料整理、推文初稿撰写、活动文案编辑、社群话题维护和用户反馈收集。我根据过往文章阅读量、收藏量和留言反馈整理内容选题表，将内容方向分为学习方法、职业探索、生活方式、心理支持和经验访谈五类，并参与撰写和编辑 12 篇公众号推文。社群运营方面，我协助维护 2 个青年成长社群，定期发布讨论话题，如“如何开始准备第一份实习”“如何安排一个不焦虑的周末”“最近一次有效学习是什么时候”等，收集用户留言并整理成内容素材。实习期间参与 3 次线上分享活动的文案和报名表设计，协助统计报名人数、实际参与人数和活动反馈。该经历让我接触到内容运营从选题、表达、发布到反馈复盘的完整流程，也让我意识到内容不是单纯写得好，而是要和用户当下的问题、情绪和行动场景有关。',1),(8,5,'某公益基金会教育项目组','项目助理实习生','2025-02','2025-05','参与县域高中生成长支持项目，协助完成学生需求调研、活动执行、材料整理、志愿者协同和项目复盘。实习期间主要使用飞书、Excel、问卷星、腾讯会议和微信公众号，围绕学生升学信息支持、时间管理、情绪压力和家庭沟通等主题开展项目支持工作。我协助整理学生报名信息、课程参与记录和活动反馈表，维护约 180 名学生的项目参与记录，并参与 3 场线上成长主题活动执行，负责会前通知、会中记录和会后反馈整理。项目反馈整理阶段，我将学生关于升学信息、学习节奏、情绪压力、家庭沟通和志愿者陪伴的反馈进行分类，累计整理 400 余条反馈信息，并协助撰写 3 份月度项目简报和 1 份阶段复盘材料。与志愿者团队协作时，我跟进学生个案反馈和活动改进建议，记录学生在参与频率、活动理解和反馈表达上的变化。该经历让我更熟悉公益项目中“服务对象需求—活动设计—执行记录—反馈复盘—项目改进”的基本闭环，也让我确认自己更适合长期、细致、服务导向的组织支持工作。',0),(9,5,'某高校公共政策研究中心','研究助理实习生','2024-07','2024-09','参与教育与社区公共服务相关课题资料整理工作，主要支持文献检索、政策资料梳理、访谈纪要整理和案例库维护。实习期间围绕教育资源配置、社区公共服务、青年发展和基层治理等主题收集公开政策文件、研究报告和案例材料，并按地区、议题、服务对象和政策工具进行分类。我协助整理 60 余份政策与研究资料，提炼政策目标、服务对象、执行主体和实施方式等信息，并将 20 余份访谈纪要整理为标准化记录，标注关键信息、典型表述和待追问问题。工作中需要长期处理细碎材料、保持格式一致和事实准确，因此我逐渐形成了资料命名、版本管理、摘要提取和引用核对的习惯。该实习让我理解研究助理工作并不只是“查资料”，更重要的是为后续分析建立可靠、可追溯、可复用的材料基础。',1),(10,8,'长沙某软件科技有限公司','后端开发实习生','2025-03','2025-05','参与企业内部后台管理系统的后端接口开发，项目主要服务员工信息维护、部门管理、审批记录查询和基础数据统计等场景。实习期间使用 Java、Spring Boot、MyBatis、MySQL、Redis 和 Swagger 进行开发，主要负责列表查询、详情查询、基础信息维护、字段校验和测试反馈修复。\n\n实习初期，我先参与阅读已有接口和数据库表结构，熟悉项目中的 Controller、Service、Mapper 分层方式，以及统一返回结构、分页参数、状态枚举和异常提示规范。随后参与员工信息、部门信息、审批记录和角色配置等模块开发，完成 11 个列表查询和详情接口，支持分页、条件筛选、状态过滤、关键词查询和时间范围查询。针对前端联调中出现的字段含义不清、空值返回不统一、状态枚举展示不一致等问题，我补充 Swagger 注释和字段说明，并和前端同学对齐返回结构。\n\n测试阶段，我根据测试反馈修复参数为空、分页页码异常、时间格式错误、状态筛选不生效、删除后列表未刷新等问题。对于员工列表和审批记录等高频查询接口，我协助排查慢查询原因，使用 EXPLAIN 查看 SQL 执行情况，并在正式员工指导下对部门 ID、状态、创建时间等字段增加索引，配合测试验证查询结果一致性。实习期间参与开发和维护 18 个接口，修复测试阶段反馈问题 26 项，负责模块最终在内部测试环境完成验收。\n\n通过这段实习，我第一次接触到比较完整的企业项目开发流程，包括需求理解、分支开发、接口自测、前后端联调、测试反馈修复、接口文档维护和验收确认。相比学校项目，企业项目更重视字段规范、异常处理、兼容已有数据、日志排查和稳定交付，这让我对后端开发实习生的实际工作内容有了更清晰的认识。',0);
/*!40000 ALTER TABLE `resume_internships` ENABLE KEYS */;
UNLOCK TABLES;
DROP TABLE IF EXISTS `resume_language_exams`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resume_language_exams` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `resume_id` bigint unsigned NOT NULL,
  `exam_type` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `score` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `sort_order` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `idx_rle_resume` (`resume_id`,`sort_order`),
  CONSTRAINT `fk_rle_resume` FOREIGN KEY (`resume_id`) REFERENCES `resumes` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=9 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resume_language_exams` WRITE;
/*!40000 ALTER TABLE `resume_language_exams` DISABLE KEYS */;
INSERT INTO `resume_language_exams` VALUES (1,1,'CET-6','568',0),(2,2,'CET-4','512',0),(3,3,'CET-4','489',0),(4,4,'CET-4','476',0),(5,5,'CET-6','592',0),(6,6,'CET-4','462',0),(7,7,'CET-4','462',0),(8,8,'CET-4','462',0);
/*!40000 ALTER TABLE `resume_language_exams` ENABLE KEYS */;
UNLOCK TABLES;
DROP TABLE IF EXISTS `resume_optimization_results`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resume_optimization_results` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `user_id` bigint unsigned NOT NULL,
  `resume_id` bigint unsigned DEFAULT NULL COMMENT '关联的简历ID',
  `job_id` bigint unsigned DEFAULT NULL COMMENT '关联的岗位ID',
  `result_json` json NOT NULL,
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `optimization_mode` varchar(30) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'general',
  `generation_tier` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'fast',
  `generated_by` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'mock_agent',
  `status` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'ready',
  `profile_type` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `profile_dominant_profile` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `target_direction` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `updated_at` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `idx_opt_user_created` (`user_id`,`created_at`),
  KEY `idx_opt_job` (`job_id`),
  KEY `idx_opt_resume` (`resume_id`),
  KEY `idx_opt_user_resume_mode` (`user_id`,`resume_id`,`optimization_mode`,`created_at`),
  KEY `idx_opt_resume_job_new` (`resume_id`,`job_id`,`created_at`),
  KEY `idx_opt_resume_direction` (`resume_id`,`target_direction`,`created_at`),
  CONSTRAINT `fk_opt_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=64 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='简历优化结果表';
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resume_optimization_results` WRITE;
/*!40000 ALTER TABLE `resume_optimization_results` DISABLE KEYS */;
