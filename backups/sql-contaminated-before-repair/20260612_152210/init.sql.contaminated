UNLOCK TABLES;
DROP TABLE IF EXISTS `resume_works`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resume_works` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `resume_id` bigint unsigned NOT NULL,
  `name` varchar(150) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `url` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `password` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '',
  `sort_order` int NOT NULL DEFAULT '0',
  PRIMARY KEY (`id`),
  KEY `idx_rw_resume` (`resume_id`,`sort_order`),
  CONSTRAINT `fk_rw_resume` FOREIGN KEY (`resume_id`) REFERENCES `resumes` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=26 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resume_works` WRITE;
/*!40000 ALTER TABLE `resume_works` DISABLE KEYS */;
INSERT INTO `resume_works` VALUES (1,1,'CTR 序列建模复现实验项目','https://github.com/demo-user/ctr-sequence-model','',0),(2,1,'推荐排序实验记录模板','https://github.com/demo-user/recsys-exp-template','',1),(3,1,'论文阅读与实验复现管理工具','https://github.com/demo-user/paper-exp-tracker','',2),(4,1,'推荐系统误差样例分析脚本','https://github.com/demo-user/recsys-error-analysis','',3),(5,2,'校园二手交易平台后端系统','https://github.com/demo-user/campus-trade-api','',0),(6,2,'在线题库与练习系统','https://github.com/demo-user/online-question-bank','',1),(7,2,'简易消息通知服务','https://github.com/demo-user/simple-notify-service','',2),(8,2,'个人博客与技术笔记系统','https://github.com/demo-user/dev-blog-system','',3),(9,3,'校园活动报名与签到小程序原型','https://demo.example.com/activity-signup-prototype','',0),(10,3,'二手教材交易产品需求文档','https://demo.example.com/textbook-trade-prd','',1),(11,3,'学习打卡社区产品体验分析报告','https://demo.example.com/study-checkin-analysis','',2),(12,3,'AI 求职助手产品需求拆解练习','https://demo.example.com/ai-job-assistant-prd','',3),(13,4,'大学生自习与学习陪伴小程序原型','https://demo.example.com/study-companion-prototype','',0),(14,4,'新生适应问题访谈整理与内容手册','https://demo.example.com/freshman-guide','',1),(15,4,'校园生活方式社群活动复盘合集','https://demo.example.com/campus-life-review','',2),(16,4,'在线课程学习体验优化分析报告','https://demo.example.com/online-learning-ux-review','',3),(17,5,'县域高中学生升学选择与家庭支持调研报告','https://demo.example.com/county-high-school-report','',0),(18,5,'社区老年人数字服务使用障碍调研简报','https://demo.example.com/elder-digital-service-report','',1),(19,5,'高校学生阅读支持计划活动复盘','https://demo.example.com/reading-support-review','',2),(20,5,'高校学生公共事务参与意愿访谈报告','https://demo.example.com/public-participation-interview','',3),(21,7,'校园失物招领系统','https://github.com/demo-user/lost-found-system','',0),(22,7,'个人博客与学习笔记系统','https://github.com/demo-user/personal-blog','',1),(23,8,'校园失物招领系统','https://github.com/demo-user/lost-found-system','',0),(24,8,'个人博客与学习笔记系统','https://github.com/demo-user/personal-blog','',1),(25,8,'接口重复提交与幂等处理练习','https://github.com/demo-user/idempotency-demo','',2);
/*!40000 ALTER TABLE `resume_works` ENABLE KEYS */;
UNLOCK TABLES;
DROP TABLE IF EXISTS `resumes`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `resumes` (
  `id` bigint unsigned NOT NULL AUTO_INCREMENT,
  `user_id` bigint unsigned NOT NULL,
  `name` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '简历名称',
  `is_current` tinyint(1) NOT NULL DEFAULT '0' COMMENT '是否当前默认简历',
  `real_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '姓名',
  `phone` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '手机号',
  `email` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '邮箱',
  `city` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '当前城市',
  `professional_skills` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT '专业技能 / 工具能力',
  `ai_application` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'AI 应用技能',
  `homepage` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT '' COMMENT '个人主页',
  `additional_info` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT '补充信息',
  `raw_text` mediumtext CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'AI 文本快照',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_resumes_user_name` (`user_id`,`name`),
  KEY `idx_resumes_user_current` (`user_id`,`is_current`,`updated_at`),
  KEY `idx_resumes_user_updated` (`user_id`,`updated_at`),
  CONSTRAINT `fk_resumes_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=9 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='简历主表';
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `resumes` WRITE;
/*!40000 ALTER TABLE `resumes` DISABLE KEYS */;
INSERT INTO `resumes` VALUES (1,2,'01-算法研究生-岗位匹配',1,'林知远','13900010001','mailto:linzhiyuan.cs@example.com','北京','Python、C++、SQL、Shell、Go 基础、PyTorch、Scikit-learn、Pandas、NumPy、Faiss、Redis、MySQL、Docker、Linux、Git、Hive、Spark 基础、FastAPI、推荐系统、搜索排序、CTR 预估、用户行为建模、特征工程、负采样、离线评估、AUC、NDCG、Recall、实验复现、消融实验、误差样例分析、数据分析、实验报告撰写','熟悉使用大模型辅助论文阅读、实验代码理解、错误日志定位、实验报告整理和研究思路拆解。能够通过结构化提示词将论文方法拆解为研究问题、数据处理、模型结构、训练目标、评估指标和实验结论六部分，并用于加速算法复现和实验复盘。使用 AI 工具时会主动核对论文原文、开源代码、实验设置和本地复现实验结果，避免直接采信生成内容。也会使用 AI 辅助整理实验 TODO、生成指标解释初稿和归纳误差样例，但最终结论以原始数据和实验结果为准。','https://github.com/demo-user','我目前主要投递推荐算法、搜索算法、机器学习算法、算法工程、机器学习平台和用户行为建模相关实习岗位。相比只关注模型结构本身，我更关注数据质量、样本构造、特征口径、评价指标和线上业务目标之间的关系。过去的科研和实习经历让我逐渐理解，算法岗位不仅需要建模能力，也需要将业务问题、数据分布、实验设计和工程实现结合起来，才能让模型改进真正落到实际产品效果中。\n\n我习惯通过实验数据验证想法，也愿意做长期、细致、可复现的实验复盘。当前我的优势在于推荐系统实验、用户行为建模、离线评估、误差样例分析和科研复现能力，仍需要继续补齐大规模在线系统、特征平台、实时推荐链路和线上 A/B 实验经验。希望在算法工程实习中进一步理解真实业务场景，参与推荐 / 搜索系统中的召回、排序、特征分析、样本构造、实验评估和小流量验证工作。','【简历名称】01-算法研究生-岗位匹配\n【基础信息】姓名：林知远｜手机：13900010001｜邮箱：mailto:linzhiyuan.cs@example.com｜城市：北京\n【专业技能】Python、C++、SQL、Shell、Go 基础、PyTorch、Scikit-learn、Pandas、NumPy、Faiss、Redis、MySQL、Docker、Linux、Git、Hive、Spark 基础、FastAPI、推荐系统、搜索排序、CTR 预估、用户行为建模、特征工程、负采样、离线评估、AUC、NDCG、Recall、实验复现、消融实验、误差样例分析、数据分析、实验报告撰写\n【AI应用技能】熟悉使用大模型辅助论文阅读、实验代码理解、错误日志定位、实验报告整理和研究思路拆解。能够通过结构化提示词将论文方法拆解为研究问题、数据处理、模型结构、训练目标、评估指标和实验结论六部分，并用于加速算法复现和实验复盘。使用 AI 工具时会主动核对论文原文、开源代码、实验设置和本地复现实验结果，避免直接采信生成内容。也会使用 AI 辅助整理实验 TODO、生成指标解释初稿和归纳误差样例，但最终结论以原始数据和实验结果为准。\n【教育经历】清华大学｜硕士｜计算机科学与技术｜计算机科学与技术系｜2023-09-2026-06｜GPA 3.78/4.0｜主修：机器学习、深度学习、自然语言处理、信息检索、大规模数据挖掘、高级算法设计、推荐系统、凸优化、概率图模型｜研究方向：推荐系统、搜索排序、用户行为建模、表示学习、多目标排序｜论文：参与推荐系统方向论文实验与消融分析，主要负责用户行为序列建模、负采样策略对比、离线指标复现实验和误差样例分析。研究过程中围绕用户短期兴趣、长期偏好建模、多目标排序和样本构造策略进行实验，目前论文仍处于实验补充和投稿准备阶段，已整理实验记录、指标对比、消融分析和误差样例材料。\n【教育经历】北京邮电大学｜本科｜软件工程｜计算机学院｜2019-09-2023-06｜GPA 3.62/4.0｜主修：数据结构、操作系统、数据库系统、计算机网络、概率论与数理统计、软件工程、Java 程序设计、算法设计与分析、数据库课程设计｜论文：本科阶段主要完成软件工程、算法设计、数据库课程设计和数学建模竞赛相关项目，具备较好的编程基础、数据建模基础和工程协作意识，为后续推荐系统与机器学习方向研究打下基础。\n【项目经历】多目标推荐排序模型实验平台｜角色：核心开发者｜2024-03-2024-11｜面向实验室推荐系统研究场景，搭建用于多目标排序模型实验、指标对比和实验记录管理的平台，支持召回结果导入、样本构建、特征拼接、模型训练、离线评估、实验记录管理和实验复现。项目使用 Python、PyTorch、Faiss、Redis、MySQL、Docker、Linux 实现，我主要负责样本构建、特征处理、模型训练脚本、离线评估模块和实验配置管理。项目中围绕点击率、停留时长、转化倾向等多目标排序任务，设计统一的数据输入格式和实验配置格式，减少不同排序模型之间重复修改训练代码的问题。模型训练部分基于 PyTorch 实现排序模型训练流程，支持不同特征组合、损失函数和负采样策略切换；检索实验部分使用 Faiss 完成向量召回结果导入和初步对比；离线评估部分实现 NDCG、Recall、AUC、HitRate 等指标计算，并将实验配置、指标结果、结论和问题记录统一落库。为了降低组内同学复现实验成本，我使用 Docker 统一实验环境，并整理实验启动脚本、参数说明和常见问题记录。最终将单次实验配置准备时间从约 40 分钟降低到 10 分钟以内，支持 5 类排序模型在同一数据集上的离线指标对比，累计完成 20 余组消融实验记录，为后续论文实验部分提供数据支持。\n【项目经历】基于用户行为序列的点击率预估模型复现｜角色：算法实现与实验分析｜2023-10-2024-01｜基于公开电商行为数据集，复现用户兴趣建模相关方法，对比传统 LR、Wide&Deep 模型与序列兴趣建模方法在点击率预估任务中的表现差异。项目使用 Python、PyTorch、Pandas、NumPy、Scikit-learn 实现，我负责数据清洗、样本构造、模型实现、训练调参和实验分析。数据处理阶段，我完成用户行为日志清洗、用户行为序列截断、样本去重、负样本构造和训练验证集划分，并统计不同用户活跃度、物品曝光频率和序列长度分布。模型实现阶段，我基于 PyTorch 实现 Embedding、Attention Pooling 和序列兴趣建模模块，并搭建 LR、Wide&Deep 等基础对比模型。实验过程中重点分析不同序列长度、负采样比例、Embedding 维度和学习率对模型效果的影响，同时记录训练日志、指标变化和误差样例。最终在验证集上相比基础 LR 模型 AUC 提升约 6.8%，整理 12 页实验报告，说明模型结构、指标变化、参数影响和误差样例，并沉淀出一套可复用的 CTR 任务训练模板。通过误差样例分析发现，短序列用户、低频物品样本和行为噪声较高的用户更容易出现预测偏差。\n【项目经历】论文阅读与实验复现管理工具｜角色：个人开发者｜2024-12-2025-02｜为了解决论文阅读、实验配置和复现实验记录分散的问题，开发一个轻量级工具，用于管理论文笔记、实验配置、指标结果和复盘结论。项目使用 Python、FastAPI、SQLite、Vue、Markdown 实现，我独立完成数据结构设计、后端接口、前端基础页面和 Markdown 导出能力。项目中设计了论文、实验、指标、结论四类核心数据结构，支持记录论文标题、方向、模型类型、数据集、关键方法、复现状态、实验参数、指标结果和复盘结论。功能上实现论文笔记增删改查、实验记录管理、按论文方向和模型类型筛选、指标结果对比、Markdown 导出和复现实验清单维护。为了提升复盘效率，我将常见实验问题整理为复盘清单，例如数据划分是否一致、负采样策略是否可复现、指标口径是否统一、随机种子是否固定、训练日志是否完整等。项目累计整理 30 余篇推荐系统和表示学习相关论文笔记，管理 40 余条实验配置和指标结果，帮助自己将论文阅读和实验复盘从零散记录转为结构化沉淀。\n【项目经历】推荐系统论文实验误差样例分析｜角色：实验分析与案例整理｜2025-03-2025-05｜围绕推荐排序模型实验中“整体指标提升但部分用户预测效果不稳定”的问题，开展误差样例分析和样本分层研究，尝试从用户活跃度、行为序列长度、物品热度和负反馈比例等角度解释模型表现差异。项目使用 Python、Pandas、NumPy、Matplotlib 和 SQL 完成实验数据整理与分析。我将用户样本按行为序列长度、最近活跃时间、点击频率和物品交互稀疏程度进行分层，统计不同分层下 AUC、Recall 和 NDCG 的变化，并抽取预测偏差较大的样本进行人工检查。分析发现，模型在高活跃用户和热门物品上的表现更稳定，但在短序列用户、冷门物品和负反馈样本较多的用户群体上存在明显波动。基于分析结果，我整理了样本构造、负采样策略和特征补充方向的改进建议，并形成 10 页实验分析报告。该项目强化了我对推荐系统实验中“不能只看整体指标，还要理解样本结构和业务分布”的认识。\n【实习经历】某头部内容平台｜搜索推荐算法实习生｜2024-07-2024-10｜参与内容推荐场景的召回与排序实验，围绕用户短期兴趣变化、内容冷启动和负反馈样本处理进行实验分析。实习期间使用 Python、PyTorch、Spark、Hive 和 SQL 处理用户行为数据、构建实验样本、分析离线指标和整理实验结论。我主要参与用户行为特征统计、异常曝光样本定位、召回侧特征实验对比和小流量实验前的数据核验。在样本分析阶段，我使用 Hive 和 SQL 统计用户点击、曝光、停留时长、负反馈和内容发布时间等特征，定位 3 类异常曝光样本，并协助修正实验样本过滤规则。在召回侧特征实验中，我对比不同时间窗口下用户近期兴趣特征对点击率和召回覆盖的影响，整理离线指标变化和分层结果。针对冷启动内容样本，我按内容发布时间、曝光次数、类目和互动行为进行分层分析，输出低曝光内容的特征分布报告。实习期间参与 8 组离线实验，输出 4 份实验分析文档，其中 2 项特征策略进入小流量验证。通过这段经历，我理解了真实推荐业务中数据质量、样本口径、离线指标和小流量实验之间的关系，也意识到算法工程不仅是训练模型，还需要严谨的数据核验和实验复盘。\n【外语考试】CET-6：568\n【证书】中国计算机学会 CSP 认证｜2023 年 3 月获得，成绩排名前 20%，具备较好的算法基础和程序设计能力。\n【证书】阿里云机器学习平台 PAI 基础课程认证｜2024 年 5 月通过，了解机器学习平台基础能力、模型训练流程、数据处理和云上实验管理。\n【获奖】研究生学业一等奖学金｜校级奖学金，2024 年 10 月获得，基于课程成绩、科研参与和综合表现评定。\n【获奖】全国大学生数学建模竞赛省级二等奖｜省级二等奖，2021 年 11 月获得，主要负责数据建模、算法实现和结果可视化部分。\n【获奖】北京邮电大学优秀毕业生｜校级荣誉，2023 年 6 月获得，基于本科阶段学业成绩、竞赛经历和综合表现评定。\n【作品】CTR 序列建模复现实验项目｜https://github.com/demo-user/ctr-sequence-model\n【作品】推荐排序实验记录模板｜https://github.com/demo-user/recsys-exp-template\n【作品】论文阅读与实验复现管理工具｜https://github.com/demo-user/paper-exp-tracker\n【作品】推荐系统误差样例分析脚本｜https://github.com/demo-user/recsys-error-analysis\n【个人主页】https://github.com/demo-user\n【补充信息】我目前主要投递推荐算法、搜索算法、机器学习算法、算法工程、机器学习平台和用户行为建模相关实习岗位。相比只关注模型结构本身，我更关注数据质量、样本构造、特征口径、评价指标和线上业务目标之间的关系。过去的科研和实习经历让我逐渐理解，算法岗位不仅需要建模能力，也需要将业务问题、数据分布、实验设计和工程实现结合起来，才能让模型改进真正落到实际产品效果中。\n\n我习惯通过实验数据验证想法，也愿意做长期、细致、可复现的实验复盘。当前我的优势在于推荐系统实验、用户行为建模、离线评估、误差样例分析和科研复现能力，仍需要继续补齐大规模在线系统、特征平台、实时推荐链路和线上 A/B 实验经验。希望在算法工程实习中进一步理解真实业务场景，参与推荐 / 搜索系统中的召回、排序、特征分析、样本构造、实验评估和小流量验证工作。\n','2026-06-07 12:17:47','2026-06-07 13:25:49'),(2,2,'02-211后台开发-岗位匹配',0,'周明远','13900010002','mailto:zhoumingyuan.dev@example.com','武汉','Go、Java、SQL、Gin、Spring Boot、MyBatis、MySQL、Redis、RabbitMQ、JWT、RESTful API 设计、数据库表结构设计、索引基础、分页查询、参数校验、登录鉴权、接口幂等、缓存设计、消息队列基础、Docker、Docker Compose、Nginx、Linux 基础、Git、Swagger、Postman、Shell 基础、前后端联调、接口测试、基础性能优化','日常使用 AI 工具辅助阅读框架源码、拆解接口实现思路、生成接口测试样例、定位报错日志和整理技术学习笔记。能够将后端需求拆解为接口路径、请求参数、响应结构、数据库字段、异常状态和测试用例，并结合官方文档、本地运行结果和代码审查进行核对，不直接复制未经验证的生成代码。曾使用 AI 辅助梳理 Redis 缓存 key 设计、RabbitMQ 消费失败重试流程和 Swagger 接口说明，提高项目开发和复盘效率。','https://github.com/demo-user-backend','我目前主要投递后端开发、Java 后端开发、Go 后端开发、云计算后台开发和基础平台开发相关实习岗位。相比前端和算法方向，我更喜欢把业务流程拆解成接口、表结构、权限规则和状态流转，再通过代码逐步实现并验证。过去的课程项目、个人项目和实习经历让我熟悉了常见后端开发流程，包括接口设计、数据库建模、登录鉴权、缓存使用、分页查询、消息队列、前后端联调、接口文档维护和测试反馈修复。\n\n当前我的能力还处于本科实习生阶段，系统设计和高并发经验不算深入，但我具备较强的工程实践意识，愿意从基础接口、数据表、日志排查、性能优化和文档维护做起。我比较重视代码可运行、接口可联调、字段说明清楚和问题复盘，遇到不熟悉的技术会先通过官方文档、Demo 验证和本地测试确认，再应用到项目中。后续希望继续提升 Go / Java 后端开发能力，重点补齐数据库优化、Redis 缓存一致性、消息队列可靠性、Linux 部署、服务监控和真实业务系统设计经验。','【简历名称】02-211后台开发-岗位匹配\n【基础信息】姓名：周明远｜手机：13900010002｜邮箱：mailto:zhoumingyuan.dev@example.com｜城市：武汉\n【专业技能】Go、Java、SQL、Gin、Spring Boot、MyBatis、MySQL、Redis、RabbitMQ、JWT、RESTful API 设计、数据库表结构设计、索引基础、分页查询、参数校验、登录鉴权、接口幂等、缓存设计、消息队列基础、Docker、Docker Compose、Nginx、Linux 基础、Git、Swagger、Postman、Shell 基础、前后端联调、接口测试、基础性能优化\n【AI应用技能】日常使用 AI 工具辅助阅读框架源码、拆解接口实现思路、生成接口测试样例、定位报错日志和整理技术学习笔记。能够将后端需求拆解为接口路径、请求参数、响应结构、数据库字段、异常状态和测试用例，并结合官方文档、本地运行结果和代码审查进行核对，不直接复制未经验证的生成代码。曾使用 AI 辅助梳理 Redis 缓存 key 设计、RabbitMQ 消费失败重试流程和 Swagger 接口说明，提高项目开发和复盘效率。\n【教育经历】武汉理工大学｜本科｜软件工程｜计算机与人工智能学院｜2022-09-2026-06｜GPA 3.42/4.0｜主修：数据结构、操作系统、计算机网络、数据库系统、Java 程序设计、软件工程、Web 应用开发、分布式系统导论、软件测试、Linux 操作系统基础｜研究方向：后端开发、数据库设计、缓存与接口性能优化｜论文：暂无正式论文发表。课程学习和项目实践主要围绕后端接口开发、数据库建模、缓存优化、登录鉴权、消息队列和服务部署展开，曾在课程综合项目中负责后端系统设计与接口实现，并整理项目接口文档、测试用例和部署说明。\n【项目经历】校园二手交易平台后端系统｜角色：后端负责人｜2024-03-2024-07｜面向校内学生闲置物品交易场景，开发校园二手交易平台后端系统，支持用户注册登录、商品发布、商品搜索、收藏、留言、订单状态流转和后台基础管理。项目采用 Go、Gin、MySQL、Redis、JWT、Docker、Nginx 实现，我主要负责后端整体设计、数据库建模、核心接口开发和前后端联调。项目中设计了用户表、商品表、商品图片表、收藏表、留言表、订单表和操作日志表等核心数据结构，完成用户登录鉴权、商品分页查询、关键词搜索、商品发布与编辑、收藏取消、留言回复、订单状态变更等 30 余个接口。为了提升商品列表和热门商品详情的访问效率，我使用 Redis 缓存热门商品列表和商品详情，并设置合理过期时间和缓存 key 规则，使重复访问场景下商品详情接口平均响应时间由约 180ms 降低到 60ms 左右。项目过程中补充了参数校验、登录态校验和资源归属校验，修复未登录用户发布商品、普通用户修改他人商品状态、订单状态重复变更等问题。最终项目完成前后端联调，并在课程展示中作为小组 Demo 演示，累计模拟录入 150 余条商品数据和 40 余条交易记录。\n【项目经历】在线题库与练习系统｜角色：后端开发｜2024-08-2024-11｜面向学生刷题练习场景，开发在线题库与练习系统，支持题目管理、分类筛选、答题记录、错题本、练习统计和接口文档展示。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis、Swagger 实现，我负责题库模块、答题记录模块和错题本模块的后端开发。项目中设计了题目表、题目分类表、用户答题记录表、错题本表和练习统计表，完成题目分页查询、分类筛选、关键词搜索、提交答案、错题记录、错题移除、练习统计查询等接口。为了避免题目列表一次性加载导致响应变慢，我将原全量查询改为分页查询，并针对分类、难度、创建时间等字段增加组合索引，提升常见筛选场景的查询效率。对于用户近期练习统计，我使用 Redis 记录近 7 天练习次数和正确率摘要，减少频繁聚合查询对数据库的压力。项目中通过 Swagger 维护接口文档，补充请求参数、响应字段和异常码说明，降低前后端联调时字段理解不一致的问题。最终完成题库、练习记录、错题本 3 个核心模块，沉淀出一套较完整的 Controller、Service、Mapper 分层开发流程和接口测试用例。\n【项目经历】简易消息通知服务｜角色：后端开发｜2025-01-2025-02｜为了理解消息队列在后端系统中的异步解耦和最终一致性作用，开发一个简易消息通知服务，模拟订单状态变更后异步发送站内通知的流程。项目使用 Go、RabbitMQ、MySQL、Redis 实现，包含订单事件生产、消息投递、通知消费、失败重试、未读数统计和幂等处理等功能。我设计了通知表、消息投递记录表和消费状态字段，使用 RabbitMQ 将订单状态变更事件发送到通知队列，由消费者异步写入用户站内通知。为了避免消费失败或重复投递导致重复通知，我使用业务唯一键作为幂等标识，并在消费前检查消息处理状态；对于消费失败的消息，记录失败原因和重试次数，超过阈值后进入异常记录表，便于后续人工排查。项目中使用 Redis 维护用户未读通知数，在通知写入成功后同步更新计数，并提供未读数查询和已读更新接口。通过该项目，我理解了消息队列在削峰、解耦、异步通知和最终一致性场景下的基本使用方式，也加深了对幂等处理、失败重试和消息状态流转的理解。\n【项目经历】个人博客与技术笔记系统｜角色：个人开发者｜2024-10-2024-01｜为了整理课程笔记和技术学习内容，开发个人博客与技术笔记系统，支持文章发布、分类管理、标签筛选、评论管理、后台登录和 Markdown 内容展示。项目使用 Java、Spring Boot、MySQL、Redis、Vue 实现，我独立完成后端接口、数据库设计和基础后台页面联调。后端部分设计了文章、分类、标签、评论、用户和操作日志等数据表，实现文章增删改查、分类标签管理、评论审核、登录鉴权和文章浏览统计等能力。为了减少热门文章重复查询，我使用 Redis 缓存文章详情和首页文章列表，并在文章更新后主动清理相关缓存。项目中补充了 Markdown 内容存储、XSS 基础过滤、后台接口登录校验和评论状态控制，避免未审核评论直接展示。该项目虽然规模不大，但帮助我完整练习了从数据库建模、接口设计、权限控制、缓存使用到前后端联调的基础后端开发流程。\n【实习经历】武汉某软件科技有限公司｜后端开发实习生｜2025-03-2025-05｜参与企业内部管理系统的后端接口开发，项目主要面向公司内部员工信息维护、部门管理、审批记录查询和基础数据统计场景。实习期间使用 Java、Spring Boot、MyBatis、MySQL、Redis 进行后端开发，主要负责基础信息维护、列表查询、权限字段校验和部分统计接口。我参与员工信息、部门信息、审批记录、角色配置等模块开发，完成 12 个列表查询和详情接口，支持分页、条件筛选、状态过滤和时间范围查询。针对测试反馈较多的参数为空、分页异常、状态枚举不一致、时间格式错误等问题，我补充统一参数校验和异常提示，并完善 Swagger 字段说明。对于员工列表和审批记录等高频查询接口，我协助排查慢查询原因，对部门 ID、状态、创建时间等字段增加索引，并配合测试验证查询结果一致性。实习期间参与开发和维护 20 余个接口，修复测试阶段反馈问题 30 余项，负责模块最终在内部测试环境完成验收。通过这段经历，我熟悉了企业项目中的需求评审、分支开发、接口联调、测试反馈修复和上线前验收流程。\n【实习经历】武汉某云服务技术有限公司｜｜2024-12-2025-02｜参与云资源管理后台的部分接口维护工作，主要支持服务器资源列表、操作记录查询、告警信息展示和用户操作日志模块。实习期间使用 Go、MySQL、Redis 和 Linux 环境进行开发和问题排查。我主要负责补充资源列表筛选条件、优化操作日志分页查询、修复部分接口字段缺失和状态展示不一致问题。项目中根据前端联调反馈，补充实例状态、资源地域、创建时间、操作人等筛选字段，并统一返回结构中的分页信息和空列表格式。对于操作日志查询较慢的问题，我协助分析 SQL 执行计划，确认部分查询未命中索引，随后根据查询条件调整索引并限制最大分页大小，避免大页码查询拖慢接口。实习期间还参与整理接口变更说明和测试用例，记录 15 余条接口字段调整和异常场景。该经历让我接触到更接近真实后台系统的资源管理、日志查询和状态展示场景，也加深了对接口稳定性、字段兼容性和查询性能的理解。\n【外语考试】CET-4：512\n【证书】阿里云云计算基础认证 ACA｜2025 年 4 月通过，了解云服务器、云数据库、对象存储、网络与安全等云计算基础概念。\n【证书】全国计算机等级考试二级｜2023 年 9 月通过，主要考查程序设计基础、数据库基础和常见办公软件应用能力。\n【证书】软件设计师基础知识训练营结业证书｜2024 年 12 月获得，系统学习软件工程、数据库、计算机网络、操作系统和面向对象设计等基础知识。\n【获奖】校级程序设计竞赛三等奖｜校级三等奖，2023 年 12 月获得，主要使用 C++ 完成数组、字符串、排序、搜索和基础动态规划题目。\n【获奖】软件工程课程设计优秀项目｜课程项目荣誉，2024 年 7 月获得，项目为校园二手交易平台后端系统，主要负责后端接口设计、数据库建模和部署联调。\n【获奖】优秀学生干部｜学院级荣誉，2024 年 6 月获得，担任班级学习委员，参与课程资料整理、学习打卡组织和班级事务协同。\n【作品】校园二手交易平台后端系统｜https://github.com/demo-user/campus-trade-api\n【作品】在线题库与练习系统｜https://github.com/demo-user/online-question-bank\n【作品】简易消息通知服务｜https://github.com/demo-user/simple-notify-service\n【作品】个人博客与技术笔记系统｜https://github.com/demo-user/dev-blog-system\n【个人主页】https://github.com/demo-user-backend\n【补充信息】我目前主要投递后端开发、Java 后端开发、Go 后端开发、云计算后台开发和基础平台开发相关实习岗位。相比前端和算法方向，我更喜欢把业务流程拆解成接口、表结构、权限规则和状态流转，再通过代码逐步实现并验证。过去的课程项目、个人项目和实习经历让我熟悉了常见后端开发流程，包括接口设计、数据库建模、登录鉴权、缓存使用、分页查询、消息队列、前后端联调、接口文档维护和测试反馈修复。\n\n当前我的能力还处于本科实习生阶段，系统设计和高并发经验不算深入，但我具备较强的工程实践意识，愿意从基础接口、数据表、日志排查、性能优化和文档维护做起。我比较重视代码可运行、接口可联调、字段说明清楚和问题复盘，遇到不熟悉的技术会先通过官方文档、Demo 验证和本地测试确认，再应用到项目中。后续希望继续提升 Go / Java 后端开发能力，重点补齐数据库优化、Redis 缓存一致性、消息队列可靠性、Linux 部署、服务监控和真实业务系统设计经验。\n','2026-06-07 12:37:50','2026-06-07 13:25:49'),(3,2,'03-二本产品经理-岗位匹配',0,'陈思雨','13900010003','chensiyu.pm@example.com','杭州','产品需求分析、用户访谈、问卷设计、竞品分析、用户旅程图、业务流程图、功能结构图、PRD 文档、字段说明、异常状态梳理、验收标准编写、原型设计、低保真原型、高保真原型、功能优先级拆分、用户反馈分类、项目复盘、Axure、Figma、墨刀、XMind、Excel、飞书文档、问卷星、禅道、SQL 基础、Python 数据分析基础、PowerPoint、Markdown','会使用 AI 工具辅助整理访谈纪要、归纳用户反馈、生成竞品分析维度、检查 PRD 是否遗漏字段规则和异常状态，也会用 AI 辅助拆解岗位 JD、提取产品经理岗位关键词和优化项目复盘表达。对于重要结论，会回到问卷数据、访谈原文、竞品页面和实际业务流程中二次核对，避免把生成内容直接当成真实用户需求。能够将模糊想法拆解为用户场景、核心痛点、功能模块、页面流程、字段规则和验收标准。','','我目前主要投递产品经理实习生、产品助理、产品运营、用户增长产品和教育 / 校园服务方向产品岗位。虽然学校背景和技术能力不是特别突出，但我比较愿意深入真实用户场景，能把零散的用户问题整理成流程、表格、原型和产品文档。过去做过校园活动报名、二手教材交易、学习打卡产品分析和 AI 求职助手需求拆解，对用户访谈、问卷调研、竞品分析、原型设计、PRD 编写和需求验收有一定实践经验。\n\n相比直接提出一个功能想法，我更习惯先判断用户是谁、问题发生在什么场景、当前流程为什么低效，再通过调研数据和用户反馈判断哪些功能应该优先实现。当前我仍需要继续提升数据分析、技术理解、商业判断和跨团队沟通能力，但愿意从具体需求、用户反馈、测试验收和项目执行做起，逐步积累真实产品经验。希望在实习中参与完整产品迭代流程，承担需求整理、原型设计、竞品分析、用户反馈分类、数据复盘和小功能跟进等工作。','【简历名称】03-二本产品经理-岗位匹配\n【基础信息】姓名：陈思雨｜手机：13900010003｜邮箱：chensiyu.pm@example.com｜城市：杭州\n【专业技能】产品需求分析、用户访谈、问卷设计、竞品分析、用户旅程图、业务流程图、功能结构图、PRD 文档、字段说明、异常状态梳理、验收标准编写、原型设计、低保真原型、高保真原型、功能优先级拆分、用户反馈分类、项目复盘、Axure、Figma、墨刀、XMind、Excel、飞书文档、问卷星、禅道、SQL 基础、Python 数据分析基础、PowerPoint、Markdown\n【AI应用技能】会使用 AI 工具辅助整理访谈纪要、归纳用户反馈、生成竞品分析维度、检查 PRD 是否遗漏字段规则和异常状态，也会用 AI 辅助拆解岗位 JD、提取产品经理岗位关键词和优化项目复盘表达。对于重要结论，会回到问卷数据、访谈原文、竞品页面和实际业务流程中二次核对，避免把生成内容直接当成真实用户需求。能够将模糊想法拆解为用户场景、核心痛点、功能模块、页面流程、字段规则和验收标准。\n【教育经历】浙江万里学院｜本科｜信息管理与信息系统｜信息管理系｜2022-09-2026-06｜GPA 3.36/4.0｜主修：管理信息系统、数据库原理、用户体验设计、电子商务概论、统计学、市场调研、数据分析基础、项目管理、消费者行为学、Python 数据分析基础｜论文：暂无正式论文发表。课程项目和实践项目主要围绕校园服务产品、用户调研、业务流程梳理、产品原型设计和数据分析展开，曾完成校园活动报名、二手教材交易、学习打卡产品体验分析等项目，并沉淀产品需求文档、用户访谈记录、问卷分析和原型设计材料。\n【项目经历】校园活动报名与签到小程序｜角色：产品负责人｜2024-03-2024-06｜面向校内社团、学院讲座和校园活动组织场景，设计一款活动报名与签到小程序原型，解决原本依赖微信群接龙、Excel 表格和人工签到导致的信息混乱、统计耗时、报名状态不清晰等问题。项目覆盖用户访谈、需求分析、流程设计、原型设计、PRD 编写和试用反馈收集。我主要负责前期调研和产品方案设计，访谈 8 名社团负责人和 20 余名学生参与者，梳理出活动发布、报名填写、名单管理、二维码签到、活动提醒和反馈收集等核心流程。基于调研结果，我使用 XMind 绘制功能结构图，使用墨刀和 Axure 设计活动列表、活动详情、报名表单、报名成功页、签到入口、组织者名单管理和反馈统计等页面，并编写 18 页产品需求文档，补充字段说明、页面状态、异常提示、数据统计口径和验收标准。项目试用阶段组织 2 轮同学体验，根据反馈调整报名成功提示、签到入口位置和报名表单字段顺序。最终原型支持一次学院讲座活动的流程模拟，活动负责人整理报名名单的时间从约 30 分钟降低到 10 分钟以内，并通过反馈问卷收集 63 份学生意见，定位出“报名后不知道是否成功”“签到入口不明显”“活动提醒不足”等 5 类问题。\n【项目经历】二手教材交易需求调研与产品原型设计｜角色：产品设计与调研负责人｜2024-09-2024-12｜围绕大学生二手教材交易场景，完成从需求调研、竞品分析、用户分层到产品原型设计的完整产品分析流程，重点解决教材版本不一致、交易沟通成本高、教材信息不完整和交易状态不透明等问题。项目初期通过问卷星设计并回收 146 份问卷，分析学生购买和出售二手教材时的主要顾虑、交易渠道和价格接受区间；同时体验闲鱼、孔夫子旧书网、校内微信群等渠道，整理不同平台在商品信息展示、交易沟通、搜索筛选和信任机制上的差异。根据调研结果，我将用户划分为卖书学生、买书学生、班级教材负责人三类角色，梳理教材发布、教材搜索、版本核对、在线留言、交易确认和状态流转等核心链路。原型设计阶段，我使用 Figma 设计 16 个核心页面，重点增加 ISBN、课程名、任课老师、教材版本、适用专业和新旧程度等字段，降低买错教材的概率。项目最终输出竞品分析表、用户旅程图、功能优先级表、25 页产品需求说明文档和高保真原型。调研数据显示，72% 的学生最担心“教材版本不一致”，因此该项目将“版本核对”设为 MVP 优先级最高的功能之一，课程评分 91 分，并获得任课老师关于调研完整性和问题定义清晰度的正向评价。\n【项目经历】学习打卡社区产品改版分析｜角色：产品分析与数据整理｜2025-01-2024-02｜选择 3 款学习打卡类产品进行体验分析，围绕新用户引导、目标创建、每日打卡、内容沉淀、社群互动和激励机制进行拆解，并提出改版建议。项目中我从新用户视角完整体验注册登录、目标创建、打卡提醒、每日复盘、好友互动和连续打卡反馈等流程，记录关键页面、转化节点和中断点，并用 Excel 整理功能矩阵、体验问题和改版优先级。分析过程中，我将问题分为新用户初次使用阻力、打卡持续动力不足、复盘内容沉淀弱、社交激励弱和提醒机制不清晰五类，共梳理 18 个体验问题，其中 6 个问题集中在新用户首次创建目标和首次打卡环节。基于问题优先级，我设计了“目标创建简化”“打卡后复盘提示”“连续打卡反馈”三个低保真改版原型，并输出 11 页产品体验分析报告。该项目帮助我理解产品分析不能只停留在页面好不好看，而要结合用户路径、操作成本、动机反馈和留存场景判断功能价值。\n【项目经历】AI 求职助手产品需求拆解练习｜角色：产品需求分析｜2025-04-2025-05｜围绕学生求职中“不会判断岗位是否适合自己、不会根据 JD 修改简历、投递后缺少复盘”的问题，完成一套 AI 求职助手产品需求拆解练习。项目以产品方案设计为主，模拟实现简历录入、岗位 JD 粘贴、岗位匹配分析、简历优化建议和版本记录等功能。我通过访谈 10 名正在找实习的同学，整理出简历经历表达弱、岗位关键词看不懂、无法判断能力差距、修改简历没有方向等常见问题，并将需求拆分为“简历结构化录入、岗位信息管理、匹配结果展示、优化建议、历史记录”五个模块。原型设计中，我重点设计了匹配结果页的信息结构，将结果拆成匹配分数、优势项、风险项、缺失能力、优化建议和证据引用，避免只展示一个空泛分数。我使用飞书文档编写需求说明，并通过 AI 工具辅助整理字段清单和异常状态，再人工核对访谈记录和实际岗位 JD，保证功能描述贴近真实求职场景。最终沉淀 1 份产品功能清单、1 份页面流程图和 8 个核心页面原型。\n【实习经历】杭州某教育科技公司｜产品运营实习生｜2025-03-2025-05｜参与在线课程后台和学习打卡工具的日常运营支持，协助产品经理整理用户反馈、跟进小需求、测试功能改动和维护运营数据表。实习期间主要使用飞书、Excel、墨刀、禅道和 SQL 基础查询工具，围绕课程播放、作业提交、学习打卡、后台筛选和用户反馈处理等场景开展工作。我每周整理客服和运营反馈，将问题按登录、课程播放、作业提交、打卡提醒、数据展示和后台配置等类型进行分类，并标注影响范围、出现频次和处理状态，累计整理 230 余条用户反馈，输出 5 份周反馈汇总。需求协作方面，我协助产品经理补充 6 个小需求说明，包括字段规则、按钮状态、异常提示、后台筛选条件和验收标准；参与课程后台筛选功能和学习打卡提醒功能测试，记录并跟进 17 个问题。数据方面，我维护学习打卡数据表，统计用户打卡次数、连续打卡天数、中断原因和提醒触达情况，并根据用户反馈整理出“提醒时间不明显”“作业入口不清晰”“打卡成功反馈弱”等问题。最终协助完成 6 个小需求上线前验收，也让我更熟悉产品助理在真实团队中从用户反馈、需求记录、开发沟通到测试验收的基础工作流程。\n【实习经历】杭州某本地生活服务公司｜产品运营实习生｜2024-07-2024-09｜参与本地生活优惠活动的页面配置、用户反馈整理和基础数据复盘，主要服务校园周边餐饮、奶茶和休闲娱乐类商家活动。实习期间协助运营同学上线 10 余场优惠活动，负责核对活动标题、优惠价格、库存数量、使用时间、门店地址、核销规则和活动说明，减少用户因规则理解不清导致的咨询和投诉。用户反馈方面，我将活动咨询记录整理为优惠不可用、门店距离远、库存显示不及时、核销规则不清楚、页面入口不明显等类型，并每周输出问题归类表给运营和产品同学参考。数据复盘方面，我使用 Excel 统计活动曝光、点击、领取、核销和退款数据，协助分析不同活动标题、优惠力度和门店距离对转化的影响。实习期间共参与整理 8 份活动复盘表，并参与 2 次活动页面文案优化，其中一次将“领取后到店核销”的规则提示前置到活动卡片和详情页首屏，减少了部分重复咨询。该经历让我理解产品和运营并不是割裂的，页面信息结构、规则表达和数据反馈都会直接影响用户转化与体验。\n【外语考试】CET-4：489\n【证书】全国计算机等级考试二级｜2024 年 3 月通过，掌握基础程序设计、数据库基础和常用办公软件应用能力。\n【证书】Axure 产品原型设计课程证书｜2024 年 8 月获得，学习产品原型设计、页面交互说明、组件复用和基础 PRD 表达方法。\n【证书】数据分析基础训练营结业证书｜2024 年 11 月获得，学习 Excel 数据透视表、基础 SQL 查询、用户分层和常见产品指标分析方法。\n【获奖】校级互联网+创新创业训练项目立项｜校级项目立项，2024 年 6 月获得，参与校园服务类项目的需求调研和商业计划书撰写，主要负责用户问题分析、竞品调研和产品功能规划部分。\n【获奖】商学院优秀课程项目展示｜学院级课程项目荣誉，2024 年 12 月获得，二手教材交易项目在课程展示中被评为优秀小组案例。\n【获奖】市场调研课程优秀报告｜课程项目荣誉，2024 年 11 月获得，围绕大学生教材购买与二手交易行为完成问卷调研、数据整理和结论展示。\n【作品】校园活动报名与签到小程序原型｜https://demo.example.com/activity-signup-prototype\n【作品】二手教材交易产品需求文档｜https://demo.example.com/textbook-trade-prd\n【作品】学习打卡社区产品体验分析报告｜https://demo.example.com/study-checkin-analysis\n【作品】AI 求职助手产品需求拆解练习｜https://demo.example.com/ai-job-assistant-prd\n【补充信息】我目前主要投递产品经理实习生、产品助理、产品运营、用户增长产品和教育 / 校园服务方向产品岗位。虽然学校背景和技术能力不是特别突出，但我比较愿意深入真实用户场景，能把零散的用户问题整理成流程、表格、原型和产品文档。过去做过校园活动报名、二手教材交易、学习打卡产品分析和 AI 求职助手需求拆解，对用户访谈、问卷调研、竞品分析、原型设计、PRD 编写和需求验收有一定实践经验。\n\n相比直接提出一个功能想法，我更习惯先判断用户是谁、问题发生在什么场景、当前流程为什么低效，再通过调研数据和用户反馈判断哪些功能应该优先实现。当前我仍需要继续提升数据分析、技术理解、商业判断和跨团队沟通能力，但愿意从具体需求、用户反馈、测试验收和项目执行做起，逐步积累真实产品经验。希望在实习中参与完整产品迭代流程，承担需求整理、原型设计、竞品分析、用户反馈分类、数据复盘和小功能跟进等工作。\n','2026-06-07 12:45:00','2026-06-07 13:25:49'),(4,2,'04-职业探索型学生-岗位推荐',0,'许安然','13900010004','mailto:xuanran.life@example.com','成都','问卷设计、用户访谈、访谈纪要整理、用户反馈归类、学习体验分析、活动策划、社群运营、内容策划、内容编辑、产品原型基础、功能结构图、用户流程图、用户画像、活动复盘、Excel 数据整理、问卷星、飞书文档、XMind、墨刀、Figma 基础、Canva、剪映、微信公众号排版、PowerPoint、Markdown、基础数据分析','会使用 AI 工具辅助整理访谈纪要、归纳问卷开放题、生成活动复盘初稿、优化活动文案表达、拆解用户反馈和梳理内容手册结构。对于涉及真实学生反馈和用户结论的内容，会回到原始访谈记录、问卷数据和实际活动反馈中核对，不直接把 AI 生成内容作为最终结论。能够使用结构化提示词将模糊问题拆分为用户场景、典型痛点、行为原因、内容方案和后续行动建议。','','我目前还在职业探索阶段，对产品助理、用户运营、内容运营、教育科技、学习体验设计、学生成长服务和社群运营等方向都有兴趣。相比一开始就确定某个具体岗位，我更希望通过真实实习进一步判断自己更适合偏产品设计、偏用户运营，还是偏内容与社群方向的工作。过去的经历让我发现，我比较擅长倾听真实问题、整理零散反馈、设计轻量活动、组织内容结构，并把复杂信息转成清晰文档。\n\n我关注人的学习体验和成长过程，也愿意做长期陪伴型、服务型的工作。在项目和实习中，我比较重视用户为什么会中断、为什么不愿参与、什么样的反馈能帮助他们继续行动。当前我还需要继续提升数据分析、产品方法、商业意识和技术理解能力，但愿意从具体用户反馈、社群维护、内容整理、活动执行和需求分析做起，逐步找到更适合自己的职业方向。','【简历名称】04-职业探索型学生-岗位推荐\n【基础信息】姓名：许安然｜手机：13900010004｜邮箱：mailto:xuanran.life@example.com｜城市：成都\n【专业技能】问卷设计、用户访谈、访谈纪要整理、用户反馈归类、学习体验分析、活动策划、社群运营、内容策划、内容编辑、产品原型基础、功能结构图、用户流程图、用户画像、活动复盘、Excel 数据整理、问卷星、飞书文档、XMind、墨刀、Figma 基础、Canva、剪映、微信公众号排版、PowerPoint、Markdown、基础数据分析\n【AI应用技能】会使用 AI 工具辅助整理访谈纪要、归纳问卷开放题、生成活动复盘初稿、优化活动文案表达、拆解用户反馈和梳理内容手册结构。对于涉及真实学生反馈和用户结论的内容，会回到原始访谈记录、问卷数据和实际活动反馈中核对，不直接把 AI 生成内容作为最终结论。能够使用结构化提示词将模糊问题拆分为用户场景、典型痛点、行为原因、内容方案和后续行动建议。\n【教育经历】四川师范大学｜本科｜教育技术学｜教育科学学院｜2022-09-2026-06｜GPA 3.48/4.0｜主修：教育心理学、学习科学、教学设计、教育数据分析、用户体验基础、数字媒体技术、课程与教学论、统计学基础、教育传播学、在线课程设计｜论文：暂无正式论文发表。课程项目和实践经历主要围绕数字化学习、学习体验、学生成长支持和校园社群运营展开，曾参与学院数字学习体验调研项目，协助完成学生访谈、问卷整理和学习平台使用问题归纳，重点关注学生在在线学习过程中的任务拖延、反馈获得感、学习动机和平台使用体验等问题。\n【项目经历】大学生自习与学习陪伴小程序调研项目｜角色：调研与产品原型负责人｜2024-03-2024-06｜围绕大学生自习效率低、学习计划难坚持、缺少陪伴感和阶段反馈不足等问题，完成一款学习陪伴小程序的用户调研、需求分析和原型设计。项目重点探索“轻量打卡 + 学习搭子 + 阶段复盘”的学习支持方式，目标不是强制监督学生，而是帮助学生降低开始学习的门槛，并在学习过程中获得持续反馈。我主要负责问卷设计、学生访谈、需求整理、功能优先级拆分和核心页面原型设计。前期通过问卷星回收 178 份问卷，分析学生自习频率、学习计划中断原因、拖延场景和对学习陪伴功能的接受程度；同时访谈 12 名不同年级学生，整理出“任务太大不知道从哪里开始”“缺少即时反馈”“一个人坚持困难”“复盘记录分散”等典型问题。基于调研结果，我将功能拆分为学习目标创建、今日任务、学习搭子匹配、每日打卡、阶段复盘和轻量提醒六个模块，并使用 XMind 绘制功能结构图，使用墨刀和 Figma 设计 14 个核心页面原型。项目试用阶段组织 2 次小范围体验，根据反馈调整打卡入口、复盘提示文案和任务拆分方式。最终输出 20 页调研分析文档和一套可点击原型，调研数据显示超过 60% 的受访学生会制定学习计划，但连续执行超过 7 天的比例较低，因此项目将复杂学习计划拆为“今日任务 + 本周目标 + 阶段复盘”三层结构，提升功能可理解性和执行可行性。\n【项目经历】校园生活方式社群运营计划｜角色：社群运营负责人｜2023-10-2024-05｜参与运营一个面向学生的校园生活方式社群，内容覆盖阅读、运动、摄影、城市探索和学习复盘，目标是帮助同学形成更稳定的生活节奏和兴趣交流氛围。项目不是单纯做活动通知，而是通过主题活动、轻量打卡、同伴交流和阶段复盘，让社群成员在低压力环境中形成持续参与感。我主要负责月度活动策划、活动文案、报名表设计、社群规则维护、活动反馈收集和复盘整理。运营过程中策划并执行“21 天阅读记录”“周末城市散步”“运动打卡”“期末复盘夜谈”等活动，使用微信公众号、飞书、Excel、Canva 和剪映完成活动通知、视觉物料、报名统计和复盘内容整理。数据方面，我持续记录报名人数、实际参与人数、打卡完成率、互动次数和反馈关键词，用于判断活动主题是否适合长期运营。项目期间累计组织 9 场线上 / 线下活动，覆盖 300 余名学生，其中“21 天阅读记录”活动报名 86 人，完整完成打卡 37 人。通过活动复盘发现，学生更容易接受明确阶段目标、低压力提醒和正向反馈，而不是强制打卡式管理。公众号活动总结平均阅读量约 600，最高单篇阅读量超过 1200，也帮助我理解内容选题、社群节奏和用户参与感之间的关系。\n【项目经历】校园新生适应问题访谈与内容手册设计｜角色：访谈整理与内容策划｜2024-09-2024-11｜协助学院老师和学生会完成新生适应问题调研，围绕课程学习、宿舍关系、社团选择、时间管理、信息获取和情绪压力等主题，整理一份面向新生的适应手册。项目目标是将零散的新生困惑转化为结构化内容，帮助新生更快理解大学生活中的常见问题和可求助路径。我主要负责访谈记录整理、问题归类、内容框架设计和部分章节撰写。项目中协助设计新生适应问卷和访谈提纲，整理 20 份访谈记录，将问题归纳为学习适应、生活适应、人际适应、信息获取和自我管理五类，并从中提炼出 32 个高频问题。内容策划阶段，我参与设计手册章节结构，撰写“如何安排第一学期”“如何选择社团”“如何处理宿舍关系”“如何寻求老师和学长学姐帮助”等内容，并协助完成线上版本排版和发布。最终形成约 1.5 万字的新生适应手册初稿，发布后被学院新生群置顶使用。这个项目提升了我对学生真实需求的理解，也让我练习了从访谈资料中提炼问题、组织内容和面向目标用户表达信息的能力。\n【项目经历】在线课程学习体验优化分析｜角色：学习体验分析与反馈整理｜2025-01-2025-02｜围绕在线课程学习过程中“课程开始难、坚持难、反馈少、作业压力不清晰”等问题，选择 2 个主流在线学习平台和 1 个学校课程平台进行体验分析，重点拆解课程详情页、学习路径、任务提醒、作业提交、学习进度和反馈机制。我从学生用户视角完整体验选课、开始学习、观看课程、提交作业、查看反馈和复盘学习记录等流程，并记录关键页面、操作阻力和信息缺失点。分析过程中，我将体验问题分为学习目标不明确、课程结构不清晰、任务提醒不够友好、学习进度反馈弱和作业反馈延迟五类，并用 Excel 整理功能矩阵和问题优先级。基于体验结果，我提出了课程学习路径可视化、阶段目标提示、作业截止提醒、学习进度反馈和学习复盘卡片等优化建议，并使用 Figma 绘制 6 个低保真优化页面。最终输出 12 页体验分析报告，帮助我进一步理解教育科技产品中“学习效果”和“用户体验”需要同时考虑，不能只关注页面功能是否完整。\n【实习经历】成都某在线教育公司｜用户运营实习生｜2025-03-2025-06｜参与在线学习社群和训练营运营，协助完成学员提醒、学习数据整理、社群活动策划和用户反馈收集。实习期间主要使用企业微信、飞书、Excel、问卷星和 Canva，服务对象为报名在线课程和训练营的学习用户。我每周整理学员学习进度表，标记未完成任务、连续缺勤、活跃学员和需要重点跟进的用户，并协助运营 3 个学习社群，负责每日提醒、问题收集、活动通知和阶段复盘。为了减少机械催促感，我根据学员反馈调整提醒文案，将单纯的“请完成任务”改为更具体的“今天建议完成第几节课、预计用时多少、完成后可以得到什么反馈”，提升提醒内容的可接受度。活动方面，我参与设计学习打卡活动和阶段复盘模板，整理学员对课程难度、作业量、直播时间和社群节奏的反馈，并输出 6 份周运营复盘。实习期间累计维护约 450 名学员的学习进度数据，协助完成 2 次学习活动策划，也让我理解用户运营不仅是发通知，更需要理解用户为什么中断、什么样的反馈能帮助用户继续学习，以及如何在运营动作中平衡效率和用户感受。\n【实习经历】成都某青年成长服务机构｜内容运营实习生｜2024-07-2024-09｜参与青年成长类公众号和社群内容运营，内容主题包括大学学习方法、时间管理、实习准备、情绪支持和城市生活体验。实习期间主要负责选题资料整理、推文初稿撰写、活动文案编辑、社群话题维护和用户反馈收集。我根据过往文章阅读量、收藏量和留言反馈整理内容选题表，将内容方向分为学习方法、职业探索、生活方式、心理支持和经验访谈五类，并参与撰写和编辑 12 篇公众号推文。社群运营方面，我协助维护 2 个青年成长社群，定期发布讨论话题，如“如何开始准备第一份实习”“如何安排一个不焦虑的周末”“最近一次有效学习是什么时候”等，收集用户留言并整理成内容素材。实习期间参与 3 次线上分享活动的文案和报名表设计，协助统计报名人数、实际参与人数和活动反馈。该经历让我接触到内容运营从选题、表达、发布到反馈复盘的完整流程，也让我意识到内容不是单纯写得好，而是要和用户当下的问题、情绪和行动场景有关。\n【外语考试】CET-4：476\n【证书】普通话水平测试二级甲等｜2024 年 4 月获得，具备较好的普通话表达和沟通能力。\n【证书】心理健康教育基础课程证书｜2024 年 11 月获得，学习大学生常见心理困扰识别、基础沟通方法和心理支持边界等内容。\n【证书】新媒体内容运营课程结业证书｜2024 年 10 月获得，学习内容选题、社群互动、公众号排版、活动复盘和基础数据分析方法。\n【获奖】校级优秀学生干部｜校级荣誉，2024 年 6 月获得，担任学院学生会学习发展部干事，参与学习活动组织、新生适应支持和学院学生服务工作。\n【获奖】学院优秀志愿服务个人｜学院级荣誉，2023 年 12 月获得，参与迎新、校园开放日和公益支教活动，累计志愿服务时长超过 80 小时。\n【获奖】校园生活方式社群优秀策划｜社团内部评选荣誉，2024 年 5 月获得，参与策划阅读打卡和城市探索活动，活动参与度和成员反馈较好。\n【作品】大学生自习与学习陪伴小程序原型｜https://demo.example.com/study-companion-prototype\n【作品】新生适应问题访谈整理与内容手册｜https://demo.example.com/freshman-guide\n【作品】校园生活方式社群活动复盘合集｜https://demo.example.com/campus-life-review\n【作品】在线课程学习体验优化分析报告｜https://demo.example.com/online-learning-ux-review\n【补充信息】我目前还在职业探索阶段，对产品助理、用户运营、内容运营、教育科技、学习体验设计、学生成长服务和社群运营等方向都有兴趣。相比一开始就确定某个具体岗位，我更希望通过真实实习进一步判断自己更适合偏产品设计、偏用户运营，还是偏内容与社群方向的工作。过去的经历让我发现，我比较擅长倾听真实问题、整理零散反馈、设计轻量活动、组织内容结构，并把复杂信息转成清晰文档。\n\n我关注人的学习体验和成长过程，也愿意做长期陪伴型、服务型的工作。在项目和实习中，我比较重视用户为什么会中断、为什么不愿参与、什么样的反馈能帮助他们继续行动。当前我还需要继续提升数据分析、产品方法、商业意识和技术理解能力，但愿意从具体用户反馈、社群维护、内容整理、活动执行和需求分析做起，逐步找到更适合自己的职业方向。\n','2026-06-07 12:51:56','2026-06-07 13:25:49'),(5,2,'05-优秀但不适合互联网-岗位推荐',0,'顾清和','13900010005','mailto:guqinghe.research@example.com','南京','社会调研、用户访谈、半结构化访谈、问卷设计、问卷清洗、描述统计、交叉分析、质性资料编码、案例整理、公共政策分析、公共服务研究、组织社会学分析、报告写作、项目简报、活动策划、内容策划、阅读活动组织、Excel、SPSS 基础、NVivo 基础、问卷星、飞书文档、微信公众号排版、Canva、PowerPoint、Markdown','会使用 AI 工具辅助访谈材料初步整理、开放题归类、报告结构梳理、活动文案润色和资料摘要提取。对于调研结论，会回到原始访谈、问卷数据、研究问题和团队讨论记录中核对，不会直接使用生成内容替代真实分析。能够通过结构化提示词将调研材料拆解为研究问题、对象特征、核心发现、典型案例、风险边界和后续建议，提高资料整理和报告初稿效率。','','我目前更希望寻找教育公益、公共服务、社会研究、青年发展、公益项目、内容研究、公共事务和组织支持相关实习机会。相比快节奏商业增长、强转化指标和高频迭代的互联网岗位，我更适合长期研究、项目支持、材料沉淀、服务对象理解和组织协同类工作。大学期间，我花了较多时间参与社会调研、公益项目、阅读活动和学生成长支持相关实践，也逐渐意识到自己更喜欢有长期价值、能沉淀材料、能与具体人群产生连接的工作。\n\n我擅长倾听和整理具体人的真实处境，能够把零散访谈、问卷数据、活动反馈和项目材料整理成结构化报告。工作风格上，我更重视准确、细致、可追溯和长期积累，能够接受重复但有意义的资料整理、反馈跟进和项目执行工作。当前我仍需要继续提升统计分析、项目管理和政策研究能力，希望在实习中进一步理解公共服务项目如何从需求识别、方案设计、执行协同到复盘改进形成闭环。','【简历名称】05-优秀但不适合互联网-岗位推荐\n【基础信息】姓名：顾清和｜手机：13900010005｜邮箱：mailto:guqinghe.research@example.com｜城市：南京\n【专业技能】社会调研、用户访谈、半结构化访谈、问卷设计、问卷清洗、描述统计、交叉分析、质性资料编码、案例整理、公共政策分析、公共服务研究、组织社会学分析、报告写作、项目简报、活动策划、内容策划、阅读活动组织、Excel、SPSS 基础、NVivo 基础、问卷星、飞书文档、微信公众号排版、Canva、PowerPoint、Markdown\n【AI应用技能】会使用 AI 工具辅助访谈材料初步整理、开放题归类、报告结构梳理、活动文案润色和资料摘要提取。对于调研结论，会回到原始访谈、问卷数据、研究问题和团队讨论记录中核对，不会直接使用生成内容替代真实分析。能够通过结构化提示词将调研材料拆解为研究问题、对象特征、核心发现、典型案例、风险边界和后续建议，提高资料整理和报告初稿效率。\n【教育经历】南京大学｜本科｜社会学｜社会学院｜2022-09-2026-06｜GPA 3.86/4.0｜主修：社会学概论、社会研究方法、社会统计学、组织社会学、教育社会学、城市社会学、公共政策分析、质性研究方法、社会调查实务、社会心理学｜研究方向：青年发展、教育公平、公共服务、基层治理、组织运行机制｜论文：暂无正式论文发表。参与县域高中学生升学选择与家庭支持调研、社区老年人数字服务使用障碍研究等项目，主要负责访谈提纲设计、访谈资料整理、问卷数据清洗、质性编码分析和阶段性报告撰写。个人长期关注青年成长、教育支持、公共服务可及性和组织运行机制，更希望在长期议题中持续积累研究和项目经验。\n【项目经历】县域高中学生升学选择与家庭支持调研｜角色：调研执行与报告撰写｜2024-04-2024-11｜围绕县域高中学生在升学选择、家庭支持、信息获取和心理压力方面的问题，参与完成问卷调研、深度访谈、资料编码和阶段性报告撰写，为后续教育支持项目设计提供参考。项目重点关注学生在升学信息获取、家庭经验支持、学校资源差异和自我目标形成过程中的真实困境。我参与问卷设计和访谈提纲设计，围绕家庭教育资源、学校咨询支持、线上信息来源、同伴影响和情绪压力等变量设计问题，并协助整理 312 份有效问卷，完成基础描述统计和交叉分析。在访谈部分，我参与 26 名学生、家长和教师的半结构化访谈，使用 NVivo 对访谈文本进行初步编码，将学生困境归纳为信息渠道不足、家庭经验有限、同伴信息偏差、线上信息过载、心理压力缺少出口等类型。报告撰写阶段，我主要负责“学生信息获取路径”和“家庭支持差异”两个章节，整理 18 个典型案例，并将访谈材料与问卷结果进行交叉验证。最终团队输出约 2.4 万字阶段性调研报告，归纳出 5 类升学信息差来源，为公益组织后续设计高中生成长支持活动、线上讲座和个案陪伴机制提供参考。\n【项目经历】社区老年人数字服务使用障碍研究｜角色：项目协调与访谈整理｜2023-10-2024-02｜围绕社区老年人在使用线上挂号、缴费、出行、政务服务等数字化工具时遇到的障碍，开展访谈、观察记录和问题归纳，并形成面向社区服务站的建议材料。项目不是简单判断老年人“不会用手机”，而是尝试理解数字服务流程、信息提示、线下兜底和即时帮助机制对老年用户的影响。我协助联系社区工作人员，安排访谈时间和调研流程，参与 18 名老年居民和 5 名社区工作人员访谈，记录他们在健康码、线上挂号、公交乘车码、政务小程序、线上缴费等场景中的具体困难。整理过程中，我将问题归类为操作步骤复杂、信息提示不清、记忆负担较重、担心误操作、对子女协助依赖和线下兜底不足六类，并参与制作社区数字服务协助卡片和简易操作说明。最终团队输出 12 页调研简报，提交给社区服务站作为数字服务志愿活动参考，并协助设计 4 张常用服务操作说明卡片。该项目让我意识到，公共服务体验问题往往不只是技术能力不足，也包括信息设计、支持体系、心理安全感和服务兜底机制。\n【项目经历】高校学生阅读支持计划｜角色：内容策划与活动组织｜2024-03-2024-06｜参与组织一个面向本科生的阅读支持计划，通过主题书单、共读小组、读书会和阶段复盘，帮助同学建立更稳定的阅读习惯，并促进社会科学主题的交流讨论。项目主要面向想读书但难以持续、缺少讨论氛围和不知道如何选择书目的学生。我参与设计 4 期主题书单，包括社会科学入门、城市与生活、教育与成长、女性与社会，负责报名表、活动说明、共读规则和复盘问题设计，并维护共读小组的日常交流。活动过程中，我整理成员阅读反馈、讨论问题和中断原因，撰写读书会总结推文和阶段复盘材料，并通过问卷收集参与者对活动节奏、书目难度、讨论形式和组织方式的反馈。4 期活动累计报名 126 人，稳定参与 48 人，公众号活动总结平均阅读量约 800，最高单篇超过 1500。通过反馈发现，相比强制打卡，开放讨论、阶段性目标和有质量的复盘问题更能提高参与者的持续性。项目最终沉淀出一套活动流程模板，便于后续学生社团继续组织类似阅读支持活动。\n【项目经历】高校学生公共事务参与意愿访谈｜角色：访谈设计与分析整理｜2025-01-2025-03｜围绕高校学生参与志愿服务、学生组织、校园议题讨论和公共事务活动的动机与阻力，完成一项小规模访谈研究。项目希望理解学生为什么愿意或不愿意参与公共事务，以及时间成本、组织氛围、反馈机制和个人价值感如何影响参与持续性。我设计访谈提纲，围绕参与动机、退出原因、组织体验、获得感、压力来源和对活动改进的期待展开访谈，共整理 16 份访谈记录。分析过程中，我将学生参与阻力归纳为时间安排冲突、活动目标模糊、组织反馈不足、任务分工不清和长期价值感较弱五类，也发现部分学生对“能直接帮助具体人”“能沉淀清晰成果”“能和稳定团队长期合作”的活动更有持续参与意愿。最终输出 9 页访谈分析报告和 1 份校园公共事务活动优化建议清单，提出明确活动目标、降低初次参与门槛、建立阶段反馈和减少无效会议等建议。这个项目进一步确认了我对组织运行、公共参与和长期服务议题的兴趣。\n【实习经历】某公益基金会教育项目组｜项目助理实习生｜2025-02-2025-05｜参与县域高中生成长支持项目，协助完成学生需求调研、活动执行、材料整理、志愿者协同和项目复盘。实习期间主要使用飞书、Excel、问卷星、腾讯会议和微信公众号，围绕学生升学信息支持、时间管理、情绪压力和家庭沟通等主题开展项目支持工作。我协助整理学生报名信息、课程参与记录和活动反馈表，维护约 180 名学生的项目参与记录，并参与 3 场线上成长主题活动执行，负责会前通知、会中记录和会后反馈整理。项目反馈整理阶段，我将学生关于升学信息、学习节奏、情绪压力、家庭沟通和志愿者陪伴的反馈进行分类，累计整理 400 余条反馈信息，并协助撰写 3 份月度项目简报和 1 份阶段复盘材料。与志愿者团队协作时，我跟进学生个案反馈和活动改进建议，记录学生在参与频率、活动理解和反馈表达上的变化。该经历让我更熟悉公益项目中“服务对象需求—活动设计—执行记录—反馈复盘—项目改进”的基本闭环，也让我确认自己更适合长期、细致、服务导向的组织支持工作。\n【实习经历】某高校公共政策研究中心｜研究助理实习生｜2024-07-2024-09｜参与教育与社区公共服务相关课题资料整理工作，主要支持文献检索、政策资料梳理、访谈纪要整理和案例库维护。实习期间围绕教育资源配置、社区公共服务、青年发展和基层治理等主题收集公开政策文件、研究报告和案例材料，并按地区、议题、服务对象和政策工具进行分类。我协助整理 60 余份政策与研究资料，提炼政策目标、服务对象、执行主体和实施方式等信息，并将 20 余份访谈纪要整理为标准化记录，标注关键信息、典型表述和待追问问题。工作中需要长期处理细碎材料、保持格式一致和事实准确，因此我逐渐形成了资料命名、版本管理、摘要提取和引用核对的习惯。该实习让我理解研究助理工作并不只是“查资料”，更重要的是为后续分析建立可靠、可追溯、可复用的材料基础。\n【外语考试】CET-6：592\n【证书】普通话水平测试二级甲等｜2024 年 4 月获得，具备较好的普通话表达和访谈沟通能力。\n【证书】社会调查方法训练营结业证书｜2024 年 8 月获得，结业评价为优秀学员，系统学习问卷设计、访谈方法、抽样基础、资料整理和调研报告写作。\n【证书】SPSS 社会统计基础课程证书｜2024 年 11 月获得，学习描述统计、交叉分析、相关分析和基础数据可视化方法。\n【获奖】国家励志奖学金｜国家级奖学金，2024 年 10 月获得，基于学业成绩、综合表现和家庭经济情况评定。\n【获奖】校级优秀社会实践个人｜校级荣誉，2024 年 9 月获得，参与社区老年人数字服务使用障碍研究，在访谈整理、调研简报和成果展示中表现突出。\n【获奖】学院优秀学生｜学院级荣誉，2023 年 12 月获得，学业成绩稳定，参与学院调研项目、阅读支持计划和学生公益活动较多。\n【作品】县域高中学生升学选择与家庭支持调研报告｜https://demo.example.com/county-high-school-report\n【作品】社区老年人数字服务使用障碍调研简报｜https://demo.example.com/elder-digital-service-report\n【作品】高校学生阅读支持计划活动复盘｜https://demo.example.com/reading-support-review\n【作品】高校学生公共事务参与意愿访谈报告｜https://demo.example.com/public-participation-interview\n【补充信息】我目前更希望寻找教育公益、公共服务、社会研究、青年发展、公益项目、内容研究、公共事务和组织支持相关实习机会。相比快节奏商业增长、强转化指标和高频迭代的互联网岗位，我更适合长期研究、项目支持、材料沉淀、服务对象理解和组织协同类工作。大学期间，我花了较多时间参与社会调研、公益项目、阅读活动和学生成长支持相关实践，也逐渐意识到自己更喜欢有长期价值、能沉淀材料、能与具体人群产生连接的工作。\n\n我擅长倾听和整理具体人的真实处境，能够把零散访谈、问卷数据、活动反馈和项目材料整理成结构化报告。工作风格上，我更重视准确、细致、可追溯和长期积累，能够接受重复但有意义的资料整理、反馈跟进和项目执行工作。当前我仍需要继续提升统计分析、项目管理和政策研究能力，希望在实习中进一步理解公共服务项目如何从需求识别、方案设计、执行协同到复盘改进形成闭环。\n','2026-06-07 12:56:37','2026-06-07 13:25:49'),(6,2,'06-后端开发简历版本对比-V1纯小白',1,'赵宇航','13900020001','mailto:zhaoyuhang.backend@example.com','长沙','Java 基础、SQL 基础、MySQL 基础、HTML 基础、CSS 基础、Git 基础、Linux 基础、数据结构基础、面向对象编程基础','会使用 AI 工具辅助理解课程知识、解释代码报错和整理学习笔记。对于生成的代码，会尝试在本地运行，但目前还缺少系统性的项目实践经验。','','我目前正在准备后端开发实习，主要学习方向是 Java 后端开发和数据库基础。现阶段对 Spring Boot、MySQL、Redis、Linux 和 Git 等技术还在入门学习中，暂时没有完整项目和实习经历。\n\n我希望接下来通过课程项目、个人项目和实习机会逐步提升工程实践能力。当前主要目标是先补齐 Java 基础、数据库基础、接口开发、前后端联调和项目部署相关能力，再进一步尝试完成一个较完整的后端项目。','【简历名称】06-后端开发简历版本对比-V1纯小白\n【基础信息】姓名：赵宇航｜手机：13900020001｜邮箱：mailto:zhaoyuhang.backend@example.com｜城市：长沙\n【专业技能】Java 基础、SQL 基础、MySQL 基础、HTML 基础、CSS 基础、Git 基础、Linux 基础、数据结构基础、面向对象编程基础\n【AI应用技能】会使用 AI 工具辅助理解课程知识、解释代码报错和整理学习笔记。对于生成的代码，会尝试在本地运行，但目前还缺少系统性的项目实践经验。\n【教育经历】湖南科技大学｜本科｜软件工程｜计算机科学与工程学院｜2022-09-2026-06｜GPA 3.31/4.0｜主修：数据结构、Java 程序设计、数据库系统、计算机网络、操作系统、软件工程、Web 开发技术｜论文：暂无正式论文发表。当前主要完成校内课程学习和基础编程练习，正在学习 Java 后端开发、数据库和 Web 开发相关内容。\n【外语考试】CET-4：462\n【证书】全国计算机等级考试二级｜2024 年 3 月通过，掌握基础程序设计和常用办公软件应用能力。\n【补充信息】我目前正在准备后端开发实习，主要学习方向是 Java 后端开发和数据库基础。现阶段对 Spring Boot、MySQL、Redis、Linux 和 Git 等技术还在入门学习中，暂时没有完整项目和实习经历。\n\n我希望接下来通过课程项目、个人项目和实习机会逐步提升工程实践能力。当前主要目标是先补齐 Java 基础、数据库基础、接口开发、前后端联调和项目部署相关能力，再进一步尝试完成一个较完整的后端项目。\n','2026-06-08 22:26:01','2026-06-08 22:26:01'),(7,2,'07-后端开发简历版本对比-V2项目实践版',1,'赵宇航','13900020001','mailto:zhaoyuhang.backend@example.com','长沙','Java、SQL、Spring Boot、MyBatis、MySQL、Redis 基础、JWT、RESTful API 设计、数据库表结构设计、分页查询、参数校验、登录鉴权、Swagger、Postman、Git、Linux 基础、HTML 基础、CSS 基础、Vue 基础、前后端联调基础','会使用 AI 工具辅助理解框架报错、生成接口测试样例、整理数据库表字段和补充接口文档。对于 AI 生成的代码，会结合课程资料、官方文档和本地运行结果进行核对，目前主要将 AI 作为学习和排查问题的辅助工具。','https://github.com/demo-user-backend-v2','我目前主要投递 Java 后端开发、后端开发实习和企业应用开发相关岗位。相比第一个阶段只学习基础知识，现在已经通过两个项目练习了数据库设计、接口开发、登录鉴权、分页查询、接口文档和前后端联调，但还缺少真实企业实习经验。\n\n当前我的能力仍处于本科实习生入门阶段，对高并发、分布式和复杂系统设计理解还不深入，但已经具备一定项目实践基础。接下来希望通过实习进一步学习企业项目中的需求评审、分支开发、接口规范、测试反馈修复、日志排查和上线验收流程，也会继续补齐 Redis、Docker、Linux 部署和数据库优化相关能力。','【简历名称】07-后端开发简历版本对比-V2项目实践版\n【基础信息】姓名：赵宇航｜手机：13900020001｜邮箱：mailto:zhaoyuhang.backend@example.com｜城市：长沙\n【专业技能】Java、SQL、Spring Boot、MyBatis、MySQL、Redis 基础、JWT、RESTful API 设计、数据库表结构设计、分页查询、参数校验、登录鉴权、Swagger、Postman、Git、Linux 基础、HTML 基础、CSS 基础、Vue 基础、前后端联调基础\n【AI应用技能】会使用 AI 工具辅助理解框架报错、生成接口测试样例、整理数据库表字段和补充接口文档。对于 AI 生成的代码，会结合课程资料、官方文档和本地运行结果进行核对，目前主要将 AI 作为学习和排查问题的辅助工具。\n【教育经历】湖南科技大学｜本科｜软件工程｜计算机科学与工程学院｜2022-09-2026-06｜GPA 3.31/4.0｜主修：数据结构、Java 程序设计、数据库系统、计算机网络、操作系统、软件工程、Web 开发技术、Linux 操作系统基础\n【项目经历】校园失物招领系统｜角色：后端开发｜2024-03-2024-06｜面向校内学生失物招领场景，开发一个校园失物招领系统，支持用户注册登录、失物信息发布、失物列表查询、关键词搜索、留言评论和状态修改等功能。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis、JWT 和 Swagger 实现，我主要负责后端接口开发、数据库表设计和前后端联调。\n\n项目中设计了用户表、失物信息表、留言表和操作记录表，完成用户注册登录、失物信息发布、失物分页查询、关键词搜索、留言提交、状态修改等接口。登录部分使用 JWT 保存用户登录状态，并对发布失物、留言和修改状态等接口增加登录校验。为了方便前端同学联调，我使用 Swagger 补充接口路径、请求参数和返回字段说明。项目后期根据测试反馈修复了空参数提交、分页页码异常、未登录用户发布信息、普通用户修改他人失物状态等问题。\n\n该项目最终完成基础前后端联调，模拟录入 100 余条失物信息和 30 余条留言记录。通过这个项目，我第一次比较完整地练习了从需求拆分、数据库建表、接口开发、接口文档到联调修复的后端开发流程，也开始理解登录鉴权、参数校验和资源归属校验的重要性。\n【项目经历】个人博客与学习笔记系统｜角色：个人开发者｜2024-08-2024-10｜为了整理自己的技术学习笔记，开发一个个人博客与学习笔记系统，支持文章发布、文章分类、标签筛选、评论管理和后台登录等功能。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis 和 Vue 实现，我独立完成后端接口、数据库设计和基础页面联调。\n\n项目中设计了文章表、分类表、标签表、评论表和用户表，实现文章增删改查、文章分页查询、分类筛选、标签筛选、评论提交、评论审核和后台登录等接口。为了减少首页文章列表和文章详情的重复查询，我尝试使用 Redis 缓存热门文章详情和首页文章列表，并在文章更新后手动清理对应缓存。评论模块增加了审核状态，避免评论提交后直接展示。后台接口增加登录校验，防止未登录用户访问管理接口。\n\n该项目虽然规模不大，但帮助我进一步熟悉了 Spring Boot、MyBatis、MySQL 和 Redis 的基础使用，也让我对数据库表关系、分页查询、缓存更新、后台权限校验和接口测试有了更具体的理解。项目完成后，我整理了接口文档和本地启动说明，方便后续继续迭代。\n【外语考试】CET-4：462\n【证书】全国计算机等级考试二级｜2024 年 3 月通过，掌握基础程序设计和常用办公软件应用能力。\n【证书】Java Web 后端开发训练营结业证书｜2024 年 12 月获得，学习 Spring Boot、MyBatis、MySQL、Redis、接口开发和项目部署基础。\n【获奖】软件工程课程设计优秀项目｜校级课程项目荣誉，2024 年 6 月获得，项目为校园失物招领系统，主要负责后端接口开发和数据库设计。\n【作品】校园失物招领系统｜https://github.com/demo-user/lost-found-system\n【作品】个人博客与学习笔记系统｜https://github.com/demo-user/personal-blog\n【个人主页】https://github.com/demo-user-backend-v2\n【补充信息】我目前主要投递 Java 后端开发、后端开发实习和企业应用开发相关岗位。相比第一个阶段只学习基础知识，现在已经通过两个项目练习了数据库设计、接口开发、登录鉴权、分页查询、接口文档和前后端联调，但还缺少真实企业实习经验。\n\n当前我的能力仍处于本科实习生入门阶段，对高并发、分布式和复杂系统设计理解还不深入，但已经具备一定项目实践基础。接下来希望通过实习进一步学习企业项目中的需求评审、分支开发、接口规范、测试反馈修复、日志排查和上线验收流程，也会继续补齐 Redis、Docker、Linux 部署和数据库优化相关能力。\n','2026-06-08 22:31:58','2026-06-08 22:31:58'),(8,2,'08-后端开发简历版本对比-V3实习投递版',1,'赵宇航','13900020001','zhaoyuhang.backend@example.com','长沙','Java、SQL、Spring Boot、MyBatis、MySQL、Redis 基础、JWT、RESTful API 设计、数据库表结构设计、索引基础、分页查询、参数校验、登录鉴权、资源归属校验、接口幂等基础、缓存设计、Swagger、Postman、Git、Linux 基础、Docker 基础、Nginx 基础、Shell 基础、HTML 基础、CSS 基础、Vue 基础、前后端联调、接口测试、测试反馈修复','会使用 AI 工具辅助理解框架报错、生成接口测试样例、整理数据库表字段、补充 Swagger 接口说明和梳理 Bug 排查思路。对于 AI 生成的代码，会结合课程资料、官方文档、本地运行结果和接口测试结果进行核对，不直接复制未经验证的生成代码。实习和项目中主要将 AI 作为学习、排查问题和整理文档的辅助工具。','https://github.com/demo-user-backend-v3','我目前主要投递 Java 后端开发、后端开发实习、企业应用开发和后台系统开发相关岗位。相比最开始只学习基础语法和数据库知识，现在已经通过课程项目、个人项目和企业实习，逐步补齐了接口开发、数据库建模、登录鉴权、分页查询、资源归属校验、Redis 基础使用、接口文档维护和前后端联调经验。\n\n当前我的能力仍处于本科实习生阶段，对高并发、分布式架构和复杂系统设计理解还不深入，但已经具备一定后端项目实践和企业实习经验。我比较重视接口可运行、字段说明清楚、异常返回明确、问题可以复现和修改后能够验证。后续希望继续提升 Java 后端开发能力，重点补齐 MySQL 查询优化、Redis 缓存一致性、消息队列、Linux 部署、日志排查和真实业务系统设计经验。','【简历名称】08-后端开发简历版本对比-V3实习投递版\n【基础信息】姓名：赵宇航｜手机：13900020001｜邮箱：zhaoyuhang.backend@example.com｜城市：长沙\n【专业技能】Java、SQL、Spring Boot、MyBatis、MySQL、Redis 基础、JWT、RESTful API 设计、数据库表结构设计、索引基础、分页查询、参数校验、登录鉴权、资源归属校验、接口幂等基础、缓存设计、Swagger、Postman、Git、Linux 基础、Docker 基础、Nginx 基础、Shell 基础、HTML 基础、CSS 基础、Vue 基础、前后端联调、接口测试、测试反馈修复\n【AI应用技能】会使用 AI 工具辅助理解框架报错、生成接口测试样例、整理数据库表字段、补充 Swagger 接口说明和梳理 Bug 排查思路。对于 AI 生成的代码，会结合课程资料、官方文档、本地运行结果和接口测试结果进行核对，不直接复制未经验证的生成代码。实习和项目中主要将 AI 作为学习、排查问题和整理文档的辅助工具。\n【教育经历】湖南科技大学｜本科｜软件工程｜计算机科学与工程学院｜2022-09-2026-06｜GPA 3.31/4.0｜主修：数据结构、Java 程序设计、数据库系统、计算机网络、操作系统、软件工程、Web 开发技术、Linux 操作系统基础、软件测试、数据库课程设计｜论文：暂无正式论文发表。本科阶段主要围绕 Java 后端开发、数据库设计、接口开发、登录鉴权、缓存使用和前后端联调进行项目实践。已完成校园失物招领系统、个人博客与学习笔记系统等项目，并在企业实习中参与后台管理系统接口开发、测试反馈修复和接口文档维护。\n【项目经历】校园失物招领系统｜角色：后端开发｜2024-03-2024-06｜面向校内学生失物招领场景，开发校园失物招领系统，支持用户注册登录、失物信息发布、失物列表查询、关键词搜索、留言评论、认领申请和状态修改等功能。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis、JWT 和 Swagger 实现，我主要负责后端接口开发、数据库表设计、登录鉴权和前后端联调。\n\n项目中设计了用户表、失物信息表、留言表、认领申请表和操作记录表，完成用户注册登录、失物信息发布、分页查询、关键词搜索、留言提交、认领申请提交、状态修改等接口。登录部分使用 JWT 保存用户登录状态，并对发布失物、提交留言、提交认领申请和修改状态等接口增加登录校验。为了避免普通用户修改他人发布的信息，我在修改和删除接口中补充资源归属校验，先根据失物信息 ID 查询发布人，再判断当前登录用户是否有操作权限。为了方便前端联调，我使用 Swagger 维护接口路径、请求参数、返回字段和异常状态说明。\n\n项目后期根据测试反馈修复了空参数提交、分页页码异常、未登录用户发布信息、普通用户修改他人失物状态、重复提交认领申请等问题。最终项目完成基础前后端联调，模拟录入 100 余条失物信息、30 余条留言记录和 20 余条认领申请记录。通过这个项目，我比较完整地练习了需求拆分、数据库建表、接口开发、登录鉴权、资源归属校验、接口文档和联调修复流程。\n【项目经历】个人博客与学习笔记系统｜角色：个人开发者｜2024-08-2024-10｜为了整理自己的技术学习笔记，开发个人博客与学习笔记系统，支持文章发布、文章分类、标签筛选、评论管理、后台登录、Markdown 内容展示和文章浏览统计。项目使用 Java、Spring Boot、MyBatis、MySQL、Redis 和 Vue 实现，我独立完成后端接口、数据库设计和基础页面联调。\n\n项目中设计了文章表、分类表、标签表、评论表、用户表和文章浏览记录表，实现文章增删改查、文章分页查询、分类筛选、标签筛选、评论提交、评论审核、后台登录和文章浏览量统计等接口。为了减少首页文章列表和文章详情的重复查询，我使用 Redis 缓存热门文章详情和首页文章列表，并在文章更新、删除和评论状态变更后清理相关缓存。评论模块增加审核状态，避免评论提交后直接展示；后台接口增加登录校验，防止未登录用户访问管理接口。\n\n项目完成后，我整理了接口文档、本地启动说明和常见问题记录。通过该项目，我进一步熟悉了 Spring Boot、MyBatis、MySQL 和 Redis 的基础使用，也对数据库表关系、分页查询、缓存更新、后台权限校验和接口测试有了更具体的理解。\n【项目经历】接口重复提交与幂等处理练习｜角色：个人开发者｜2025-02-2025-02｜为了理解后端接口在重复点击、网络重试和并发请求场景下可能出现的数据重复问题，完成一个接口重复提交与幂等处理练习项目，模拟认领申请提交、评论提交和订单提交等业务场景。项目使用 Java、Spring Boot、Redis 和 MySQL 实现。\n\n项目中设计了请求 token 生成、Redis 校验、业务处理和 token 失效流程，使用 Redis 的 SETNX 思路对短时间内重复提交进行拦截。针对认领申请提交场景，我额外增加业务唯一键校验，避免同一用户对同一失物重复提交认领申请。测试过程中，我分别验证了正常提交、连续点击提交、刷新重试、请求参数缺失和业务处理异常等场景，并记录接口返回结果。该练习让我理解幂等处理不是简单禁用按钮，而是需要结合前端交互、请求唯一标识、业务唯一键、事务处理和异常返回共同设计。\n【实习经历】长沙某软件科技有限公司｜后端开发实习生｜2025-03-2025-05｜参与企业内部后台管理系统的后端接口开发，项目主要服务员工信息维护、部门管理、审批记录查询和基础数据统计等场景。实习期间使用 Java、Spring Boot、MyBatis、MySQL、Redis 和 Swagger 进行开发，主要负责列表查询、详情查询、基础信息维护、字段校验和测试反馈修复。\n\n实习初期，我先参与阅读已有接口和数据库表结构，熟悉项目中的 Controller、Service、Mapper 分层方式，以及统一返回结构、分页参数、状态枚举和异常提示规范。随后参与员工信息、部门信息、审批记录和角色配置等模块开发，完成 11 个列表查询和详情接口，支持分页、条件筛选、状态过滤、关键词查询和时间范围查询。针对前端联调中出现的字段含义不清、空值返回不统一、状态枚举展示不一致等问题，我补充 Swagger 注释和字段说明，并和前端同学对齐返回结构。\n\n测试阶段，我根据测试反馈修复参数为空、分页页码异常、时间格式错误、状态筛选不生效、删除后列表未刷新等问题。对于员工列表和审批记录等高频查询接口，我协助排查慢查询原因，使用 EXPLAIN 查看 SQL 执行情况，并在正式员工指导下对部门 ID、状态、创建时间等字段增加索引，配合测试验证查询结果一致性。实习期间参与开发和维护 18 个接口，修复测试阶段反馈问题 26 项，负责模块最终在内部测试环境完成验收。\n\n通过这段实习，我第一次接触到比较完整的企业项目开发流程，包括需求理解、分支开发、接口自测、前后端联调、测试反馈修复、接口文档维护和验收确认。相比学校项目，企业项目更重视字段规范、异常处理、兼容已有数据、日志排查和稳定交付，这让我对后端开发实习生的实际工作内容有了更清晰的认识。\n【外语考试】CET-4：462\n【证书】全国计算机等级考试二级｜2024 年 3 月通过，掌握基础程序设计、数据库基础和常用办公软件应用能力。\n【证书】Java Web 后端开发训练营结业证书｜2024 年 12 月获得，学习 Spring Boot、MyBatis、MySQL、Redis、接口开发和项目部署基础。\n【获奖】软件工程课程设计优秀项目｜校级课程项目荣誉，2024 年 6 月获得，项目为校园失物招领系统，主要负责后端接口开发、数据库设计和前后端联调。\n【获奖】校级程序设计竞赛三等奖｜校级三等奖，2024 年 5 月获得，主要使用 C++ 完成数组、字符串、排序和基础动态规划题目。\n【作品】校园失物招领系统｜https://github.com/demo-user/lost-found-system\n【作品】个人博客与学习笔记系统｜https://github.com/demo-user/personal-blog\n【作品】接口重复提交与幂等处理练习｜https://github.com/demo-user/idempotency-demo\n【个人主页】https://github.com/demo-user-backend-v3\n【补充信息】我目前主要投递 Java 后端开发、后端开发实习、企业应用开发和后台系统开发相关岗位。相比最开始只学习基础语法和数据库知识，现在已经通过课程项目、个人项目和企业实习，逐步补齐了接口开发、数据库建模、登录鉴权、分页查询、资源归属校验、Redis 基础使用、接口文档维护和前后端联调经验。\n\n当前我的能力仍处于本科实习生阶段，对高并发、分布式架构和复杂系统设计理解还不深入，但已经具备一定后端项目实践和企业实习经验。我比较重视接口可运行、字段说明清楚、异常返回明确、问题可以复现和修改后能够验证。后续希望继续提升 Java 后端开发能力，重点补齐 MySQL 查询优化、Redis 缓存一致性、消息队列、Linux 部署、日志排查和真实业务系统设计经验。\n','2026-06-08 22:39:30','2026-06-08 22:39:30');
