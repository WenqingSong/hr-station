DROP TABLE IF EXISTS `semantic_profile_tags`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `semantic_profile_tags` (
  `id` bigint NOT NULL AUTO_INCREMENT,
  `profile_id` bigint NOT NULL,
  `target_type` varchar(32) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'resume/job',
  `target_id` bigint NOT NULL COMMENT 'resume_id/job_id',
  `tag_code` varchar(128) COLLATE utf8mb4_unicode_ci NOT NULL,
  `tag_label` varchar(255) COLLATE utf8mb4_unicode_ci NOT NULL,
  `category` varchar(64) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT 'role_direction/technical_skill/engineering_capability/domain_context/experience_signal/risk_signal/preference_signal',
  `confidence` decimal(9,4) NOT NULL DEFAULT '0.0000',
  `evidence_text` text COLLATE utf8mb4_unicode_ci,
  `explanation` text COLLATE utf8mb4_unicode_ci,
  `source_section` varchar(128) COLLATE utf8mb4_unicode_ci DEFAULT NULL,
  `is_user_visible` tinyint(1) NOT NULL DEFAULT '1',
  `weight` decimal(9,4) NOT NULL DEFAULT '0.0000',
  `created_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` datetime NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  KEY `idx_semantic_tag_profile_id` (`profile_id`),
  KEY `idx_semantic_tag_target` (`target_type`,`target_id`),
  KEY `idx_semantic_tag_code` (`tag_code`),
  KEY `idx_semantic_tag_category` (`category`),
  KEY `idx_semantic_tag_visible` (`is_user_visible`),
  CONSTRAINT `fk_semantic_tag_profile` FOREIGN KEY (`profile_id`) REFERENCES `semantic_profiles` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=709 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='SEP semantic profile tags with evidence and confidence';
/*!40101 SET character_set_client = @saved_cs_client */;

LOCK TABLES `semantic_profile_tags` WRITE;
/*!40000 ALTER TABLE `semantic_profile_tags` DISABLE KEYS */;
INSERT INTO `semantic_profile_tags` VALUES (1,1,'resume',8,'java_backend_development','Java后端开发','role_direction',0.9500,'我目前主要投递 Java 后端开发、后端开发实习、企业应用开发和后台系统开发相关岗位','明确候选人的核心求职方向，是匹配后端相关岗位的核心依据','补充信息',1,0.9500,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(2,1,'resume',8,'backend_development_intern','后端开发实习','role_direction',0.9000,'我目前主要投递 Java 后端开发、后端开发实习、企业应用开发和后台系统开发相关岗位','候选人当前求职定位为实习岗位，是校园招聘场景下的核心匹配方向','补充信息',1,0.9000,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(3,1,'resume',8,'enterprise_application_backend_development','企业应用后端开发','role_direction',0.8500,'我目前主要投递 Java 后端开发、后端开发实习、企业应用开发和后台系统开发相关岗位','候选人有企业后台管理系统开发实习经历，适配企业应用开发方向','补充信息',1,0.8500,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(4,1,'resume',8,'java_springboot_mysql_backend_development','Java Spring Boot MySQL后端开发','technical_skill',0.9500,'项目使用 Java、Spring Boot、MyBatis、MySQL、Redis、JWT 和 Swagger 实现，我主要负责后端接口开发、数据库表设计、登录鉴权和前后端联调','候选人的核心技术栈，是后端开发岗位匹配的核心能力依据','项目经历-校园失物招领系统',1,0.9500,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(5,1,'resume',8,'redis_basic_application','Redis基础应用','technical_skill',0.9000,'为了减少首页文章列表和文章详情的重复查询，我使用 Redis 缓存热门文章详情和首页文章列表，并在文章更新、删除和评论状态变更后清理相关缓存','候选人具备Redis基础使用能力，可支撑缓存相关基础开发需求','项目经历-个人博客与学习笔记系统',1,0.8500,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(6,1,'resume',8,'restful_api_design_and_development','RESTful API设计与开发','technical_skill',0.9000,'专业技能：JWT、RESTful API 设计、数据库表结构设计、索引基础、分页查询、参数校验、登录鉴权、资源归属校验、接口幂等基础、缓存设计、Swagger','接口开发是后端核心工作，该能力是候选人完成多个项目的基础','专业技能',1,0.9000,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(7,1,'resume',8,'database_table_design_and_optimization','数据库表设计与优化','engineering_capability',0.8800,'针对前端联调中出现的字段含义不清、空值返回不统一、状态枚举展示不一致等问题，我补充 Swagger 注释和字段说明，并和前端同学对齐返回结构。测试阶段，我根据测试反馈修复参数为空、分页页码异常、时间格式错误、状态筛选不生效、删除后列表未刷新等问题。对于员工列表和审批记录等高频查询接口，我协助排查慢查询原因，使用 EXPLAIN 查看 SQL 执行情况，并在正式员工指导下对部门 ID、状态、创建时间等字段增加索引','数据库设计及优化能力是后端开发的核心工程能力，直接影响系统性能','实习经历',1,0.8800,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(8,1,'resume',8,'interface_idempotent_design','接口幂等设计','engineering_capability',0.8500,'为了理解后端接口在重复点击、网络重试和并发请求场景下可能出现的数据重复问题，完成一个接口重复提交与幂等处理练习项目，模拟认领申请提交、评论提交和订单提交等业务场景。项目中设计了请求 token 生成、Redis 校验、业务处理和 token 失效流程，使用 Redis 的 SETNX 思路对短时间内重复提交进行拦截','接口幂等是后端开发的重要工程能力，可避免重复提交带来的数据问题','项目经历-接口重复提交与幂等处理练习',1,0.8500,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(9,1,'resume',8,'frontend_backend_joint_debugging','前后端联调','engineering_capability',0.9200,'我主要负责后端接口开发、数据库表设计、登录鉴权和前后端联调','前后端联调是后端开发必备的协作能力，候选人多个项目均有相关实践','项目经历-校园失物招领系统',1,0.9000,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(10,1,'resume',8,'campus_scene_project_experience','校园场景项目经验','domain_context',0.9000,'面向校内学生失物招领场景，开发校园失物招领系统，支持用户注册登录、失物信息发布、失物列表查询、关键词搜索、留言评论、认领申请和状态修改等功能','校园场景项目经验可适配校园服务类相关后端开发岗位需求','项目经历-校园失物招领系统',1,0.8000,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(11,1,'resume',8,'enterprise_background_management_system_experience','企业后台管理系统开发经验','domain_context',0.8800,'参与企业内部后台管理系统的后端接口开发，项目主要服务员工信息维护、部门管理、审批记录查询和基础数据统计等场景','企业后台管理系统是后端开发的常见业务领域，该经验适配相关岗位','实习经历',1,0.8500,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(12,1,'resume',8,'backend_development_internship_experience','后端开发实习经历','experience_signal',0.9500,'长沙某软件科技有限公司｜后端开发实习生｜2025-03-2025-05｜参与企业内部后台管理系统的后端接口开发，实习期间参与开发和维护 18 个接口，修复测试阶段反馈问题 26 项，负责模块最终在内部测试环境完成验收','企业实习经历是校园招聘中评估候选人实践能力的重要信号','实习经历',1,0.9500,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(13,1,'resume',8,'multiple_backend_project_landing','多个后端项目落地','experience_signal',0.9200,'已完成校园失物招领系统、个人博客与学习笔记系统等项目，并在企业实习中参与后台管理系统接口开发、测试反馈修复和接口文档维护','多个项目落地证明候选人具备将技术能力转化为实际产出的能力','教育经历',1,0.9000,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(14,1,'resume',8,'ai_assisted_development_ability','AI辅助开发能力','experience_signal',0.8500,'会使用 AI 工具辅助理解框架报错、生成接口测试样例、整理数据库表字段、补充 Swagger 接口说明和梳理 Bug 排查思路。对于 AI 生成的代码，会结合课程资料、官方文档、本地运行结果和接口测试结果进行核对，不直接复制未经验证的生成代码','AI辅助开发是当前开发提效的重要方式，该能力可提升候选人开发效率','AI应用技能',1,0.7500,'2026-06-12 12:15:13','2026-06-12 12:15:13'),(15,2,'job',10001,'后台开发','后台开发','role_direction',1.0000,'岗位名称：软件开发-后台开发方向','岗位明确属于后台开发方向','岗位名称',1,10.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(16,2,'job',10001,'C/C++开发','C/C++开发','technical_skill',1.0000,'熟练掌握 C/C++/Java/Go 等其中一门开发语言','岗位要求熟练掌握C/C++作为开发语言之一','必备要求',1,8.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(17,2,'job',10001,'Java开发','Java开发','technical_skill',1.0000,'熟练掌握 C/C++/Java/Go 等其中一门开发语言','岗位要求熟练掌握Java作为开发语言之一','必备要求',1,8.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(18,2,'job',10001,'Go开发','Go开发','technical_skill',1.0000,'熟练掌握 C/C++/Java/Go 等其中一门开发语言','岗位要求熟练掌握Go作为开发语言之一','必备要求',1,8.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(19,2,'job',10001,'TCP/UDP网络协议编程','TCP/UDP网络协议编程','technical_skill',1.0000,'熟悉 TCP/UDP 网络协议及相关编程、进程间通讯编程','岗位要求熟悉TCP/UDP网络协议及相关编程能力','必备要求',1,9.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(20,2,'job',10001,'进程间通讯编程','进程间通讯编程','technical_skill',1.0000,'熟悉 TCP/UDP 网络协议及相关编程、进程间通讯编程','岗位要求熟悉进程间通讯编程能力','必备要求',1,8.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(21,2,'job',10001,'软件专业知识储备','软件专业知识储备','engineering_capability',1.0000,'具备算法、操作系统、软件工程、设计模式、数据结构、数据库系统、网络安全等专业软件知识','岗位要求具备多领域专业软件知识','必备要求',1,9.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(22,2,'job',10001,'脚本语言了解','脚本语言了解','technical_skill',0.8000,'了解 Python、Shell、Perl 等脚本语言','岗位对Python、Shell等脚本语言有了解项要求','了解项',1,5.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(23,2,'job',10001,'MySQL及SQL编程了解','MySQL及SQL编程了解','technical_skill',0.8000,'了解 MySQL 及 SQL 编程','岗位对MySQL及SQL编程有了解项要求','了解项',1,5.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(24,2,'job',10001,'NoSQL存储原理了解','NoSQL存储原理了解','technical_skill',0.8000,'了解 NoSQL、Key-Value 存储原理','岗位对NoSQL、Key-Value存储原理有了解项要求','了解项',1,5.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(25,2,'job',10001,'分布式系统开发知识','分布式系统开发知识','preference_signal',0.9000,'了解分布式系统设计与开发、负载均衡、系统容灾、高可用系统等知识','了解分布式系统相关知识为岗位加分项','加分项',1,7.0000,'2026-06-12 12:25:51','2026-06-12 12:25:51'),(26,2,'job',10001,'云原生技术了解','云原生技术了解','preference_signal',0.9000,'对云原生相关技术有所了解','对云原生相关技术有了解为岗位加分项','加分项',1,7.0000,'2026-06-12 