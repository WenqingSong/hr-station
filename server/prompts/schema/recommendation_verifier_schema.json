{
"title": "Recommendation Verifier Agent Output Schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_name", "generated_by", "agent_status", "fallback", "generation_tier", "items", "verification"],
  "properties": {
    "agent_name": {"type": "string", "const": "recommend_verifier_agent"},
    "generated_by": {"type": "string", "const": "llm_agent"},
    "agent_status": {"type": "string", "enum": ["verified"]},
    "fallback": {"type": "boolean", "const": false},
    "repair_applied": {"type": "boolean"},
    "generation_tier": {"type": "string", "const": "quality"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["job_id", "recommendation_score", "recommendation_reason", "match_highlights", "risk_points"],
        "properties": {
          "job_id": {"type": "integer"},
          "title": {"type": "string"},
          "recommendation_score": {"type": "integer", "minimum": 40, "maximum": 100},
          "recommendation_reason": {"type": "string"},
          "recommendation_level": {"type": "string"},
          "match_highlights": {"type": "array", "items": {"type": "string"}},
          "risk_points": {"type": "array", "items": {"type": "string"}},
          "resume_evidence": {"type": "array", "items": {"type": "string"}},
          "job_evidence": {"type": "array", "items": {"type": "string"}},
          "suggested_action": {"type": "string"},
          "optimization_stop_signal": {"type": "string"}
        }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "all_job_ids_valid": {"type": "boolean"},
        "score_differentiated": {"type": "boolean"},
        "fields_complete": {"type": "boolean"},
        "issues_found": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
