{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "server/prompts/schema/resume_optimization_core_schema.json",
"title": "Resume Optimization Core Agent Output Schema",
"type": "object",
"additionalProperties": false,
"required": [
"optimization_summary",
"apply_readiness",
"top_fix_items",
"missing_keywords",
"final_checklist",
"authenticity_notice",
"generated_by"
],
"properties": {
"optimization_summary": {"type": "string", "minLength": 10, "maxLength": 500},
"apply_readiness": {"type": "string", "enum": ["ready","needs_revision","high_risk","insufficient_information"]},
"top_fix_items": {
"type": "array", "minItems": 0, "maxItems": 3,
"items": {
"type": "object", "additionalProperties": false,
"required": ["priority","issue","jd_evidence","resume_gap","action","why_it_matters"],
"properties": {
"priority": {"type": "string", "enum": ["P0","P1","P2"]},
"issue": {"type": "string", "minLength": 4, "maxLength": 220},
"jd_evidence": {"type": "string", "minLength": 4, "maxLength": 260},
"resume_gap": {"type": "string", "minLength": 4, "maxLength": 260},
"action": {"type": "string", "minLength": 4, "maxLength": 300},
"rewrite_example": {"type": "string", "maxLength": 400},
"why_it_matters": {"type": "string", "minLength": 4, "maxLength": 260}
}
}
},
"missing_keywords": {"type": "array", "minItems": 0, "maxItems": 8, "items": {"type": "string", "maxLength": 120}},
"final_checklist": {"type": "array", "minItems": 0, "maxItems": 5, "items": {"type": "string", "maxLength": 200}},
"authenticity_notice": {"type": "string", "minLength": 10, "maxLength": 300},
"generated_by": {"type": "string", "enum": ["llm_agent"]}
}
}
