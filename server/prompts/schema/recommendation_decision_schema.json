{
"title": "Recommendation Decision Agent Output Schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_name", "recommendations", "overall_strategy", "generation_notes"],
  "properties": {
    "agent_name": {"type": "string", "const": "recommend_decision_agent"},
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "recommendation_score", "recommendation_level", "recommendation_reason", "match_highlights", "risk_points"],
        "properties": {
          "job_id": {"type": "integer"},
          "title": {"type": "string"},
          "recommendation_score": {"type": "integer", "minimum": 40, "maximum": 100},
          "recommendation_level": {"type": "string", "enum": ["strong_recommend", "recommend", "try", "backup"]},
          "recommendation_reason": {"type": "string", "minLength": 10, "maxLength": 300},
          "match_highlights": {"type": "array", "items": {"type": "string"}},
          "risk_points": {"type": "array", "items": {"type": "string"}},
          "resume_evidence": {"type": "array", "items": {"type": "string"}},
          "job_evidence": {"type": "array", "items": {"type": "string"}},
          "optimization_stop_signal": {"type": "string"},
          "suggested_action": {"type": "string"}
        }
      }
    },
    "overall_strategy": {"type": "string", "minLength": 10, "maxLength": 500},
    "generation_notes": {
      "type": "object",
      "properties": {
        "score_distribution": {"type": "string"},
        "evidence_based": {"type": "boolean"}
      }
    }
  }
}
