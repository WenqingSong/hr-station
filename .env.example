# ============================================================
# Offer 捕手 - 本地开发环境变量示例
# 说明：
# 1. 本文件可以提交到代码仓库。
# 2. 请不要在本文件中填写真实密钥。
# 3. 本地开发时复制为 .env 后再按需修改。
# 4. .env 不应提交到代码仓库。
# ============================================================

# ------------------------------------------------------------
# 应用基础配置
# ------------------------------------------------------------
APP_NAME=offer-catcher
APP_ENV=local

# 前端开发服务端口
WEB_PORT=5173

# 后端 API 服务端口
SERVER_PORT=8080

# 前端请求后端 API 的基础地址
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------
# 本地 Go 后端连接 Docker Compose 暴露到宿主机的 MySQL 时，使用 127.0.0.1
# 如果后端也放入 Docker Compose 容器内运行，应改为 mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=offer_catcher
DB_USER=root
DB_PASSWORD=password

# Go 后端 GORM / MySQL DSN 示例
DB_DSN=root:password@tcp(127.0.0.1:3306)/offer_catcher?charset=utf8mb4&parseTime=True&loc=Local

# ------------------------------------------------------------
# Docker Compose MySQL 配置
# ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=offer_catcher
MYSQL_PORT=3306

# ------------------------------------------------------------
# JWT 配置
# ------------------------------------------------------------
# 本地开发示例值。生产或公开环境必须替换。
JWT_SECRET=change-me-in-local
JWT_EXPIRE_HOURS=168

# ------------------------------------------------------------
# LLM / Agent
# ------------------------------------------------------------
# 是否启用真实 LLM Agent
# true: 优先调用真实模型
# false: 使用阶段 3 Mock Agent
ENABLE_LLM_AGENT=false

# 是否启用 LLM 失败兜底
# true: LLM 调用失败、JSON 解析失败、字段校验失败时回退 Mock Agent
ENABLE_LLM_FALLBACK=true

# LLM Provider
# 当前阶段建议：hunyuan
LLM_PROVIDER=hunyuan

# Hunyuan OpenAI-compatible Base URL
# 用户需要按腾讯云混元官方控制台 / 文档确认最终地址
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1/chat/completions

# Hunyuan API Key
# 真实值只允许填写在 .env，不允许提交到仓库
LLM_API_KEY=sk-kpyTRRICS2kEKsjkCDWZtC7OnKvqsXeFH0JDTjKVt5ZC4Nql

# Hunyuan 模型名称
# 用户需要根据控制台可用模型填写
LLM_MODEL=hy3-preview

# LLM 请求超时时间，单位秒
LLM_TIMEOUT_SECONDS=20

# LLM 最大重试次数
LLM_MAX_RETRIES=1

# LLM 输出最大 token 数
LLM_MAX_OUTPUT_TOKENS=2048

# LLM 温度
LLM_TEMPERATURE=0.2

# ------------------------------------------------------------
# 腾讯招聘公开岗位数据源
# ------------------------------------------------------------
# 说明：
# 1. 这些配置项用于腾讯招聘官网公开岗位数据源的低频同步。
# 2. 完整拉取逻辑后续由 scripts/dev/tencent_jobs.sh 实现（4-1.2.3）。
# 3. 本次不创建数据目录，后续 4-1.2.3 脚本中再创建。
# 4. 腾讯招聘公开岗位接口不需要 API Key，不需要 Cookie，不需要 Token。
# 5. 不接登录、投递、收藏、用户中心等需要登录态的接口。
# ------------------------------------------------------------

# 是否启用腾讯招聘公开岗位数据源
TENCENT_JOBS_ENABLE=true

# 腾讯招聘岗位列表接口
# 来源：4-1.2.0.2 必要接口确认报告
TENCENT_JOBS_LIST_URL=https://join.qq.com/api/v1/position/searchPosition

# 腾讯招聘岗位详情接口
# 来源：4-1.2.0.2 必要接口确认报告
TENCENT_JOBS_DETAIL_URL=https://join.qq.com/api/v1/jobDetails/getJobDetailsByPostId

# 腾讯招聘字典接口（可选）
# 来源：4-1.2.0.2 必要接口确认报告
TENCENT_JOBS_DICTIONARY_URL=https://join.qq.com/api/v1/dictionary/

# 招聘项目映射 ID
# 2 通常对应应届实习 / p_2 场景，具体以探测报告为准
# 其他可选值：1=应届毕业生, 14=青云计划-应届生
TENCENT_JOBS_PROJECT_MAPPING_IDS=2

# 每页拉取数量
TENCENT_JOBS_PAGE_SIZE=50

# 最大拉取页数
# Demo 阶段建议控制页数，避免高频请求
TENCENT_JOBS_MAX_PAGES=3

# 是否拉取岗位详情
# true: 基于列表 postId 继续拉取岗位详情（推荐）
# false: 只拉取列表摘要数据
TENCENT_JOBS_FETCH_DETAIL=true

# 是否拉取字典数据
# true: 额外拉取字典数据用于 code→name 映射
# false: 不拉取字典（详情接口已返回城市名称和岗位大类名称）
TENCENT_JOBS_FETCH_DICTIONARY=true

# 每次请求间隔，单位毫秒
# 低频请求，避免触发限流
TENCENT_JOBS_REQUEST_INTERVAL_MS=500

# 请求超时时间，单位秒
TENCENT_JOBS_TIMEOUT_SECONDS=10

# 请求 User-Agent
# 模拟公开招聘页面正常请求上下文
TENCENT_JOBS_USER_AGENT=Mozilla/5.0

# 请求 Referer
TENCENT_JOBS_REFERER=https://join.qq.com/post.html?query=p_2

# 请求 Origin
TENCENT_JOBS_ORIGIN=https://join.qq.com

# 原始数据输出目录
# 注意：本次不创建该目录，后续 4-1.2.3 脚本中再创建
# 完整岗位数据默认不应提交仓库
TENCENT_JOBS_OUTPUT_DIR=data/tencent-jobs/raw

# ------------------------------------------------------------
# 开发调试配置
# ------------------------------------------------------------
LOG_LEVEL=debug
ENABLE_MOCK_AGENT=true
