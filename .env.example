# ============================================================
# Offerr鹅 - 本地开发环境变量示例
# 说明：
# 1. 本文件可以提交到代码仓库。
# 2. 请不要在本文件中填写真实密钥。
# 3. 本地开发时复制为 .env 后再按需修改。
# 4. .env 不应提交到代码仓库。
# ============================================================

# ------------------------------------------------------------
# 应用基础配置
# ------------------------------------------------------------
APP_NAME=offer-catcher
APP_ENV=local

# 前端开发服务端口
WEB_PORT=5173

# 后端 API 服务端口
SERVER_PORT=8080

# 前端请求后端 API 的基础地址
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------
# 本地 Go 后端连接 Docker Compose 暴露到宿主机的 MySQL 时，使用 127.0.0.1
# 如果后端也放入 Docker Compose 容器内运行，应改为 mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=offer_catcher
DB_USER=root
DB_PASSWORD=password

# Go 后端 GORM / MySQL DSN 示例
DB_DSN=root:password@tcp(127.0.0.1:3306)/offer_catcher?charset=utf8mb4&parseTime=True&loc=Local

# ------------------------------------------------------------
# Docker Compose MySQL 配置
# ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=offer_catcher
MYSQL_PORT=3306

# ------------------------------------------------------------
# JWT 配置
# ------------------------------------------------------------
# ⚠️ 本地开发示例值。请务必在非 local 环境替换为强随机值。
# 生成建议：openssl rand -hex 32
JWT_SECRET=change-me-in-local
JWT_EXPIRE_HOURS=168

# =========================
# Redis Config
# =========================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=604800

# =========================
# LLM / DeepSeek Config（双模型分层）
# =========================
#
# K7-1 / K7-2 双模型分层设计：
#   Fast Model   → deepseek-v4-flash       高频、轻量、成本敏感（岗位推荐）
#   Quality Model → deepseek-v4-pro-202606   深度分析、复杂推理、Demo 展示（匹配/优化/对比）
#   Fallback     → Mock Agent               任何模型失败时的兜底
#
# 兼容说明：
#   LLM_MODEL 保留为 legacy fallback。优先读取 LLM_FAST_MODEL / LLM_QUALITY_MODEL。
#   如果 LLM_FAST_MODEL 缺失，回退到 LLM_MODEL。
#   如果 LLM_QUALITY_MODEL 缺失，回退到 LLM_MODEL。

# 是否启用 LLM。默认 false，避免本地或演示环境误触发真实模型调用。
LLM_ENABLE=true

# LLM provider。支持 deepseek / hunyuan / tokenhub / hy3。
# 默认使用 tokenhub（标准 OpenAI 兼容接口）。
# 注意：token 平台必须与 LLM_BASE_URL 匹配，否则会 401 not authorized。
LLM_PROVIDER=tokenhub

# LLM API Base URL。
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1/chat/completions

# LLM API Key。必须只在本地 .env 中填写，禁止提交真实 Key。
LLM_API_KEY=

# Legacy fallback 模型。仅作为兼容字段；双模型路由优先使用 LLM_FAST_MODEL / LLM_QUALITY_MODEL。
LLM_MODEL=hy3-preview

# Fast Tier：高频、轻量、成本敏感任务（岗位推荐）。
LLM_FAST_MODEL=hy3-preview

# Quality Tier：深度分析、复杂推理、Demo 展示任务（匹配分析、简历优化、版本对比）。
LLM_QUALITY_MODEL=hy3-preview

# 默认模型层级。当前推荐 fast。
LLM_DEFAULT_TIER=fast

# 模型温度。推荐低温度，保证结构化输出稳定。
LLM_TEMPERATURE=0.2

# K14-Hy3: Top-P 采样参数（仅 Hy3 provider 使用）。
LLM_TOP_P=1.0

# 最大输出 token。Prompt + JSON 输出较长，建议不低于 8192。
LLM_MAX_OUTPUT_TOKENS=4096

# LLM 请求超时时间，单位秒。
LLM_TIMEOUT_SECONDS=180

# 是否启用 JSON repair。默认 true，模型输出 JSON 异常时允许修复一次。
LLM_REPAIR_ENABLE=true

# JSON repair 最大尝试次数。必须为 1，禁止递归修复。
LLM_REPAIR_MAX_ATTEMPTS=1

# 是否启用 Mock fallback。设为 false 时模型失败直接报错，不返回 mock 内容。
LLM_FALLBACK_ENABLE=false

# 是否记录模型原始输出。默认 false，避免日志泄露简历、JD 或敏感信息。
LLM_LOG_RAW_OUTPUT=false

# Prompt 文件目录。后续 Prompt Loader 使用。
LLM_PROMPT_DIR=server/prompts

# Schema 文件目录。后续 Schema Loader 使用。
LLM_SCHEMA_DIR=server/prompts/schema

# ─── K14-Hy3: Hy3-preview Provider ─────────────────────────────────
# 仅在 LLM_PROVIDER=hy3 时生效。
# Endpoint: https://api.lkeap.cloud.tencent.com/plan/v3/chat/completions
# Model: hy3-preview

LLM_HY3_BASE_URL=https://api.lkeap.cloud.tencent.com/plan/v3/chat/completions
LLM_HY3_API_KEY=
LLM_HY3_MODEL=hy3-preview

# ─── K14-Hy3: Reasoning Effort per Stage ────────────────────────────
# 仅 Hy3 provider 使用。支持值：no_think / low / high。
# think_low / think_high 不作为正式值使用。

# Fast tier: 不走 LLM，不使用 reasoning_effort
HY3_REASONING_EFFORT_FAST=no_think
# Tag/Evidence: 不走 LLM，不使用 reasoning_effort
HY3_REASONING_EFFORT_TAG=no_think
# Deep Agent1 (Context): 纯规则，不走 LLM
HY3_REASONING_EFFORT_DEEP_CONTEXT=low
# Deep Agent2 (Decision): 核心决策层，使用 high
HY3_REASONING_EFFORT_DEEP_DECISION=high
# Deep Agent3 (Verifier): 校验层，使用 low
HY3_REASONING_EFFORT_DEEP_VERIFIER=low
# JSON Repair: 修复层，使用 no_think
HY3_REASONING_EFFORT_REPAIR=no_think

# ------------------------------------------------------------
# 腾讯招聘公开岗位数据源
# ------------------------------------------------------------
# 说明：
# 1. 这些配置项用于腾讯招聘官网公开岗位数据源的低频同步。
# 2. 完整拉取逻辑后续由 scripts/dev/tencent_jobs.sh 实现（4-1.2.3）。
# 3. 本次不创建数据目录，后续 4-1.2.3 脚本中再创建。
# 4. 腾讯招聘公开岗位接口不需要 API Key，不需要 Cookie，不需要 Token。
# 5. 不接登录、投递、收藏、用户中心等需要登录态的接口。
# ------------------------------------------------------------

# 是否启用腾讯招聘公开岗位数据源
TENCENT_JOBS_ENABLE=true

# 腾讯招聘岗位列表接口
# 来源：4-1.2.0.2 必要接口确认报告
TENCENT_JOBS_LIST_URL=https://join.qq.com/api/v1/position/searchPosition

# 腾讯招聘岗位详情接口
# 来源：4-1.2.0.2 必要接口确认报告
TENCENT_JOBS_DETAIL_URL=https://join.qq.com/api/v1/jobDetails/getJobDetailsByPostId

# 腾讯招聘字典接口（可选）
# 来源：4-1.2.0.2 必要接口确认报告
TENCENT_JOBS_DICTIONARY_URL=https://join.qq.com/api/v1/dictionary/

# 招聘项目映射 ID
# 2 通常对应应届实习 / p_2 场景，具体以探测报告为准
# 其他可选值：1=应届毕业生, 14=青云计划-应届生
TENCENT_JOBS_PROJECT_MAPPING_IDS=2

# 每页拉取数量
TENCENT_JOBS_PAGE_SIZE=50

# 最大拉取页数
# Demo 阶段建议控制页数，避免高频请求
TENCENT_JOBS_MAX_PAGES=3

# 是否拉取岗位详情
# true: 基于列表 postId 继续拉取岗位详情（推荐）
# false: 只拉取列表摘要数据
TENCENT_JOBS_FETCH_DETAIL=true

# 是否拉取字典数据
# true: 额外拉取字典数据用于 code→name 映射
# false: 不拉取字典（详情接口已返回城市名称和岗位大类名称）
TENCENT_JOBS_FETCH_DICTIONARY=true

# 每次请求间隔，单位毫秒
# 低频请求，避免触发限流
TENCENT_JOBS_REQUEST_INTERVAL_MS=500

# 请求超时时间，单位秒
TENCENT_JOBS_TIMEOUT_SECONDS=10

# 请求 User-Agent
# 模拟公开招聘页面正常请求上下文
TENCENT_JOBS_USER_AGENT=Mozilla/5.0

# 请求 Referer
TENCENT_JOBS_REFERER=https://join.qq.com/post.html?query=p_2

# 请求 Origin
TENCENT_JOBS_ORIGIN=https://join.qq.com

# 原始数据输出目录
# 注意：本次不创建该目录，后续 4-1.2.3 脚本中再创建
# 完整岗位数据默认不应提交仓库
TENCENT_JOBS_OUTPUT_DIR=data/tencent-jobs/raw

# ------------------------------------------------------------
# CORS 配置
# ------------------------------------------------------------
# 允许的 Origin 列表，逗号分隔。
# 开发环境默认：localhost:5173, 127.0.0.1:5173, localhost（Nginx 同源）, 127.0.0.1（Nginx 同源）
# 生产环境：只允许正式域名，不要使用 *，不要把 localhost 当作 production 配置
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:5173

# 允许的 HTTP 方法
CORS_ALLOWED_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS

# 允许的请求头
CORS_ALLOWED_HEADERS=Content-Type, Authorization, X-Requested-With

# 是否允许携带凭证（Cookie）。当前项目使用 JWT Authorization Header，不使用 Cookie，建议 false
CORS_ALLOW_CREDENTIALS=false

# ------------------------------------------------------------
# 开发调试配置
# ------------------------------------------------------------
LOG_LEVEL=debug
ENABLE_MOCK_AGENT=false
