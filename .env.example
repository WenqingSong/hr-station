# ============================================================
# Offer 捕手 - 本地开发环境变量示例
# 说明：
# 1. 本文件可以提交到代码仓库。
# 2. 请不要在本文件中填写真实密钥。
# 3. 本地开发时复制为 .env 后再按需修改。
# 4. .env 不应提交到代码仓库。
# ============================================================

# ------------------------------------------------------------
# 应用基础配置
# ------------------------------------------------------------
APP_NAME=offer-catcher
APP_ENV=local

# 前端开发服务端口
WEB_PORT=5173

# 后端 API 服务端口
SERVER_PORT=8080

# 前端请求后端 API 的基础地址
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------
# 本地 Go 后端连接 Docker Compose 暴露到宿主机的 MySQL 时，使用 127.0.0.1
# 如果后端也放入 Docker Compose 容器内运行，应改为 mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=offer_catcher
DB_USER=root
DB_PASSWORD=password

# Go 后端 GORM / MySQL DSN 示例
DB_DSN=root:password@tcp(127.0.0.1:3306)/offer_catcher?charset=utf8mb4&parseTime=True&loc=Local

# ------------------------------------------------------------
# Docker Compose MySQL 配置
# ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=offer_catcher
MYSQL_PORT=3306

# ------------------------------------------------------------
# JWT 配置
# ------------------------------------------------------------
# 本地开发示例值。生产或公开环境必须替换。
JWT_SECRET=change-me-in-local
JWT_EXPIRE_HOURS=168

# ------------------------------------------------------------
# LLM / Agent
# ------------------------------------------------------------
# 是否启用真实 LLM Agent
# true: 优先调用真实模型
# false: 使用阶段 3 Mock Agent
ENABLE_LLM_AGENT=false

# 是否启用 LLM 失败兜底
# true: LLM 调用失败、JSON 解析失败、字段校验失败时回退 Mock Agent
ENABLE_LLM_FALLBACK=true

# LLM Provider
# 当前阶段建议：hunyuan
LLM_PROVIDER=hunyuan

# Hunyuan OpenAI-compatible Base URL
# 用户需要按腾讯云混元官方控制台 / 文档确认最终地址
LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# Hunyuan API Key
# 真实值只允许填写在 .env，不允许提交到仓库
LLM_API_KEY=

# Hunyuan 模型名称
# 用户需要根据控制台可用模型填写
LLM_MODEL=hunyuan-turbos-latest

# LLM 请求超时时间，单位秒
LLM_TIMEOUT_SECONDS=20

# LLM 最大重试次数
LLM_MAX_RETRIES=1

# LLM 输出最大 token 数
LLM_MAX_OUTPUT_TOKENS=2048

# LLM 温度
LLM_TEMPERATURE=0.2

# ------------------------------------------------------------
# 开发调试配置
# ------------------------------------------------------------
LOG_LEVEL=debug
ENABLE_MOCK_AGENT=true
