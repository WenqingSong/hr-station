# ============================================================
# Offer 捕手 - 本地开发环境变量示例
# 说明：
# 1. 本文件可以提交到代码仓库。
# 2. 请不要在本文件中填写真实密钥。
# 3. 本地开发时复制为 .env 后再按需修改。
# 4. .env 不应提交到代码仓库。
# ============================================================

# ------------------------------------------------------------
# 应用基础配置
# ------------------------------------------------------------
APP_NAME=offer-catcher
APP_ENV=local

# 前端开发服务端口
WEB_PORT=5173

# 后端 API 服务端口
SERVER_PORT=8080

# 前端请求后端 API 的基础地址
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------
# 本地 Go 后端连接 Docker Compose 暴露到宿主机的 MySQL 时，使用 127.0.0.1
# 如果后端也放入 Docker Compose 容器内运行，应改为 mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=offer_catcher
DB_USER=root
DB_PASSWORD=password

# Go 后端 GORM / MySQL DSN 示例
DB_DSN=root:password@tcp(127.0.0.1:3306)/offer_catcher?charset=utf8mb4&parseTime=True&loc=Local

# ------------------------------------------------------------
# Docker Compose MySQL 配置
# ------------------------------------------------------------
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=offer_catcher
MYSQL_PORT=3306

# ------------------------------------------------------------
# JWT 配置
# ------------------------------------------------------------
# 本地开发示例值。生产或公开环境必须替换。
JWT_SECRET=change-me-in-local
JWT_EXPIRE_HOURS=168

# ------------------------------------------------------------
# LLM / Agent 配置
# ------------------------------------------------------------
# 阶段 4 才会真正接入模型。
# 当前阶段仅预留变量，不要填写真实密钥。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ------------------------------------------------------------
# 开发调试配置
# ------------------------------------------------------------
LOG_LEVEL=debug
ENABLE_MOCK_AGENT=true
